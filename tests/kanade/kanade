#!/usr/bin/env python3
"""카나데 — SekaiOS 코드 검토 하네스 (코드가 자라는 데 걸림돌이 되는 것을 찾는다)

  kanade run [-c 점검…] [--all]     점검 → 화면 요약 + 보고서(~/.cache/kanade/reports/<시각>/)
        -c imports   우리 코드끼리 import — 순환, 층 위반(공용→앱, 앱→앱), 싣지 않는 모듈
        -c deps      바깥 의존성 — 부르는 명령·typelib·파이썬 모듈이 sekai-desktop 의존성으로 깔리는가
        -c dupes     중복 구현 — 똑같은·거의 같은 함수, 모듈마다 다시 만든 도우미, 겹치는 CSS 클래스
        --all        참고(info)까지 화면에 다 보인다
  kanade list                      점검 목록

파이썬은 SekaiOS 와 같은 3.13 으로 돌린다 (uv 가 있으면 저절로) — 서버의 3.10 은 3.12+ 문법을 못 읽는다.
"""
import argparse
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))

if sys.version_info < (3, 12) and not os.environ.get("KANADE_NO_UV"):
    import shutil
    uv = shutil.which("uv") or os.path.expanduser("~/.local/bin/uv")
    if os.path.exists(uv):
        os.environ["KANADE_NO_UV"] = "1"
        os.execv(uv, [uv, "run", "-q", "--no-project", "--python", "3.13", "python3", __file__] + sys.argv[1:])

sys.path.insert(0, HERE)
from kd import deps, dupes, imports  # noqa: E402
from kd.finding import LEVEL_KO, LEVELS  # noqa: E402

CHECKS = {"imports": imports.check, "deps": deps.check, "dupes": dupes.check}
REPORTS = os.path.join(os.environ.get("KANADE_ROOT", os.path.expanduser("~/.cache/kanade")), "reports")
ICON = {"error": "✗", "warn": "!", "info": "·"}


def run(a):
    names = a.check or list(CHECKS)
    out = os.path.join(REPORTS, time.strftime("%Y%m%d-%H%M%S"))
    os.makedirs(out, exist_ok=True)
    allf = []
    for n in names:
        t0 = time.time()
        fs = CHECKS[n]()
        allf.extend(fs)
        cnt = {lv: sum(f.level == lv for f in fs) for lv in LEVELS}
        print(f"■ {n} — 오류 {cnt['error']} · 경고 {cnt['warn']} · 참고 {cnt['info']}  ({time.time() - t0:.1f}s)")
        for f in sorted(fs, key=lambda f: (LEVELS.index(f.level), f.kind, f.path or "", f.line or 0)):
            if f.level == "info" and not a.all:
                continue
            print(f"  {ICON[f.level]} [{f.kind}] {f.msg}")
            if f.where():
                print(f"      {f.where()}")
    with open(os.path.join(out, "results.json"), "w") as fp:
        json.dump([f.as_dict() for f in allf], fp, ensure_ascii=False, indent=1)
    cnt = {lv: sum(f.level == lv for f in allf) for lv in LEVELS}
    print(f"■ 결과: " + " · ".join(f"{LEVEL_KO[lv]} {cnt[lv]}" for lv in LEVELS))
    print(f"■ 기록: {out}/results.json")
    return 1 if cnt["error"] else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    r = sp.add_parser("run")
    r.add_argument("-c", "--check", action="append", choices=list(CHECKS))
    r.add_argument("--all", action="store_true")
    sp.add_parser("list")
    a = ap.parse_args()
    if a.cmd == "list":
        for n, fn in CHECKS.items():
            print(f"{n:10} {(sys.modules[fn.__module__].__doc__ or '').strip().splitlines()[0]}")
        return 0
    return run(a)


if __name__ == "__main__":
    sys.exit(main())
