<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SekaiOS 시스템 환경 변수 도우미 — 설정 앱의 "환경 변수" 가 pkexec 로 부른다 -->
<policyconfig>
  <vendor>SekaiOS</vendor>
  <action id="org.sekaios.envvars">
    <description>Change system environment variables</description>
    <description xml:lang="ko">시스템 환경 변수 바꾸기</description>
    <message>Authentication is required to change system environment variables</message>
    <message xml:lang="ko">모든 사용자의 환경 변수를 바꾸려면 인증이 필요합니다</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sekai/sekai-envvars</annotate>
  </action>
</policyconfig>
