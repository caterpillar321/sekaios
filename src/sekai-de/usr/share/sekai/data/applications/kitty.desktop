[Desktop Entry]
# SekaiOS: 기본 터미널은 Nenerobo(org.sekaios.Nenerobo.desktop, "터미널") — kitty 는 "다른 터미널"로 남긴다.
#   sekai-terminal 을 거쳐 켠다 (SEKAI_TERMINAL=kitty — 가상 머신이면 CPU 로 그리게 하는 등 SekaiOS 에 맞춘 처리가 거기 있다)
Version=1.0
Type=Application
Name=kitty
Name[ko]=kitty (다른 터미널)
GenericName=Terminal emulator
GenericName[ko]=터미널
Comment=GPU terminal emulator
Comment[ko]=GPU 로 그리는 다른 터미널
TryExec=kitty
StartupNotify=true
StartupWMClass=kitty
Exec=env SEKAI_TERMINAL=kitty sekai-terminal
Icon=kitty
Categories=System;TerminalEmulator;
Keywords=kitty;terminal;
X-TerminalArgExec=--
X-TerminalArgTitle=--title
X-TerminalArgAppId=--class
X-TerminalArgDir=--working-directory
X-TerminalArgHold=--hold
