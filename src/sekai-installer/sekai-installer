        self.esp_mb = 512
        self.swap_mb = 0
        self.fs = "btrfs"                      # btrfs = 시스템 복원 지점을 쓸 수 있다 (고급 설정에서 ext4)
        self.encrypt = False                   # 드라이브 암호화 — 기본 끔 (원하는 사람만)
        self.tpm, self.secure_boot = tpm_ready()
        self.recovery = None
