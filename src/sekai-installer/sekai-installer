            h.pack_start(W.icon(["drive-harddisk-solidstate" if d.get("ssd") else "drive-harddisk"], 36), False, False, 0)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            v.pack_start(W.label(f"빈 공간 {human(r['bytes'])}  ·  {d.get('model') or d['path']}", "choice-title"),
