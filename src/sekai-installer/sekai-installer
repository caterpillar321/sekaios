# ── 디스크 ────────────────────────────────────────────────
def live_disk():
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/live/medium"],
                             capture_output=True, text=True).stdout.strip().split("[")[0]
        if not src:
            return None
        pk = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True,
                            text=True).stdout.strip().splitlines()
        return "/dev/" + pk[0] if pk and pk[0] else src
    except Exception:
        return None


def disks():
    try:
        out = subprocess.run(["lsblk", "-J", "-b", "-o",
                              "NAME,PATH,SIZE,MODEL,VENDOR,TRAN,ROTA,RM,TYPE,FSTYPE,LABEL,PARTTYPENAME"],
                             capture_output=True, text=True).stdout
        data = json.loads(out)["blockdevices"]
    except Exception:
        return []
    live = live_disk()
    res = []
    for d in data:
        if d.get("type") != "disk" or d.get("path") == live:
            continue
        if d["name"].startswith(("zram", "loop", "sr", "fd")):
            continue
        parts = d.get("children") or []
        fs = [p.get("fstype") or "" for p in parts]
        names = [(p.get("parttypename") or "") for p in parts]
        windows = "ntfs" in fs or any("Microsoft" in n for n in names)
        linux = any(f in ("ext4", "ext3", "btrfs", "xfs") for f in fs)
        sekai = any((p.get("label") or "") in ("SekaiOS", "SEKAIESP") for p in parts)
        res.append({
            "path": d["path"], "size": int(d.get("size") or 0),
            "model": disk_name(d),
            "tran": (d.get("tran") or "").lower(), "ssd": d.get("rota") in (False, 0, "0"),
            "removable": d.get("rm") in (True, 1, "1"),
            "parts": len(parts), "windows": windows, "linux": linux, "sekai": sekai,
        })
    return res


def disk_name(d):
    vendor = (d.get("vendor") or "").strip().rstrip(",").strip()
    model = (d.get("model") or "").strip().replace("_", " ")
    if vendor and model.lower().startswith(vendor.lower()):
        vendor = ""                                  # "VMware, VMware Virtual S" → 한 번만
    if vendor.upper() == "ATA":                      # SATA 디스크는 제조사 자리에 ATA 가 온다
        vendor = ""
    if re.fullmatch(r"0x[0-9a-fA-F]+", vendor):       # 가상 디스크(virtio)는 제조사 자리에 장치 번호(0x1af4)가 온다
        vendor = ""
    name = " ".join(x for x in (vendor, model) if x)
    if name:
        return name
    # 모델 이름이 없다 — 연결 방식으로 (컴퓨터 관리 › 디스크 관리와 같은 이름)
    tran = (d.get("tran") or "").lower()
    if tran == "virtio" or d.get("name", "").startswith("vd"):
        return "가상 디스크"
    if tran == "nvme":
        return "NVMe SSD"
    if tran == "usb":
        return "USB 드라이브" if d.get("rm") in (True, 1, "1") else "외장 디스크"
    return "SSD" if d.get("rota") in (False, 0, "0") else "하드 디스크"


def probe_layout():
    """sekai-partition probe — 디스크·파티션·빈 공간 (관리자 권한으로)"""
    if DEMO:
        return demo_layout()
    cmd = [PARTITION, "probe"]
    if os.geteuid() != 0:
        cmd = ["sudo", "-n"] + cmd
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    if r.returncode != 0:
        raise RuntimeError((r.stdout + r.stderr).strip()[-300:] or "디스크를 읽지 못했습니다")
    return json.loads(r.stdout)


def demo_layout():
    """흉내 모드(SEKAI_INSTALLER_DEMO=1) — 윈도우 11 노트북 배치 (C: 를 줄여 빈 공간이 있는)"""
    sec, G = 512, 1024 ** 3
    def part(n, start, size, fs, typ, label="", **kw):
        d = {"path": f"/dev/nvme0n1p{n}", "number": n, "start": start, "sectors": size // sec, "size": size,
             "type": typ, "fs": fs, "label": label, "partlabel": "", "uuid": "", "mounts": [],
             "esp": typ == "C12A7328-F81F-11D2-BA4B-00A0C93EC93B", "msr": False,
             "winre": typ == "DE94BBA4-06D1-4D40-A16A-BFD50179D6AC", "bitlocker": fs == "BitLocker",
             "windows": fs in ("ntfs", "BitLocker")}
        d.update(kw)
        return d
    total = 1024 * 1000 ** 3
    p1 = part(1, 2048, 260 * MIB, "vfat", "C12A7328-F81F-11D2-BA4B-00A0C93EC93B", "SYSTEM", esp_free=200 * MIB,
              esp_windows=True)
    p2 = part(2, 2048 + 260 * 2048, 16 * MIB, "", "E3C9E316-0B5C-4DB8-817D-F92DF00215AE")
    p3 = part(3, 2048 + 276 * 2048, 700 * G, "BitLocker", "EBD0A0A2-B9E5-4433-87C0-68B6B72699C7", "OS")
    free_s = p3["start"] + p3["sectors"]
    last = total // sec - 34
    p5 = part(5, last - 260 * 2048 + 1, 260 * MIB, "ntfs", "DE94BBA4-06D1-4D40-A16A-BFD50179D6AC")
    p4 = part(4, p5["start"] - 2 * 1024 * 2048, 2 * G, "ntfs", "DE94BBA4-06D1-4D40-A16A-BFD50179D6AC")
    free = {"start": free_s, "end": p4["start"] - 1, "bytes": (p4["start"] - free_s) * sec}
    return {"disks": [{"path": "/dev/nvme0n1", "size": total, "model": "SAMSUNG MZVL21T0HCLR", "serial": "DEMO",
                       "tran": "nvme", "ssd": True, "removable": False, "live": False, "table": "gpt",
                       "ptuuid": "demo", "sector": sec, "first": 34, "last": last,
                       "parts": [p1, p2, p3, p4, p5], "free": [free]}]}


def side_options(layout):
    """다른 운영체제 옆에 설치할 수 있는 빈 공간들 — [{disk, region, esp}] (esp 가 None 이면 새로 만든다)"""
    out = []
    for d in layout.get("disks", []):
        if d.get("live") or d.get("table") != "gpt":
            continue
        esp = next((p for p in d["parts"] if p["esp"] and p["fs"] == "vfat"
                    and (p.get("esp_free") or 0) >= 16 * MIB), None)
        for r in d["free"]:
            if r["bytes"] >= MIN_SIDE + (0 if esp else 512 * MIB):
                out.append({"disk": d, "region": r, "esp": esp})
    return out


def part_title(p):
    """파티션을 사람 말로 — 디스크 관리(윈도우)와 비슷하게"""
    if p.get("esp"):
        return "EFI 시스템"
    if p.get("msr"):
        return "MS 예약"
    if p.get("winre"):
        return "복구"
    fs = (p.get("fs") or "").lower()
    if fs == "bitlocker":
        return f"{p.get('label') or 'Windows'} (BitLocker)"
    if fs == "ntfs":
        return p.get("label") or "Windows"
    if fs in ("ext4", "btrfs", "xfs"):
        return p.get("label") or "Linux"
    if fs == "swap":
        return "스왑"
    return p.get("label") or p.get("partlabel") or (fs.upper() if fs else "파티션")


def disk_bar(d, new=None, region=None, width=760):
    """디스크 막대 — 있는 파티션(그대로) + 빈 공간. region 자리에는 new[(종류, 이름, 바이트)]를 그린다"""
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
    segs = []
    for p in d["parts"]:
        cls = "win" if p.get("windows") and not p.get("winre") else "keep"
        segs.append((p["start"], cls, part_title(p), p["size"]))
    for r in d["free"]:
        if region is not None and r["start"] == region["start"] and new:
            for i, (cls, name, b) in enumerate(new):
                segs.append((r["start"] + i * 1e-3, cls, name, b))
        else:
            segs.append((r["start"], "free", "빈 공간", r["bytes"]))
    segs.sort(key=lambda x: x[0])
    total = max(1, d["size"])
    for _, cls, name, b in segs:
        if b < 64 * MIB and cls in ("keep", "free"):
            continue                                   # 아주 작은 조각(MS 예약 등)은 막대에서 뺀다
        seg = Gtk.Box()
        seg.get_style_context().add_class("plan-seg")
        seg.get_style_context().add_class(cls)
        txt = f"{name}  {human(b)}" if b >= 1000 ** 3 else f"{name}  {b // MIB} MB"
        lb = W.label(txt)
        lb.set_ellipsize(3)
        seg.pack_start(lb, True, True, 0)
        seg.set_size_request(max(70, int(width * b / total)), -1)
        box.pack_start(seg, cls in ("root", "win"), True, 0)
    return box


def human(b):
    gb = b / 1000 ** 3
    return f"{gb / 1000:.1f} TB" if gb >= 1000 else f"{gb:.0f} GB"


def tpm_ready():
    """TPM 2.0 이 있고 보안 부팅이 켜졌나 — 둘 다면 켤 때 암호를 묻지 않게 봉인할 수 있다"""
    tpm = os.path.exists("/dev/tpmrm0") or os.path.exists("/dev/tpm0")
    sb = False
    try:
        import glob
        for f in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
            with open(f, "rb") as fh:
                sb = fh.read()[4:5] == b"\x01"
    except OSError:
        pass
    return tpm, sb


def ram_mb():
    try:
        with open("/proc/meminfo") as f:
            for ln in f:
                if ln.startswith("MemTotal"):
                    return int(ln.split()[1]) // 1024
    except OSError:
        pass
    return 0


