# ── 디스크 ────────────────────────────────────────────────
def live_disk():
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/live/medium"],
                             capture_output=True, text=True).stdout.strip().split("[")[0]
        if not src:
            return None
        pk = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True,
                            text=True).stdout.strip().splitlines()
        return "/dev/" + pk[0] if pk and pk[0] else src
    except Exception:
        return None


def disks():
    try:
        out = subprocess.run(["lsblk", "-J", "-b", "-o",
                              "NAME,PATH,SIZE,MODEL,VENDOR,TRAN,ROTA,RM,TYPE,FSTYPE,LABEL,PARTTYPENAME"],
                             capture_output=True, text=True).stdout
        data = json.loads(out)["blockdevices"]
    except Exception:
        return []
    live = live_disk()
    res = []
    for d in data:
        if d.get("type") != "disk" or d.get("path") == live:
            continue
        if d["name"].startswith(("zram", "loop", "sr", "fd")):
            continue
        parts = d.get("children") or []
        fs = [p.get("fstype") or "" for p in parts]
        names = [(p.get("parttypename") or "") for p in parts]
        windows = "ntfs" in fs or any("Microsoft" in n for n in names)
        linux = any(f in ("ext4", "ext3", "btrfs", "xfs") for f in fs)
        sekai = any((p.get("label") or "") in ("SekaiOS", "SEKAIESP") for p in parts)
        res.append({
            "path": d["path"], "size": int(d.get("size") or 0),
            "model": disk_name(d),
            "tran": (d.get("tran") or "").lower(), "ssd": d.get("rota") in (False, 0, "0"),
            "removable": d.get("rm") in (True, 1, "1"),
            "parts": len(parts), "windows": windows, "linux": linux, "sekai": sekai,
        })
    return res


def disk_name(d):
    vendor = (d.get("vendor") or "").strip().rstrip(",").strip()
    model = (d.get("model") or "").strip().replace("_", " ")
    if vendor and model.lower().startswith(vendor.lower()):
        vendor = ""                                  # "VMware, VMware Virtual S" → 한 번만
    if vendor.upper() == "ATA":                      # SATA 디스크는 제조사 자리에 ATA 가 온다
        vendor = ""
    if re.fullmatch(r"0x[0-9a-fA-F]+", vendor):       # 가상 디스크(virtio)는 제조사 자리에 장치 번호(0x1af4)가 온다
        vendor = ""
    name = " ".join(x for x in (vendor, model) if x)
    if name:
        return name
    # 모델 이름이 없다 — 연결 방식으로 (컴퓨터 관리 › 디스크 관리와 같은 이름)
    tran = (d.get("tran") or "").lower()
    if tran == "virtio" or d.get("name", "").startswith("vd"):
        return "가상 디스크"
    if tran == "nvme":
        return "NVMe SSD"
    if tran == "usb":
        return "USB 드라이브" if d.get("rm") in (True, 1, "1") else "외장 디스크"
    return "SSD" if d.get("rota") in (False, 0, "0") else "하드 디스크"


def human(b):
    gb = b / 1000 ** 3
    return f"{gb / 1000:.1f} TB" if gb >= 1000 else f"{gb:.0f} GB"


def tpm_ready():
    """TPM 2.0 이 있고 보안 부팅이 켜졌나 — 둘 다면 켤 때 암호를 묻지 않게 봉인할 수 있다"""
    tpm = os.path.exists("/dev/tpmrm0") or os.path.exists("/dev/tpm0")
    sb = False
    try:
        import glob
        for f in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
            with open(f, "rb") as fh:
                sb = fh.read()[4:5] == b"\x01"
    except OSError:
        pass
    return tpm, sb


def ram_mb():
    try:
        with open("/proc/meminfo") as f:
            for ln in f:
                if ln.startswith("MemTotal"):
                    return int(ln.split()[1]) // 1024
    except OSError:
        pass
    return 0


