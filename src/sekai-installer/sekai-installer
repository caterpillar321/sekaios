    def start(self):
        self.busy = True
        self.started = time.monotonic()
        self.bar.set_fraction(0)
        self.pct.set_text("0%")
        self.wz.show_page("install", back=None, next_label=None, footer=False)
        self._show_tip()
        GLib.timeout_add_seconds(8, self._next_tip)
        threading.Thread(target=self._run, daemon=True).start()

    def _side_plan(self):
        """다른 운영체제 옆에 설치 — 고른 빈 공간에 (ESP) · 부팅 · SekaiOS"""
        o = self.side
        d, r = o["disk"], o["region"]
        spm = MIB // d["sector"]
        s = r["start"]
        create, mounts = [], []
        if o["esp"]:
            mounts.append({"target": "/boot/efi", "dev": o["esp"]["path"], "fs": "vfat", "format": False})
        else:
            create.append({"id": "esp", "disk": d["path"], "start": s, "end": s + 512 * spm - 1, "type": "ef00",
                           "name": "SEKAI-ESP"})
            mounts.append({"target": "/boot/efi", "dev": "@esp", "fs": "vfat", "format": True})
            s += 512 * spm
        create.append({"id": "boot", "disk": d["path"], "start": s, "end": s + 1024 * spm - 1, "type": "ea00",
                       "name": "SEKAI-BOOT"})
        s += 1024 * spm
        create.append({"id": "root", "disk": d["path"], "start": s, "end": r["end"], "type": "8304",
                       "name": "SEKAI-ROOT"})
        mounts += [{"target": "/boot", "dev": "@boot", "fs": "ext4", "format": True},
                   {"target": "/", "dev": "@root", "fs": self.fs, "format": True, "encrypt": self.encrypt,
                    "label": "SekaiOS"}]
        return {"version": 1, "disks": [{"path": d["path"], "size": d["size"], "serial": d["serial"],
                                         "ptuuid": d["ptuuid"]}],
                "delete": [], "create": create, "mounts": mounts}

    def _cmd(self):
        if self.mode in ("side", "manual"):
            import tempfile
            fd, self.plan_path = tempfile.mkstemp(prefix="sekai-plan-", suffix=".json")
            with os.fdopen(fd, "w") as f:
                json.dump(self._side_plan() if self.mode == "side" else self.manual.model.plan(self.encrypt), f)
            os.chmod(self.plan_path, 0o644)
            args = [BACKEND, "--plan", self.plan_path, "--yes-erase"]
        else:
            args = [BACKEND, "--disk", self.disk, "--esp-mb", str(self.esp_mb),
                    "--swap-mb", str(self.swap_mb), "--fs", self.fs, "--yes-erase"]
        if self.encrypt:
            args.append("--encrypt")
            if self._use_tpm():
                args.append("--tpm")
                if self.pin_check.get_active():
                    args.append("--pin")
        ident = getattr(self, "disk_id", []) if self.mode == "erase" else []
        if ident:
            args += ["--expect-size", ident[0]]
        if len(ident) > 1:
            args += ["--expect-serial", ident[1]]
        if DEMO:
            return None
        # 라이브 사용자는 암호 없이 sudo 가 된다. 안 되면 pkexec 로 암호를 묻는다.
        if subprocess.run(["sudo", "-n", "true"], capture_output=True).returncode == 0:
            return ["sudo", "-n"] + args
        return ["pkexec"] + args

    def _run(self):
        cmd = self._cmd()
        if cmd is None:                          # 흉내
            steps = ["디스크 준비", "파일 시스템 만들기", "파일 복사", "시스템 설정", "부팅 준비", "마무리"]
            for i in range(101):
                s = min(5, i // 17)
                GLib.idle_add(self._line, f"STEP {s + 1} 6 {steps[s]}")
                GLib.idle_add(self._line, f"PROGRESS {i}")
                time.sleep(0.08)
            GLib.idle_add(self._line, "DONE")
            return
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        except OSError as e:
            GLib.idle_add(self._line, f"ERROR 설치 프로그램을 실행하지 못했습니다: {e}")
            return
        # 암호화 비밀은 표준 입력으로 (인자는 ps 에 보인다): 첫 줄 암호, 둘째 줄 PIN
        try:
            if self.encrypt:
                pin = self._use_tpm() and self.pin_check.get_active()
                secret = self.secret1.get_text() if (pin or not self._use_tpm()) else ""
                p.stdin.write(("" if pin else secret) + "\n" + (secret if pin else "") + "\n")
            p.stdin.close()
        except OSError:
            pass
        got_end = False
        for line in p.stdout:
            line = line.rstrip("\n")
            got_end = got_end or line.startswith(("DONE", "ERROR"))
            GLib.idle_add(self._line, line)
        rc = p.wait()
        if not got_end:
            GLib.idle_add(self._line, f"ERROR 설치가 중간에 끝났습니다 (코드 {rc})")

    def _line(self, line):
        kind, _, rest = line.partition(" ")
        if kind == "STEP":
            n, total, text = (rest.split(" ", 2) + ["", ""])[:3]
            self.step_lbl.set_text(text)
            self.step_sub.set_text(f"{n}/{total} 단계")
        elif kind == "PROGRESS":
            p, _, text = rest.partition(" ")
            try:
                v = max(0, min(100, int(p)))
            except ValueError:
                return False
            self.bar.set_fraction(v / 100)
            self.pct.set_text(f"{v}%")
            if text:
                self.step_sub.set_text(text)
        elif kind == "RECOVERY":
            self.recovery = rest.strip()
        elif kind == "DONE":
            self.busy = False
            if self.recovery:
                self.go_recovery()
            else:
                self.go_done()
        elif kind == "ERROR":
            self.busy = False
            self.go_error(rest)
        return False

    # ── 4-b. 복구 키 (드라이브 암호화) ──
    def build_recovery(self):
        box = W.page_box("복구 키를 저장하세요",
                         "보안 부팅을 끄거나, 메인보드·보안 칩이 바뀌거나, PIN·암호를 잊으면 이 48자리 복구 키로만 "
                         "드라이브를 열 수 있습니다. 잃어버리면 SekaiOS 도 아무도 열어 드릴 수 없습니다.")
        self.rk_lbl = W.label("", "recovery-key", 0.5)
        self.rk_lbl.set_selectable(True)
        box.pack_start(self.rk_lbl, False, False, 18)
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        h.set_halign(Gtk.Align.CENTER)
        save = Gtk.Button(label="파일로 저장 (USB 등)…")
        save.connect("clicked", lambda *_: self._save_recovery())
        h.pack_start(save, False, False, 0)
        box.pack_start(h, False, False, 0)
        self.rk_saved = W.label("", "row-sub", 0.5, wrap=True)
        box.pack_start(self.rk_saved, False, False, 0)
        box.pack_start(W.label("설치한 디스크가 아닌 곳(USB·휴대폰 사진·종이)에 두세요. 설치한 뒤에는 "
                               "설정 › 장치 암호화에서 다시 볼 수 있습니다.", "row-sub", 0.5, wrap=True), False, False, 0)
        self.rk_ack = Gtk.CheckButton(label="복구 키를 안전한 곳에 저장했습니다")
        self.rk_ack.set_halign(Gtk.Align.CENTER)
        self.rk_ack.connect("toggled", lambda b: self.wz.set_next_enabled(b.get_active()))
        box.pack_start(self.rk_ack, False, False, 10)
        return box

    def go_recovery(self):
        self.rk_lbl.set_text(self.recovery)
        self.rk_ack.set_active(False)
        self.wz.show_page("recovery", back=None, next_label="다음", next_enabled=False)
        self.wz.on_next = self.go_done

    def _save_recovery(self):
        d = Gtk.FileChooserDialog(title="복구 키 저장", transient_for=self, action=Gtk.FileChooserAction.SAVE)
        d.add_button("취소", Gtk.ResponseType.CANCEL)
        d.add_button("저장", Gtk.ResponseType.OK)
        d.set_do_overwrite_confirmation(True)
        d.set_current_name("SekaiOS-복구-키.txt")
        media = "/media"
        if os.path.isdir(media):
            d.set_current_folder(media)
        if d.run() == Gtk.ResponseType.OK:
            path = d.get_filename()
            try:
                with open(path, "w", encoding="utf-8") as f:
                    f.write("SekaiOS 드라이브 암호화 복구 키\n\n" + self.recovery + "\n\n"
                            "부팅 화면에서 암호를 물으면 이 키를 - 와 함께 또는 숫자만 입력하세요.\n"
                            f"설치한 날: {time.strftime('%Y-%m-%d %H:%M')}\n")
                self.rk_saved.set_text(f"저장했습니다: {path}")
            except OSError as e:
                self.rk_saved.set_text(f"저장하지 못했습니다: {e}")
        d.destroy()

    # ── 5. 완료 ──
    def build_done(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)
        box.pack_start(W.icon(["emblem-ok-symbolic", "object-select-symbolic"], 72), False, False, 0)
        box.pack_start(W.label("설치가 끝났습니다", "wiz-title", 0.5), False, False, 0)
        box.pack_start(W.label("설치 USB 를 뺀 뒤 다시 시작하세요.\n처음 켜면 계정과 지역을 설정하는 화면이 나옵니다.",
                               "wiz-sub", 0.5), False, False, 0)
        return box

    def go_done(self):
        mins = int((time.monotonic() - self.started) // 60)
        self.wz.show_page("done", back=None, next_label="지금 다시 시작",
                          hint=f"걸린 시간 {max(1, mins)}분")
        self.wz.on_next = lambda: subprocess.Popen(["systemctl", "reboot"])

    # ── 오류 ──
    def build_error(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_valign(Gtk.Align.CENTER)
        box.pack_start(W.icon(["dialog-error-symbolic", "dialog-error"], 64), False, False, 0)
        box.pack_start(W.label("설치하지 못했습니다", "wiz-title", 0.5), False, False, 0)
        self.err_lbl = W.label("", "wiz-sub", 0.5, wrap=True)
        self.err_lbl.set_justify(Gtk.Justification.CENTER)
        box.pack_start(self.err_lbl, False, False, 0)
        lb = Gtk.Button(label="자세한 기록 보기")
        lb.set_halign(Gtk.Align.CENTER)
        lb.connect("clicked", lambda *_: subprocess.Popen(
            ["sh", "-c", f"sudo -n cat {LOG} > /tmp/sekai-install.log 2>/dev/null || "
                         f"cp {LOG} /tmp/sekai-install.log; xdg-open /tmp/sekai-install.log"]))
        box.pack_start(lb, False, False, 8)
        return box

    def go_error(self, msg):
        self.err_lbl.set_text(msg + "\n\n디스크는 설치하다 만 상태일 수 있습니다. 다시 시도하면 처음부터 새로 합니다.")
        self.wz.show_page("error", back=lambda: self.go_disk(forward=False), next_label="다시 시도")
        self.wz.on_next = self.start

    # ── 닫기 ──
    def on_close(self, *_):
        if not self.busy:
            return False
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                              buttons=Gtk.ButtonsType.OK,
                              text="설치하는 중에는 닫을 수 없습니다")
        d.format_secondary_text("지금 멈추면 디스크가 쓸 수 없는 상태로 남습니다. 잠시만 기다려 주세요.")
        d.run()
        d.destroy()
        return True


def main():
    GLib.set_prgname("sekai-installer")        # 창 클래스 (Hyprland 규칙용)
    if "--autostart" in sys.argv:
        # 라이브 세션에서만, 한 번만
        if not os.path.isdir("/run/live/medium"):
            return 0
        flag = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sekai-installer-shown")
        if os.path.exists(flag):
            return 0
        open(flag, "w").close()
    W.load_css(".recovery-key { font-family: monospace; font-size: 19pt; font-weight: 700; padding: 14px; "
               "border: 1px solid rgba(128,128,128,0.45); border-radius: 8px; }")
    win = Installer()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.wz.stack.get_visible_child().show_all()
    win.go_welcome()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
