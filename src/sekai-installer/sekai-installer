        ram = ram_mb()
        checks = [
            (uefi, "UEFI 모드로 켜졌습니다" if uefi else
             "BIOS(레거시) 모드로 켜졌습니다 — 펌웨어 설정에서 UEFI 로 바꾼 뒤 다시 켜 주세요"),
            (live, "설치 USB 에서 실행 중입니다" if live else "이미 설치된 시스템에서는 설치할 수 없습니다"),
