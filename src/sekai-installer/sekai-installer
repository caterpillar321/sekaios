            ("welcome", "환영"), ("disk", "설치 위치"), ("confirm", "확인"),
            ("install", "설치"), ("recovery", None), ("done", "완료"), ("error", None)])
        self.add(self.wz)
        self.wz.add_page("welcome", self.build_welcome())
        self.wz.add_page("disk", self.build_disk())
        self.wz.add_page("confirm", self.build_confirm())
        self.wz.add_page("install", self.build_install())
        self.wz.add_page("recovery", self.build_recovery())
        self.wz.add_page("done", self.build_done())
