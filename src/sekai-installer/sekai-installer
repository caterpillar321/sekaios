    def _check_row(self, ok, text):
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        h.pack_start(W.icon("emblem-ok-symbolic" if ok else "dialog-warning-symbolic", 16),
                     False, False, 0)
        h.pack_start(W.label(text, "choice-sub"), False, False, 0)
        return h

    def go_welcome(self):
        for c in self.check_box.get_children():
            self.check_box.remove(c)
        uefi = os.path.isdir("/sys/firmware/efi")
        live = os.path.isdir("/run/live/medium") or DEMO
        ds = [d for d in disks() if d["size"] >= MIN_GB * 1000 ** 3]
        ram = ram_mb()
        checks = [
            (uefi, "UEFI 모드로 켜졌습니다" if uefi else
             "BIOS(레거시) 모드로 켜졌습니다 — 펌웨어 설정에서 UEFI 로 바꾼 뒤 다시 켜 주세요"),
            (live, "설치 USB 에서 실행 중입니다" if live else "이미 설치된 시스템에서는 설치할 수 없습니다"),
            (bool(ds), f"설치할 수 있는 디스크 {len(ds)}개" if ds else
             f"설치할 수 있는 디스크가 없습니다 ({MIN_GB}GB 이상 필요)"),
            (ram >= 2000, f"메모리 {ram / 1024:.1f} GB" + ("" if ram >= 2000 else " — 4GB 이상을 권장합니다")),
        ]
        for ok, text in checks:
            self.check_box.pack_start(self._check_row(ok, text), False, False, 0)
        self.check_box.show_all()
        self.inst_btn.set_sensitive(all(ok for ok, _ in checks[:3]) or DEMO)
        self.wz.show_page("welcome", back=None, next_label=None, footer=False)

    # ── 2. 설치 방식 ──
    def build_mode(self):
        box = W.page_box("어떻게 설치할까요?",
                         "Windows 를 남겨 두고 같이 쓰거나, 디스크 하나를 SekaiOS 에 통째로 줄 수 있습니다.")
        self.mode_list = W.ChoiceList(self.on_mode)
        box.pack_start(self.mode_list, False, False, 4)
        self.mode_note = W.label("", "choice-sub", wrap=True)
        box.pack_start(self.mode_note, False, False, 0)
        return box

    def _mode_card(self, icon, title, sub, badge=None):
        h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        h.pack_start(W.icon([icon, "drive-harddisk"], 40), False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        t = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        t.pack_start(W.label(title, "choice-title"), False, False, 0)
        if badge:
            t.pack_start(W.label(badge[0], "badge " + badge[1]), False, False, 0)
        v.pack_start(t, False, False, 0)
        v.pack_start(W.label(sub, "choice-sub", wrap=True), False, False, 0)
        h.pack_start(v, True, True, 0)
        return h

    def go_mode(self, forward=True):
        try:
            self.layout = probe_layout()
            err = None
        except Exception as e:
            self.layout, err = {"disks": []}, str(e)
        opts = side_options(self.layout)
        has_win = any(p.get("windows") for d in self.layout["disks"] if not d.get("live") for p in d["parts"])
        self.mode_list.clear()
        if opts:
            sub = f"빈 공간 {human(max(o['region']['bytes'] for o in opts))}에 설치합니다. 켤 때 부팅 메뉴에서 고릅니다."
            badge = ("빈 공간 있음", "ok")
        elif has_win:
