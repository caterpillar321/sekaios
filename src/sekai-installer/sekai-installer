    def _set_esp(self, v):
        self.esp_mb = v
        self._plan()

    def _set_swap(self, v):
        self.swap_mb = v
        self._plan()

    def _set_fs(self, v):
        self.fs = v or "btrfs"
        if self.fs != "btrfs" and self.encrypt:
            self.enc_check.set_active(False)
        self.enc_check.set_sensitive(self.fs == "btrfs")
        self._plan()

    # ── 드라이브 암호화 ──
    def _use_tpm(self):
        return self.tpm and self.secure_boot

    def _set_encrypt(self, on):
        self.encrypt = on
        self.enc_detail.set_visible(on)
        if on:
            for w in self.enc_detail.get_children():
                w.show_all()
        self._enc_changed()
        self._plan()

    def _enc_changed(self):
        """칸들의 뜻과 보이기를 고르고, 다음으로 갈 수 있나를 정한다"""
        if not self.encrypt:
            self.wz.set_next_enabled(self.disk is not None)
            return
        tpm = self._use_tpm()
        pin = tpm and self.pin_check.get_active()
        self.pin_check.set_visible(tpm)
        if tpm:
            self.enc_note.set_text("이 컴퓨터의 보안 칩(TPM 2.0)과 보안 부팅으로 잠급니다 — 켤 때 암호를 묻지 않습니다. "
                                   "설치가 끝나면 복구 키(48자리)를 보여 드립니다. 보안 부팅을 끄거나 메인보드를 바꾸면 "
                                   "복구 키가 필요합니다.")
        else:
            why = "TPM 2.0 이 없어" if not self.tpm else "보안 부팅이 꺼져 있어"
            self.enc_note.set_text(f"{why} 켤 때마다 암호를 묻습니다. 설치가 끝나면 복구 키(48자리)도 보여 드립니다.")
        need = pin or not tpm
        self.secret_grid.set_visible(need)
        if need:
            self.secret_grid.show_all()
        self.secret1_lbl.set_text("PIN (4~32자)" if pin else "암호 (8자 이상)")
        self.secret2_lbl.set_text("PIN 확인" if pin else "암호 확인")
        a, b = self.secret1.get_text(), self.secret2.get_text()
        err = ""
        if need:
            if pin and not re.fullmatch(r"[0-9A-Za-z]{4,32}", a):
                err = "PIN 은 숫자·영문 4~32자" if a else ""
            elif not pin and len(a) < 8:
                err = "암호는 8자 이상" if a else ""
            elif a != b:
                err = "두 칸이 다릅니다" if b else ""
            ok = not err and a and a == b
        else:
            ok = True
        self.enc_err.set_text(err)
        self.enc_err.set_visible(bool(err))
        self.wz.set_next_enabled(bool(ok) and self.disk is not None)

    def go_disk(self, forward=True):
        self.disk_list.clear()
        self.all_disks = {d["path"]: d for d in disks()}
        for d in self.all_disks.values():
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            icn = ("drive-removable-media" if d["removable"] or d["tran"] == "usb" else
                   "drive-harddisk-solidstate" if d["ssd"] else "drive-harddisk")
            h.pack_start(W.icon([icn, "drive-harddisk"], 40), False, False, 0)
