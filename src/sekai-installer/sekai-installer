        return True

    def _show_tip(self):
        ic, t, b = TIPS[self.tip_i % len(TIPS)]
        self.tip_i += 1
        self.tip_icon.set_from_icon_name(ic, Gtk.IconSize.DIALOG)
        self.tip_icon.set_pixel_size(32)
