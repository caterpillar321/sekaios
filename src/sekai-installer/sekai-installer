    def on_disk(self, path):
        self.disk = path
        # 고른 순간의 크기·시리얼 — 설치 직전에 같은 디스크인지 백엔드가 다시 확인한다
        #   (확인 화면에 머무는 사이 USB 를 바꿔 꽂으면 같은 /dev/sdX 가 다른 디스크일 수 있다)
        def q(col):
            return subprocess.run(["lsblk", "-dno", col, "-b", path], capture_output=True,
                                  text=True, timeout=5).stdout.strip().replace(" ", "")
        try:
            self.disk_id = [x for x in (q("SIZE"), q("SERIAL")) if x] if q("SIZE") else []
        except Exception:
            self.disk_id = []
        self._plan()
        self._enc_changed()             # 암호화를 켰으면 칸이 맞아야 다음으로

    def _plan(self):
        for c in self.plan.get_children():
            self.plan.remove(c)
        d = self.all_disks.get(self.disk) if hasattr(self, "all_disks") else None
        vis = d is not None
        for w in (self.plan_title, self.plan, self.plan_legend):
            w.set_visible(vis)
        if not d:
            return
        total = d["size"] / 1000 / 1000            # 디스크 크기 표시와 같은 단위(10진 GB)로
        root = total - self.esp_mb * 1.048576 - self.swap_mb * 1.048576
        root -= 1024 * 1.048576
        segs = [("esp", "ESP", self.esp_mb), ("esp", "부팅", 1024)]
        if self.swap_mb:
            segs.append(("swap", "스왑", self.swap_mb))
        segs.append(("root", "SekaiOS · 암호화" if self.encrypt else "SekaiOS", root))
        for cls, name, mb in segs:
            b = Gtk.Box()
            b.get_style_context().add_class("plan-seg")
            b.get_style_context().add_class(cls)
            txt = f"{name}  {human(mb * 1000 ** 2)}" if cls == "root" else \
                f"{name}  {mb / 1024:.0f} GB" if mb >= 1024 else f"{name}  {mb:.0f} MB"
            lb = W.label(txt)
            b.pack_start(lb, True, True, 0)
            # 비율대로, 다만 작은 조각도 글자가 보이게 최소 폭
            b.set_size_request(max(110, int(760 * mb / total)), -1)
            self.plan.pack_start(b, cls == "root", True, 0)
        self.plan.show_all()
        fs_note = ("btrfs 로 만들어 업데이트 전마다 시스템 복원 지점을 남깁니다 (개인 파일은 건드리지 않음)"
                   if self.fs == "btrfs" else "ext4 로 만듭니다 (시스템 복원 지점 없음)")
        legend = (f"ESP 는 FAT32, 부팅(커널)은 ext4, SekaiOS 는 {fs_note}"
                  + (" — 드라이브 전체를 암호화합니다(LUKS2)" if self.encrypt else "") +
                  ". 부트로더(GRUB, 보안 부팅 지원)는 이 디스크의 ESP 에만 설치되고, 다른 디스크의 Windows 는 "
                  "부팅 메뉴에서 자동으로 찾아 보여 줍니다.")
        self.plan_legend.set_text(legend)

