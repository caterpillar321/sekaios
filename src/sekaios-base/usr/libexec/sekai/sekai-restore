def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


def die(msg, code=1):
    print(f"ERROR {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, check=True, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if check and r.returncode != 0:
        die(f"{' '.join(cmd)}: {(r.stderr or r.stdout).strip()}")
    return r


def snapper(*args, check=True):
    # snapperd 없이 — 설치 프로그램의 chroot·apt 훅에서도 같게
    return run(["snapper", "--no-dbus", "-c", CONFIG] + list(args), check=check)


# ── 쓸 수 있나 ──────────────────────────────────────────────
def root_info():
    """(파일 시스템, 루트 하위 볼륨, 장치) — 루트가 btrfs 의 @ 인지 본다"""
    r = run(["findmnt", "-no", "FSTYPE,FSROOT,SOURCE", "/"], check=False)
    parts = r.stdout.split()
    if len(parts) < 3:
        return "", "", ""
    fs, fsroot, src = parts[0], parts[1], parts[2]
    return fs, fsroot, re.sub(r"\[.*\]$", "", src)


def snapshots_mounted():
    r = run(["findmnt", "-no", "FSROOT", "/.snapshots"], check=False)
    return r.stdout.strip() == "/@snapshots"


def backend():
    """"btrfs" (snapper 스냅숏) · "copy" (파일 복사) · None"""
    if btrfs_why() is None:
        return "btrfs"
    if RC.why() is None:
        return "copy"
    return None


def why_unsupported():
    if backend():
        return None
    return RC.why() or btrfs_why()


def btrfs_why():
    if os.path.isdir("/run/live/medium"):
        return "설치 USB(라이브)로 켠 상태입니다"
    fs, fsroot, _ = root_info()
    if fs != "btrfs":
        return (f"이 PC 는 {fs or '알 수 없는'} 파일 시스템에 설치되어 복원 지점을 만들 수 없습니다 "
                "(btrfs 로 설치한 SekaiOS 에서 쓸 수 있습니다)")
    if fsroot != "/@":
        return "시스템이 SekaiOS 의 btrfs 구조(@ 하위 볼륨)로 설치되지 않았습니다"
    if not snapshots_mounted():
        return "복원 지점 저장소(/.snapshots)가 연결되지 않았습니다"
    if not shutil.which("snapper"):
        return "snapper 가 설치되지 않았습니다"
    return None


def need_supported():
    why = why_unsupported()
    if why:
        die(why, 3)
    if backend() == "btrfs" and not os.path.isfile(CONF_FILE):
        setup()
    elif backend() == "copy" and not RC.ready():
        RC.setup()


# ── 맨 위 하위 볼륨 ─────────────────────────────────────────
class Top:
    """파일 시스템 맨 위(subvolid=5)를 잠깐 연결한다 (@, @before-restore-*, 요청 파일이 있는 곳)"""

    def __enter__(self):
        _, _, dev = root_info()
        os.makedirs(TOP, exist_ok=True)
        if not os.path.ismount(TOP):
            run(["mount", "-t", "btrfs", "-o", "subvolid=5", dev, TOP])
        return TOP

    def __exit__(self, *a):
        run(["umount", TOP], check=False)


def old_roots(top):
    return sorted((n for n in os.listdir(top) if n.startswith(OLD_PREFIX)), reverse=True)


def read_request(top):
    try:
        with open(os.path.join(top, REQUEST)) as f:
            parts = f.read().split()
        return {"action": parts[0], "arg": parts[1]} if len(parts) >= 2 else None
    except OSError:
        return None


def write_request(top, action, arg):
    p = os.path.join(top, REQUEST)
    with open(p + ".tmp", "w") as f:
        f.write(f"{action} {arg}\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(p + ".tmp", p)


def last_log(top):
    """initramfs 가 남긴 마지막 결과 줄: "<시각> restore <번호> <옛 이름>" · "<시각> undo <이름> <치운 이름>" · "... fail <이유>" """
    try:
        with open(os.path.join(top, RLOG)) as f:
            lines = [ln.split() for ln in f if ln.strip()]
        return lines[-1] if lines else None
    except OSError:
        return None


# ── snapper ─────────────────────────────────────────────────
def setup():
    """snapper 설정 (btrfs 설치본에서만). /.snapshots 는 이미 @snapshots 가 연결돼 있어 create-config 를
    쓰지 않고(.snapshots 하위 볼륨을 새로 만들려다 실패한다) 파일을 직접 만든다. 복사 방식이면 그 저장소를"""
    why = why_unsupported()
    if why:
        die(why, 3)
    if backend() == "copy":
        RC.setup()
        return
    os.makedirs("/etc/snapper/configs", exist_ok=True)
    conf_set = dict(CONF_SET)
    try:
        with open(LIMIT_FILE) as f:
            v = float(f.read().strip())
        if 0.02 <= v <= 0.5:
            conf_set["SPACE_LIMIT"] = f"{v:g}"                 # 사용자가 고른 상한은 남긴다
    except (OSError, ValueError):
        pass
    lines = []
    if os.path.isfile(TEMPLATE):
        with open(TEMPLATE) as f:
            lines = f.read().splitlines()
    seen = set()
    for i, ln in enumerate(lines):
        m = re.match(r"^([A-Z_]+)=", ln)
        if m and m.group(1) in conf_set:
            lines[i] = f'{m.group(1)}="{conf_set[m.group(1)]}"'
            seen.add(m.group(1))
    lines += [f'{k}="{v}"' for k, v in conf_set.items() if k not in seen]
    tmp = CONF_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write("# SekaiOS 시스템 복원 — sekai-restore setup 이 만듦\n" + "\n".join(lines) + "\n")
    os.chmod(tmp, 0o640)
    os.replace(tmp, CONF_FILE)
    # 설정 목록에 root, snapper 의 apt 훅은 끈다 (우리 훅이 설명을 붙여 만든다 — 80sekai-restore)
    text = ""
    if os.path.isfile(DEFAULTS):
        with open(DEFAULTS) as f:
            text = f.read()
    for key, val in (("SNAPPER_CONFIGS", "root"), ("DISABLE_APT_SNAPSHOT", "yes")):
        if re.search(rf"^{key}=", text, re.M):
            text = re.sub(rf"^{key}=.*$", f'{key}="{val}"', text, flags=re.M)
        else:
            text += f'\n{key}="{val}"\n'
    with open(DEFAULTS, "w") as f:
        f.write(text)
    os.chmod("/.snapshots", 0o750)
    setup_quota()
    # snapper 가 켜 두는 "켤 때마다 지점"(snapper-boot)·시간별 지점(snapper-timeline)은 끈다 — 공간만 붙잡는다.
    #   정리(snapper-cleanup)와 우리 주간 지점만
    live = os.path.isdir("/run/systemd/system")
    run(["systemctl", "disable"] + (["--now"] if live else []) + ["snapper-boot.timer", "snapper-timeline.timer"],
        check=False)
    run(["systemctl", "enable"] + (["--now"] if live else []) + ["snapper-cleanup.timer", "sekai-restore-weekly.timer"],
        check=False)


def read_conf():
    out = {}
    try:
        with open(CONF_FILE) as f:
            for ln in f:
                m = re.match(r'^([A-Z_]+)="(.*)"\s*$', ln.strip())
                if m:
                    out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def setup_quota():
    """일반 qgroup 을 켜고, 복원 지점을 모두 1/0 에 묶는다 (snapper 가 새 지점은 알아서 넣는다)"""
    r = run(["btrfs", "qgroup", "show", "--raw", "/"], check=False)
    if r.returncode != 0:
        run(["btrfs", "quota", "enable", "/"], check=False)
        r = run(["btrfs", "qgroup", "show", "--raw", "/"], check=False)
        if r.returncode != 0:
            return
    if not re.search(r"^1/0\s", r.stdout, re.M):
        run(["btrfs", "qgroup", "create", QGROUP, "/"], check=False)
    try:
        nums = [n for n in os.listdir("/.snapshots") if n.isdigit()]
    except OSError:
        nums = []
    for n in nums:
        p = f"/.snapshots/{n}/snapshot"
        if not os.path.isdir(p):
            continue
        sid = run(["btrfs", "inspect-internal", "rootid", p], check=False).stdout.strip()
        if sid.isdigit():
            run(["btrfs", "qgroup", "assign", "--no-rescan", f"0/{sid}", QGROUP, "/"], check=False)
    run(["btrfs", "quota", "rescan", "/"], check=False)        # 기다리지 않는다 — 다 세면 숫자가 맞아진다


def space():
    """(복원 지점만 붙잡은 바이트, 상한 바이트) — 모르면 None"""
    r = run(["btrfs", "qgroup", "show", "--raw", "/"], check=False)
    m = re.search(r"^1/0\s+(\d+)\s+(\d+)", r.stdout, re.M)
    st = os.statvfs("/")
    total = st.f_blocks * st.f_frsize
    try:
        lim = float(read_conf().get("SPACE_LIMIT", "0.1"))
    except ValueError:
        lim = 0.1
    return (int(m.group(2)) if m else None), int(total * lim), lim


KIND_TEXT = {"update": "업데이트", "install": "앱 설치", "remove": "앱 제거", "driver": "드라이버",
             "manual": "수동", "weekly": "정기", "timeline": "정기", "apt": "패키지 변경", "first": "설치 직후",
             "before-restore": "복원 전 상태"}


def list_points():
    if backend() == "copy":
        return RC.list_points()
    r = snapper("--jsonout", "list", "--disable-used-space", check=False)
    if r.returncode != 0:
        r = snapper("--jsonout", "list", check=False)
    try:
        rows = json.loads(r.stdout).get(CONFIG, [])
    except (ValueError, AttributeError):
        rows = []
    pts = []
    for s in rows:
        n = s.get("number", 0)
        if not n or s.get("type") == "post":
            continue                      # 0 은 지금 시스템, post 는 "후" — 되돌릴 자리는 "전"·단일 지점
        ud = s.get("userdata") or {}
        # 우리가 만들지 않은 지점: snapper 정기(timeline)·켤 때(boot)·apt 는 자동, 정리 규칙이 없으면 직접 만든 것
        kind = ud.get("sekai") or ("timeline" if s.get("cleanup") in ("timeline", "number") else "manual")
        date = s.get("date", "")
        pts.append({"number": n, "date": date, "description": s.get("description") or "",
                    "kind": kind, "kind_text": KIND_TEXT.get(kind, kind),
                    "important": ud.get("important") == "yes",
                    "kernel": newest_kernel(f"/.snapshots/{n}/snapshot") or ""})
    pts.sort(key=lambda p: p["number"], reverse=True)
    return pts


def newest_kernel(root):
    try:
        ks = [f[len("vmlinuz-"):] for f in os.listdir(os.path.join(root, "boot")) if f.startswith("vmlinuz-")]
    except OSError:
        return None
    if not ks:
        return None

    def key(v):
        return [int(x) if x.isdigit() else x for x in re.split(r"[.\-+]", v)]
    try:
        return sorted(ks, key=key)[-1]
    except TypeError:
        return sorted(ks)[-1]


IMPORTANT_KINDS = ("manual", "first", "driver")


def free_fraction():
    st = os.statvfs("/")
    return st.f_bavail / st.f_blocks if st.f_blocks else 1.0


def create(desc, kind="manual", auto=False):
    """복원 지점 하나 (늘 단일 지점 — "후" 지점은 만들지 않는다). 모두 number 정리 대상:
    수동·설치 직후·드라이버는 중요(important)로 따로 센다. 자동 지점은 공간이 모자라면 건너뛴다 → 0"""
    if free_fraction() < MIN_FREE:
        snapper("cleanup", "number", check=False)
        if free_fraction() < MIN_FREE:
            if auto:
                print("디스크 여유 공간이 부족해 자동 복원 지점을 만들지 않았습니다", file=sys.stderr)
                return 0
            die("디스크 여유 공간이 부족해 복원 지점을 만들 수 없습니다 — 파일을 정리한 뒤 다시 해 보세요")
    ud = f"sekai={kind}" + (",important=yes" if kind in IMPORTANT_KINDS else "")
    r = snapper("create", "-p", "-d", desc[:120], "-u", ud, "-c", "number")
    n = int(r.stdout.strip() or 0)
    snapper("cleanup", "number", check=False)
    return n


def weekly():
    """7일 안에 만든 지점이 없으면 정기 지점 하나 (윈도우도 한동안 지점이 없으면 만든다)"""
    if os.path.exists(AUTO_OFF):
        return
    if backend() == "copy":
        if RC.weekly():
            refresh()
        return
    now = datetime.datetime.now()
    for p in list_points():
        try:
            if now - datetime.datetime.fromisoformat(p["date"][:19]) < datetime.timedelta(days=WEEKLY_DAYS):
                return
        except ValueError:
            continue
    if create("정기 복원 지점", kind="weekly", auto=True):
        refresh()


# ── apt 훅 ──────────────────────────────────────────────────
def apt_desc():
    """이 apt 가 무엇을 하는지 — 부른 쪽(sekai-update·스토어)이 SEKAI_RESTORE_DESC 로 알려 주면 그것,
    아니면 apt 의 명령줄로 짐작한다"""
    desc = os.environ.get("SEKAI_RESTORE_DESC", "").strip()
    kind = os.environ.get("SEKAI_RESTORE_KIND", "").strip()
    if desc:
        return desc, kind or "apt"
    pid, argv = os.getppid(), []
    for _ in range(4):                    # sh → apt(-get) → … 위로 올라가며 apt 를 찾는다
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
            with open(f"/proc/{pid}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
        if argv and os.path.basename(argv[0]) in ("apt", "apt-get", "aptitude"):
            break
        pid, argv = ppid, []
    words = [a for a in argv[1:] if not a.startswith("-")]
    verb, names = (words[0], words[1:]) if words else ("", [])
    names = [os.path.basename(n) for n in names][:3]
    more = " 등" if len(words) > 4 else ""
    if verb in ("upgrade", "full-upgrade", "dist-upgrade"):
        return "업데이트 전", "update"
    if verb in ("install", "reinstall") and names:
        return f"설치 전: {', '.join(names)}{more}", "install"
    if verb in ("remove", "purge", "autoremove"):
        return (f"제거 전: {', '.join(names)}{more}" if names else "패키지 정리 전"), "remove"
    return "패키지 변경 전", "apt"


def apt_hook_ok():
    if os.path.exists(AUTO_OFF) or os.environ.get("SEKAI_NO_SNAPSHOT") == "1":
        return False
    b = backend()
    if b is None or (b == "btrfs" and not os.path.isfile(CONF_FILE)) or (b == "copy" and not RC.ready()):
        return False
    # chroot(이미지 만들기·설치 프로그램)에선 하지 않는다 — 진짜 루트와 장치가 다르다
    try:
        return os.stat("/").st_ino == os.stat("/proc/1/root/.").st_ino
    except OSError:
        return False


def apt_pre():
    if not apt_hook_ok():
        return
    desc, kind = apt_desc()
    if backend() == "copy":
        # 복사는 오래 걸린다 — 업데이트·드라이버 설치 전만 (앱 설치 전은 만들지 않는다)
        if kind in RC.AUTO_KINDS and RC.create(desc, kind=kind, auto=True, in_apt=True):
            with open(PRE_FILE, "w") as f:
                f.write("1")
        return
    if create(desc, kind=kind, auto=True):
        with open(PRE_FILE, "w") as f:
            f.write("1")


def apt_post():
    # "후" 지점은 만들지 않는다 — 앞에서 지점을 만들었으면 부팅 메뉴·목록만 새로
    try:
        os.unlink(PRE_FILE)
    except OSError:
        return
    if apt_hook_ok():
        refresh()


# ── 부팅 메뉴 ───────────────────────────────────────────────
def esc_grub(s):
    return s.replace("'", "'\\''")


def write_grub():
    """부팅 메뉴의 "복원" 하위 메뉴가 읽는 파일 — 지점마다 그 지점의 커널로 켜면서 sekai.restore=<번호>.
    grub.cfg 전체를 다시 만들지 않고(오래 걸린다) 이 파일만 쓴다 (/etc/grub.d/41_sekai-restore 가 source)"""
    if backend() is None or not os.path.isdir("/boot/grub"):
        return
    _, _, dev = root_info()
    uuid = run(["blkid", "-s", "UUID", "-o", "value", dev], check=False).stdout.strip()
    if not uuid:
        return
    opts = "quiet splash"
    try:
        with open("/etc/default/sekai-boot") as f:
            m = re.search(r'^SEKAI_KERNEL_OPTS="([^"]*)"', f.read(), re.M)
            if m:
                opts = m.group(1)
    except OSError:
        pass
    blocks = []
    if backend() == "copy":
        blocks = RC.grub_blocks(uuid, opts, esc_grub, GRUB_MAX)
    for p in (list_points()[:GRUB_MAX] if backend() == "btrfs" else []):
        k = p["kernel"]
        if not k:
            continue
        base = f"/@snapshots/{p['number']}/snapshot/boot"
        if not os.path.isfile(f"/.snapshots/{p['number']}/snapshot/boot/initrd.img-{k}"):
            continue
        when = p["date"][:16]
        title = esc_grub(f"{when} — {p['description'] or p['kind_text']}")
        blocks.append(
            f"menuentry '{title}' --class sekaios --class os {{\n"
            f"\tload_video\n\tset gfxpayload=keep\n\tinsmod gzio\n\tinsmod part_gpt\n\tinsmod btrfs\n"
            f"\tsearch --no-floppy --fs-uuid --set=root {uuid}\n"
            f"\techo '복원 지점 {p['number']}번으로 되돌리는 중...'\n"
            f"\tlinux {base}/vmlinuz-{k} root=UUID={uuid} ro rootflags=subvol=@ sekai.restore={p['number']} {opts}\n"
            f"\tinitrd {base}/initrd.img-{k}\n}}\n")
    text = ("# SekaiOS 복원 지점 — sekai-restore grub 이 만듦 (고치지 마세요)\n"
            + ("".join(blocks) if blocks else
               "menuentry '복원 지점이 없습니다' --class sekaios { true }\n"))
    fd, tmp = tempfile.mkstemp(dir="/boot/grub", prefix=".sekai-restore.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, GRUB_CFG)


# ── 상태 ────────────────────────────────────────────────────
def status():
    why = why_unsupported()
    st = {"supported": why is None, "reason": why or "", "auto": not os.path.exists(AUTO_OFF),
          "pending": None, "last": None, "undo": None, "used": None, "limit": None, "limit_ratio": None,
          "backend": backend()}
    if why:
        return st
    if backend() == "copy":
        return RC.status(st)
    st["used"], st["limit"], st["limit_ratio"] = space()
    with Top() as top:
        st["pending"] = read_request(top)
        olds = old_roots(top)
        st["undo"] = olds[0] if olds else None
        ln = last_log(top)
        if ln and len(ln) >= 3:
            st["last"] = {"time": ln[0], "action": ln[1], "arg": ln[2], "detail": " ".join(ln[3:])}
    return st


def refresh():
    """부팅 메뉴의 복원 항목과 설정 앱이 읽는 목록 파일을 새로"""
    write_grub()
    try:
        data = {"status": status(), "points": list_points() if why_unsupported() is None else []}
    except SystemExit:
        return
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(CACHE), prefix=".restore.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False)
    os.chmod(tmp, 0o644)
    os.replace(tmp, CACHE)


def prune_old(top):
    """복원 전 상태(@before-restore-*)는 마지막 KEEP_OLD 개만 — 지금 연결된 루트는 아니다.
    강제 종료로 남은 것(취소한 쪽 @undone-restore-*, 요청 없이 남은 @restore-new)도 치운다"""
    names = old_roots(top)[KEEP_OLD:] + [n for n in os.listdir(top) if n.startswith("@undone-restore-")]
    if not os.path.exists(os.path.join(top, REQUEST)) and os.path.isdir(os.path.join(top, "@restore-new")):
        names.append("@restore-new")
    for name in names:
        run(["btrfs", "subvolume", "delete", os.path.join(top, name)], check=False)


def copy_main(cmd, a):
    """파일 복사 방식 (ext4 등) — btrfs 쪽 명령과 같은 뜻"""
    need_supported()
    if cmd == "create":
        n = RC.create(" ".join(a[1:]).strip() or "수동 복원 지점", kind=os.environ.get("SEKAI_RESTORE_KIND", "manual"))
        refresh()
        out({"number": n})
    elif cmd == "delete":
        nums = [x for x in a[1:] if x.isdigit()]
        if not nums:
            die("지울 번호가 없습니다", 2)
        RC.delete(nums)
        refresh()
    elif cmd == "restore":
        if len(a) < 2 or not a[1].isdigit():
            die("번호가 없습니다", 2)
        RC.restore(int(a[1]))
        refresh()
    elif cmd == "undo":
        st = RC.status({})
        if not st.get("undo"):
            die("취소할 복원이 없습니다")
        RC.restore(int(st["undo"]), undo=True)
        refresh()
    elif cmd == "cancel":
        try:
            os.unlink(RC.REQ)
        except FileNotFoundError:
            pass
        refresh()
    elif cmd == "limit":
        try:
            v = float(a[1])
        except (IndexError, ValueError):
            die("비율을 주세요 (예: 0.2)", 2)
        if not 0.05 <= v <= 0.5:
            die("0.05 에서 0.5 사이여야 합니다", 2)
        RC.set_conf(limit=v)
        RC.prune()
        refresh()
    elif cmd == "grub":
        RC.cleanup_tmp()
        refresh()


def main():
    RC.C.out, RC.C.die, RC.C.run, RC.C.newest_kernel = out, die, run, newest_kernel
    RC.C.KIND_TEXT = KIND_TEXT
    a = sys.argv[1:]
    if not a:
        die("명령이 없습니다 (status · list · create · delete · restore · undo · cancel · auto · setup · grub)", 2)
    cmd = a[0]
    if os.geteuid() != 0 and cmd not in ("status",):
        die("관리자 권한이 필요합니다", 2)
    if backend() == "copy" and cmd in ("create", "delete", "restore", "undo", "cancel", "limit", "grub"):
        copy_main(cmd, a)
        return
    if cmd == "status":
        if os.geteuid() != 0:
            out({"supported": why_unsupported() is None, "reason": why_unsupported() or "",
                 "auto": not os.path.exists(AUTO_OFF), "pending": None, "last": None, "undo": None})
            return
        out(status())
    elif cmd == "setup":
        setup()
        refresh()
    elif cmd == "list":
        need_supported()
        out(list_points())
    elif cmd == "create":
        need_supported()
        desc = " ".join(a[1:]).strip() or "수동 복원 지점"
        kind = os.environ.get("SEKAI_RESTORE_KIND", "manual")
        n = create(desc, kind=kind)
        refresh()
        out({"number": n})
    elif cmd == "delete":
        need_supported()
        nums = [x for x in a[1:] if x.isdigit()]
        if not nums:
            die("지울 번호가 없습니다", 2)
        snapper("delete", *nums)
        refresh()
    elif cmd == "restore":
        need_supported()
        if len(a) < 2 or not a[1].isdigit():
            die("번호가 없습니다", 2)
        n = a[1]
        if not os.path.isdir(f"/.snapshots/{n}/snapshot"):
            die(f"복원 지점 {n} 이 없습니다")
        with Top() as top:
            prune_old(top)
            write_request(top, "restore", n)
        refresh()
    elif cmd == "undo":
        need_supported()
        with Top() as top:
            olds = old_roots(top)
            if not olds:
                die("취소할 복원이 없습니다")
            write_request(top, "undo", olds[0])
        refresh()
    elif cmd == "cancel":
        need_supported()
        with Top() as top:
            try:
                os.unlink(os.path.join(top, REQUEST))
            except FileNotFoundError:
                pass
        refresh()
    elif cmd == "auto":
        if len(a) < 2 or a[1] not in ("on", "off"):
            die("on 또는 off", 2)
        if a[1] == "off":
            os.makedirs(os.path.dirname(AUTO_OFF), exist_ok=True)
            open(AUTO_OFF, "w").close()
        elif os.path.exists(AUTO_OFF):
            os.unlink(AUTO_OFF)
        if why_unsupported() is None:
            refresh()
    elif cmd == "limit":
        need_supported()
        try:
            v = float(a[1])
        except (IndexError, ValueError):
            die("비율을 주세요 (예: 0.1)", 2)
        if not 0.02 <= v <= 0.5:
            die("0.02 에서 0.5 사이여야 합니다", 2)
        snapper("set-config", f"SPACE_LIMIT={v:g}")
        os.makedirs(os.path.dirname(LIMIT_FILE), exist_ok=True)
        with open(LIMIT_FILE, "w") as f:
            f.write(f"{v:g}\n")
        snapper("cleanup", "number", check=False)
        refresh()
    elif cmd == "apt-pre":
        apt_pre()
    elif cmd == "apt-post":
        apt_post()
    elif cmd == "weekly":
        if (backend() == "btrfs" and os.path.isfile(CONF_FILE)) or (backend() == "copy" and RC.ready()):
            weekly()
    elif cmd == "grub":
        if why_unsupported() is None:
            # 켤 때도 불린다 (sekai-restore-grub.service) — 부팅 메뉴로 되돌리면 옛 "복원 전 상태"가 쌓이니 여기서 정리
            with Top() as top:
                prune_old(top)
            refresh()
    else:
        die(f"모르는 명령: {cmd}", 2)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
