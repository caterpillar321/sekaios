#!/bin/sh
# SekaiOS — 부팅·로그인 화면 전환 진단 (화면 깜박임·신호 끊김 원인 찾기)
#   sudo /usr/libexec/sekai/sekai-bootdiag [저장할 파일]   (기본: ~/sekai-bootdiag.txt)
#   sudo /usr/libexec/sekai/sekai-bootdiag --plymouth-debug on|off
#       부팅 화면(Plymouth)이 스스로 남기는 기록을 켜고 끈다 — 다음 부팅부터 /var/log/plymouth-debug.log
#       (부팅마다 새로 쓴다). 켜 두면 진단에 그 기록의 화면 관련 줄이 들어간다.
#   개인 정보(파일·비밀번호 등)는 모으지 않는다 — 부팅 기록 중 그래픽 관련 줄만.
if [ "${1:-}" = "--plymouth-debug" ]; then
    [ "$(id -u)" -eq 0 ] || { echo "관리자 권한이 필요합니다 (sudo)"; exit 1; }
    f=/etc/default/grub.d/zz-sekai-plymouth-debug.cfg
    case "${2:-}" in
        on)  printf '%s\n' "# sekai-bootdiag --plymouth-debug on 이 만든 파일 — 끄기: sudo /usr/libexec/sekai/sekai-bootdiag --plymouth-debug off" \
                 'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT plymouth.debug"' > "$f" ;;
        off) rm -f "$f" ;;
        *)   echo "사용법: sekai-bootdiag --plymouth-debug on|off"; exit 2 ;;
    esac
    /usr/libexec/sekai/update-grub-locked >/dev/null 2>&1 || { echo "부팅 메뉴를 고치지 못했습니다 (update-grub)"; exit 1; }
    echo "부팅 화면 기록: $2 — 다음 부팅부터"
    exit 0
fi
U=${SUDO_USER:-$(id -un)}
H=$(getent passwd "$U" | cut -d: -f6)
OUT=${1:-$H/sekai-bootdiag.txt}

# 사용자가 바꿀 수 있는 파일을 root 로 읽는다 — 누구나 쓰는 displays 폴더, 각 사용자의 hyprland.log.
#   그냥 cat 하면 FIFO 에서 영원히 멈추고, 1TB 성긴 파일이면 0 바이트를 보고서에 그대로 적어 디스크를 채운다.
#   그래서 링크는 따라가지 않고(O_NOFOLLOW) 막히지 않게(O_NONBLOCK) 한 번 연 fd 로, 주인이 $2(이름·uid)인
#   일반 파일만, $3 바이트까지 읽는다. $4=head 면 더 큰 파일은 앞부분만, 아니면 건너뛴다.
#   제어 문자는 ? 로 (보고서를 터미널로 볼 때 이스케이프가 먹지 않게)
read_user_file() {
    timeout 10 python3 -c '
import os, pwd, re, stat, sys
path, owner, lim, head = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4:] == ["head"]
try:
    uid = int(owner) if owner.isdigit() else pwd.getpwnam(owner).pw_uid
except KeyError:
    sys.exit("(건너뜀: 없는 사용자)")
try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    st = os.fstat(fd)
except OSError as e:
    sys.exit("(건너뜀: %s)" % e.strerror)
if not stat.S_ISREG(st.st_mode):
    sys.exit("(건너뜀: 일반 파일이 아님)")
if st.st_uid != uid:
    sys.exit("(건너뜀: 주인이 uid %d — %d 이어야 함)" % (st.st_uid, uid))
if st.st_size > lim and not head:
    sys.exit("(건너뜀: 너무 큼 %d 바이트)" % st.st_size)
data = bytearray()
while len(data) < lim:
    b = os.read(fd, min(1 << 20, lim - len(data)))
    if not b:
        break
    data += b
data = re.sub(rb"[\x00-\x08\x0b-\x1f\x7f]", b"?", data)
try:
    os.write(1, data if data.endswith(b"\n") or not data else data + b"\n")
except OSError:
    pass                                    # 뒤의 head 가 먼저 끝났다
if st.st_size > lim:
    sys.exit("(앞 %d 바이트만 — 전체 %d 바이트)" % (lim, st.st_size))
' "$@"
}
# 파일 이름도 사용자가 정한다 — 제어 문자를 빼고 printf 로 찍는다 (dash 의 echo 는 \033 같은 것을 풀어 쓴다)
name() { printf '%s' "$1" | tr -d '[:cntrl:]'; }

show_displays() {  # 확장자 — <사용자>.<확장자> 는 그 사용자의 파일일 때만
    for f in /var/lib/sekai/displays/*."$1"; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        n=${f##*/}; n=${n%."$1"}
        printf '%s\n' "-- $(name "$n").$1"
        case "$n" in [!a-z_]*|*[!a-z0-9_-]*|"") echo "(건너뜀: 사용자 이름 모양이 아님)"; continue ;; esac
        read_user_file "$f" "$n" 65536
    done
}

{
echo "== $(date)  $(uname -r)"
echo "== cmdline";           cat /proc/cmdline
echo "== boot-video";        cat /var/lib/sekai/boot-video 2>&1
echo "== modes (세션)";      show_displays modes
echo "== displays conf";     show_displays conf
echo "== modprobe";          cat /etc/modprobe.d/sekai-nvidia.conf 2>&1
echo "== initramfs nvidia";  lsinitramfs "/boot/initrd.img-$(uname -r)" 2>/dev/null | grep -E "/nvidia(-[a-z]+|_[a-z]+)?\.ko" | head
echo "== plymouth";          plymouth-set-default-theme 2>&1
echo "== drm 장치";           ls -l /dev/dri/ 2>&1
for c in /sys/class/drm/card*-*; do
    [ -f "$c/status" ] || continue
    echo "-- ${c##*/}: $(cat $c/status) enabled=$(cat $c/enabled 2>/dev/null) $(head -3 $c/modes 2>/dev/null | tr '\n' ' ')"
done
echo "== fb";                cat /proc/fb 2>&1
echo "== 커널 (그래픽)"
journalctl -b -k --no-pager -o short-monotonic 2>/dev/null | grep -iE "nvidia|drm|fbcon|fb0|simpledrm|efifb|framebuffer|console" | head -120
echo "== 부팅 순서 (plymouth·greetd·sekai)"
journalctl -b --no-pager -o short-monotonic -u plymouth-start -u plymouth-quit -u plymouth-quit-wait -u greetd -u sekai-drm-hold -u sekai-bootmode 2>/dev/null | head -60
echo "== 세션 Hyprland (DRM)"
# 로그는 수 MB 가 될 수 있다 — 앞 8MB 에서 (시작할 때 찍히는 줄들이라 충분하다), 주인은 /run/user/<uid> 의 그 uid
for f in /run/user/*/hypr/*/hyprland.log; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    u=${f#/run/user/}; u=${u%%/*}
    case "$u" in *[!0-9]*|"") continue ;; esac
    printf '%s\n' "-- $(name "$f")"
    read_user_file "$f" "$u" 8388608 head \
        | grep -aiE "\[AQ\].*(drm|modeset|crtc|connector|mode |commit fail|restor)|monitor .*(added|mode)" | cut -c1-400 | head -80
done
# 증상이 매번 나지 않는다 — 탈이 난 부팅 뒤에 다시 켜서 돌려도 그 부팅을 볼 수 있게 지난 부팅 몇 번의 요점도
#   (데비안은 저널을 /var/log/journal 에 남긴다. 세션 Hyprland 로그는 /run 이라 지난 부팅 것은 없다)
echo "== 지난 부팅들"
journalctl --list-boots --no-pager 2>/dev/null | tail -4
for b in -1 -2 -3; do
    journalctl -b "$b" -n 1 --no-pager >/dev/null 2>&1 || continue
    echo "-- 부팅 $b"
    journalctl -b "$b" -k --no-pager -o short-monotonic 2>/dev/null \
        | grep -iE "Command line|User-defined mode|efifb: mode|nvidia-drmdrmfb|fbcon|\[drm\].*(error|fail|timeout|flip)|nvidia.*(error|fail|Xid)" | grep -viE "kernel command line" | cut -c1-300 | head -15
    journalctl -b "$b" --no-pager -o short-monotonic -u plymouth-start -u plymouth-quit -u plymouth-quit-wait -u greetd -u sekai-drm-hold 2>/dev/null \
        | grep -vE "gkr-pam|pam_unix" | cut -c1-300 | head -15
done
# Plymouth 가 모니터를 어떻게 잡았는지 — 이미 켜진 모니터·고른 모드·출력 변화(늦게 나타난 모니터)·스플래시 표시/끝
echo "== Plymouth 기록"
P=/var/log/plymouth-debug.log
if grep -qw "plymouth.debug" /proc/cmdline && [ -f "$P" ] && [ ! -L "$P" ]; then
    ls -l --time-style=+%F\ %T "$P"
    grep -aE "renderers/drm/plugin\.c|ply-device-manager\.c:[0-9]+:(on_udev|create_dev:|ply_device)|ply-renderer\.c|ply-boot-splash\.c|two-step/plugin\.c:[0-9]+:(show_splash|become_idle|hide)|main\.c:[0-9]+:(on_quit|on_boot_splash_idle|on_show|on_hide|on_deactivate|on_reactivate|tell_systemd|plymouth_should)|[Ff]ail|[Cc]ould not|[Ee]rror" "$P" \
        | grep -av "ply-key-file" | tr -d '\000-\010\013-\037' | cut -c1-260 | head -300
else
    echo "(없음 — 켜려면 sudo /usr/libexec/sekai/sekai-bootdiag --plymouth-debug on 뒤 다시 부팅)"
fi
} > "$OUT" 2>&1
chown "$U" "$OUT" 2>/dev/null
echo "저장했습니다: $OUT"
