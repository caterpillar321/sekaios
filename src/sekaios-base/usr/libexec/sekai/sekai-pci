#!/usr/bin/python3
"""SekaiOS — PCI 자동 재배치(pci=realloc) 호환성 도우미.

  sekai-pci check          부팅마다 (sekai-pci.service) — 자동 모드면 이번 부팅의 커널 기록을 보고 다음 부팅 옵션을 정한다
  sekai-pci set auto|off|on 설정 › 그래픽 (pkexec) — 자동 / 항상 끄기(pci=realloc=off) / 끄지 않기
  sekai-pci status         설정 앱이 읽는 상태 (JSON, 권한 없이)

왜: 블랙웰(RTX 50·RTX PRO) 카드에는 가상 GPU 영역(SR-IOV VF BAR)이 있는데 펌웨어는 여기에 주소를 주지 않는다.
  데비안 커널(CONFIG_PCI_REALLOC_ENABLE_AUTO=y)은 이런 장치를 보면 PCI 주소를 스스로 다시 배치하는데, 칩셋 슬롯에 꽂으면
  그 VF BAR 까지 넣을 창이 없어 브리지 창을 다시 짜다가 칩셋 USB 컨트롤러(ASMedia, TUF GAMING B650-PLUS)를 옮겨 죽였다
  ("xhci_hcd …: Host controller not accessible") — 로그인 화면에서 키보드·마우스가 먹통 (2026-10-25, 9600·8600G 둘 다).
  pci=realloc=off 면 펌웨어가 준 주소 그대로라 멀쩡하다. 그러나 펌웨어가 일반 BAR 를 못 준 PC(리사이저블 BAR 창이 모자란
  8600G 등)에선 재배치가 있어야 그래픽 카드가 산다 → 모든 PC 에 넣지 않고, 다음 셋이 모두 맞을 때만 자동으로 넣는다:
    ① 재배치가 켜진 부팅이었고 VF BAR 를 못 넣었다 (재배치를 켠 까닭)
    ② 그 뒤 USB 컨트롤러가 접근 불가로 죽었다
    ③ 펌웨어가 VF BAR 말고는 모든 메모리 BAR 에 주소를 줬다 (끄더라도 잃는 장치가 없다)
  자동으로 넣은 뒤의 부팅에서 펌웨어가 못 준 BAR 가 생겼거나(배치가 바뀜) USB 가 여전히 죽으면 도로 뺀다.
  결과는 다음 부팅부터 — /var/lib/sekai/boot-pci 를 09_sekaios 가 읽는다. 바뀌면 /run/sekai/pci-hint.json 으로 알린다 (sekai-panel).
"""
import json
import os
import re
import subprocess
import sys

STATE = "/var/lib/sekai/pci-realloc.json"     # {"mode": auto|off|on, "auto": bool, "reason": str, "useless": bool}
OUT = "/var/lib/sekai/boot-pci"               # SEKAI_PCI_OPTS="pci=realloc=off" — 09_sekaios
HINT = "/run/sekai/pci-hint.json"
UPDATE_GRUB = "/usr/libexec/sekai/update-grub-locked"
OPT = "pci=realloc=off"
MODES = ("auto", "off", "on")

ENUM_BAR = re.compile(r"^pci (\S+): BAR (\d) \[mem (0x[0-9a-f]+)-0x[0-9a-f]+")
VF_FAIL = re.compile(r"^pci (\S+): VF BAR \d \[.*\]: failed to assign")
BAR_EVT = re.compile(r"^pci (\S+): BAR (\d) \[.*\]: (assigned|failed to assign)")
USB_DEAD = re.compile(r"^xhci_hcd (\S+): (Host controller not accessible|init fail, -19)")


def log(*a):
    print("sekai-pci:", *a, file=sys.stderr, flush=True)


def load():
    try:
        with open(STATE, encoding="utf-8") as f:
            st = json.load(f)
        if st.get("mode") not in MODES:
            st["mode"] = "auto"
        return {"mode": st["mode"], "auto": bool(st.get("auto")), "reason": str(st.get("reason", ""))[:300],
                "useless": bool(st.get("useless"))}
    except (OSError, ValueError, AttributeError):
        return {"mode": "auto", "auto": False, "reason": "", "useless": False}


def write_atomic(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def configured():
    try:
        with open(OUT, encoding="utf-8") as f:
            return OPT in f.read()
    except OSError:
        return False


def active():
    try:
        with open("/proc/cmdline") as f:
            return OPT in f.read().split()
    except OSError:
        return False


def apply(st):
    """상태를 저장하고 부팅 옵션 파일을 맞춘다 — 바뀌었으면 update-grub. 성공하면 True"""
    want = st["mode"] == "off" or (st["mode"] == "auto" and st["auto"])
    write_atomic(STATE, json.dumps(st, ensure_ascii=False) + "\n")
    if want == configured():
        return True
    write_atomic(OUT, f'SEKAI_PCI_OPTS="{OPT if want else ""}"\n')
    r = subprocess.run([UPDATE_GRUB], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        log("update-grub 실패:", (r.stderr or "").strip()[-300:])
        return False
    return True


def kernel_log():
    for cmd in (["journalctl", "-k", "-b", "0", "-o", "cat", "--no-pager", "-q"], ["dmesg"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError):
            continue
        if r.returncode == 0 and r.stdout:
            return r.stdout.splitlines()
    return []


def analyse(lines):
    """(VF BAR 를 못 넣은 장치, 죽은 USB 컨트롤러, 펌웨어가 주소를 안 준 일반 BAR, 일반 BAR 할당 실패)"""
    vf, dead, unset = set(), set(), set()
    seen, last = set(), {}
    for ln in lines:
        m = BAR_EVT.match(ln)
        if m:                                   # 재배치 중엔 실패했다가 나중에 들어가기도 한다 — 마지막 결과만
            last[f"{m.group(1)} BAR {m.group(2)}"] = m.group(3) == "assigned"
            continue
        m = ENUM_BAR.match(ln)
        if m:
            key = (m.group(1), m.group(2))
            if key not in seen:                 # 처음 찍힌 것 = 펌웨어가 준 값 (뒤의 것은 커널이 다시 잡은 값)
                seen.add(key)
                if int(m.group(3), 16) == 0:
                    unset.add(f"{m.group(1)} BAR {m.group(2)}")
            continue
        m = VF_FAIL.match(ln)
        if m:
            vf.add(m.group(1))
            continue
        m = USB_DEAD.match(ln)
        if m:
            dead.add(m.group(1))
    failed = {k for k, ok in last.items() if not ok}
    return vf, dead, unset, failed


def hint(kind, text):
    try:
        write_atomic(HINT, json.dumps({"kind": kind, "text": text}, ensure_ascii=False) + "\n")
    except OSError as e:
        log("알림 파일을 못 씀:", e)


def check():
    st = load()
    if st["mode"] != "auto":
        apply(st)                               # 수동 값이면 옵션 파일만 맞춰 둔다
        return 0
    vf, dead, unset, failed = analyse(kernel_log())
    if not active():
        if st["auto"]:
            return 0                            # 넣어 두었는데 아직 그 옵션으로 켜지 않았다 (다시 시작 전)
        if vf and dead and not unset and not st["useless"]:
            st.update(auto=True, reason=f"재배치 뒤 USB 컨트롤러 {', '.join(sorted(dead))} 가 응답하지 않음 "
                                               f"(가상 GPU 영역을 못 넣은 장치: {', '.join(sorted(vf))})")
            log("자동 재배치를 끕니다 —", st["reason"])
            if apply(st):
                hint("applied", "PCI 장치 주소를 다시 잡다가 USB 컨트롤러가 멈췄습니다. 다음에 켤 때부터 주소를 다시 잡지 않도록 "
                                "바꿨습니다 — 다시 시작하면 USB 포트가 돌아옵니다.")
        elif vf and dead and unset:
            log("USB 가 죽었지만 펌웨어가 주소를 주지 않은 BAR 가 있어 자동으로 끄지 않음:", ", ".join(sorted(unset)))
        elif vf and dead:
            log("USB 가 죽었지만 지난번에 꺼 봐도 소용없어서 자동으로 끄지 않음")
        return 0
    if st["auto"]:
        bad, useless = None, False
        if unset or failed:
            bad = "펌웨어가 주소를 주지 않은 장치가 생겼습니다 (" + ", ".join(sorted(unset | failed)) + ")"
        elif dead:
            # 소용없었다 — 기억해 두고 다시 넣지 않는다 (넣고 빼기를 부팅마다 되풀이하지 않게). 설정에서 모드를 고르면 잊는다
            bad, useless = "주소를 다시 잡지 않아도 USB 컨트롤러가 응답하지 않습니다 — 이 설정으로는 고쳐지지 않습니다", True
        if bad:
            st.update(auto=False, reason=bad, useless=useless)
            log("자동으로 넣은 옵션을 도로 뺍니다 —", bad)
            if apply(st):
                hint("reverted", "PCI 호환 설정을 원래대로 돌렸습니다: " + bad + ". 다음에 켤 때부터 적용됩니다.")
    return 0


def status():
    st = load()
    print(json.dumps({"mode": st["mode"], "auto": st["auto"], "reason": st["reason"],
                      "configured": configured(), "active": active()}, ensure_ascii=False))
    return 0


def main():
    a = sys.argv[1:]
    if a == ["status"]:
        return status()
    if os.geteuid() != 0:
        log("관리자 권한이 필요합니다")
        return 1
    if a == ["check"]:
        return check()
    if len(a) == 2 and a[0] == "set" and a[1] in MODES:
        st = load()
        st["mode"] = a[1]
        st["useless"] = False
        if a[1] != "auto":
            st["reason"] = ""
        return 0 if apply(st) else 1
    log("사용법: sekai-pci check | set auto|off|on | status")
    return 2


if __name__ == "__main__":
    sys.exit(main())
