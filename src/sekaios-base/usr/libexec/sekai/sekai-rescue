#!/usr/bin/python3
# ═══════════════════════════════════════════════════════════════
#  SekaiOS 복구 화면 — 시스템이 정상적으로 시작되지 못했을 때 (윈도우의 "자동 복구"처럼)
#
#    sekai-rescue emergency   비상 모드(emergency.service 대신 — 디스크 연결 실패 등)
#    sekai-rescue rescue      복구 모드(부팅 메뉴의 "SekaiOS — 복구 모드", rescue.service 대신)
#    sekai-rescue repeated    연달아 정상적으로 시작되지 못했을 때 (sekai-rescue.service ← bootcheck)
#    sekai-rescue bootcheck   (켤 때) 부팅 횟수를 세고, 두 번 연달아 끝까지 못 켰으면 위 화면을 띄운다
#    sekai-rescue bootok      (켜지고 1분 뒤 로그인 화면이 떠 있으면 · 깨끗하게 끌 때) 부팅 횟수를 0 으로
#    sekai-rescue crashcheck  (켤 때, systemd-pstore 뒤) 지난번 커널 패닉 기록이 있으면 이벤트 뷰어에 남기고
#                             /var/lib/sekai/last-crash.json 을 쓴다 — 로그인하면 패널이 알린다 (crashhint)
#
#  리눅스 글자 콘솔은 한글을 그릴 수 없어서(글꼴 512자) 프레임버퍼(/dev/fb0)에 cairo·Pango 로 직접 그린다.
#  키는 tty1 에서 읽는다 (↑↓ · Enter · Esc · 숫자). 그릴 수 없으면(프레임버퍼 없음 등) 원래의 systemd 비상 셸로.
#  root 는 잠겨 있어 비상 셸은 쓸 수 없다 — "명령줄"은 관리자 계정으로 로그인(login)한다.
# ═══════════════════════════════════════════════════════════════
import fcntl
import json
import mmap
import os
import select
import struct
import subprocess
import sys
import termios
import time
import tty

RESTORE = "/usr/libexec/sekai/sekai-restore"
SULOGIN = "/usr/lib/systemd/systemd-sulogin-shell"
COUNT = "/var/lib/sekai/boot-attempts"
HEALTHY = "/run/sekai-boot-healthy"
FAIL_LIMIT = 2                 # 이만큼 연달아 끝까지 켜지지 못하면 복구 화면
KDSETMODE, KD_TEXT, KD_GRAPHICS = 0x4B3A, 0, 1
FBIOGET_VSCREENINFO, FBIOPUT_VSCREENINFO, FB_ACTIVATE_FORCE = 0x4600, 0x4601, 0x80
VT_ACTIVATE, VT_WAITACTIVE = 0x5606, 0x5607

# 색 (SekaiOS 어두운 테마)
BG = (0x12 / 255, 0x13 / 255, 0x17 / 255)
PANEL = (0x1c / 255, 0x1e / 255, 0x24 / 255)
FG = (0.93, 0.94, 0.95)
DIM = (0.62, 0.64, 0.68)
ACCENT = (0x3e / 255, 0xc6 / 255, 0xbd / 255)
WARN = (0.98, 0.72, 0.30)


# ── 부팅 횟수 ───────────────────────────────────────────────
def read_count():
    try:
        with open(COUNT) as f:
            return int(f.read().strip() or 0)
    except (OSError, ValueError):
        return 0


def write_count(n):
    try:
        os.makedirs(os.path.dirname(COUNT), exist_ok=True)
        with open(COUNT + ".tmp", "w") as f:
            f.write(f"{n}\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(COUNT + ".tmp", COUNT)
    except OSError:
        pass


def bootcheck():
    """켤 때마다 1 올린다 — 로그인 화면이 1분 넘게 떠 있거나 깨끗하게 끄면 0 (bootok).
    올리기 전 값이 FAIL_LIMIT 이상이면 = 앞의 두 번을 끝까지 못 켰다 → 복구 화면"""
    n = read_count()
    write_count(n + 1)
    if n >= FAIL_LIMIT and "sekai.norescue" not in open("/proc/cmdline").read():
        subprocess.run(["systemctl", "--no-block", "start", "sekai-rescue.service"])


def bootok(shutdown=False):
    if shutdown:
        # 끄는 중 — 이번 부팅이 로그인 화면까지 왔을 때만 "정상"으로 친다 (로그인 화면이 계속 죽어
        #   전원 단추로 끈 것까지 정상으로 세면 연달은 실패를 못 알아챈다)
        if not os.path.exists(HEALTHY):
            return
    else:
        r = subprocess.run(["systemctl", "is-active", "--quiet", "greetd.service"])
        if r.returncode != 0:
            return
        open(HEALTHY, "w").close()
    write_count(0)


# ── 지난번 커널 패닉 ────────────────────────────────────────
PSTORE = "/var/lib/systemd/pstore"
CRASH = "/var/lib/sekai/last-crash.json"


def crashcheck():
    """systemd-pstore 가 옮겨 둔 기록 중 아직 본 적 없는 것 — 패닉(Panic)이 든 것만"""
    try:
        with open(CRASH) as f:
            seen = json.load(f).get("id", "")
    except (OSError, ValueError):
        seen = ""
    try:
        dirs = sorted((d for d in os.listdir(PSTORE) if os.path.isdir(os.path.join(PSTORE, d))),
                      key=lambda d: os.path.getmtime(os.path.join(PSTORE, d)))
    except OSError:
        return
    for d in reversed(dirs):
        if d == seen:
            return                                   # 가장 새 것을 이미 봤다
        text = ""
        p = os.path.join(PSTORE, d)
        # systemd-pstore 는 <시각>/<번호>/dmesg.txt (조각들을 이은 것)와 dmesg-efi_pstore-* 를 둔다 — 한 단계 아래까지
        for root, _dirs, files in os.walk(p):
            for f in sorted(files):
                if f == "dmesg.txt" or (f.startswith("dmesg") and not any(x == "dmesg.txt" for x in files)):
                    try:
                        with open(os.path.join(root, f), errors="replace") as fh:
                            text += fh.read()
                    except OSError:
                        pass
        if "Kernel panic" not in text and "Oops" not in text and "panic" not in text.lower():
            continue
        line = next((ln.strip() for ln in text.splitlines() if "Kernel panic" in ln), "")
        line = line.split("]", 1)[-1].strip() if line else "커널 오류"
        line = line.replace("Kernel panic - not syncing:", "커널 패닉:").strip()
        when = int(os.path.getmtime(p))
        subprocess.run(["logger", "-p", "kern.crit", "-t", "sekai-crash",
                        f"지난번에 커널 오류(패닉)로 시스템이 다시 시작되었습니다: {line} — 기록 {p}"])
        os.makedirs(os.path.dirname(CRASH), exist_ok=True)
        with open(CRASH + ".tmp", "w") as fh:
            json.dump({"id": d, "time": when, "summary": line[:200]}, fh, ensure_ascii=False)
        os.chmod(CRASH + ".tmp", 0o644)
        os.replace(CRASH + ".tmp", CRASH)
        return


# ── 무엇이 실패했나 ─────────────────────────────────────────
def failed_units():
    try:
        out = subprocess.run(["systemctl", "--failed", "--no-legend", "--plain", "--no-pager"],
                             capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return []
    return [ln.split()[0] for ln in out.splitlines() if ln.strip()]


def missing_mounts():
    """/etc/fstab 에 있는데 연결되지 않은 곳 (nofail·noauto·swap 은 뺀다) — 장치를 못 찾으면 마운트 유닛은
    "실패"가 아니라 "의존성 실패"로 남아 systemctl --failed 에 안 나온다"""
    try:
        with open("/proc/self/mounts") as f:
            mounted = {ln.split()[1].replace("\\040", " ") for ln in f if ln.strip()}
        out = []
        with open("/etc/fstab") as f:
            for ln in f:
                p = ln.split()
                if len(p) < 4 or p[0].startswith("#") or p[1] in ("none", "swap") or p[2] == "swap":
                    continue
                opts = p[3].split(",")
                if "noauto" in opts or "nofail" in opts:
                    continue
                if p[1] not in mounted:
                    out.append(p[1])
        return out
    except OSError:
        return []


def reason_lines(mode):
    if mode == "repeated":
        return ["SekaiOS 가 연달아 정상적으로 시작되지 못했습니다.",
                "최근 업데이트나 설치가 원인이면 그 전 상태로 되돌리면 대부분 해결됩니다."]
    if mode == "rescue":
        return ["복구 모드로 시작했습니다. 아래에서 할 일을 고르세요."]
    lines = ["SekaiOS 를 정상적으로 시작하지 못했습니다."]
    mounts = missing_mounts()
    if mounts:
        lines.append("디스크를 연결하지 못했습니다: " + ", ".join(mounts[:3]))
    else:
        lines.append("시스템 파일이나 드라이버에 문제가 생긴 것 같습니다.")
    return lines


def restore_points():
    try:
        st = json.loads(subprocess.run([RESTORE, "status"], capture_output=True, text=True, timeout=20).stdout or "{}")
        if not st.get("supported"):
            return [], st
        pts = json.loads(subprocess.run([RESTORE, "list"], capture_output=True, text=True, timeout=30).stdout or "[]")
        return pts, st
    except Exception:
        return [], {}


def when(s):
    import datetime
    try:
        t = datetime.datetime.fromisoformat((s or "")[:19])
    except ValueError:
        return s or ""
    return f"{t.month}월 {t.day}일 {t:%H:%M}"


# ── 화면 ────────────────────────────────────────────────────
class Screen:
    def __init__(self):
        import cairo
        import gi
        gi.require_version("Pango", "1.0")
        gi.require_version("PangoCairo", "1.0")
        from gi.repository import Pango, PangoCairo
        self.cairo, self.Pango, self.PangoCairo = cairo, Pango, PangoCairo
        base = "/sys/class/graphics/fb0"
        with open(f"{base}/virtual_size") as f:
            self.w, self.h = (int(x) for x in f.read().strip().split(","))
        with open(f"{base}/bits_per_pixel") as f:
            if int(f.read()) != 32:
                raise RuntimeError("32비트 프레임버퍼만")
        with open(f"{base}/stride") as f:
            self.stride = int(f.read())
        self.fd = os.open("/dev/fb0", os.O_RDWR)
        self.mem = mmap.mmap(self.fd, self.stride * self.h)
        self.modeset()
        self.surf = cairo.ImageSurface(cairo.FORMAT_RGB24, self.w, self.h)
        self.scale = max(1.0, min(self.w / 1920, self.h / 1080) * 1.0) if self.w >= 1600 else max(0.75, self.w / 1600)

    def modeset(self):
        """화면 서버(Hyprland)가 내려간 뒤엔 모니터 출력이 꺼진 채 남아 그려도 안 보였다 — 프레임버퍼에
        모드를 다시 걸어 달라고 한다 (DRM 의 fbdev 가 이때 화면을 켠다)"""
        try:
            vi = bytearray(160)
            fcntl.ioctl(self.fd, FBIOGET_VSCREENINFO, vi, True)
            act = struct.unpack_from("I", vi, 80)[0]          # fb_var_screeninfo.activate
            struct.pack_into("I", vi, 80, act | FB_ACTIVATE_FORCE)
            fcntl.ioctl(self.fd, FBIOPUT_VSCREENINFO, vi, True)
        except OSError:
            pass

    def text(self, cr, s, size, color, x, y, weight="Regular", width=None):
        lay = self.PangoCairo.create_layout(cr)
        lay.set_font_description(self.Pango.FontDescription(f"Pretendard {weight} {size * self.scale:.0f}"))
        if width:
            lay.set_width(int(width * self.Pango.SCALE))
            lay.set_wrap(self.Pango.WrapMode.WORD_CHAR)
        lay.set_text(s, -1)
        cr.set_source_rgb(*color)
        cr.move_to(x, y)
        self.PangoCairo.show_layout(cr, lay)
        return lay.get_pixel_size()[1]

    def draw(self, title, lines, items, sel, footer):
        cr = self.cairo.Context(self.surf)
        cr.set_source_rgb(*BG)
        cr.paint()
        s = self.scale
        pw = min(self.w - 80, int(1100 * s))
        x0 = (self.w - pw) // 2
        y = int(self.h * 0.14)
        # 두 별 (SekaiOS 표지)
        for (cx, cy, r, col) in ((x0 + 22 * s, y + 18 * s, 18 * s, ACCENT), (x0 + 40 * s, y + 4 * s, 10 * s, (0.98, 0.42, 0.62))):
            cr.set_source_rgb(*col)
            cr.move_to(cx, cy - r)
            for (dx, dy) in ((0.22, -0.22), (1, 0), (0.22, 0.22), (0, 1), (-0.22, 0.22), (-1, 0), (-0.22, -0.22), (0, -1)):
                cr.line_to(cx + dx * r, cy + dy * r)
            cr.fill()
        y += int(56 * s)
        y += self.text(cr, title, 30, FG, x0, y, "SemiBold", pw) + int(14 * s)
        for ln in lines:
            y += self.text(cr, ln, 15, DIM, x0, y, "Regular", pw) + int(4 * s)
        y += int(26 * s)
        ih = int(64 * s)
        for i, (t, sub) in enumerate(items):
            if i == sel:
                cr.set_source_rgb(*PANEL)
                self._round(cr, x0, y, pw, ih - int(8 * s), 10 * s)
                cr.fill()
                cr.set_source_rgb(*ACCENT)
                self._round(cr, x0, y, int(4 * s), ih - int(8 * s), 2 * s)
                cr.fill()
            self.text(cr, f"{i + 1}   {t}", 17, FG if i == sel else (0.85, 0.86, 0.88), x0 + int(22 * s), y + int(8 * s),
                      "Medium" if i == sel else "Regular", pw - int(40 * s))
            if sub:
                self.text(cr, sub, 12.5, DIM, x0 + int(50 * s), y + int(34 * s), "Regular", pw - int(70 * s))
            y += ih
        self.text(cr, footer, 12.5, DIM, x0, self.h - int(70 * s), "Regular", pw)
        self.flush()

    @staticmethod
    def _round(cr, x, y, w, h, r):
        import math
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
        cr.close_path()

    def flush(self):
        self.surf.flush()
        data = self.surf.get_data()
        ss = self.surf.get_stride()
        row = self.w * 4
        if ss == self.stride:
            self.mem.seek(0)
            self.mem.write(bytes(data))
        else:
            for yy in range(self.h):
                self.mem.seek(yy * self.stride)
                self.mem.write(bytes(data[yy * ss:yy * ss + row]))


class Keys:
    """tty1 을 그래픽 모드로 (글자 콘솔이 그림 위에 글자를 덮지 않게) 하고 날것의 키를 읽는다"""

    def __init__(self):
        self.fd = None
        self.open()

    def open(self):
        """(다시) 연다 — 명령줄에서 로그인했다 나오면 tty1 이 또 끊겨(vhangup) 옛 fd 는 쓸 수 없다"""
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        # 다른 VT 로 갔다가 tty1 로 — 바꿀 때 콘솔이 화면 모드를 되살린다
        for vt in (2, 1):
            try:
                t0 = os.open("/dev/tty0", os.O_RDWR | os.O_NOCTTY)
                fcntl.ioctl(t0, VT_ACTIVATE, vt)
                fcntl.ioctl(t0, VT_WAITACTIVE, vt)
                os.close(t0)
            except OSError:
                pass
        # 로그인 화면(greetd)이 막 내려가면 tty1 이 끊기는(vhangup) 중이라 한동안 EIO — 다시 열어 본다
        err = None
        for _ in range(50):
            try:
                self.fd = os.open("/dev/tty1", os.O_RDWR | os.O_NOCTTY)
                self.old = termios.tcgetattr(self.fd)
                break
            except (OSError, termios.error) as e:
                err = e
                if self.fd is not None:
                    try:
                        os.close(self.fd)
                    except OSError:
                        pass
                    self.fd = None
                time.sleep(0.2)
        else:
            raise RuntimeError(f"tty1 을 열지 못함: {err}")
        tty.setraw(self.fd)
        self.graphics(True)
        self.reopened = True               # 화면 쪽이 모드를 다시 걸게 (Rescue.menu)

    def graphics(self, on):
        try:
            fcntl.ioctl(self.fd, KDSETMODE, KD_GRAPHICS if on else KD_TEXT)
        except OSError:
            pass

    def text_mode(self):
        self.graphics(False)
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)

    def back(self):
        tty.setraw(self.fd)
        self.graphics(True)

    def read(self):
        try:
            b = os.read(self.fd, 8)
        except OSError:
            self.open()                    # 끊겼다 — 다시 열고 다음 키를 기다린다
            return None
        if not b:
            self.open()
            return None
        if b in (b"\x1b[A", b"\x1bOA", b"k"):
            return "up"
        if b in (b"\x1b[B", b"\x1bOB", b"j"):
            return "down"
        if b in (b"\r", b"\n", b" "):
            return "enter"
        if b == b"\x1b":
            # Esc 홀로 — 뒤따르는 글자가 없으면
            r, _, _ = select.select([self.fd], [], [], 0.05)
            if not r:
                return "esc"
            os.read(self.fd, 8)
            return None
        s = b.decode("ascii", "ignore")
        if s.isdigit():
            return int(s)
        return None


# ── 흐름 ────────────────────────────────────────────────────
class Rescue:
    def __init__(self, mode):
        self.mode = mode
        self.scr = Screen()
        self.keys = Keys()

    def menu(self, title, lines, items, footer="↑↓ 고르기 · Enter 확인", esc=None):
        sel = 0
        while True:
            if self.keys.reopened:
                self.keys.reopened = False
                self.scr.modeset()
            self.scr.draw(title, lines, [(t, s) for t, s, _ in items], sel, footer)
            k = self.keys.read()
            if k == "up":
                sel = (sel - 1) % len(items)
            elif k == "down":
                sel = (sel + 1) % len(items)
            elif k == "enter":
                return items[sel][2]
            elif isinstance(k, int) and 1 <= k <= len(items):
                return items[k - 1][2]
            elif k == "esc" and esc is not None:
                return esc

    def say(self, title, lines):
        self.scr.draw(title, lines, [], 0, "")

    def confirm(self, title, lines, yes):
        return self.menu(title, lines, [(yes, "", True), ("돌아가기", "", False)], esc=False)

    def do_restore(self, p):
        if not self.confirm("이 복원 지점으로 되돌릴까요?",
                            [f"{when(p['date'])} — {p['description'] or p['kind_text']}",
                             "시스템 파일과 앱이 그때 상태로 돌아갑니다. 개인 파일은 그대로입니다.",
                             "되돌린 뒤 설정 › 복구에서 ‘복원 취소’를 할 수 있습니다."],
                            "되돌리고 다시 시작"):
            return
        self.say("되돌릴 준비를 하는 중…", ["잠시 기다려 주세요."])
        r = subprocess.run([RESTORE, "restore", str(p["number"])], capture_output=True, text=True)
        if r.returncode != 0:
            err = (r.stderr or "").strip().splitlines()
            self.menu("되돌리지 못했습니다", [err[-1][6:] if err and err[-1].startswith("ERROR ") else (err[-1] if err else "")],
                      [("돌아가기", "", None)])
            return
        self.say("다시 시작하는 중…", ["시작하면서 시스템을 되돌립니다. 끄지 마세요."])
        self.reboot()

    def reboot(self):
        subprocess.run(["sync"])
        subprocess.run(["systemctl", "--force", "reboot"])
        time.sleep(30)

    def shell(self):
        """관리자 계정으로 로그인한 명령줄 — root 는 잠겨 있다. 나가면(exit) 이 화면으로"""
        self.keys.text_mode()
        os.write(self.keys.fd, "\x1b[2J\x1b[H".encode() +
                 b"SekaiOS recovery shell - log in with an administrator account. Type 'exit' to return.\r\n\r\n")
        try:
            # agetty → login (관리자 계정). setsid -w: 새 세션에서 돌리고 끝날 때까지 기다린다
            subprocess.run(["setsid", "-w", "/sbin/agetty", "--noclear", "tty1", "linux"])
        finally:
            time.sleep(0.5)
            self.keys.open()               # 로그아웃하며 tty1 이 끊겼다 — 다시 열고 화면 모드도 다시
            self.scr.modeset()

    def pick_point(self, pts):
        items = [(f"{when(p['date'])} — {p['description'] or p['kind_text']}", p["kind_text"], p) for p in pts[:8]]
        items.append(("돌아가기", "", None))
        p = self.menu("복원 지점 고르기", ["되돌릴 시점을 고르세요. 위가 가장 최근입니다."], items, esc=None)
        if p:
            self.do_restore(p)

    def run(self):
        while True:
            pts, st = restore_points()
            items = []
            if pts:
                p0 = pts[0]
                items.append(("마지막 복원 지점으로 되돌리기", f"{when(p0['date'])} — {p0['description'] or p0['kind_text']}",
                              ("restore", p0)))
                if len(pts) > 1:
                    items.append(("다른 복원 지점 고르기", f"복원 지점 {len(pts)}개", ("pick", pts)))
            if self.mode == "repeated":
                items.append(("그냥 시작해 보기", "되돌리지 않고 평소대로 시작합니다", ("continue", None)))
            if self.mode == "rescue":
                items.append(("평소대로 시작", "복구 모드를 나가 바탕 화면까지 시작합니다", ("continue", None)))
            items.append(("다시 시작", "", ("reboot", None)))
            items.append(("명령줄 (관리자 계정으로 로그인)", "개발자용 — 끝나면 exit 로 이 화면에 돌아옵니다", ("shell", None)))
            items.append(("끄기", "", ("off", None)))
            lines = reason_lines(self.mode)
            if not pts:
                lines = lines + [st.get("reason") or "이 PC 에는 되돌릴 복원 지점이 없습니다."] if st else lines
            title = "복구 모드" if self.mode == "rescue" else "자동 복구"
            act, arg = self.menu(title, lines, items)
            if act == "restore":
                self.do_restore(arg)
            elif act == "pick":
                self.pick_point(arg)
            elif act == "continue":
                write_count(0)
                self.say("시작하는 중…", [])
                self.keys.text_mode()
                subprocess.run(["systemctl", "--no-block", "default"])
                return
            elif act == "reboot":
                self.say("다시 시작하는 중…", [])
                self.reboot()
            elif act == "shell":
                self.shell()
            elif act == "off":
                self.say("끄는 중…", [])
                subprocess.run(["systemctl", "--force", "poweroff"])
                time.sleep(30)


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "emergency"
    if mode == "bootcheck":
        bootcheck()
        return
    if mode == "bootok":
        bootok(shutdown="--shutdown" in sys.argv)
        return
    if mode == "crashcheck":
        crashcheck()
        return
    try:
        Rescue(mode).run()
    except Exception as e:
        # 그릴 수 없다 (프레임버퍼 없음 등) — 원래의 systemd 비상·복구 셸로
        print(f"sekai-rescue: {e!r}", file=sys.stderr)
        if mode in ("emergency", "rescue") and os.path.exists(SULOGIN):
            os.execv(SULOGIN, [SULOGIN, mode])
        if mode == "repeated":
            # 까만 화면으로 두지 않는다 — 로그인 화면을 다시 띄운다
            write_count(0)
            subprocess.run(["systemctl", "--no-block", "start", "greetd.service"])
        raise


if __name__ == "__main__":
    main()
