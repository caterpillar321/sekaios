<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SekaiOS 드라이브 연결 실패 원인 확인 — 파일 탐색기의 "원인 자세히 확인"이 pkexec 로 부른다 (읽기만 한다) -->
<policyconfig>
  <vendor>SekaiOS</vendor>
  <action id="org.sekaios.volcheck">
    <description>Find out why a drive could not be opened</description>
    <description xml:lang="ko">드라이브를 열지 못한 원인 확인</description>
    <message>Authentication is required to read the drive and the system log</message>
    <message xml:lang="ko">드라이브와 시스템 기록을 읽어 원인을 확인하려면 인증이 필요합니다</message>
    <icon_name>drive-harddisk</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sekai/sekai-volcheck</annotate>
  </action>
</policyconfig>
