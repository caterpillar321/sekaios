<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SekaiOS PCI 호환성 도우미 — 설정 › 그래픽의 "PCI 주소 다시 잡기"가 pkexec 로 부른다.
     인자는 도우미가 검사한다 (set auto|off|on 만) -->
<policyconfig>
  <vendor>SekaiOS</vendor>
  <action id="org.sekaios.pci">
    <description>Change the PCI resource reallocation setting</description>
    <description xml:lang="ko">PCI 주소 다시 잡기 설정 바꾸기</description>
    <message>Authentication is required to change how PCI device addresses are assigned at boot</message>
    <message xml:lang="ko">부팅할 때 PCI 장치 주소를 잡는 방식을 바꾸려면 인증이 필요합니다</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/sekai/sekai-pci</annotate>
  </action>
</policyconfig>
