#!/bin/sh
# SekaiOS 드라이브 암호화 — TPM2 로 저절로 여는 데 필요한 것을 initramfs 에 넣는다 (scripts/local-top/sekai-tpm2)
#   데비안 cryptroot 는 TPM2 토큰을 모른다. 그래서 systemd 의 cryptsetup 토큰 플러그인(libcryptsetup-token-systemd-tpm2)과
#   TPM 드라이버를 넣고, cryptroot 보다 먼저 `cryptsetup open --token-only` 로 연다. 못 열면 cryptroot 가 평소대로 묻는다.
#   /etc/sekai/encryption.conf (설치 프로그램이 쓴다) 의 LUKS 장치 헤더에 systemd-tpm2 토큰이 있을 때만.
PREREQ="cryptroot"
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions

CONF=/etc/sekai/encryption.conf
[ -r "$CONF" ] || exit 0
LUKS_UUID=$(sed -n 's/^LUKS_UUID=\([A-Za-z0-9-]*\)$/\1/p' "$CONF" | head -1)
LUKS_NAME=$(sed -n 's/^LUKS_NAME=\([a-z0-9-]*\)$/\1/p' "$CONF" | head -1)
[ -n "$LUKS_UUID" ] && [ -n "$LUKS_NAME" ] || exit 0
# TPM·PIN 을 쓰는지는 LUKS 헤더에서 — 설정 파일은 시스템 복원으로 옛것이 될 수 있지만 헤더는 늘 지금 것이다
META=$(cryptsetup luksDump --dump-json-metadata "/dev/disk/by-uuid/$LUKS_UUID" 2>/dev/null | tr -d ' \n')
case "$META" in *'"type":"systemd-tpm2"'*) ;; *) exit 0 ;; esac
PIN=0
case "$META" in *'"tpm2-pin":true'*) PIN=1 ;; esac

ML=/usr/lib/x86_64-linux-gnu
PLUGIN="$ML/cryptsetup/libcryptsetup-token-systemd-tpm2.so"
if [ ! -e "$PLUGIN" ]; then
    echo "sekai-tpm2: $PLUGIN 이 없습니다 (systemd-cryptsetup) — TPM 으로 저절로 열 수 없습니다" >&2
    exit 0
fi
copy_exec "$PLUGIN"
# libsystemd-shared 가 dlopen 으로 여는 TPM 라이브러리 (copy_exec 는 NEEDED 만 따라간다)
for l in libtss2-esys.so.0 libtss2-rc.so.0 libtss2-mu.so.0 libtss2-tcti-device.so.0; do
    [ -e "$ML/$l" ] && copy_exec "$ML/$l"
done
manual_add_modules tpm_crb tpm_tis tpm_tis_core tpm
mkdir -p "$DESTDIR/etc"
# 봉인할 때의 PCR 7 — 부팅 때 달라졌으면(보안 부팅을 껐다·펌웨어가 바뀌었다) PIN 을 묻지 않고 바로 복구 키로
PCR7=$(sed -n 's/^PCR7=\([0-9A-F]*\)$/\1/p' "$CONF" | head -1)
printf 'LUKS_UUID=%s\nLUKS_NAME=%s\nTPM=1\nPIN=%s\nPCR7=%s\n' "$LUKS_UUID" "$LUKS_NAME" "$PIN" "$PCR7" > "$DESTDIR/etc/sekai-encryption.conf"
exit 0
