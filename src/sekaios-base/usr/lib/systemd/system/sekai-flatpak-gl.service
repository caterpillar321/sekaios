[Unit]
Description=SekaiOS 플랫팩 앱용 NVIDIA GL 확장을 드라이버 버전에 맞추기
ConditionPathExists=/sys/module/nvidia/version
ConditionPathExists=/usr/bin/flatpak
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/sekai/sekai-flatpak-gl
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=40min
# 받기에 실패하면(켤 때 인터넷이 아직 없음 등) 다음 점검(6시간)까지 플랫팩 앱이 빈 창 — 10분 뒤 다시
Restart=on-failure
RestartSec=10min
