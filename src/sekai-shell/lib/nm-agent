NM_NAME = "org.freedesktop.NetworkManager"
AM_PATH = "/org/freedesktop/NetworkManager/AgentManager"
AM_IFACE = "org.freedesktop.NetworkManager.AgentManager"
AGENT_PATH = "/org/freedesktop/NetworkManager/SecretAgent"
IDENTIFIER = "org.sekaios.nm-agent"

ERR = "org.freedesktop.NetworkManager.SecretAgent."
ERR_NO_SECRETS = ERR + "NoSecrets"
ERR_USER_CANCELED = ERR + "UserCanceled"
ERR_AGENT_CANCELED = ERR + "AgentCanceled"

# GetSecrets flags
ALLOW_INTERACTION = 0x1
REQUEST_NEW = 0x2
USER_REQUESTED = 0x4
WPS_PBC_ACTIVE = 0x8

