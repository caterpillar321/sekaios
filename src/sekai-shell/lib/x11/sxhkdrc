# SekaiOS 기본 화면 모드 단축키 (sxhkd) — Hyprland 쪽과 같은 자리에
#   창 배치(Win+←/→/↑/↓)·닫기(Alt+F4, Win+Q)는 xfwm4 가 한다 (xfwm4-setup)
#   설정 › 단축키 에서 바꾼 키는 hyprland.conf 의 "같은 키 조합" 항목을 따라 이 파일의 줄을 바꿔
#   ~/.config/sekai/sxhkdrc 로 만든다 (sekaishell/keybinds.py) — 여기 키 조합은 hyprland.conf 와 맞춰 둘 것

# Win 키만 눌렀다 떼면 시작 메뉴 — xcape 가 "Win 단독 탭"을 Ctrl+Esc 로 바꿔 준다
# (sxhkd 의 @Super_L 은 Win+L 같은 조합 뒤에 Win 을 뗄 때도 반응해서 쓰지 않는다.
#  Ctrl+Esc 는 윈도우에서도 시작 메뉴 키다)
ctrl + Escape
	sekai-ctl menu
super + e
	sekai-files
super + Return
	sekai-terminal
super + {r,d}
	sekai-ctl menu
super + i
	sekai-settings
super + n
	sekai-ctl notifications
super + a
	sekai-ctl quicksettings
ctrl + shift + Escape
	sekai-taskmgr
super + v
	sekai-ctl clipboard
super + l
	/usr/libexec/sekai/lock-now

# Alt+Tab 창 전환기 — Alt 를 떼면 전환기가 직접 받아 고른 창으로 간다
alt + Tab
	sekai-ctl switch next
alt + shift + Tab
	sekai-ctl switch prev

# 스크린샷
Print
	sekai-screenshot
{shift + Print, super + shift + s}
	sekai-screenshot region
alt + Print
	sekai-screenshot window

# 음량·밝기·미디어
XF86AudioRaiseVolume
	sekai-ctl volume up
XF86AudioLowerVolume
	sekai-ctl volume down
XF86AudioMute
	sekai-ctl volume mute
XF86AudioMicMute
	sekai-ctl volume mic-mute
XF86MonBrightnessUp
	sekai-ctl brightness up
XF86MonBrightnessDown
	sekai-ctl brightness down
{XF86AudioPlay, XF86AudioPause}
	playerctl play-pause
XF86AudioNext
	playerctl next
XF86AudioPrev
	playerctl previous
