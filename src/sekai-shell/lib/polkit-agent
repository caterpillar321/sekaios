def pam_text(text):
    """영어 안내를 알아보면 한국어로 (한국어면 그대로, 모르면 None — 영어를 사용자에게 보이지 않는다)"""
    t = (text or "").strip()
    if not t:
        return ""
    if authui.is_korean(t):
        return t
    for pat, fn in PAM_TEXTS:
        m = re.search(pat, t, re.I)
        if m:
            return fn(m)
    return None


def is_password_prompt(prompt):
    return bool(re.match(r"^\s*(password|passwort|암호|비밀번호)\s*(for \S+)?\s*:?\s*$", prompt or "", re.I))


# ═══ 누가 요청했나 ═══════════════════════════════════════════════
# 스스로는 "앱"이 아닌 중간 프로그램 — 부모로 올라가 실제 앱을 찾는다 (sekai-admin → systemctl → polkit)
HELPERS = {"sh", "dash", "bash", "zsh", "env", "sudo", "pkexec", "systemctl", "busctl", "gdbus", "dbus-send",
           "nmcli", "udisksctl", "timedatectl", "hostnamectl", "localectl", "loginctl", "timeout", "setsid",
           "xargs", "nohup", "keep-running", "flock"}
INTERP = re.compile(r"^(python[\d.]*|perl|ruby|node|sh|bash|dash|gjs|lua[\d.]*)$")
STD_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def _read(path, binary=False):
    try:
        with open(path, "rb" if binary else "r") as f:
            return f.read()
    except OSError:
        return b"" if binary else ""


def proc_argv(pid):
    return [a.decode("utf-8", "replace") for a in _read(f"/proc/{pid}/cmdline", True).split(b"\0") if a]


def proc_info(pid):
    """pid → (보일 이름 후보, 실행 파일 경로, 부모 pid). 없으면 None"""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return None
    if pid <= 1:
        return None
    argv = proc_argv(pid)
    comm = _read(f"/proc/{pid}/comm").strip()
    if not argv and not comm:
        return None
    ppid = 0
    for line in _read(f"/proc/{pid}/status").splitlines():
        if line.startswith("PPid:"):
            try:
                ppid = int(line.split()[1])
            except (IndexError, ValueError):
                pass
            break
    path = argv[0] if argv else comm
    # 파이썬·셸 스크립트면 스크립트 파일이 앱이다 (python3 /usr/bin/sekai-settings).
    #   "sh -c '…'" 처럼 명령을 글로 받은 것은 그대로 (sh → 도우미로 보고 부모로 올라간다)
    if argv and INTERP.match(os.path.basename(argv[0])):
        for a in argv[1:]:
            if a == "-c":
                break
            if a.startswith("-"):
                continue
            if os.path.isfile(a):
                path = a
            break
    return os.path.basename(path) or comm, path, ppid


def pkexec_target(details, message):
    """pkexec 가 실행하려는 것 → (프로그램 경로, 명령줄, 실행할 사용자) 또는 None.
    polkitd 는 pkexec 가 넘긴 세부 사항(program·command_line)을 에이전트에 전하지 않는다 (요청한 쪽이 꾸밀 수 있어서).
    그래서 요청한 프로세스(polkit.caller-pid = pkexec)의 명령줄을 직접 읽는다."""
    argv = proc_argv(details.get("polkit.caller-pid") or 0)
    if not argv or os.path.basename(argv[0]) != "pkexec":
        return None
    user, i = "root", 1
    while i < len(argv):
        a = argv[i]
        if a in ("--user", "-u") and i + 1 < len(argv):
            user, i = argv[i + 1], i + 2
        elif a.startswith("--user="):
            user, i = a.split("=", 1)[1], i + 1
        elif a in ("--disable-internal-agent", "--keep-cwd"):
            i += 1
        elif a == "--":
            i += 1
            break
        else:
            break
    rest = argv[i:]
    if not rest:                                   # 인자 없는 pkexec — 관리자 셸
        try:
            rest = [pwd.getpwnam(user).pw_shell or "/bin/sh"]
        except KeyError:
            rest = ["/bin/sh"]
    prog = rest[0]
    # polkit 메시지에는 pkexec 가 찾은 절대 경로가 들어 있다 ("…run `/usr/bin/touch …' as …")
    m = re.search(r"`(/\S+)", message or "")
    if m and os.path.basename(m.group(1)) == os.path.basename(prog):
        prog = m.group(1)
    elif not os.path.isabs(prog):
        prog = shutil.which(prog, path=STD_PATH) or prog
    return prog, " ".join(shlex.quote(a) for a in [prog] + rest[1:]), user


_apps = None


def app_for(name, path=""):
    """실행 파일 이름 → (앱 이름, 아이콘 후보). .desktop 항목에서 찾는다 (없으면 파일 이름 그대로)"""
    global _apps
    if _apps is None:
        _apps = {}
        try:
            for app in Gio.AppInfo.get_all():
                exe = app.get_executable() or ""
                if not exe:
                    continue
                gi_ = app.get_icon()
                ic = gi_.to_string() if gi_ is not None else ""
                for key in {exe, os.path.basename(exe)}:
                    _apps.setdefault(key, (app.get_name() or os.path.basename(exe), ic))
        except Exception as e:                         # .desktop 가 깨져 있어도 창은 떠야 한다
            dbg("앱 목록을 읽지 못함", e)
    hit = _apps.get(path) or _apps.get(name)
    if hit is None:
        try:
            d = Gio.DesktopAppInfo.new(name + ".desktop")
        except TypeError:
            d = None
        if d is not None:
            gi_ = d.get_icon()
            hit = (d.get_name() or name, gi_.to_string() if gi_ is not None else "")
    if hit is not None:
        return hit[0], [hit[1], name, "application-x-executable"]
    return name, [name, "application-x-executable"]


def requester(details):
    """details 의 polkit.subject-pid 로 요청한 앱을 찾는다 → (앱 이름, 아이콘 후보, 자세히 글) 또는 None"""
    pid = details.get("polkit.subject-pid") or details.get("polkit.caller-pid")
    info = proc_info(pid)
    if info is None:
        return None
    first = info
    seen = 0
    while info is not None and info[0] in HELPERS and seen < 5:
        up = proc_info(info[2])
        if up is None:
            break
        info = up
        seen += 1
    name, path, _pp = info
    detail = f"{name} (pid {pid})" if first is info else f"{name} → {first[0]} (pid {pid})"
    if name in HELPERS:
        # 앱까지 올라가지 못했다 (떨어져 나온 "sh -c …" 따위) — 셸 이름을 앱처럼 보이지 않는다
        return None, [], detail
    title, icons = app_for(name, path)
    return title, icons, detail


