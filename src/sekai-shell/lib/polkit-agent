class Request:
    def __init__(self, inv, action_id, message, icon_name, details, cookie, identities):
        self.inv = inv
        self.action_id = action_id
        self.message = message
        self.icon_name = icon_name
        self.details = dict(details)
        self.cookie = cookie
        self.identities = identities
        self.dialog = None
        self.answered = False

    def reply(self, ok):
        """polkitd 에 답한다 (한 번만). ok=False 면 '취소됨' — pkexec 는 "Request dismissed" 로 끝난다"""
        if self.answered:
            return
        self.answered = True
        try:
            if ok:
                self.inv.return_value(None)
            else:
                self.inv.return_dbus_error(ERR_CANCELLED, "사용자가 인증을 취소했습니다")
        except Exception as e:                          # polkitd 가 이미 사라졌다
            dbg("답을 보내지 못함", e)


