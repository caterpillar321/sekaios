        self.agent = agent
        self.req = req
        self.session = None
        self.prompt_ready = False      # 도우미가 암호를 기다리는 중
        self.pending = None            # 도우미가 묻기 전에 "예"를 눌렀을 때의 암호
        self.responded = False         # 이 세션에 암호를 넘겼나
        self.errors = []               # 이 세션에서 받은 오류 안내 (한국어로 바꾼 것)
        self.busy = False
        self.closed = False
        self.fails = 0
        authui.load_style()

        me = os.getuid()
        uids = expand_identities(req.identities)
        if me in uids:
            uids = [me]                               # 내가 관리자 — 내 암호로 (다른 계정을 고를 까닭이 없다)
            self.mode = "self"
        else:
            if len(uids) > 1 and 0 in uids:
                uids = [u for u in uids if u != 0]    # root 는 그것밖에 없을 때만
            self.mode = "admin"
        self.accounts = [authui.account(u) for u in uids] or [authui.account(0)]
        self.uid = self.accounts[0]["uid"]

        self.dims = authui.DimSet(self._attention) if authui.use_layer() else None
        self.win = authui.CardWindow("sekai-uac", "사용자 계정 컨트롤", exclusive=True, width=512)
        self._build()
        self.win.connect("key-press-event", self._key)
        self.win.connect("delete-event", lambda *_: (self.answer(False), True)[1])
        self.win.show_all()
        self.entry.grab_focus()
        self.start_session()

    # ── 모양 ──
    def _build(self):
        ui = self.ui
        req = self.req
        d = req.details
        card = self.win.card
        card.pack_start(ui.head_strip("사용자 계정 컨트롤"), False, False, 0)
        body = ui.body_box(14)
        card.pack_start(body, False, False, 0)

        who = requester(d)
        rows = []
