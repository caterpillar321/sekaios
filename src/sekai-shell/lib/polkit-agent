        self.more_btn.connect("clicked", self._toggle_more)
        mbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        mbox.pack_start(self.more_btn, False, False, 0)
        frame.set_margin_top(6)
        mbox.pack_start(self.more, False, False, 0)
        body.pack_start(mbox, False, False, 0)

        # 계정과 암호
        if self.mode == "self":
            tip = "계속하려면 암호를 입력하세요."
        elif len(self.accounts) > 1:
