        run = pkexec_target(d, req.message)
        if run is not None and req.action_id.startswith("org.sekaios.") and req.action_id != EXEC_ACTION:
            rows += [("프로그램 위치", run[0]), ("명령줄", run[1])]      # 모양은 정책의 설명으로, 실행할 것은 자세히에
            run = None
        if run is not None:
            prog, cmdline, target = run
            try:
                p = pwd.getpwnam(target)
                shown = (p.pw_gecos or "").split(",")[0].strip() or target
            except KeyError:
                p, shown = None, target
            if target == "root" or (p is not None and p.pw_uid == 0):
                q = "이 앱이 관리자 권한으로 실행되도록 허용하시겠어요?"
            else:
                q = f"이 앱이 다른 사용자({shown}) 권한으로 실행되도록 허용하시겠어요?"
            name, icons = app_for(os.path.basename(prog), prog)
            title, sub = name, prog
