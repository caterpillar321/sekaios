    def _toggle_more(self, *_):
        on = not self.more.get_reveal_child()
        self.more.set_reveal_child(on)
        self.more_btn.set_label("자세한 내용 숨기기" if on else "자세한 내용 표시")
        self.entry.grab_focus_without_selecting()          # 암호를 치던 중이면 그대로 이어서

    def _find_package(self, prog):
        """이 프로그램을 설치한 패키지 (dpkg-query -S) — 기다리지 않고 따로 돌린다"""
        try:
            p = Gio.Subprocess.new(["dpkg-query", "-S", prog],
                                   Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self._set_publisher(None)
            return

        def done(proc, res):
            try:
                _ok, out, _err = proc.communicate_utf8_finish(res)
            except GLib.Error:
                out = ""
            pkg = None
            for line in (out or "").splitlines():
                if ":" in line and not line.startswith("diversion"):
                    pkg = line.split(":", 1)[0].split(",")[0].strip()
                    break
            if not self.closed:
                self._set_publisher(pkg)
        p.communicate_utf8_async(None, None, done)

    def _set_publisher(self, pkg):
        if self.publisher is None:
            return
        if pkg:
            self.publisher.set_text(authui.keep_words(f"게시자: {pkg} 패키지 (이 컴퓨터에 설치됨)"))
        else:
            self.publisher.set_text(authui.keep_words("게시자: 알 수 없음 — 패키지로 설치된 파일이 아닙니다"))
            self.publisher.get_style_context().add_class("auth-unknown")

    def _attention(self):
        self.win.attention()
        self.entry.grab_focus()

    def _key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.answer(False)
            return True
        return False

    def _picked(self, _l, row):
        if row is None or row.uid == self.uid or self.closed:
            return
        self.uid = row.uid
        self.entry.clear()
        self.msg.show_text("")
        self.pending = None
        if self.busy:
            self.set_busy(False)
        self.start_session()
        self.entry.grab_focus()

    def set_busy(self, on):
        self.busy = on
        self.field.set_busy(on)
        for w in (self.yes, self.list):
            w.set_sensitive(not on)
        if not on:
            self.entry.grab_focus()

    # ── PolkitAgent 세션 (암호 확인) ──
    def start_session(self):
        self.stop_session()
        self.prompt_ready = False
        self.responded = False
        self.errors = []
        try:
            s = PolkitAgent.Session.new(Polkit.UnixUser.new(self.uid), self.req.cookie)
        except Exception as e:
            log("인증 세션을 만들지 못함:", e)
            self.msg.show_text("인증을 시작할 수 없습니다.")
            return
        s.connect("request", self._on_request)
        s.connect("show-error", self._on_show, "error")
        s.connect("show-info", self._on_show, "info")
        s.connect("completed", self._on_completed)
        self.session = s
        dbg("세션 시작 uid", self.uid)
        s.initiate()

    def stop_session(self):
        s, self.session = self.session, None
        if s is not None:
            try:
                s.cancel()             # completed(False) 가 오지만 self.session 이 아니므로 무시된다
            except Exception:
                pass

    def _on_request(self, s, prompt, echo_on):
        if s is not self.session or self.closed:
            return
        dbg("도우미가 묻는다:", repr(prompt), "echo" if echo_on else "")
        self.prompt_ready = True
        if is_password_prompt(prompt):
            self.prompt.hide()
            self.entry.set_placeholder_text("암호")
        else:
            t = pam_text(prompt)
            self.prompt.set_text(authui.keep_words(t or "인증 정보를 입력하세요."))
            self.prompt.show()
            self.entry.set_placeholder_text(t or "")
        self.entry.secret = not echo_on
        self.entry.set_visibility(bool(echo_on))
        if self.pending is not None:
            pw, self.pending = self.pending, None
            self._respond(pw)

    def _respond(self, pw):
        self.prompt_ready = False
        self.responded = True
        self.session.response(pw)

    def _on_show(self, s, text, kind):
        if s is not self.session or self.closed:
            return
        dbg("도우미 안내:", kind, repr(text))
        t = pam_text(text)
        if t is None:                  # 모르는 영어 문구 — 사용자에게는 일반 문구로 (원문은 기록에)
            log("알 수 없는 인증 안내:", text)
            t = "인증 중에 문제가 생겼습니다." if kind == "error" else ""
        if not t:
            return
        if kind == "error":
            self.errors.append(t)
        self.msg.show_text(t, "error" if kind == "error" else "info")

    def _on_completed(self, s, gained):
        if s is not self.session or self.closed:
            return
        self.session = None
        dbg("세션 끝:", "성공" if gained else "실패")
        if gained:
            self.answer(True)
            return
        self.set_busy(False)
        self.entry.clear()
        if self.responded:
            self.fails += 1
            text = self.errors[-1] if self.errors else "암호가 올바르지 않습니다. 다시 입력하세요."
            self.msg.show_text(text)
            self.start_session()      # 다음 시도를 미리 준비 (도우미가 다시 암호를 기다린다)
        else:
            # 암호를 넘기기도 전에 끝났다 (계정 잠김·도우미 오류) — 곧바로 다시 시작하면 끝없이 돈다.
            #   다음에 "예"를 누를 때 새로 시작한다
            self.msg.show_text(self.errors[-1] if self.errors else "이 계정으로 인증할 수 없습니다.")

    # ── 예 / 아니요 ──
    def submit(self):
        if self.busy or self.closed:
            return
        pw = self.entry.get_text()
        self.msg.show_text("")
        self.set_busy(True)
        if self.session is None:
            self.pending = pw
            self.start_session()
        elif self.prompt_ready:
            self._respond(pw)
        else:
            self.pending = pw          # 도우미가 아직 준비 중 — 물어 오면 곧바로 넘긴다

    def answer(self, ok):
        if self.closed:
            return
        dbg("사용자 답:", "예(인증됨)" if ok else "아니요")
        self.close()
        self.agent.finished(self.req, ok)

    def close(self):
        """창을 닫는다 (polkitd 에 답하는 것은 부르는 쪽)"""
        if self.closed:
            return
        self.closed = True
        self.pending = None
        self.stop_session()
        self.win.destroy()
        if self.dims is not None:
            self.dims.destroy()


# ═══ 에이전트 ════════════════════════════════════════════════════
class Agent:
    def __init__(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.pk_owner = None           # polkitd 의 고유 버스 이름 — 이 이름에서 온 요청만 받는다
        self.registered = False
        self.queue = []                # 기다리는 요청 (앞이 먼저)
        self.current = None
        self.exit_code = 0
        info = Gio.DBusNodeInfo.new_for_xml(XML)
        self.conn.register_object(AGENT_PATH, info.interfaces[0], self._on_call, None, None)
        Gio.bus_watch_name_on_connection(self.conn, PK_NAME, Gio.BusNameWatcherFlags.NONE,
                                         self._pk_appeared, self._pk_vanished)

    # ── 등록 ──
    def _session_id(self):
        """이 에이전트가 맡을 로그인 세션 (logind 세션 ID)"""
        sid = os.environ.get("XDG_SESSION_ID")
        if sid:
            return sid
        # 세션 ID 를 물려받지 못했다 — logind 에 이 프로세스의 세션을 묻는다 (시작할 때 한 번)
        try:
            s = Polkit.UnixSession.new_for_process_sync(os.getpid(), None)
            return s.get_session_id() if s is not None else None
        except GLib.Error as e:
            log("로그인 세션을 찾지 못했습니다:", e.message)
            return None

    def _locale(self):
        for k in ("LC_ALL", "LC_MESSAGES", "LANG"):
            v = os.environ.get(k)
            if v:
                return v
        return "ko_KR.UTF-8"

    def _pk_appeared(self, _conn, _name, owner):
        self.pk_owner = owner
        sid = self._session_id()
        if not sid:
            self.quit(1)
            return
        subject = ("unix-session", {"session-id": GLib.Variant("s", sid)})
        params = GLib.Variant("((sa{sv})ss)", (subject, self._locale(), AGENT_PATH))
        dbg("polkitd 에 등록:", params)
        self.conn.call(PK_NAME, PK_PATH, PK_IFACE, "RegisterAuthenticationAgent", params, None,
                       Gio.DBusCallFlags.NONE, -1, None, self._registered)

    def _registered(self, conn, res):
        try:
            conn.call_finish(res)
        except GLib.Error as e:
            msg = Gio.DBusError.get_remote_error(e) or ""
            text = e.message
            if "already exists" in text:
                log("이 세션에는 이미 다른 인증 에이전트가 있습니다 — 끝냅니다.")
                self.quit(2)
                return
            log("polkitd 에 등록하지 못했습니다:", msg, text)
            self.quit(1)
            return
        self.registered = True
        log("등록했습니다")

    def quit(self, code):
        """GLib 콜백 안에서 sys.exit 하면 PyGObject 가 삼킨다 — 메인 루프를 끝내고 main() 에서 끝낸다"""
        self.exit_code = code
        Gtk.main_quit()

    def _pk_vanished(self, _conn, _name):
        # polkitd 가 멈췄다 — 쥐고 있던 요청은 쓸모가 없다. 다시 뜨면 _pk_appeared 에서 다시 등록한다
        if self.pk_owner is not None:
            log("polkitd 가 사라졌습니다 — 다시 뜨면 다시 등록합니다")
        self.pk_owner = None
        self.registered = False
        for r in [self.current] + self.queue if self.current else list(self.queue):
            if r.dialog is not None:
                r.dialog.close()
            r.reply(False)
        self.current = None
        self.queue = []

    # ── polkitd 가 부르는 것 ──
    def _on_call(self, _conn, sender, _path, _iface, method, params, inv):
        if self.pk_owner is None or sender != self.pk_owner:
            # 다른 프로그램이 가짜 요청으로 관리자 암호를 받아 내려는 것을 막는다
            log("polkitd 가 아닌 곳의 요청을 거절:", sender, method)
            inv.return_dbus_error("org.freedesktop.DBus.Error.AccessDenied", "polkitd 만 부를 수 있습니다")
            return
        if method == "BeginAuthentication":
            action_id, message, icon_name, details, cookie, identities = params.unpack()
            dbg("요청:", action_id, "|", message, "|", icon_name, "|", details, "|", identities)
            req = Request(inv, action_id, message, icon_name, details, cookie, identities)
            self.queue.append(req)
            if self.current is None:
                self._next()
        elif method == "CancelAuthentication":
            (cookie,) = params.unpack()
            dbg("취소:", cookie)
            self.cancel(cookie)
            inv.return_value(None)
        else:
            inv.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)

    def cancel(self, cookie):
        """요청한 쪽(pkexec 등)이 그만두었다 — 떠 있는 창이면 닫고, 기다리는 것이면 빼낸다"""
        cur = self.current
        if cur is not None and cur.cookie == cookie:
            if cur.dialog is not None:
                cur.dialog.close()
            self.finished(cur, False)
            return
        for r in list(self.queue):
            if r.cookie == cookie:
                self.queue.remove(r)
                r.reply(False)

    def _next(self):
        global _apps
        if self.current is not None or not self.queue:
            return False
        _apps = None                   # 앱 목록(.desktop)을 새로 — 그 사이 설치한 앱도 이름·아이콘으로 보이게
        req = self.queue.pop(0)
        self.current = req
        try:
            req.dialog = UacDialog(self, req)
        except Exception as e:
            import traceback
            traceback.print_exc()
            log("창을 띄우지 못했습니다:", e)
            self.finished(req, False)
        return False

    def finished(self, req, ok):
        req.reply(ok)
        if self.current is req:
            self.current = None
            req.dialog = None
            # 다음 요청은 창이 사라지는 효과가 끝난 뒤에
            GLib.timeout_add(180, self._next)


def main():
    if not Gtk.init_check(sys.argv)[0]:
        log("화면에 연결할 수 없습니다")
        sys.exit(1)
    try:
        agent = Agent()
    except GLib.Error as e:
        log("시스템 버스에 연결할 수 없습니다:", e.message)
        sys.exit(1)
    Gtk.main()
    sys.exit(agent.exit_code)


if __name__ == "__main__":
    main()
