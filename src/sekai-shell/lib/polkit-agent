def expand_identities(identities):
    """polkit 이 준 신원(unix-user / unix-group) → uid 목록 (중복 없이, 받은 순서대로)"""
    uids = []

    def add(u):
        if u not in uids:
            uids.append(u)
    for kind, props in identities:
        try:
            if kind == "unix-user":
                add(int(props.get("uid")))
            elif kind == "unix-group":
                gid = int(props.get("gid"))
                try:
                    g = grp.getgrgid(gid)
                except KeyError:
                    continue
                for name in g.gr_mem:
                    try:
                        add(pwd.getpwnam(name).pw_uid)
                    except KeyError:
                        pass
                for p in pwd.getpwall():                # 이 그룹이 기본 그룹인 계정도
                    if p.pw_gid == gid:
                        add(p.pw_uid)
        except (TypeError, ValueError):
            continue
    return uids


def is_admin_uid(uid):
    if uid == 0:
        return True
    try:
        name = pwd.getpwuid(uid).pw_name
        g = grp.getgrnam("sudo")
        return name in g.gr_mem or pwd.getpwuid(uid).pw_gid == g.gr_gid
    except KeyError:
        return False


