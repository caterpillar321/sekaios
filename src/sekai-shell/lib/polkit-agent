            self._find_package(prog)
            rows += [("프로그램 위치", prog), ("명령줄", cmdline), ("실행할 사용자", shown)]
            if req.action_id != EXEC_ACTION:
                sentence, _ic = action_text(req.action_id, req.message)
                if sentence != GENERIC:
                    rows.append(("하려는 일", sentence))
        else:
            sentence, icons = action_text(req.action_id, req.message)
            icons = list(icons) + [req.icon_name, "dialog-password", "security-high"]
            self.publisher = None
            if who is not None and who[0]:
                q = "이 앱이 디바이스를 변경할 수 있도록 허용하시겠어요?"
