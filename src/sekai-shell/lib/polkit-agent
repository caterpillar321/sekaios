# systemd 는 메시지에 서비스 이름과 동작을 넣어 보낸다 — 영어("…to start 'ssh.service'.")든
#   한국어 번역("인증은 'ssh.service'을 시작하는데 필요합니다.")이든 알아보고 "ssh.service 서비스를 시작하려고 합니다"로
UNIT_VERBS = [
    (r"\breload-or-restart\b|\btry-restart\b|\brestart\b|다시\s*시작|재시작", "{u}를 다시 시작하려고 합니다"),
    (r"\breload\b|다시\s*(읽|불러)", "{u}의 설정을 다시 읽으려고 합니다"),
    (r"\bstop\b|중지|정지|멈추", "{u}를 중지하려고 합니다"),
    (r"\bstart\b|시작", "{u}를 시작하려고 합니다"),
    (r"\bkill\b|강제", "{u}를 강제로 끝내려고 합니다"),
    (r"\breset\b|초기화", "{u}의 오류 상태를 지우려고 합니다"),
    (r"\bfreeze\b", "{u}를 일시 중지하려고 합니다"),
    (r"\bthaw\b", "{u}를 다시 실행하려고 합니다"),
]


def unit_text(message):
    m = re.search(r"['‘`\"]([\w@.:\\-]+\.(service|socket|timer|target|mount|path|scope|slice|swap|automount|device))['’\"]",
                  message or "")
    if not m:
        return None
    unit = m.group(1)
    rest = (message[:m.start()] + " " + message[m.end():]).lower()
    for pat, verb in UNIT_VERBS:
        if re.search(pat, rest):
            what = "서비스" if unit.endswith(".service") else "구성 요소"
            return verb.format(u=f"{unit} {what}")
    return None


def action_text(action_id, message):
    """(문장, 아이콘 후보) — 우리 정책(org.sekaios.*)은 정책에 적어 둔 한국어 메시지를 그대로"""
    if action_id.startswith("org.sekaios.") and message:
        return message, []
    if action_id == "org.freedesktop.systemd1.manage-units":
        t = unit_text(message)
        if t:
            return t, ["preferences-system-services", "system-run"]
    # 가장 길게 맞는 항목 — "…login1.reboot-multiple-sessions" 는 "…login1." 보다 "…login1.reboot" 에,
    #   "…wifi.share.protected" 는 "…wifi.share" 에 맞아야 한다
    best = ""
    for k in ACTIONS:
        if k.endswith((".", "-")):
            ok = action_id.startswith(k)
        else:
            ok = action_id == k or action_id.startswith((k + "-", k + "."))
        if ok and len(k) > len(best):
            best = k
    hit = ACTIONS.get(best) if best else None
    if hit is not None:
        return hit
    if authui.is_korean(message):
        return message, []
    return GENERIC, []


