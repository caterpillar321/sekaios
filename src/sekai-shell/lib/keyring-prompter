        body = authui.body_box(12)
        card.pack_start(body, False, False, 0)

        top = Gtk.Box(spacing=14)
        top.pack_start(authui.icon(["dialog-password", "seahorse", "security-high", "dialog-password-symbolic"], 36),
                       False, False, 0)
        self.message = authui.label("", "auth-title")
        self.sub = authui.label("", "auth-sub")      # 물은 프로그램 (GPG)
        self.sub.set_no_show_all(True)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        col.set_valign(Gtk.Align.CENTER)
        col.pack_start(self.message, False, False, 0)
        col.pack_start(self.sub, False, False, 0)
        top.pack_start(col, True, True, 0)
        body.pack_start(top, False, False, 0)
        self.desc = authui.label("", "auth-text")
        self.desc.set_no_show_all(True)
        body.pack_start(self.desc, False, False, 0)
        self.warning = authui.Message()
        body.pack_start(self.warning, False, False, 0)

        self.entry = authui.PasswordEntry("암호")
        self.field = authui.BusyField(self.entry)
        self.entry2 = authui.PasswordEntry("암호 확인")      # 새 암호일 때만
        self.entry2.set_no_show_all(True)
        for e in (self.entry, self.entry2):
            e.set_activates_default(False)
            e.connect("activate", self._on_activate)
            e.connect("changed", lambda *_: self.msg.show_text(""))
        self.field.show_all()                    # 보일지는 ask() 가 정한다 (창의 show_all 이 되살리지 않게)
        self.field.set_no_show_all(True)
        body.pack_start(self.field, False, False, 0)
        body.pack_start(self.entry2, False, False, 0)
        self.caps = authui.CapsWarning(self.entry, self.entry2)
        body.pack_start(self.caps, False, False, 0)
        self.choice = Gtk.CheckButton()
        self.choice.set_no_show_all(True)
        body.pack_start(self.choice, False, False, 0)
        self.msg = authui.Message()
        body.pack_start(self.msg, False, False, 0)

        foot, self.ok, self.cancel = authui.foot_buttons("열기", "취소")
        self.ok.connect("clicked", lambda *_: self.submit())
        self.cancel.connect("clicked", lambda *_: self.answer_cancel())
        card.pack_start(foot, False, False, 0)
        self.win.set_default(self.ok)
        self.win.connect("key-press-event", self._key)
        self.win.connect("delete-event", lambda *_: (self.answer_cancel(), True)[1])

    # ── 묻기 (PerformPrompt 마다) ──
    def ask(self, kind, props):
        self.kind = kind
        title = ko(props.get("title") or "") or "암호 저장소"
        req = _REQUESTER.match(title)
        self.sub.set_text(f"요청한 프로그램: {req.group(2)}" if req else "")
        self.sub.set_visible(bool(req))
        if req:
            title = "GPG 암호"
        self.win.set_title(title)
        self.head.get_children()[-1].set_text(title)
        message = ko(props.get("message") or "")
        desc = ko(props.get("description") or "")
        if not message:                          # 제목만 온 요청 — 제목을 큰 글자로
            message, desc = (desc, "") if desc and kind == "confirm" else (title, desc)
        self.message.set_text(authui.keep_words(message))
        self.desc.set_text(authui.keep_words(desc))
        self.desc.set_visible(bool(desc))
        warn = ko(props.get("warning") or "")
        self.warning.show_text(warn, "error")
        password = kind == "password"
        new = password and bool(props.get("password-new"))
        self.field.set_visible(password)
        self.entry.set_placeholder_text("새 암호" if new else "암호")
        self.entry2.set_visible(new)
        for e in (self.entry, self.entry2):
            e.clear()
        clabel = unmnemonic(ko(props.get("choice-label") or ""))
        self.choice.set_label(clabel)
        self.choice.set_active(bool(props.get("choice-chosen")))
        self.choice.set_visible(bool(clabel))
        self.ok.set_label(unmnemonic(ko(props.get("continue-label") or "")) or ("확인" if password else "계속"))
        self.cancel.set_label(unmnemonic(ko(props.get("cancel-label") or "")) or "취소")
        self.msg.show_text("")
        self.set_busy(False)
        first = not self.win.get_visible()
        self.win.show_all()
        if password:
            self.entry.grab_focus()
        else:
            self.ok.grab_focus()
        if warn and not first:
            self.win.attention()                 # 틀렸다 — 카드를 깜박인다

    def set_busy(self, on):
        """답을 보낸 뒤 — 부르는 쪽이 확인하는 동안 (맞으면 닫히고, 틀리면 다시 묻는다)"""
        self.busy = on
        self.field.set_busy(on)
        for w in (self.entry2, self.choice, self.ok, self.cancel):
            w.set_sensitive(not on)

    def _on_activate(self, e):
        if e is self.entry and self.entry2.get_visible() and not self.entry2.get_text():
            self.entry2.grab_focus()             # 새 암호 — 첫 칸에서 Enter 면 확인 칸으로
            return
        self.submit()

    def _key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.answer_cancel()
            return True
        return False

    def submit(self):
        if self.closed or self.busy or self.kind is None:
            return
        secret = None
        if self.kind == "password":
            secret = self.entry.get_text()
            if self.entry2.get_visible() and secret != self.entry2.get_text():
                self.entry2.set_text("")                 # (칸을 비우면 안내가 지워지므로 먼저)
                self.msg.show_text("두 암호가 다릅니다. 다시 입력하세요.")
                self.entry2.grab_focus()
                return
        self.set_busy(True)
        chosen = self.choice.get_active() if self.choice.get_visible() else False
        self.on_answer("yes", secret, chosen)
        for e in (self.entry, self.entry2):        # 보낸 암호를 칸에 남기지 않는다
            e.clear()

    def answer_cancel(self):
        if self.closed or self.busy or self.kind is None:
            return
        self.set_busy(True)
        self.win.hide()                          # 부르는 쪽이 StopPrompting 을 보내면 닫힌다
        self.on_answer("no", None, False)

    def close(self):
        if self.closed:
            return
        self.closed = True
        self.win.destroy()


# ═══ 프롬프터 ════════════════════════════════════════════════════
class Caller:
    """BeginPrompting 한 요청 하나 — (보낸 쪽 버스 이름, 콜백 경로)"""

    def __init__(self, sender, path):
        self.sender = sender
        self.path = path
        self.exchange = None
        self.received = False             # 부르는 쪽의 교환 문자열을 한 번이라도 받았나
        self.props = {}
        self.dialog = None
        self.watch = 0
        self.ready_busy = False           # PromptReady 를 보내는 중


class Prompter:
    def __init__(self):
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.callers = {}                 # (sender, path) → Caller
        self.waiting = []
        self.active = None
        self.names = 0                    # 가진 버스 이름 수
        self.quit_src = 0
        info = Gio.DBusNodeInfo.new_for_xml(XML)
        self.conn.register_object(PATH, info.interfaces[0], self._on_call, None, None)
        for n in BUS_NAMES:
            Gio.bus_own_name_on_connection(self.conn, n, Gio.BusNameOwnerFlags.NONE,
                                           self._name_acquired, self._name_lost)
        self._idle_later()

    # ── 버스 이름 ──
    def _name_acquired(self, _conn, name):
        dbg("이름 얻음", name)
        self.names += 1

    def _name_lost(self, _conn, name):
        # 다른 프롬프터(gcr-prompter 등)가 이미 있다 — 우리 것만 끝나면 그만둔다
        dbg("이름 못 얻음/잃음", name)
        if not self.callers:
            Gtk.main_quit()

    # ── 할 일이 없으면 끝내기 ──
    def _idle_later(self):
        if self.quit_src:
            GLib.source_remove(self.quit_src)
        self.quit_src = GLib.timeout_add_seconds(IDLE_QUIT, self._idle_quit)

    def _idle_quit(self):
        self.quit_src = 0
        if self.callers:
            return False
        dbg("할 일이 없어 끝낸다")
        Gtk.main_quit()
        return False

    # ── D-Bus 메서드 ──
    def _on_call(self, _conn, sender, _path, _iface, method, params, inv):
        try:
            if method == "BeginPrompting":
                self._begin(sender, params.unpack()[0], inv)
            elif method == "PerformPrompt":
                cb, kind, props, exchange = params.unpack()
                self._perform(sender, cb, kind, props, exchange, inv)
            elif method == "StopPrompting":
                self._stop(sender, params.unpack()[0], inv)
            else:
                inv.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
        except Exception as e:                    # 창 하나 때문에 프롬프터 전체가 죽지 않게
            dbg("처리 실패", method, repr(e))
            try:
                inv.return_dbus_error(ERR, str(e))
            except Exception:
                pass

    def _begin(self, sender, cb, inv):
        key = (sender, cb)
        if key in self.callers:
            inv.return_dbus_error(ERR, "Already begun prompting for this prompt callback")
            return
        c = Caller(sender, cb)
        self.callers[key] = c
        c.watch = Gio.bus_watch_name_on_connection(self.conn, sender, Gio.BusNameWatcherFlags.NONE,
                                                   None, lambda *_a, k=key: self._vanished(k))
        self.waiting.append(c)
        dbg("시작", sender, cb, "기다리는 수", len(self.waiting))
        inv.return_value(None)
        if self.quit_src:
            GLib.source_remove(self.quit_src)
            self.quit_src = 0
        self._next()

    def _perform(self, sender, cb, kind, props, exchange, inv):
        c = self.callers.get((sender, cb))
        if c is None or c is not self.active:
            inv.return_dbus_error(ERR, "Not the active prompt")
            return
        if kind not in ("password", "confirm"):
            inv.return_dbus_error(ERR, f"Unknown prompt type: {kind}")
            return
        if c.exchange is None or not c.exchange.receive(exchange):
            inv.return_dbus_error(ERR, "The exchange is invalid")
            return
        c.received = True
        c.props.update({k: v for k, v in props.items() if k in PROP_TYPES})
        dbg("묻기", kind, {k: v for k, v in c.props.items() if k in ("title", "message", "password-new")})
        inv.return_value(None)
        if c.dialog is None:
            c.dialog = PromptDialog(lambda reply, secret, chosen, c=c: self._answered(c, reply, secret, chosen))
        c.dialog.ask(kind, c.props)

    def _stop(self, sender, cb, inv):
        c = self.callers.get((sender, cb))
        inv.return_value(None)
        if c is not None:
            dbg("끝", sender, cb)
            self._drop(c, send_done=True)

    def _vanished(self, key):
        c = self.callers.get(key)
        if c is not None:
            dbg("부르는 쪽이 사라짐", key)
            self._drop(c, send_done=False)

    # ── 차례 ──
    def _next(self):
        if self.active is not None or not self.waiting:
            return
        c = self.waiting.pop(0)
        self.active = c
        c.exchange = Gcr.SecretExchange.new(None)
        self._send_ready(c, "", None, {})

    def _answered(self, c, reply, secret, chosen):
        if self.callers.get((c.sender, c.path)) is not c:
            return
        if "choice-label" in c.props or chosen:
            c.props["choice-chosen"] = bool(chosen)
        if secret is not None:
            c.props["password-strength"] = 1 if secret else 0
        self._send_ready(c, reply, secret, c.props)

    def _send_ready(self, c, reply, secret, props):
        # 처음(차례가 왔을 때)은 교환을 시작하고, 그다음부터는 받은 교환에 답한다 (암호가 있으면 암호화해서)
        ex = c.exchange.send(secret, -1) if c.received else c.exchange.begin()
        if ex is None:
            dbg("교환 문자열을 만들지 못함")
            self._drop(c, send_done=True)
            return
        d = {}
        for k, v in props.items():
            t = PROP_TYPES.get(k)
            if t is None or v is None:
                continue
            # gcr-prompter 가 보내는 모양 그대로 — 값이 variant 안의 variant
            d[k] = GLib.Variant("v", GLib.Variant(t, v))
        c.ready_busy = True
        self.conn.call(c.sender, c.path, CB_IFACE, "PromptReady", GLib.Variant("(sa{sv}s)", (reply, d, ex)),
                       None, Gio.DBusCallFlags.NO_AUTO_START, -1, None, self._ready_done, c)

    def _ready_done(self, conn, res, c):
        c.ready_busy = False
        try:
            conn.call_finish(res)
        except GLib.Error as e:
            dbg("PromptReady 실패 — 부르는 쪽이 사라졌다", e.message)
            self._drop(c, send_done=False)

    def _drop(self, c, send_done):
        key = (c.sender, c.path)
        if self.callers.get(key) is not c:
            return
        del self.callers[key]
        if c in self.waiting:
            self.waiting.remove(c)
        if c.watch:
            Gio.bus_unwatch_name(c.watch)
            c.watch = 0
        if c.dialog is not None:
            c.dialog.close()
            c.dialog = None
        if send_done:
            self.conn.call(c.sender, c.path, CB_IFACE, "PromptDone", None, None,
                           Gio.DBusCallFlags.NO_AUTO_START, -1, None, lambda *_: None)
        if self.active is c:
            self.active = None
        self._next()
        if not self.callers:
            self._idle_later()


def main():
    Gtk.init(sys.argv)
    Prompter()
    Gtk.main()


if __name__ == "__main__":
    main()
