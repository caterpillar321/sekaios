def _pattern(msgid):
    """"… “%s” …" → 정규식 (%s·%d 는 무엇이든)"""
    parts = re.split(r"%(?:\d\$)?[sd]", msgid)
    return re.compile("^" + "(.+?)".join(re.escape(p) for p in parts) + "$", re.S)


_PATS = [(_pattern(en), ko) for en, ko in KO_PATTERNS]
_catalogs = None


def _catalog_lookup(text):
    """gnome-keyring·gcr·GnuPG 자신의 한국어 번역에서 찾는다 (없으면 None)"""
    global _catalogs
    if _catalogs is None:
        _catalogs = []
        for dom in ("gnome-keyring", "gcr-4", "gcr", "gnupg2", "pinentry"):
            try:
                t = gettext.translation(dom, languages=["ko"])
            except OSError:
                continue
            cat = {k: v for k, v in getattr(t, "_catalog", {}).items() if isinstance(k, str) and k}
            fmt = [(_pattern(k), v) for k, v in cat.items() if re.search(r"%(?:\d\$)?[sd]", k)]
            _catalogs.append((cat, fmt))
    for cat, fmt in _catalogs:
        v = cat.get(text)
        if isinstance(v, str) and v:
            return v
        for pat, v in fmt:
            m = pat.match(text)
            if m and isinstance(v, str):
                args = iter(m.groups())
                try:
                    return re.sub(r"%(?:\d\$)?[sd]", lambda _m: next(args), v)
                except StopIteration:
                    return None
    return None


def plain(text):
    """gnome-keyring 은 설명에 마크업 이스케이프(&amp; 등)를 쓴다 — 보이는 글자로. 마크업이 아니면 그대로"""
    if not text or ("&" not in text and "<" not in text):
        return text or ""
    try:
        ok, _attrs, out, _accel = Pango.parse_markup(text, -1, "\0")
        return out if ok else text
    except GLib.Error:
        return text


def ko(text):
    """영어 문장을 알아보면 우리 말로 (이미 한국어이거나 모르면 그대로)"""
    t = plain(text).strip()
    if not t:
        return t
    if t in KO:
        return KO[t]
    # (한국어 검사보다 먼저 — 저장소 이름이 한글이면 영어 문장에도 한글이 들어 있다)
    for pat, out in _PATS:
        m = pat.match(t)
        if m:
            return out.format(*(LABELS.get(g, g) for g in m.groups()))
    if authui.is_korean(t):
        return t
    hit = _catalog_lookup(t)
    if hit:
        return hit
    if "\n" in t:                                 # 여러 줄(GPG 의 키 설명 등) — 줄마다
        return "\n".join(ko(line) for line in t.split("\n"))
    return t


def unmnemonic(text):
    """단추 이름의 단축키 표시를 뺀다 — "_Save …" → "Save …", "확인(_O)" → "확인" (pinentry 가 붙여 보낸다)"""
    text = re.sub(r"\s*\(_[^()\s]\)", "", text or "")
    return re.sub(r"_(.)", r"\1", text)


# pinentry 가 제목으로 보내는 "[pid]@호스트 (명령줄)" — 띠에는 짧게, 명령줄은 카드 안에 작게
_REQUESTER = re.compile(r"^\[(\d+)\]@\S+ \((.+)\)$", re.S)


# ═══ 창 ═════════════════════════════════════════════════════════
class PromptDialog:
    """사용자 계정 컨트롤과 같은 카드. 한 요청(콜백) 동안 열려 있다 — 암호가 틀리면 같은 창에 다시 묻는다"""

    def __init__(self, on_answer):
        self.on_answer = on_answer          # (답 "yes"|"no", 암호 또는 None, 고른 것 bool)
        self.closed = False
        self.busy = False
