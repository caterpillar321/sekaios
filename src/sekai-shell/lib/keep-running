#!/bin/sh
# SekaiOS — 셸 프로그램(패널·바탕화면)이 죽으면 다시 띄운다. 화면 서버가 살아 있는 동안만.
#   keep-running <명령> [인자…]
#   로그아웃으로 화면 서버가 사라지면 멈춘다 — 안 그러면 1초마다 다시 띄우며 세션이
#   끝나지 않아, 로그인 화면이 그 사용자를 "이미 로그인됨"으로 보고 다시 들어갈 수 없다.
alive() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        case "$WAYLAND_DISPLAY" in /*) s=$WAYLAND_DISPLAY ;; *) s="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/$WAYLAND_DISPLAY" ;; esac
        [ -S "$s" ]
    elif [ -n "${DISPLAY:-}" ]; then
        n=${DISPLAY#*:}; n=${n%%.*}
        [ -S "/tmp/.X11-unix/X$n" ]
    else
        return 1
    fi
}
#   끝난 코드가 75(EX_TEMPFAIL)면 "지금은 할 수 없다" — 1분 뒤에 다시 (에이전트: 다른 에이전트가 이미 있을 때.
#   곧바로 다시 띄우면 5초마다 GTK 를 새로 올리며 기록을 쌓았다)
fails=0
while alive; do
    started=$(date +%s)
    "$@" && exit 0
    if [ $? -eq 75 ]; then
        sleep 60
        continue
    fi
    # 계속 곧바로 죽으면 (설정 오류 등) 조금씩 더 기다린다.
    #   한동안(30초) 잘 돌다 죽은 것이면 처음부터 센다 — 안 그러면 몇 시간에 한 번씩 죽어도
    #   여섯 번째부터는 매번 5초씩 작업 표시줄이 비었다
    [ $(( $(date +%s) - started )) -ge 30 ] && fails=0
    fails=$((fails + 1))
    [ "$fails" -gt 5 ] && sleep 5 || sleep 1
done
