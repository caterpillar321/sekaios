#!/bin/sh
# ═══════════════════════════════════════════════════════════
#  SekaiOS 그래픽 세션 시작
#
#  tty1 에 로그인하면 ~/.bash_profile 이 이걸 exec 한다.
#  세션 환경은 전부 여기서 정한다 — 패키지가 관리하므로 업데이트가
#  기존 사용자에게도 그대로 전달된다. (.bash_profile 은 설치 때 한 번
#  복사되고 끝이라 거기 넣으면 갱신이 안 된다.)
# ═══════════════════════════════════════════════════════════

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# ── 언어 ────────────────────────────────────────────────
# 시스템 기본(/etc/default/locale)은 영어로 둔다. 텍스트 콘솔은 글자를 512개까지만
# 그릴 수 있어 한글이 깨지기 때문. 그래픽 세션에서만 사용자가 고른 언어를 쓴다.
#   설정: ~/.config/sekai/settings.json 의 locale.lang (기본 ko_KR.UTF-8)
SEKAI_LANG=$(python3 - 2>/dev/null <<'PY'
import json, os
try:
    d = json.load(open(os.path.expanduser("~/.config/sekai/settings.json")))
    print(d.get("locale", {}).get("lang", ""))
except Exception:
    pass
PY
)
[ -n "$SEKAI_LANG" ] || SEKAI_LANG=ko_KR.UTF-8
# 생성되지 않은 로캘이면 쓰지 않는다 (앱마다 경고를 쏟아낸다)
if locale -a 2>/dev/null | grep -qix "$(echo "$SEKAI_LANG" | sed 's/UTF-8/utf8/I')"; then
    export LANG="$SEKAI_LANG"
    case "$SEKAI_LANG" in
        ko_*) export LANGUAGE="ko:en" ;;
        ja_*) export LANGUAGE="ja:en" ;;
        *)    export LANGUAGE="${SEKAI_LANG%%_*}:en" ;;
    esac
fi

# ── 한글 입력기 (ibus) ──────────────────────────────────
#   네이티브 Wayland 앱은 입력기 프로토콜(input-method-v2)로 ibus 에 직접 붙는다.
#   GTK_IM_MODULE 은 일부러 비워 둔다 — 설정하면 GTK 앱이 Wayland 경로 대신
#   D-Bus 모듈로 붙어서 두 경로가 겹친다.
export XMODIFIERS=@im=ibus          # XWayland(X11) 앱
# Qt 6 앱: Wayland 입력 프로토콜을 먼저, 안 되면 ibus 모듈.
#   QT_IM_MODULE=ibus 는 넣지 않는다 — Wayland 모드 ibus 가 "환경 변수를 해제하라"는
#   경고 알림을 띄우고, Wayland 경로와 겹친다.
export QT_IM_MODULES="wayland;ibus"

# ── 로그인 화면이 같은 해상도로 뜨게 모니터 설정을 알려 둔다 ─────
#   로그인 화면(_greetd)은 내 홈을 못 읽으므로 공용 폴더에 monitor 줄만 적는다.
#   (sekai-greeter-session 이 형식을 엄격히 검사한 뒤에만 쓴다)
if [ -d /var/lib/sekai/displays ] && [ -f "$HOME/.config/hypr/sekai.conf" ]; then
    ( umask 022; { grep '^monitor = ' "$HOME/.config/hypr/sekai.conf"
      # 주 디스플레이 — 로그인 화면이 입력 칸을 거기에 띄운다
      python3 -c 'import json,os
p = (json.load(open(os.path.expanduser("~/.config/sekai/settings.json"))).get("layout") or {}).get("primary") or ""
print("# primary = " + p) if p else None' 2>/dev/null
    } > "/var/lib/sekai/displays/$(id -un).conf" 2>/dev/null ) || true
fi

# ── 하드웨어 보정 (VMware 등) ─────────────────────────────
. /usr/lib/sekai/hw-env.sh

# 출력은 파일로 — 안 그러면 로그인 직후 Hyprland 시작 로그가 화면에 잠깐 찍힌다
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/sekai"
mkdir -p "$LOGDIR"
# 설정 앱이 만드는 Hyprland 조각(~/.config/hypr/sekai.conf)을 지금의 기본값으로 다시 쓴다.
#   사용자가 바꾼 값은 settings.json 에 있어 그대로 남고, 바꾸지 않은 값은 업데이트로 바뀐
#   기본값(예: 최대화 여백 0)을 따르게 된다. 설정 앱을 한 번도 안 열었어도.
#   다크/라이트 모드도 일반 앱(gsettings·GTK 설정 파일)에 다시 맞춘다.
timeout 10 python3 -c 'from sekaisettings.store import Store
from sekaishell import theme
s = Store(); s.write_hypr_fragment(); theme.apply_system(theme.mode_of(s.get("appearance")))' \
    >/dev/null 2>&1 || true

# 그래픽 드라이버가 없으면(hw-env.sh 가 SEKAI_BASIC=1) 처음부터 기본 화면 모드(X11)
[ -n "${SEKAI_BASIC:-}" ] && exec /usr/lib/sekai/x11/start /usr/lib/sekai/x11/session
# Hyprland 가 시작하자마자(10초 안) 비정상으로 끝나면 — 드라이버 문제 — 기본 화면 모드로 다시
started=$(date +%s)
Hyprland >"$LOGDIR/session.log" 2>&1
rc=$?
if [ $rc -ne 0 ] && [ $(( $(date +%s) - started )) -lt 10 ]; then
    export SEKAI_BASIC=1 SEKAI_BASIC_REASON=crash
    exec /usr/lib/sekai/x11/start /usr/lib/sekai/x11/session
fi
# 로그아웃: 이 세션에서 띄운 것(패널·트레이 앱·입력기…)을 모두 정리해야 세션이 닫힌다.
#   데비안 기본값(KillUserProcesses=no)에선 남은 프로세스 때문에 세션이 "closing" 으로 남고,
#   로그인 화면이 그 사용자를 이미 로그인한 것으로 본다. (이 스크립트도 함께 끝난다)
[ -n "${XDG_SESSION_ID:-}" ] && loginctl terminate-session "$XDG_SESSION_ID" 2>/dev/null
exit $rc
