_apps_cache = {"t": 0, "apps": {}}


def apps_by_id():
    """시작 메뉴의 앱 목록을 id 로 (30초 동안 다시 읽지 않는다)"""
    if time.monotonic() - _apps_cache["t"] > 30:
        _apps_cache["apps"] = {a["id"]: a for a in load_apps()}
        _apps_cache["t"] = time.monotonic()
    return _apps_cache["apps"]


def launch_app_id(app_id):
    a = apps_by_id().get(app_id)
    if a:
        launch(a)
        return
    info = pins.app_info(app_id)                  # 시작 메뉴에 안 보이는 앱 (NoDisplay)
    if info is not None:
        try:
            info.launch([], None)
        except Exception:
            pass


def hypr_monitor_origins(hypr):
    """Hyprland 모니터 id → (x, y). 창이 어느 모니터에 있는지 Gdk 모니터와 맞춰 보려고"""
    return {m.get("id"): (m.get("x"), m.get("y")) for m in (hypr.query("monitors") or [])}


def primary_monitor():
    """주 디스플레이 — 설정(디스플레이 → 주 디스플레이로 사용)을 따른다"""
    return monitors.primary_gdk()


def focused_gdk_monitor(hypr):
    """Hyprland 에서 초점이 있는 모니터의 Gdk 모니터 (Win 키로 시작 메뉴를 열 때)"""
    disp = Gdk.Display.get_default()
    for m in hypr.query("monitors") or []:
        if m.get("focused"):
            for i in range(disp.get_n_monitors()):
                g = disp.get_monitor(i).get_geometry()
                if (g.x, g.y) == (m.get("x"), m.get("y")):
                    return disp.get_monitor(i)
    return primary_monitor()


class TaskbarMixin:
    """작업 버튼 — 주 작업 표시줄과 다른 모니터의 작업 표시줄이 함께 쓴다.

    필요한 속성: self.hypr, self.tasks(Gtk.Box), self.gdk_monitor (이 작업 표시줄의 모니터)
    윈도우 7 이후처럼 앱마다 아이콘 하나: 같은 앱의 창은 한 버튼으로 묶고, 아래 막대로 상태를 보인다
      (실행 중 = 짧은 막대, 초점 = 긴 강조색 막대). 창이 여럿이면 누를 때 창 목록.
    순서: 고정한 앱 → 고정 안 한 실행 중 앱 (처음 연 순서).
    모니터가 여럿이면 각 작업 표시줄에는 그 모니터에 있는 창만. 고정한 앱은 모든 작업 표시줄에.
    """

    _preview = None

    @property
    def preview(self):
        """창 미리보기 — 모든 작업 표시줄이 하나를 같이 쓴다"""
        if TaskbarMixin._preview is None:
            TaskbarMixin._preview = TaskPreview(self.hypr)
        return TaskbarMixin._preview

    def _hook_preview(self):
        if getattr(self, "_pv_hooked", False):
            return
        self._pv_hooked = True
        self.add_events(Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("leave-notify-event",
                     lambda _w, ev: ev.detail != Gdk.NotifyType.INFERIOR and self.preview.schedule_hide() and False)

    def _my_clients(self, clients):
        disp = Gdk.Display.get_default()
        if disp.get_n_monitors() < 2 or self.gdk_monitor is None:
            return clients
        g = self.gdk_monitor.get_geometry()
        origins = hypr_monitor_origins(self.hypr)
        return [c for c in clients if origins.get(c.get("monitor")) == (g.x, g.y)]

    def rebuild_tasks(self):
        self._hook_preview()
        for c in self.tasks.get_children():
            self.tasks.remove(c)
        clients = self._my_clients(self.hypr.query("clients") or [])
        clients = [c for c in clients if c.get("mapped", True) and c.get("address")]  # 연 순서
        active = self.hypr.query("activewindow") or {}
        active_addr = active.get("address") if isinstance(active, dict) else None

        groups = {}                                         # 묶음 키 → 창들
        order = []
        for c in clients:
            cls = c.get("class") or ""
            key = pins.app_id_for_class(cls) or ("class:" + cls.lower())
            if key not in groups:
                groups[key] = []
                order.append(key)
            groups[key].append(c)
        pinned = [pid for pid in pins.load() if pid in groups or pins.app_info(pid) is not None]
        for key in pinned + [k for k in order if k not in pinned]:
            self._app_button(key, groups.get(key, []), active_addr)
        self.tasks.show_all()
        return False

    def _app_button(self, key, wins, active_addr):
        app_id = None if key.startswith("class:") else key
        info = pins.app_info(app_id) if app_id else None
        name = info.get_display_name() if info else \
            ((wins[0].get("class") or "?") if wins else key)
        name = name[:1].upper() + name[1:]

        btn = Gtk.Button()
        ctx = btn.get_style_context()
        ctx.add_class("task-btn")
        ctx.add_class("app-btn")
        btn.set_valign(Gtk.Align.CENTER)
        if wins:
            ctx.add_class("running")
            if any(c.get("address") == active_addr for c in wins):
                ctx.add_class("active")
            elif all(self._minimized(c) for c in wins):
                ctx.add_class("minimized")
        if not wins:
            btn.set_tooltip_text(name)             # 창이 있으면 미리보기가 대신한다

        if info is not None and info.get_icon() is not None:
            img = Gtk.Image.new_from_gicon(info.get_icon(), Gtk.IconSize.DIALOG)
            img.set_pixel_size(24)
        else:
            img = app_icon((wins[0].get("class") if wins else None) or app_id or "", 24)
        btn.add(img)

        btn.connect("clicked", self.on_app_click, key, app_id, wins, active_addr)
        btn.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                       | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        if wins:
            btn.connect("enter-notify-event", lambda b, _e: self.preview.show_later(
                key, b, wins, active_addr, self._preview_pick, self._preview_close) and False)
        else:
            btn.connect("enter-notify-event", lambda *_: self.preview.schedule_hide() and False)
        btn.connect("leave-notify-event", lambda *_: self.preview.schedule_hide() and False)
        btn.connect("button-press-event", self.on_app_press, app_id, wins, name)
        self.tasks.pack_start(btn, False, False, 0)

    @staticmethod
    def _minimized(c):
        # 워크스페이스 id 가 음수 = 특수 워크스페이스 = 우리 기준 "최소화"
        return (c.get("workspace", {}) or {}).get("id", 0) < 0

    def on_app_click(self, btn, key, app_id, wins, active_addr):
        """윈도우 작업 표시줄과 같은 동작:
             창 없음     → 앱 실행
             창 하나     → 최소화됨: 복원 / 초점 있음: 최소화 / 그 외: 초점
             창 여럿     → 창 미리보기 (골라서 전환)"""
        if not wins:
            self.preview.hide_now()
            if app_id:
                launch_app_id(app_id)
            return
        if len(wins) > 1:
            self.preview.show_for(key, btn, wins, active_addr, self._preview_pick, self._preview_close)
            return
        self.preview.hide_now()
        self.activate_window(wins[0], active_addr)

    def _preview_pick(self, c):
        """미리보기에서 고름 — 최소화돼 있으면 복원, 아니면 초점 (초점이 있어도 최소화하지 않는다)"""
        if self._minimized(c):
            self.restore_window(c.get("address"))
        else:
            self.hypr.dispatch(f"focuswindow address:{c.get('address')}")
            GLib.timeout_add(120, self.rebuild_tasks)

    def _preview_close(self, c):
        self.hypr.dispatch(f"closewindow address:{c.get('address')}")

    def activate_window(self, c, active_addr):
        addr = c.get("address")
        if self._minimized(c):
            self.restore_window(addr)
        elif addr == active_addr:
            self.hypr.dispatch(f"movetoworkspacesilent special:min,address:{addr}")
        else:
            self.hypr.dispatch(f"focuswindow address:{addr}")
        GLib.timeout_add(120, self.rebuild_tasks)

    def restore_window(self, addr):
        """최소화(special:min)된 창을 지금 워크스페이스로 되돌리고 초점"""
        cur = self.hypr.query("activeworkspace") or {}
        wid = cur.get("id", 1)
        self.hypr.dispatch(f"movetoworkspace {wid},address:{addr}")
        self.hypr.dispatch(f"focuswindow address:{addr}")
        GLib.timeout_add(120, self.rebuild_tasks)

    # ── 우클릭 메뉴 (윈도우의 점프 목록처럼) · 가운데 클릭 = 새 창 ──
    def on_app_press(self, _w, ev, app_id, wins, name):
        if ev.button in (2, 3):
            self.preview.hide_now()
        if ev.button == 2:
            if app_id:
                launch_app_id(app_id)
            return True
        if ev.button != 3:
            return False
        m = Gtk.Menu()
        if app_id:
            it = Gtk.MenuItem(label=name if not wins else f"{name} — 새 창")
            it.connect("activate", lambda *_: launch_app_id(app_id))
            m.append(it)
            if pins.is_pinned(app_id):
                it = Gtk.MenuItem(label="작업 표시줄에서 고정 해제")
                it.connect("activate", lambda *_: pins.unpin(app_id))
            else:
                it = Gtk.MenuItem(label="작업 표시줄에 고정")
                it.connect("activate", lambda *_: pins.pin(app_id))
            m.append(it)
        if wins:
            if app_id:
                m.append(Gtk.SeparatorMenuItem())
            it = Gtk.MenuItem(label="창 닫기" if len(wins) == 1 else "모든 창 닫기")
            addrs = [c.get("address") for c in wins]
            it.connect("activate", lambda *_: [self.hypr.dispatch(f"closewindow address:{a}") for a in addrs])
            m.append(it)
        if not m.get_children():
            return True
        self._popup(m, ev)
        return True

    def _popup(self, menu, ev):
        menu.get_style_context().add_class("task-menu")
        menu.attach_to_widget(self, None)
        menu.show_all()
        menu.popup_at_pointer(ev)


class SecondaryPanel(Gtk.Window, TaskbarMixin):
    """주 모니터가 아닌 모니터의 작업 표시줄 — 시작 버튼, 그 모니터의 창, 시계 (윈도우 11 처럼).
