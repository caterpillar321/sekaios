# 창 주소 → 처음 본 순서. 작업 표시줄 단추는 연 순서로 둔다 — hyprctl clients 는 쌓임 순서라
#   창을 고를 때마다(맨 앞으로 올라오니) 바뀌어, 누르는 순간 단추가 자리를 바꿨다
_SEEN = {}
_SEEN_N = [0]


def _open_order(clients):
    live = {c.get("address") for c in clients}
    for a in [a for a in _SEEN if a not in live]:   # 닫힌 창 — 주소는 다시 쓰일 수 있다
        del _SEEN[a]
    for c in clients:
        a = c.get("address")
        if a and a not in _SEEN:
            _SEEN_N[0] += 1
            _SEEN[a] = _SEEN_N[0]
    return sorted(clients, key=lambda c: _SEEN.get(c.get("address"), 0))


