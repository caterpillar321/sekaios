        cb.set_valign(Gtk.Align.CENTER)
        self.clock = Gtk.Label(label="--:--", xalign=1)
        self.clock.get_style_context().add_class("clock-time")
        self.clock_date = Gtk.Label(label="", xalign=1)
        self.clock_date.get_style_context().add_class("clock-date")
