    ("파일",     ["sekai-files", "thunar"],                                 ["system-file-manager", "folder"]),
    ("웹",       ["google-chrome", "chromium", "firefox-esr"],             ["chromium", "web-browser"]),
    ("터미널",   ["kitty", "foot", "footclient"],                           ["utilities-terminal"]),
    ("메모장",   ["sekai-notepad", "org.xfce.mousepad"],                    ["accessories-text-editor"]),
    ("계산기",   ["sekai-calc", "galculator"],                              ["accessories-calculator"]),
    ("설정",     ["sekai-settings"],                                        ["preferences-system"]),
]


# 사용자 전환: 먼저 이 화면을 잠그고 로그인 화면으로 간다.
#   Wayland 의 sekai-lock 은 잠긴 뒤 곧바로 0 으로 끝난다 (swaylock -f 와 같은 약속).
#   X11 의 sekai-lock 은 xsecurelock 이 잠금이 풀릴 때까지 앞에서 돈다 → 뒤로 돌리고 잠시 뒤 전환.
#   lock-now: sekai-lock 이 실패하면 swaylock 으로 대신 잠그고, 잠금 프로그램이 죽으면 다시 띄운다.
#   (X11 은 잠긴 채 앞에서 돈다 — 전환은 sekai-switch-user 가 잠김을 직접 확인한 뒤에만 한다)
SWITCH_USER_CMD = ("/usr/libexec/sekai/lock-now && pkexec /usr/libexec/sekai/sekai-switch-user" if _layer.WAYLAND else
                   "/usr/libexec/sekai/lock-now & sleep 1.5; pkexec /usr/libexec/sekai/sekai-switch-user")


class StartMenu(Gtk.Window):
    W, H = 720, 600

    def __init__(self, hypr):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.hypr = hypr
        self.apps = []
        # 검색: 앱·설정·계산은 입력마다 바로, 파일은 작업 스레드에서 (도착하면 목록 끝에 붙는다)
        self.files = search.FileSearcher(self._files_arrived)
        self._usage = {}          # 앱 실행 횟수 (메뉴를 열 때 읽는다)
        self._preedit = ""        # 조합 중인 한글 — 아직 칸에 들어가지 않은 글자도 찾게
        self._refill_src = 0
        self._q = None            # 지금 보여 주는 검색어 (search.Query) — 없으면 모든 앱
        self._res = None
        self._best = None
        self._files_pending = False
        self.get_style_context().add_class("start-menu")
        make_translucent(self)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sekai-menu")      # 뒤를 흐리게 (hyprland layerrule)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.BOTTOM, 10)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, 10)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)
        self.set_size_request(self.W, self.H)

        self.catcher = ClickCatcher(self.close)
        self.other_catchers = []     # 다른 모니터를 눌러도 닫히게 (어둡게 하진 않는다)

        root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        root.get_style_context().add_class("menu-root")
        self.add(root)

        root.pack_start(self._build_rail(), False, False, 0)
        self.power_box = self._build_power()
        root.pack_start(self._build_applist(), False, False, 0)
        root.pack_start(self._build_tiles(), True, True, 0)

        self.connect("key-press-event", self.on_key)

    # ── 좌측 레일 ────────────────────────────────────────
    def _build_rail(self):
        rail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        rail.get_style_context().add_class("rail")

        mark = Gtk.DrawingArea()
        mark.set_size_request(24, 24)
        mark.connect("draw", self._draw_mark)
        mark.set_margin_top(6)
        mark.set_margin_bottom(16)
        rail.pack_start(mark, False, False, 0)

        def rail_btn(icons, tip, cb, cls=""):
            b = Gtk.Button()
            b.set_tooltip_text(tip)
            b.get_style_context().add_class("rail-btn")
            if cls:
                b.get_style_context().add_class(cls)
            b.add(icon_image(icons, 20))
            b.connect("clicked", lambda *_: cb())
            return b

        # 폴더는 인자 목록으로 넘긴다 — 문자열로 이으면 공백이 든 경로가 둘로 갈렸다
        def files_at(path):
            return shlex.split(sekai_conf("apps", "files", "sekai-files") or "sekai-files") + [path]

        rail.pack_start(rail_btn(["user-home-symbolic", "go-home-symbolic"],
                                 os.environ.get("USER", "user"),
                                 lambda: self._run(files_at(os.path.expanduser("~")))), False, False, 0)
        rail.pack_start(rail_btn(["folder-documents-symbolic", "folder-symbolic"],
                                 "문서",
                                 lambda: self._run(files_at(user_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS)))),
                        False, False, 0)
        rail.pack_start(rail_btn(["emblem-system-symbolic", "preferences-system-symbolic"],
                                 "설정",
                                 lambda: self._run("sekai-settings")), False, False, 0)

        self.power_btn = rail_btn(["system-shutdown-symbolic", "system-shutdown"],
                                  "전원", self._toggle_power, "rail-power")
        rail.pack_end(self.power_btn, False, False, 0)
        return rail

    # ── 가운데: 모든 앱 ──────────────────────────────────
    def _build_applist(self):
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        col.get_style_context().add_class("applist-col")
        col.set_size_request(320, -1)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("앱·설정·파일 검색")
        self.search.get_style_context().add_class("menu-search")
        # search-changed 는 150ms 늦게 온다 — changed 로 바로 (같은 차례의 변화는 한 번에 모아 그린다)
        self.search.connect("changed", lambda *_: self._queue_refill())
        self.search.connect("preedit-changed", self._on_preedit)
        self.search.connect("key-press-event", self._on_search_key)
        self.search.connect("activate", self.on_activate_first)
        self.search.connect("stop-search", lambda *_: self.close())
        col.pack_start(self.search, False, False, 0)

        lbl = Gtk.Label(label="모든 앱", xalign=0)
        lbl.get_style_context().add_class("section-title")
        col.pack_start(lbl, False, False, 0)
        self.list_title = lbl

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True)
        self.list_scroll = scroll
        self.listbox = Gtk.ListBox()
        self.listbox.get_style_context().add_class("app-list")
        self.listbox.set_header_func(self._letter_header, None)
        self.listbox.connect("row-activated", self.on_row)
        self.listbox.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.listbox.connect("button-press-event", self._row_menu)
        # 결과가 없을 때 (파일을 찾는 동안은 "검색 중…")
        self.empty_label = Gtk.Label(label="", xalign=0.5)
        self.empty_label.get_style_context().add_class("search-empty")
        self.empty_label.set_line_wrap(True)
        self.empty_label.set_max_width_chars(28)
        self.empty_label.show()
        self.listbox.set_placeholder(self.empty_label)
        scroll.add(self.listbox)
        col.pack_start(scroll, True, True, 0)
        return col

    def _letter_header(self, row, before, _d):
        """알파벳이 바뀌는 지점에 글자 머리표를 넣는다 (윈도우 10 방식)"""
        if not hasattr(row, "app"):
            return
        cur = index_letter(row.app["name"])
        prev = index_letter(before.app["name"]) if before is not None and hasattr(before, "app") else None
        if cur != prev:
            h = Gtk.Label(label=cur, xalign=0)
            h.get_style_context().add_class("letter-header")
            h.show_all()
            row.set_header(h)
        else:
            row.set_header(None)

    # ── 우측: 고정 타일 ──────────────────────────────────
    def _build_tiles(self):
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        col.get_style_context().add_class("tiles-col")

        lbl = Gtk.Label(label="고정됨", xalign=0)
        lbl.get_style_context().add_class("section-title")
        col.pack_start(lbl, False, False, 0)

        self.flow = Gtk.FlowBox()
        self.flow.get_style_context().add_class("tiles")
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_min_children_per_line(3)
        self.flow.set_max_children_per_line(3)
        self.flow.set_homogeneous(True)
        col.pack_start(self.flow, False, False, 0)

        return col

    def _build_power(self):
        """전원 메뉴 — 전원 버튼 옆에 뜨는 작은 메뉴 (윈도우 11 처럼)"""
        pop = Gtk.Popover()
        pop.set_relative_to(self.power_btn)
        pop.set_position(Gtk.PositionType.RIGHT)
        pop.get_style_context().add_class("power-pop")
        # 바로 뜨고 바로 닫힌다 — GTK3 팝오버의 여닫기 효과(150ms 동안 옮기며 흐려지기)는 GTK 가 매 프레임
        #   CPU 로 다시 그린다(그림자 흐림까지). 반투명·흐림 처리된 시작 메뉴 위라 실제 PC 에선 버벅였다
        pop.set_transitions_enabled(False)
        # 열려 있는 동안 전원 버튼의 "전원" 풍선 도움말이 메뉴에 겹쳐 떠 있지 않게
        pop.connect("show", lambda *_: self.power_btn.set_has_tooltip(False))
        pop.connect("closed", lambda *_: self.power_btn.set_has_tooltip(True))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        groups = (
            (("잠금",        "pw-lock",    "system-lock-screen-symbolic", lambda: subprocess.Popen(["/usr/libexec/sekai/lock-now"])),
             ("사용자 전환", "pw-switch",  "system-switch-user-symbolic",
              lambda: subprocess.Popen(["sh", "-c", SWITCH_USER_CMD])),
             ("로그아웃",    "pw-exit",    "system-log-out-symbolic",     lambda: self.hypr.dispatch("exit"))),
            (("절전",        "pw-suspend", "weather-clear-night-symbolic", lambda: subprocess.Popen(["systemctl", "suspend"])),
             ("다시 시작",   "pw-reboot",  "system-reboot-symbolic",      lambda: subprocess.Popen(["systemctl", "reboot"])),
             ("시스템 종료", "pw-off",     "system-shutdown-symbolic",    lambda: subprocess.Popen(["systemctl", "poweroff"]))),
        )
        for gi_, group in enumerate(groups):
            if gi_:
                sep = Gtk.Separator()
                sep.get_style_context().add_class("power-sep")
                box.pack_start(sep, False, False, 4)
            for label, cls, icon, action in group:
                b = Gtk.Button()
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                row.pack_start(icon_image([icon, "system-shutdown-symbolic"], 16), False, False, 0)
                row.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
                b.add(row)
                b.get_style_context().add_class("power-btn")
                b.get_style_context().add_class(cls)
                b.connect("clicked", lambda _w, a=action: (pop.popdown(), self.close(), a()))
                box.pack_start(b, False, False, 0)
        box.show_all()
        pop.add(box)
        return pop

    def _toggle_power(self):
        if self.power_box.get_visible():
            self.power_box.popdown()
        else:
            self.power_box.popup()

    # ── 동작 ─────────────────────────────────────────────
    def _run(self, cmd):
        """cmd: 명령 문자열 또는 인자 목록"""
        self.close()
        try:
            subprocess.Popen(cmd if isinstance(cmd, list) else shlex.split(cmd), start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def _draw_mark(self, widget, cr):
        a = widget.get_allocation()
        size = min(a.width, a.height)
        cr.translate((a.width - size) / 2, (a.height - size) / 2)
        draw_logo(cr, size)
        return False

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def close(self):
        self.power_box.hide()
        self.hide()
        self.catcher.hide()
        self.files.drop()             # 늦게 온 파일 결과는 버리고, 파일 색인도 놓는다
        for c in self.other_catchers:
            c.destroy()
        self.other_catchers = []

    def present_menu(self, monitor=None):
        if monitor is not None:
            GtkLayerShell.set_monitor(self, monitor)
            GtkLayerShell.set_monitor(self.catcher, monitor)
            disp = Gdk.Display.get_default()
            for i in range(disp.get_n_monitors()):
                m = disp.get_monitor(i)
                if m != monitor:
                    c = ClickCatcher(self.close, dim=False)
                    GtkLayerShell.set_monitor(c, m)
                    c.show_all()
                    self.other_catchers.append(c)
        self.apps = load_apps()
        self._usage = search.load_usage()
        self._preedit = ""
        self.search.set_text("")
        self.refill()
        self.fill_tiles()
        self.power_box.hide()
        self.catcher.show_all()
        self.show_all()
        self.power_box.hide()
        self.present()
        self.search.grab_focus()

    def _start_defaults(self):
        """고정 타일 기본값 → (id 목록, id → (짧은 이름, 아이콘)) — 설치된 것 중 후보 순서대로.
        시작 메뉴 고정(startpins)은 id 를 소문자로 적으므로 여기서도 소문자로"""
        by_id = {a["id"].lower(): a for a in self.apps}
        ids, labels = [], {}
        for label, cands, icons in DEFAULT_PINS:
            aid = next((c for c in cands if c in by_id), None)
            if aid and aid not in ids:
                ids.append(aid)
                labels[aid] = (label, icons[0])
        return ids, labels

    def fill_tiles(self):
        for c in self.flow.get_children():
            self.flow.remove(c)
        by_id = {a["id"].lower(): a for a in self.apps}      # 앱 id 는 파일 이름 그대로 — 대소문자 무시로 찾는다
        defaults, labels = self._start_defaults()
        for aid in startpins.load(defaults):
            app = by_id.get(aid.lower())
            if not app:
                continue                                     # 지운 앱
            label, icon = labels.get(aid.lower(), (app["name"], "application-x-executable"))
            btn = Gtk.Button()
            btn.get_style_context().add_class("tile")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            box.pack_start(icon_image(app["icon"] or icon, 32), False, False, 0)
            t = Gtk.Label(label=label)
            t.set_ellipsize(Pango.EllipsizeMode.END)
            t.set_max_width_chars(10)
            box.pack_start(t, False, False, 0)
            btn.add(box)
            btn.set_tooltip_text(app["name"])
            btn.connect("clicked", lambda _w, a=app: (self.close(), launch(a)))
            btn.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            btn.connect("button-press-event", lambda _w, ev, a=app: self._app_menu(a, ev))
            self.flow.add(btn)
        self.flow.show_all()

    # ── 검색 ─────────────────────────────────────────────
    GROUP_TITLES = {"best": "가장 일치하는 항목", "app": "앱", "setting": "설정", "file": "파일"}
    GROUP_MAX = {"app": 6, "setting": 4, "file": 6}

    def _query_text(self):
        """칸의 글 + 조합 중인 글자(커서 자리에) — ibus 는 조합이 끝나야 칸에 넣는다"""
        text = self.search.get_text()
        if self._preedit:
            pos = self.search.get_position()
            text = text[:pos] + self._preedit + text[pos:]
        return text

    def _on_preedit(self, _entry, pre):
        self._preedit = pre or ""
        self._queue_refill()

    def _queue_refill(self):
        """글자 확정(changed)과 조합 변화(preedit-changed)가 잇달아 와도 한 번만, 그리기 전에"""
        if not self._refill_src:
            self._refill_src = GLib.idle_add(self._idle_refill, priority=GLib.PRIORITY_HIGH_IDLE)

    def _idle_refill(self):
        self._refill_src = 0
        self.refill()
        return False

    def _flush_refill(self):
        """Enter·방향키가 밀린 다시 그리기보다 먼저 오면 옛 결과를 고르지 않게"""
        if self._refill_src:
            self.refill()

    def refill(self):
        if self._refill_src:
            GLib.source_remove(self._refill_src)
            self._refill_src = 0
        text = self._query_text()
        qo = search.Query(text) if text.strip() else None
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        self._q, self._res, self._best = qo, None, None
        self.list_scroll.get_vadjustment().set_value(0)
        ctx = self.listbox.get_style_context()
        if qo is not None:
            self.list_title.set_text("검색 결과")
            ctx.add_class("searching")
            self.listbox.set_header_func(self._group_header, None)
            self._res = search.find(qo, self.apps, self._usage)
            self._res["files"] = []
            self._files_pending = self.files.search(qo)
            self._render()
            return
        # 검색어가 없으면 모든 앱 (알파벳·초성 머리표)
        self.files.cancel()
        self._files_pending = False
        self.list_title.set_text("모든 앱")
        self.empty_label.set_text("")
        ctx.remove_class("searching")
        self.listbox.set_header_func(self._letter_header, None)
        for app in self.apps:
            row = Gtk.ListBoxRow()
            row.app = app
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.get_style_context().add_class("app-row")
            box.pack_start(icon_image(app["icon"], 24), False, False, 0)
            lbl = Gtk.Label(label=app["name"], xalign=0)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(lbl, True, True, 0)
            row.add(box)
            self.listbox.add(row)
        self.listbox.invalidate_headers()
        self.listbox.show_all()

    def _render(self):
        """윈도우처럼 묶어서: 가장 일치하는 항목 → 앱 → 설정 → 파일 (파일은 나중에 와서 붙기도 한다)"""
        res = self._res
        best = None
        if res["calc"] is not None:
            best = ("calc", res["calc"])             # 수식을 쳤으면 계산 결과가 원하는 것
        else:
            cands = []                               # (점수, 같을 때 앞설 순서, 종류, 항목)
            if res["apps"]:
                cands.append((res["apps"][0][0], 2, "app", res["apps"][0][1]))
            if res["settings"]:
                cands.append((res["settings"][0][0], 1, "setting", res["settings"][0][1]))
            if not cands and res["files"]:           # 앱·설정이 없을 때만 — 보던 맨 위가 바뀌지 않게
                cands.append((0, 0, "file", res["files"][0]))
            if cands:
                _s, _o, kind, item = max(cands, key=lambda c: (c[0], c[1]))
                best = (kind, item)
        self._best = best
        if best:
            self.listbox.add(self._result_row(best[0], best[1], "best"))
        for kind, items in (("app", [a for _s, a in res["apps"]]),
                            ("setting", [e for _s, e in res["settings"]]),
                            ("file", res["files"])):
            self._add_group(kind, items)
        self._update_empty()
        self.listbox.show_all()
        first = self.listbox.get_row_at_index(0)
        if first is not None:
            self.listbox.select_row(first)           # Enter 가 무엇을 열지 보이게

    def _add_group(self, kind, items):
        best = self._best[1] if self._best else None
        items = [it for it in items if it is not best][:self.GROUP_MAX[kind]]
        for it in items:
            self.listbox.add(self._result_row(kind, it, kind))

    def _files_arrived(self, qo, files):
        """작업 스레드의 파일 결과 (메인 루프에서). 검색어가 그새 바뀌었으면 버린다"""
        if qo is not self._q or self._res is None:
            return
        self._files_pending = False
        self._res["files"] = files
        if self._best is None and files:             # 아무것도 없던 목록 — 파일이 가장 일치하는 항목이 된다
            self._render()
            return
        self._add_group("file", files)
        self._update_empty()
        self.listbox.show_all()

    def _update_empty(self):
        q = self._q.raw if self._q is not None else ""
        self.empty_label.set_text("" if not q else "검색 중…" if self._files_pending
                                  else f"'{q}'에 대한 검색 결과가 없습니다")

    def _group_header(self, row, before, _d):
        """묶음이 바뀌는 곳에 제목 (가장 일치하는 항목 · 앱 · 설정 · 파일)"""
        g = getattr(row, "group", None)
        if g is None or (before is not None and getattr(before, "group", None) == g):
            row.set_header(None)
            return
        cur = row.get_header()
        if cur is not None and getattr(cur, "group", None) == g:
            return
        h = Gtk.Label(label=self.GROUP_TITLES.get(g, ""), xalign=0)
        h.group = g
        h.get_style_context().add_class("result-header")
        h.show_all()
        row.set_header(h)

    def _result_row(self, kind, item, group):
        best = group == "best"
        size = 32 if best else 24
        row = Gtk.ListBoxRow()
        row.kind, row.item, row.group = kind, item, group
        if kind == "app":
            row.app = item                           # 우클릭 메뉴(_row_menu)가 쓴다
            icon, title, sub = icon_image(item["icon"], size), item["name"], ("앱" if best else "")
        elif kind == "setting":
            icon = icon_image(list(item["icons"]) + ["preferences-system"], size)
            title, where = item["title"], item["sub"]
            sub = ("설정" + (f" › {where}" if where else "")) if best else where
        elif kind == "file":
            icon = self._file_icon(item, size)
            title = item["name"]
            parent, home = os.path.dirname(item["path"]), os.path.expanduser("~")
            if parent == home or parent.startswith(home + os.sep):
                parent = "~" + parent[len(home):]
            sub = f"{'폴더' if item['dir'] else '파일'} · {parent}" if best else parent
            row.set_tooltip_text(item["path"])
        else:                                        # calc
            icon = icon_image(["accessories-calculator", "galculator", "org.gnome.Calculator"], size)
            title = f"= {item}"
            sub = f"{self._q.raw if self._q else ''}  ·  Enter 로 결과 복사"
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.get_style_context().add_class("app-row")
        box.pack_start(icon, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text.set_valign(Gtk.Align.CENTER)
        t = Gtk.Label(label=title, xalign=0)
        t.set_ellipsize(Pango.EllipsizeMode.END)
        t.get_style_context().add_class("result-title")
        if best:
            t.get_style_context().add_class("best-title")
        text.pack_start(t, False, False, 0)
        if sub:
            s = Gtk.Label(label=sub, xalign=0)
            s.set_ellipsize(Pango.EllipsizeMode.MIDDLE if kind == "file" else Pango.EllipsizeMode.END)
            s.get_style_context().add_class("result-sub")
            text.pack_start(s, False, False, 0)
        box.pack_start(text, True, True, 0)
        row.add(box)
        if best:
            row.get_style_context().add_class("best-row")
        return row

    @staticmethod
    def _file_icon(item, size):
        img = Gtk.Image()
        img.set_pixel_size(size)
        gicon = None
        if not item["dir"]:
            ctype, _unsure = Gio.content_type_guess(item["name"], None)
            gicon = Gio.content_type_get_icon(ctype) if ctype else None
        if gicon is not None:
            img.set_from_gicon(gicon, Gtk.IconSize.MENU)
        else:
            img.set_from_icon_name("folder" if item["dir"] else "text-x-generic", Gtk.IconSize.MENU)
        return img

    def _on_search_key(self, _w, ev):
        """검색 칸에 초점을 둔 채 ↓/↑ 로 결과를 고른다 (계속 칠 수 있게)"""
        step = {Gdk.KEY_Down: 1, Gdk.KEY_KP_Down: 1, Gdk.KEY_Up: -1, Gdk.KEY_KP_Up: -1}.get(ev.keyval)
        if step is None:
            return False
        self._flush_refill()
        rows = self.listbox.get_children()
        if rows:
            cur = self.listbox.get_selected_row()
            i = rows.index(cur) + step if cur in rows else (0 if step > 0 else len(rows) - 1)
            row = rows[max(0, min(len(rows) - 1, i))]
            self.listbox.select_row(row)
            self._scroll_to(row)
        return True

    def _scroll_to(self, row):
        """고른 행(과 그 묶음 제목)이 보이게. 목록 상자는 자기 창이 있어 행 위치가 곧 내용 좌표다"""
        adj = self.list_scroll.get_vadjustment()
        a = row.get_allocation()
        top, bottom = a.y, a.y + a.height
        hdr = row.get_header()
        if hdr is not None and hdr.get_visible():
            top = min(top, hdr.get_allocation().y)
        if row.get_index() == 0:
            top = 0
        if top < adj.get_value():
            adj.set_value(top)
        elif bottom > adj.get_value() + adj.get_page_size():
            adj.set_value(bottom - adj.get_page_size())

    def _open_file(self, item):
        """파일은 기본 앱으로, 폴더는 설정한 파일 관리자로. 열 앱이 없으면 든 폴더를 연다"""
        fm = shlex.split(sekai_conf("apps", "files", "sekai-files") or "sekai-files")
        if item["dir"]:
            self._run(fm + [item["path"]])
            return
        self.close()
        try:
            Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(item["path"]).get_uri(), None)
        except GLib.Error as e:
            dbg("파일 열기 실패", item["path"], e)
            self._run(fm + [os.path.dirname(item["path"])])

    @staticmethod
    def _copy_text(text):
        """계산 결과를 클립보드로 — Wayland 는 메뉴가 닫혀도 남게 wl-copy, X11 은 패널이 계속 쥔다"""
        if _layer.WAYLAND:
            try:
                p = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
                p.stdin.write(text.encode())
                p.stdin.close()
            except OSError as e:
                dbg("wl-copy 실패", e)
        else:
            cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
            cb.set_text(text, -1)
            cb.store()

    def _row_menu(self, lb, ev):
        """앱 목록 우클릭"""
        if ev.button != 3:
            return False
        row = lb.get_row_at_y(int(ev.y))
        if row is None or not hasattr(row, "app"):
            return False
        return self._app_menu(row.app, ev)

    def _app_menu(self, app, ev):
        """앱 우클릭 메뉴 (목록·고정 타일 같이) — 열기 · 시작 메뉴 고정 · 작업 표시줄 고정 · 바탕 화면 바로 가기"""
        if ev.button != 3:
            return False
        aid = app["id"]
        defaults = self._start_defaults()[0]
        m = Gtk.Menu()
        it = Gtk.MenuItem(label="열기")
        it.connect("activate", lambda *_: (self.close(), launch(app)))
        m.append(it)
        m.append(Gtk.SeparatorMenuItem())
        if startpins.is_pinned(aid, defaults):
            it = Gtk.MenuItem(label="시작 메뉴에서 고정 해제")
            it.connect("activate", lambda *_: (startpins.unpin(aid, defaults), self.fill_tiles()))
        else:
            it = Gtk.MenuItem(label="시작 메뉴에 고정")
            it.connect("activate", lambda *_: (startpins.pin(aid, defaults), self.fill_tiles()))
        m.append(it)
        if pins.is_pinned(aid):
            it = Gtk.MenuItem(label="작업 표시줄에서 고정 해제")
            it.connect("activate", lambda *_: pins.unpin(aid))
        else:
            it = Gtk.MenuItem(label="작업 표시줄에 고정")
            it.connect("activate", lambda *_: pins.pin(aid))
        m.append(it)
        it = Gtk.MenuItem(label="바탕 화면에 바로 가기 만들기")
        it.set_sensitive(bool(app.get("path")))
        it.connect("activate", lambda *_: make_desktop_shortcut(app))
        m.append(it)
        popup_menu(m, self, ev)
        return True

    def on_row(self, _lb, row):
        kind = getattr(row, "kind", "app" if hasattr(row, "app") else None)
        if kind == "app":
            launch(row.app)
            self.close()
        elif kind == "setting":
            # 항목(볼륨·고정 IP …)이면 설정 앱이 그 줄을 찾아 보여 준다
            self._run(["sekai-settings", "--page=" + row.item["page"]] +
                      (["--item=" + row.item["title"]] if row.item.get("sub") else []))
        elif kind == "file":
            self._open_file(row.item)
        elif kind == "calc":
            self._copy_text(row.item)
            self.close()

    def on_activate_first(self, _entry):
        """Enter — 고른 결과, 없으면 첫 결과"""
        self._flush_refill()
        row = self.listbox.get_selected_row() or self.listbox.get_row_at_index(0)
        if row is not None:
            self.on_row(self.listbox, row)


