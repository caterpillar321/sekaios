def _locale_keys():
    """LANG=ko_KR.UTF-8 → ["ko_KR", "ko"]  (.desktop 의 Name[ko_KR], Name[ko] 순서로 찾는다)"""
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
            or os.environ.get("LANG") or "").split(".")[0].split("@")[0]
    keys = []
    if lang and lang not in ("C", "POSIX"):
        keys.append(lang)
        if "_" in lang:
            keys.append(lang.split("_")[0])
    return keys


LOCALE_KEYS = _locale_keys()


def localized(entry, key):
    for loc in LOCALE_KEYS:
        v = entry.get(f"{key}[{loc}]")
        if v:
            return v
    return entry.get(key, "")


# 한글 초성 — 윈도우처럼 한글 앱을 ㄱ ㄴ ㄷ … 으로 묶는다
CHOSEONG = "ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ"
CHOSEONG_GROUP = {"ㄲ": "ㄱ", "ㄸ": "ㄷ", "ㅃ": "ㅂ", "ㅆ": "ㅅ", "ㅉ": "ㅈ"}   # 된소리는 예사소리 칸에


def index_letter(name):
    """목록 머리글자: 영문은 A–Z, 한글은 초성, 그 밖(숫자·기호)은 #"""
    c = (name or "#")[:1]
    if "가" <= c <= "힣":
        ch = CHOSEONG[(ord(c) - 0xAC00) // 588]
        return CHOSEONG_GROUP.get(ch, ch)
    if c.isascii() and c.isalpha():
        return c.upper()
    return "#"


def sort_key(name):
    """정렬: 한글 → 영문 → 기타 (윈도우 한국어판과 같은 순서)"""
    c = (name or "")[:1]
    group = 0 if "가" <= c <= "힣" else (1 if c.isascii() and c.isalpha() else 2)
    return (group, name.lower())


# 모든 앱 목록에서 숨길 것 — 사용자가 직접 실행할 일이 없는 내부 구성요소
HIDDEN_APPS = {"foot-server", "footclient"}


def app_dirs():
    """앱(.desktop) 폴더 — XDG 규칙 순서 (앞 폴더의 같은 이름이 이긴다).
    XDG_DATA_HOME(~/.local/share) → XDG_DATA_DIRS. SekaiOS 는 XDG_DATA_DIRS 맨 앞에
    /usr/share/sekai/data 를 둬서 데비안 항목을 덮어쓴다 (kitty → sekai-terminal, foot-server 숨김 등).
    예전엔 세 폴더를 고정해 둬서 덮어쓰기를 무시했다 — 시작 메뉴 "터미널"이 설정 없는 맨 kitty 를 띄웠다."""
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    rest = os.environ.get("XDG_DATA_DIRS") or "/usr/share/sekai/data:/usr/local/share:/usr/share"
    out = []
    for d in [home] + rest.split(":"):
        d = os.path.join(d, "applications") if d else ""
        if d and d not in out:
            out.append(d)
    return out


# 지금 데스크톱 — Hyprland 세션은 "SekaiOS:Hyprland", 기본 화면 모드(X11, xfwm4)는 "SekaiOS"
CURRENT_DESKTOPS = [d for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d]


def shown_here(entry):
    """OnlyShowIn/NotShowIn — GIO(g_desktop_app_info_get_show_in)와 같은 규칙.
    지금 데스크톱을 앞에서부터 보며 OnlyShowIn 에 있으면 보이고 NotShowIn 에 있으면 숨는다.
    (Hyprland 에서 아무 효과 없는 xfwm4 설정(OnlyShowIn=XFCE)이 보였다)"""
    only = [x for x in entry.get("OnlyShowIn", "").split(";") if x]
    never = [x for x in entry.get("NotShowIn", "").split(";") if x]
    for d in CURRENT_DESKTOPS:
        if d in only:
            return True
        if d in never:
            return False
    return not only


def load_apps():
    dirs = app_dirs()
    apps, seen = [], set()
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop") or fn in seen:
                continue
            seen.add(fn)
            entry = {}
            try:
                with open(os.path.join(d, fn), encoding="utf-8", errors="replace") as f:
                    in_main = False
                    for line in f:
                        line = line.strip()
                        if line.startswith("["):
                            in_main = line == "[Desktop Entry]"
                            continue
                        if not in_main or "=" not in line:
                            continue
                        k, _, v = line.partition("=")
                        entry[k] = v
            except OSError:
                continue
            # 숨김 — 앞 폴더에서 숨긴 이름은 뒤 폴더의 같은 이름도 숨는다 (seen 에 먼저 넣었다)
            if entry.get("NoDisplay", "").lower() == "true" or entry.get("Hidden", "").lower() == "true":
                continue
            if not shown_here(entry):
                continue
            if fn[:-len(".desktop")].lower() in HIDDEN_APPS:
                continue
            if entry.get("Type", "Application") != "Application":
                continue
            name, exe = localized(entry, "Name"), entry.get("Exec")
            if not name or not exe:
                continue
            # %f %u %U %F %i %c %k 같은 필드 코드 제거
            exe = " ".join(t for t in exe.split() if not (len(t) == 2 and t[0] == "%"))
            apps.append({
                # 파일 이름 그대로 — Gio 는 데스크톱 id 의 대소문자를 가린다 (org.gnome.Evince).
                #   찾을 때는 대소문자를 가리지 않는다 (소문자로 적힌 예전 고정 목록도 찾게)
                "id": fn[:-len(".desktop")],
                "name": name,
                "exec": exe,
                "icon": entry.get("Icon", "application-x-executable"),
                "terminal": entry.get("Terminal", "").lower() == "true",
                "comment": localized(entry, "Comment"),
                "name_en": entry.get("Name", name),      # 영어 이름으로도 검색되게
                # 검색용 — 현지화한 것과 영어 것을 함께 (어느 말로 쳐도 찾게)
                "generic": list(dict.fromkeys(v for v in (localized(entry, "GenericName"),
                                                          entry.get("GenericName", "")) if v)),
                "keywords": list(dict.fromkeys(
                    k.strip() for k in (localized(entry, "Keywords") + ";" + entry.get("Keywords", "")).split(";")
                    if k.strip())),
                "path": os.path.join(d, fn),              # 바탕 화면 바로 가기를 만들 때 복사한다
            })
    apps.sort(key=lambda a: sort_key(a["name"]))
    return apps


def desktop_dir():
    """바탕 화면 폴더 — sekai-desk 가 보여 주는 곳과 같게 (xdg-user-dir DESKTOP, 없으면 ~/Desktop)"""
    try:
        p = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True,
                           text=True, timeout=2).stdout.strip()
    except Exception:
        p = ""
    if not p or p == os.path.expanduser("~"):
        p = os.path.expanduser("~/Desktop")
    os.makedirs(p, exist_ok=True)
    return p


def user_dir(kind):
    """사용자 폴더(문서 등) — xdg-user-dirs 가 정한 곳(한국어면 ~/문서). 없으면 홈.
    ~/Documents 로 고정해 두어 한국어 사용자에겐 없는 폴더를 열었다."""
    GLib.reload_user_special_dirs_cache()           # 패널이 뜬 뒤에 폴더 이름이 바뀌었을 수 있다 (OOBE 언어)
    p = GLib.get_user_special_dir(kind)
    return p if p and os.path.isdir(p) else os.path.expanduser("~")


def make_desktop_shortcut(app):
    """시작 메뉴 → 바탕 화면에 바로 가기: 앱의 .desktop 파일을 바탕 화면 폴더에 복사.
    같은 이름이 있으면 덮어쓰지 않는다 (내용이 같으면 이미 있는 것, 다르면 이름-2 …).
    실행 권한과 신뢰 표시(metadata::trusted)를 붙인다 — 파일 탐색기에서 열어도 묻지 않게."""
    src = app.get("path")
    if not src:
        return
    try:
        with open(src, "rb") as f:
            data = f.read()
        ddir = desktop_dir()
    except OSError as e:
        dbg("바로 가기 만들기 실패", e)
        return
    base = os.path.basename(src)
    stem = base[:-len(".desktop")] if base.endswith(".desktop") else base
    dst, n = os.path.join(ddir, base), 2
    while os.path.lexists(dst):
        try:
            with open(dst, "rb") as f:
                if f.read() == data:
                    return                                  # 이미 있다
        except OSError:
            pass
        dst = os.path.join(ddir, f"{stem}-{n}.desktop")
        n += 1
    try:
        with open(dst, "xb") as f:                          # 새로 만들 때만 (그사이 생긴 파일을 덮지 않게)
            f.write(data)
        os.chmod(dst, 0o755)
    except OSError as e:
        dbg("바로 가기 만들기 실패", e)
        return
    try:
        subprocess.Popen(["gio", "set", dst, "metadata::trusted", "true"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def launch(app):
    search.note_launch(app.get("id"))             # 시작 메뉴 검색에서 자주 여는 앱을 앞으로
    cmd = app["exec"]
    if app.get("terminal"):
        cmd = f"sekai-terminal -e {cmd}"
    # foot 은 Wayland 전용 — 기본 화면 모드(X11)에서는 X 용 터미널로
    if cmd.split()[:1] in (["foot"], ["footclient"]):
        cmd = "sekai-terminal" + cmd[len(cmd.split()[0]):]
    try:
        subprocess.Popen(shlex.split(cmd), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


# 요일 — 로캘에 기대지 않는다 (세션 로캘이 영어여도 한국어로)
WEEKDAYS = ["월", "화", "수", "목", "금", "토", "일"]


def korean_date(t=None, weekday_long=False):
    t = t or time.localtime()
    wd = WEEKDAYS[t.tm_wday] + ("요일" if weekday_long else "")
    return f"{t.tm_mon}월 {t.tm_mday}일 ({wd})" if not weekday_long else f"{t.tm_mon}월 {t.tm_mday}일 {wd}"


def icon_image(names, size):
    """names 는 문자열 또는 후보 목록. 처음 찾아지는 것을 쓴다."""
    if isinstance(names, str):
        names = [names]
    img = Gtk.Image()
    img.set_pixel_size(size)
    theme = Gtk.IconTheme.get_default()
    for n in names:
        if not n:
            continue
        if n.startswith("/") and os.path.exists(n):
            img.set_from_file(n)
            return img
        if theme.has_icon(n):
            img.set_from_icon_name(n, Gtk.IconSize.MENU)
            return img
    img.set_from_icon_name("application-x-executable", Gtk.IconSize.MENU)
    return img


