    # ── 알림 버튼 표시 ──────────────────────────────────
    def _on_noti_count(self, unread, total, dnd):
        ctx = self.noti_btn.get_style_context()
        (ctx.add_class if dnd else ctx.remove_class)("dnd")
        (ctx.add_class if unread else ctx.remove_class)("unread")
        self.noti_icon.set_from_icon_name(
            "notifications-disabled-symbolic" if dnd else "notifications-symbolic",
            Gtk.IconSize.MENU)
        if unread and not dnd:
            self.noti_badge.set_text(str(min(unread, 99)))
            self.noti_badge.show()
        else:
            self.noti_badge.hide()
        self.noti_btn.set_tooltip_text(
            "방해 금지" if dnd else
            (f"읽지 않은 알림 {unread}개" if unread else f"알림 {total}개"))
        qs = getattr(self, "qs", None)            # 알림 센터·설정 앱에서 바꾼 방해 금지를 빠른 설정 타일에도
        if qs is not None:
            qs.sync_dnd()

    # ── 빠른 설정 · 알림 센터 · 시작 메뉴 — 한 번에 하나만 ──
    #   팝업 바깥은 클릭 캐처가 덮으므로 마우스로는 겹칠 수 없다. 단축키(Win+A·Win+N·Win)로 열 때 서로 닫는다
    def toggle_quick_settings(self):
        """Win+A (sekai-ctl quicksettings) — 주 모니터의 작업 표시줄 위에"""
        self.qs.toggle(self.gdk_monitor)

    def _close_for_qs(self):
        if self.menu.get_visible():
            self.menu.close()
        c = getattr(self.notifications, "center", None)
        for p in (c, getattr(self, "cal_popup", None)):
            if p is not None and p.get_visible():
                p.close()

    def toggle_center(self):
        """알림 센터 (알림 데몬이 없으면 달력)"""
        c = getattr(self.notifications, "center", None) or self.cal_popup
        if not c.get_visible():
            self.qs.close()
            if self.menu.get_visible():
                self.menu.close()
        c.toggle()

    # ── 음량 (작업 표시줄 아이콘 위 휠) — 슬라이더는 빠른 설정에 ──
    def _on_vol_scroll(self, _w, ev):
        """휠 한 칸 = 5%. 터치패드는 작은 dy 를 초당 수십 번 보낸다 — 모아서 1.0 마다 한 칸
        (이벤트마다 5% 로 치면 살짝 쓸어도 100% 로 튀었다). 한 이벤트는 많아야 한 칸 (휠 한 칸의 dy 가 1.5 여도)"""
        steps = 0
        if ev.direction == Gdk.ScrollDirection.UP:
            steps = 1
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            steps = -1
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, _dx, dy = ev.get_scroll_deltas()
            d = max(-1.0, min(1.0, -dy))
            acc = getattr(self, "_vol_acc", 0.0)
            if acc * d < 0:
                acc = 0.0                          # 방향을 바꿨다 — 반대쪽 나머지는 버린다
            acc += d
            steps = int(acc + (1e-6 if acc > 0 else -1e-6))   # 0 쪽으로 자른다 (0.1 열 번이 0.999… 여도 한 칸)
            self._vol_acc = acc - steps
            try:
                if ev.is_scroll_stop_event():      # 손가락을 뗐다
                    self._vol_acc = 0.0
            except AttributeError:
                pass
        if steps:
            self._step_volume(steps * 5)
        return True

    def _step_volume(self, delta):
        """휠 음량 — 빠른 설정의 슬라이더(LastValue)처럼 wpctl 은 한 번에 하나만. 도는 동안 온 칸은 모았다가
        끝난 뒤 한 번에 (이벤트마다 띄우면 wpctl 이 이벤트 수만큼 쌓였다)"""
        self._vol_delta = getattr(self, "_vol_delta", 0) + delta
        if getattr(self, "_vol_stepping", False) or not self._vol_delta:
            return
        d, self._vol_delta = self._vol_delta, 0
        self._vol_stepping = True

        def done(_out):
            self._vol_stepping = False
            if self._vol_delta:
                self._step_volume(0)
            else:
                self.refresh_sys(0)
        run_limited(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@",
                     f"{abs(d)}%{'+' if d > 0 else '-'}"], done)

    # ── 달력 팝업 ───────────────────────────────────────
    def _build_cal_popup(self):
        pop = PanelPopup(GtkLayerShell.Edge.RIGHT, margin=10)
        box = pop.root
        box.set_spacing(10)
        box.set_size_request(300, -1)

        self.cal_date = Gtk.Label(xalign=0)
        self.cal_date.get_style_context().add_class("pop-title")
        box.pack_start(self.cal_date, False, False, 0)
        self.cal_year = Gtk.Label(xalign=0)
        self.cal_year.get_style_context().add_class("pop-subtitle")
        box.pack_start(self.cal_year, False, False, 0)

        self.calendar = Gtk.Calendar()
        self.calendar.get_style_context().add_class("calendar")
        box.pack_start(self.calendar, False, False, 0)

        today = Gtk.Button(label="오늘")
        today.get_style_context().add_class("pop-btn")
        today.set_halign(Gtk.Align.END)
        today.connect("clicked", lambda *_: self._cal_today())
        box.pack_start(today, False, False, 0)

        pop.on_open = self._cal_today
        return pop

    def _cal_today(self):
        t = time.localtime()
        self.calendar.select_month(t.tm_mon - 1, t.tm_year)
        self.calendar.select_day(t.tm_mday)
        self.cal_date.set_text(korean_date(t, weekday_long=True))
        self.cal_year.set_text(f"{t.tm_year}년")

    # ── 워크스페이스 ────────────────────────────────────
    def rebuild_workspaces(self):
        # 작업 표시줄에서는 제거됨. 별도 워크스페이스 UI 에서 재사용 예정.
        if not hasattr(self, "wsbox"):
            return False
        for c in self.wsbox.get_children():
            self.wsbox.remove(c)
        wss = self.hypr.query("workspaces") or []
        active = (self.hypr.query("activeworkspace") or {}).get("id")
        used = {w["id"] for w in wss if w.get("windows", 0) > 0 and w.get("id", 0) > 0}
        for i in range(1, 6):
            b = Gtk.Button(label=str(i))
            ctx = b.get_style_context()
            ctx.add_class("ws-btn")
            if i == active:
                ctx.add_class("active")
            elif i in used:
                ctx.add_class("used")
            b.connect("clicked", lambda _w, n=i: self.hypr.dispatch(f"workspace {n}"))
            self.wsbox.pack_start(b, False, False, 0)
        self.wsbox.show_all()
        return False

    def draw_logo(self, widget, cr):
        a = widget.get_allocation()
        size = min(a.width, a.height)
        cr.translate((a.width - size) / 2, (a.height - size) / 2)
        draw_logo(cr, size)
        return False

    def toggle_menu(self, *_, monitor=None):
        """monitor: 그 모니터의 시작 버튼을 눌렀을 때. 없으면(Win 키) 초점이 있는 모니터에"""
        if self.menu.get_visible():
            self.menu.close()
        else:
            self.qs.close()                  # 빠른 설정과 같이 열리지 않게
            if monitor is None:
                monitor = focused_gdk_monitor(self.hypr)
            self.menu.present_menu(monitor)  # None 이면 모니터를 정하지 않는다

    # ── Hyprland 이벤트 ──
    def on_hypr_event(self, name, _arg):
        for fn in self.event_hooks:
            try:
                fn(name, _arg)
            except Exception as e:
                dbg("이벤트 훅 오류", name, e)
        # 초점 창의 제목·클래스만 바뀌어도 Hyprland 는 activewindow(v2) 를 다시 보낸다 — 같은 창이면
        #   초점이 옮겨 간 게 아니다. (activewindow 는 늘 v2 와 함께 오므로 v2 만 본다.
        #   X11 흉내는 주소 없이 보낸다 — 그땐 옮겨 간 것으로 본다)
        same_focus = (name == "activewindowv2" and bool(_arg.strip())
                      and "0x" + _arg.strip() == getattr(self, "_last_active", None))
        # 폴백: 사용자가 다른 창을 클릭하면 포커스 이벤트가 온다 → 메뉴 닫기
        if name in ("activewindowv2", "openwindow") and not same_focus and self.menu.get_visible():
            GLib.idle_add(self.menu.close)
        if name in ("windowtitle", "windowtitlev2") or same_focus:
            # 제목만 바뀌었다 — 버튼은 아이콘뿐이라 다시 만들지 않고 제목을 쓰는 곳(미리보기)만 고친다.
            #   제목이 계속 바뀌는 창(터미널·웹 페이지)이 있으면 누르고 떼는 사이에 버튼이 새로 만들어져 클릭이 씹혔다
            self.queue_title_refresh()
        elif name in ("openwindow", "closewindow", "activewindowv2",
                      "movewindow", "movewindowv2",
                      "workspace", "activespecial", "fullscreen", "changefloatingmode",
                      "focusedmon", "moveworkspace", "monitoradded", "monitorremoved"):
            # 창 하나를 열거나 옮기면 이벤트가 여럿 한꺼번에 온다 — 모아서 한 번에.
            self.queue_rebuild_all(50)

    def queue_title_refresh(self, delay=250):
        """창 제목 바뀜을 모은다 — 이미 걸려 있으면 그대로 둔다"""
        if not getattr(self, "_title_src", 0):
            self._title_src = GLib.timeout_add(delay, self._refresh_titles)

    def _refresh_titles(self):
        """버튼이 쥔 창 정보의 제목을 제자리에서 고치고, 떠 있는 미리보기 카드의 제목도 고친다.
        창이 사라졌거나 클래스가 바뀌었으면(묶음이 달라진다) 그때만 다시 만든다."""
        self._title_src = 0
        now = {c.get("address"): c for c in self.hypr.query("clients") or []}
        for p in [self] + self.others:
            for _btn, wins in getattr(p, "_task_btns", {}).values():
                for c in wins:
                    n = now.get(c.get("address"))
                    if n is None or (n.get("class") or "") != (c.get("class") or ""):
                        self.queue_rebuild_all(50)
                        return False
                    if n.get("title") != c.get("title"):
                        c["title"] = n.get("title")     # 버튼·미리보기가 같은 dict 를 쥐고 있다
                        self.preview.update_title(c)
        return False

    def queue_rebuild_all(self, delay=50):
        """작업 표시줄 다시 그리기를 모은다. 이미 걸려 있으면 더 이른 쪽만 남긴다."""
        due = GLib.get_monotonic_time() + delay * 1000
        if getattr(self, "_rebuild_src", 0):
            if due >= self._rebuild_due:
                return
            GLib.source_remove(self._rebuild_src)
        self._rebuild_due = due
        self._rebuild_src = GLib.timeout_add(delay, self._rebuild_due_now)

    def _rebuild_due_now(self):
        self._rebuild_src = 0
        return self.rebuild_all_tasks()

    def rebuild_all_tasks(self):
        if getattr(self, "_rebuild_src", 0):        # 곧 할 것을 지금 했다
            GLib.source_remove(self._rebuild_src)
            self._rebuild_src = 0
        snap = self.task_snapshot()                 # Hyprland 조회는 한 번 — 모든 작업 표시줄이 같이 쓴다
        self._last_active = snap["active"]          # 초점이 정말 옮겨 갔는지 가리려고 (on_hypr_event)
        self.rebuild_tasks(snap)
        for p in self.others:
            p.rebuild_tasks(snap)
        return False

    def sync_monitors(self):
        """모니터마다 작업 표시줄 — 주 모니터 말고는 SecondaryPanel"""
        for p in self.others:
            p.destroy()
        self.others = []
        disp = Gdk.Display.get_default()
        prim = primary_monitor()
        if prim is not None and prim != self.gdk_monitor:
            self.gdk_monitor = prim
            GtkLayerShell.set_monitor(self, prim)
        if not self.get_visible():              # 그 모니터가 빠져 레이어가 닫혔다 — 주 모니터에 다시
            self.show()
        for i in range(disp.get_n_monitors()):
            m = disp.get_monitor(i)
            if m != self.gdk_monitor:
                p = SecondaryPanel(self.hypr, m, self)
                p.show_all()
                self.others.append(p)
        self.rebuild_all_tasks()
        # 지금 모니터 모드를 부팅 옵션용으로 알린다 (monitors.publish_modes) — 모드가 자리 잡은 뒤에.
        #   예전 화면 설정(단자 이름)은 지금 꽂힌 모니터의 설정으로 옮긴다 (monitors.migrate_display_keys)
        if _layer.WAYLAND:
            GLib.timeout_add(2500, lambda: (monitors.publish_modes(), monitors.migrate_display_keys()) and False)
        return False

    # ── 시스템 정보 ──
    def tick_clock(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(
            sekai_conf("panel", "clock_format", "%H:%M") or "%H:%M", t))
        self.clock_date.set_text(korean_date(t))
        self.clock_btn.set_tooltip_text(time.strftime("%Y년 ", t) + korean_date(t, True))
        return True

    def refresh_sys(self, delay=150):
        """음량을 바꾼 직후 한 번 새로 읽기 — 1회용. 이미 걸려 있으면 다시 걸지 않는다.
        (update_sys 는 5초 반복 타이머라 True 를 돌려준다 — 그대로 timeout_add 에 걸면 영원히 반복됐다)"""
        if getattr(self, "_sys_src", 0):
            return

        def go():
            self._sys_src = 0
            self.update_sys()
            return False
        self._sys_src = GLib.timeout_add(delay, go)

    def update_sys(self):
        """5초마다 (반복 타이머 — True) — 볼륨 아이콘. 조회는 기다리지 않는다 (query_volume)"""
        if not getattr(self, "_sys_busy", False):
            self._sys_busy = True                # wpctl 이 멈춰 있으면 새로 띄우지 않는다 (쌓이지 않게)
            query_volume(self._apply_sys)
        return True

    def _apply_sys(self, r):
        self._sys_busy = False
        # 음량 — 아이콘 묶음과 (열려 있으면) 빠른 설정의 슬라이더
        self.qs.show_volume(r)


# ───────────────────────────────────────────────────────────────
def main():
    import signal

    # style.css 는 @accent / @bg / @surface / @fg 를 쓴다.
    # 그 정의는 설정 파일에서 읽어 앞에 붙인다.
    css_paths = (os.path.join(HERE, "style.css"),
                 "/usr/share/sekai-shell/style.css")
    css_holder = {"prov": None}

    def load_css():
        refresh_logo_colors()
        body = ""
        for path in css_paths:
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    body = f.read()
                break
        # 사용자가 직접 덧붙이고 싶을 때
        if not _layer.WAYLAND:
            # 기본 화면 모드(X11)엔 뒤를 흐리는 효과가 없다 — 반투명 면을 거의 불투명하게
            body = body.replace("alpha(@surface, 0.86)", "alpha(@surface, 0.97)")
        user = os.path.expanduser("~/.config/sekai/panel.css")
        if os.path.exists(user):
            with open(user, encoding="utf-8") as f:
                body += "\n" + f.read()
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data((css_prelude() + body).encode())
        except Exception as e:
            dbg("CSS 오류:", e)
            return
        if css_holder["prov"] is not None:
            Gtk.StyleContext.remove_provider_for_screen(
                Gdk.Screen.get_default(), css_holder["prov"])
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        css_holder["prov"] = prov

    load_css()

    # 다크/라이트 모드 — 아이콘 테마(어두운 바탕엔 Papirus-Dark, 밝은 바탕엔 Papirus)와 GTK 다크 여부
    from sekaishell import theme as _theme

    def apply_mode():
        _theme.apply_gtk_settings(Gtk.Settings.get_default(),
                                  _theme.mode_of(sekai_settings().get("appearance", {})))
    apply_mode()

    # Wayland(Hyprland) 이면 IPC 소켓, X11 기본 화면 모드면 libwnck 로 흉내
    if _layer.WAYLAND:
        hypr = Hypr()
    else:
        from sekaishell.wm import X11Hypr
        hypr = X11Hypr()
    panel = Panel(hypr)
    panel.show_all()
    # 모니터마다 작업 표시줄 — 꽂고 뺄 때도 다시 맞춘다
    panel.sync_monitors()
    if monitors.primary_name() and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        # 주 디스플레이를 골라 두었으면 로그인 직후 초점(새 창이 뜨는 곳)을 그리로
        hypr.dispatch(f"focusmonitor {monitors.primary_hypr_name()}")
    _mon_src = {"id": 0}

    def _monitors_changed(*_):
        if _mon_src["id"]:
            GLib.source_remove(_mon_src["id"])

        def go():
            _mon_src["id"] = 0
            return panel.sync_monitors()
        _mon_src["id"] = GLib.timeout_add(600, go)
    Gdk.Display.get_default().connect("monitor-added", _monitors_changed)
    Gdk.Display.get_default().connect("monitor-removed", _monitors_changed)
    pins.on_change(lambda: panel.queue_rebuild_all(0))

    # ── 창 전환기 · OSD · 클립보드 · 창 배치 — org.sekai.Shell 로 부른다 (sekai-ctl) ──
    switcher = Switcher(hypr, on_restore=panel.restore_window)
    osd = Osd(bottom_margin=int(sekai_conf("panel", "height", PANEL_HEIGHT)) + 24)
    clip = ClipboardPopup(hypr)
    clip.set_panel_height(int(sekai_conf("panel", "height", PANEL_HEIGHT)))
    wm = WindowManager(hypr)
    if _layer.WAYLAND:
        # 끌어서 스냅 미리보기 (X11 기본 화면 모드에선 xfwm4 가 가장자리 스냅을 직접 한다)
        from sekaishell.snappreview import SnapPreview
        from sekaishell.snapassist import SnapAssist
        wm.preview = SnapPreview()
        wm.assist = SnapAssist(wm)            # 스냅한 뒤 남은 칸에 둘 창 고르기
        from sekaishell.snaplayouts import TopLayoutBar
        wm.topbar = TopLayoutBar()            # 위쪽 가운데로 끌면 내려오는 레이아웃 바
        # (최대화 버튼에 마우스를 올리면 뜨던 배치 그림은 없앴다 — 위쪽 레이아웃 바와 겹쳐 방해됐다)
    panel.event_hooks.append(wm.on_event)

    # 음량 키 — OSD 가 작업 스레드에서 바꾸고, 끝나면 작업 표시줄 아이콘도 새로
    osd.on_volume = lambda: panel.refresh_sys(0)

    def volume(action):
        osd.volume(action)

    # 가상 데스크톱 — 바꾸면 화면 가운데에 이름 (윈도우 11 처럼). 일은 desktops.py 가 hyprctl 로
    desk_osd = DesktopOsd()
    if not _layer.WAYLAND:
        # 기본 화면 모드: 세션은 기본 단축키 파일로 sxhkd 를 띄운다 — 설정 › 단축키 에서 바꾼 것이
        #   있으면(~/.config/sekai/sxhkdrc) 그것으로 다시 띄운다
        from sekaishell import keybinds
        GLib.timeout_add_seconds(2, lambda: keybinds.restart_sxhkd(only_if_needed=True) and False)

    def desktop(action, arg=""):
        text = desktops.handle(action, arg)
        if text:
            desk_osd.show_name(text, focused_gdk_monitor(hypr), note=isinstance(text, desktops.Note))

    panel.updates = UpdateNotifier()
    panel.gpuhint = GpuHint()

    panel.shell = ShellService({
        "Switch": switcher.step,
        "SwitchCommit": switcher.commit,
        "Volume": volume,
        "Brightness": osd.brightness,
        "Snap": wm.snap,
        "Clipboard": clip.toggle,
        "StartMenu": panel.toggle_menu,
        "NotificationCenter": panel.toggle_center,
        "QuickSettings": panel.toggle_quick_settings,
        "Osd": osd.show_text,
        "Desktop": desktop,
    })

    # SIGUSR1 = 시작 메뉴 토글
    #   Hyprland 키바인딩에서:  bind = SUPER, Super_L, exec, pkill -USR1 -f sekai-panel
    def on_usr1(*_):
        GLib.idle_add(panel.toggle_menu)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)

    # SIGUSR2 = 알림 센터 토글  (pkill -USR2 -f sekai-panel)
    #   달력은 시계를 누르면 열리므로 단축키는 알림 센터에 준다.
    def on_usr2(*_):
        GLib.idle_add(panel.toggle_center)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, on_usr2)

    # SIGHUP = 설정이 바뀌었다 (sekai-settings 가 보낸다) → CSS 다시 적용
    def on_hup(*_):
        def reload_():
            # 패널은 D-Bus 이름(알림 데몬, 트레이 워처)을 쥐고 있으므로
            # 재시작하지 않고 제자리에서 크기를 바꾼다.
            new_h = int(sekai_conf("panel", "height", PANEL_HEIGHT))
            osd.set_bottom(new_h + 24)
            clip.set_panel_height(new_h)
            for p in [panel] + panel.others:        # 다른 모니터의 작업 표시줄도 (예전엔 주 모니터 것만 바뀌었다)
                if new_h != p.get_size_request()[1]:
                    dbg("패널 높이 변경", new_h)
                    p.set_size_request(-1, new_h)
                    GtkLayerShell.auto_exclusive_zone_enable(p)
            load_css()
            apply_mode()                    # 다크/라이트가 바뀌었을 수 있다 (아이콘 테마)
            if primary_monitor() != panel.gdk_monitor:
                panel.sync_monitors()       # 주 디스플레이가 바뀌었다 — 작업 표시줄을 옮긴다
            elif _layer.WAYLAND:
                # 해상도·주사율을 바꿨을 수 있다 — 부팅 옵션용으로 다시 알린다
                GLib.timeout_add(2500, lambda: monitors.publish_modes() and False)
            panel.tray.refresh_icons()
            panel.qs.refresh_icons()        # 네트워크·음량·배터리 아이콘도 새 테마로 (다크 모드 타일도 맞춘다)
            panel.queue_rebuild_all(0)      # 작업 표시줄에 보일 창(지금 데스크톱만 / 모두)이 바뀌었을 수 있다
            # 방해 금지·기록 지우기·보관 개수는 설정 앱에서도 바꾼다 — 다시 읽는다
            try:
                panel.notifications.sync_settings()
            except Exception as e:
                dbg("알림 설정 갱신 실패:", e)
            panel.queue_draw()
            return False
        GLib.idle_add(reload_)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, on_hup)

    Gtk.main()


if __name__ == "__main__":
    main()
