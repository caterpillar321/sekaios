            self.noti_badge.set_text(str(min(unread, 99)))
            self.noti_badge.show()
        else:
            self.noti_badge.hide()
        self.noti_btn.set_tooltip_text(
            "방해 금지" if dnd else
            (f"읽지 않은 알림 {unread}개" if unread else f"알림 {total}개"))

    # ── 볼륨 팝업 ───────────────────────────────────────
    def _build_vol_popup(self):
        pop = PanelPopup(GtkLayerShell.Edge.RIGHT, margin=10)
        box = pop.root
        box.set_spacing(12)
        box.set_size_request(300, -1)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        t = Gtk.Label(label="음량", xalign=0)
        t.get_style_context().add_class("pop-title")
        head.pack_start(t, True, True, 0)
        self.vol_value = Gtk.Label(label="", xalign=1)
        self.vol_value.get_style_context().add_class("pop-value")
        head.pack_end(self.vol_value, False, False, 0)
        box.pack_start(head, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.mute_btn = Gtk.ToggleButton()
        self.mute_btn.get_style_context().add_class("icon-btn")
        self.mute_icon = icon_image("audio-volume-high-symbolic", 16)
        self.mute_btn.add(self.mute_icon)
        self.mute_btn.set_tooltip_text("음소거")
        self.mute_btn.set_valign(Gtk.Align.CENTER)
        self.mute_btn.connect("toggled", self._on_mute)
        row.pack_start(self.mute_btn, False, False, 0)

        self.vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol_scale.set_draw_value(False)
        self.vol_scale.connect("value-changed", self._on_vol_scale)
        row.pack_start(self.vol_scale, True, True, 0)
        box.pack_start(row, False, False, 0)

        mix = Gtk.Button(label="소리 설정")
        mix.get_style_context().add_class("pop-btn")
        mix.set_halign(Gtk.Align.END)
        mix.connect("clicked", lambda *_: (pop.close(),
                    subprocess.Popen(["sekai-settings", "--page=sound"], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
        box.pack_start(mix, False, False, 0)

        pop.on_open = self._sync_vol_popup
        return pop

    def _sync_vol_popup(self):
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, text=True, timeout=1).stdout
            v = float(out.split()[1]) if len(out.split()) > 1 else 0.0
            self._vol_guard = True
            self.vol_scale.set_value(round(v * 100))
            muted = "MUTED" in out
            self.mute_btn.set_active(muted)
            self.mute_icon.set_from_icon_name(
                "audio-volume-muted-symbolic" if muted else "audio-volume-high-symbolic",
                Gtk.IconSize.MENU)
            self.vol_value.set_text("음소거" if muted else f"{round(v * 100)}%")
            self._vol_guard = False
        except Exception:
            pass

    def _on_vol_scale(self, sc):
        if getattr(self, "_vol_guard", False):
            return
        subprocess.Popen(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                          f"{int(sc.get_value())}%"])
        self.vol_value.set_text(f"{int(sc.get_value())}%")
        GLib.timeout_add(150, self.update_sys)

    def _on_vol_scroll(self, _w, ev):
        step = 0
        if ev.direction == Gdk.ScrollDirection.UP:
            step = 5
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            step = -5
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            step = -5 if dy > 0 else (5 if dy < 0 else 0)
        if step:
            subprocess.Popen(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@",
                              f"{abs(step)}%{'+' if step > 0 else '-'}"])
            GLib.timeout_add(120, self.update_sys)
        return True

    def _on_mute(self, btn):
        if getattr(self, "_vol_guard", False):
            return
        subprocess.Popen(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@",
                          "1" if btn.get_active() else "0"])
        GLib.timeout_add(150, self.update_sys)
        GLib.timeout_add(200, lambda: (self._sync_vol_popup(), False)[1])

    # ── 달력 팝업 ───────────────────────────────────────
    def _build_cal_popup(self):
        pop = PanelPopup(GtkLayerShell.Edge.RIGHT, margin=10)
        box = pop.root
        box.set_spacing(10)
        box.set_size_request(300, -1)

        self.cal_date = Gtk.Label(xalign=0)
        self.cal_date.get_style_context().add_class("pop-title")
        box.pack_start(self.cal_date, False, False, 0)
        self.cal_year = Gtk.Label(xalign=0)
        self.cal_year.get_style_context().add_class("pop-subtitle")
        box.pack_start(self.cal_year, False, False, 0)

        self.calendar = Gtk.Calendar()
        self.calendar.get_style_context().add_class("calendar")
        box.pack_start(self.calendar, False, False, 0)

        today = Gtk.Button(label="오늘")
        today.get_style_context().add_class("pop-btn")
        today.set_halign(Gtk.Align.END)
        today.connect("clicked", lambda *_: self._cal_today())
        box.pack_start(today, False, False, 0)

        pop.on_open = self._cal_today
        return pop

    def _cal_today(self):
        t = time.localtime()
        self.calendar.select_month(t.tm_mon - 1, t.tm_year)
        self.calendar.select_day(t.tm_mday)
        self.cal_date.set_text(korean_date(t, weekday_long=True))
        self.cal_year.set_text(f"{t.tm_year}년")

    # ── 워크스페이스 ────────────────────────────────────
    def rebuild_workspaces(self):
        # 작업 표시줄에서는 제거됨. 별도 워크스페이스 UI 에서 재사용 예정.
        if not hasattr(self, "wsbox"):
            return False
        for c in self.wsbox.get_children():
            self.wsbox.remove(c)
        wss = self.hypr.query("workspaces") or []
        active = (self.hypr.query("activeworkspace") or {}).get("id")
        used = {w["id"] for w in wss if w.get("windows", 0) > 0 and w.get("id", 0) > 0}
        for i in range(1, 6):
            b = Gtk.Button(label=str(i))
            ctx = b.get_style_context()
            ctx.add_class("ws-btn")
            if i == active:
                ctx.add_class("active")
            elif i in used:
                ctx.add_class("used")
            b.connect("clicked", lambda _w, n=i: self.hypr.dispatch(f"workspace {n}"))
            self.wsbox.pack_start(b, False, False, 0)
        self.wsbox.show_all()
        return False

    def draw_logo(self, widget, cr):
        a = widget.get_allocation()
        size = min(a.width, a.height)
        cr.translate((a.width - size) / 2, (a.height - size) / 2)
        draw_logo(cr, size)
        return False

    def toggle_menu(self, *_):
        if self.menu.get_visible():
            self.menu.close()
        else:
            self.menu.present_menu()

    # ── Hyprland 이벤트 ──
    def on_hypr_event(self, name, _arg):
        for fn in self.event_hooks:
            try:
                fn(name, _arg)
            except Exception as e:
                dbg("이벤트 훅 오류", name, e)
        # 폴백: 사용자가 다른 창을 클릭하면 포커스 이벤트가 온다 → 메뉴 닫기
        if name in ("activewindow", "activewindowv2", "openwindow") and self.menu.get_visible():
            GLib.idle_add(self.menu.close)
        if name in ("openwindow", "closewindow", "activewindow", "activewindowv2",
                    "movewindow", "movewindowv2", "windowtitle", "windowtitlev2",
                    "workspace", "activespecial", "fullscreen", "changefloatingmode"):
            GLib.idle_add(self.rebuild_tasks)

    def rebuild_tasks(self):
        for c in self.tasks.get_children():
            self.tasks.remove(c)
        clients = self.hypr.query("clients") or []
        active = self.hypr.query("activewindow") or {}
        active_addr = active.get("address") if isinstance(active, dict) else None

        for c in clients:
            ws = c.get("workspace", {}) or {}
            # 워크스페이스 id 가 음수 = 특수 워크스페이스 = 우리 기준 "최소화"
            minimized = ws.get("id", 0) < 0
            cls = c.get("class") or ""
            title = (c.get("title") or "").strip()
            # 제목이 비었거나 클래스와 같으면 클래스를 보기 좋게
            label = title if title and title.lower() != cls.lower() else (cls[:1].upper() + cls[1:])
            addr = c.get("address")

            btn = Gtk.Button()
            btn.get_style_context().add_class("task-btn")
            btn.set_valign(Gtk.Align.CENTER)
            if minimized:
                btn.get_style_context().add_class("minimized")
            elif addr == active_addr:
                btn.get_style_context().add_class("active")
            btn.set_tooltip_text(f"{cls}\n{title}" if title else cls)

            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            box.pack_start(app_icon(cls, 20), False, False, 0)
            lbl = Gtk.Label(label=label or "?", xalign=0)
            lbl.set_ellipsize(Pango.EllipsizeMode.END)
            lbl.set_max_width_chars(20)
            box.pack_start(lbl, True, True, 0)
            btn.add(box)

            btn.connect("clicked", self.on_task_activate, addr, minimized,
                        addr == active_addr)
            # 우클릭 / 가운데클릭 = 창 닫기
            btn.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            btn.connect("button-press-event", self.on_task_click, addr)
            self.tasks.pack_start(btn, False, False, 0)
        self.tasks.show_all()
        return False

    def on_task_activate(self, _w, addr, minimized, is_active):
        """윈도우 작업 표시줄과 같은 동작:
             최소화됨   → 복원 + 포커스
             활성 창     → 최소화
             그 외       → 포커스
        """
        if minimized:
            self.restore_window(addr)
        elif is_active:
            self.hypr.dispatch(f"movetoworkspacesilent special:min,address:{addr}")
        else:
            self.hypr.dispatch(f"focuswindow address:{addr}")
        GLib.timeout_add(120, self.rebuild_tasks)

    def restore_window(self, addr):
        """최소화(special:min)된 창을 지금 워크스페이스로 되돌리고 초점"""
        cur = self.hypr.query("activeworkspace") or {}
        wid = cur.get("id", 1)
        self.hypr.dispatch(f"movetoworkspace {wid},address:{addr}")
        self.hypr.dispatch(f"focuswindow address:{addr}")
        GLib.timeout_add(120, self.rebuild_tasks)

    def on_task_click(self, _w, ev, addr):
        if ev.button in (2, 3):                      # 가운데 / 오른쪽
            self.hypr.dispatch(f"closewindow address:{addr}")
            return True
        return False

    # ── 시스템 정보 ──
    def tick_clock(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(
            sekai_conf("panel", "clock_format", "%H:%M") or "%H:%M", t))
        self.clock_date.set_text(korean_date(t))
        self.clock_btn.set_tooltip_text(time.strftime("%Y년 ", t) + korean_date(t, True))
        return True

    def update_sys(self):
        # 볼륨
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, text=True, timeout=1).stdout
            muted = "MUTED" in out
            v = float(out.split()[1]) if len(out.split()) > 1 else 0.0
            pct = int(round(v * 100))
            if muted or pct == 0:
                name = "audio-volume-muted-symbolic"
            elif pct < 34:
                name = "audio-volume-low-symbolic"
            elif pct < 67:
                name = "audio-volume-medium-symbolic"
            else:
                name = "audio-volume-high-symbolic"
            self.vol_icon.set_from_icon_name(name, Gtk.IconSize.MENU)
            self.vol.set_tooltip_text("음소거" if muted else f"음량 {pct}%")
            ctx = self.vol.get_style_context()
            (ctx.add_class if muted else ctx.remove_class)("muted")
        except Exception:
            self.vol.set_tooltip_text("음량")
        return True


