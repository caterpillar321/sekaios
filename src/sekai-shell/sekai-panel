class Hypr:
    def __init__(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
        if not sig:
            raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE 없음 — Hyprland 안에서 실행하세요")
        self.dir = f"{rt}/hypr/{sig}"

    def _request(self, payload: str) -> bytes:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(2)
        s.connect(f"{self.dir}/.socket.sock")
        s.sendall(payload.encode())
        out = b""
        while True:
            chunk = s.recv(8192)
            if not chunk:
                break
            out += chunk
        s.close()
        return out

    def query(self, what: str):
        """clients / workspaces / activewindow / monitors …"""
        try:
            return json.loads(self._request(f"j/{what}"))
        except Exception:
            return []

    def dispatch(self, cmd: str):
        try:
            self._request(f"/dispatch {cmd}")
        except Exception:
            pass

    def subscribe(self, on_event):
        """이벤트 소켓을 GLib 메인루프에 연결. 끊기면 잠시 뒤 다시 붙는다
        (예전엔 한 번 끊기면 그대로라 작업 표시줄이 창 변화를 더는 몰랐다)"""
        self._on_event = on_event
        self._connect_events()

    def _connect_events(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(f"{self.dir}/.socket2.sock")
        s.setblocking(False)
        self._buf = b""

        def reader(sock, cond):
            try:
                data = sock.recv(8192)
            except BlockingIOError:
                return True
            except OSError:
                data = b""
            if not data:                       # 끊겼다
                sock.close()
                self._evsock = None
                GLib.timeout_add(1000, self._reconnect_events)
                return False
            self._buf += data
            while b"\n" in self._buf:
                line, self._buf = self._buf.split(b"\n", 1)
                text = line.decode("utf-8", "replace")
                if ">>" in text:
                    name, _, arg = text.partition(">>")
                    self._on_event(name, arg)
            return True

        GLib.io_add_watch(s, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, reader)
        self._evsock = s

    def _reconnect_events(self):
        """다시 붙기 — 안 되면(Hyprland 가 아직/이미 없다) 2초마다 다시. 붙으면 그동안 놓친 변화를 한 번 알린다"""
        try:
            self._connect_events()
        except OSError:
            GLib.timeout_add(2000, self._reconnect_events)
            return False
        dbg("Hyprland 이벤트 소켓 다시 연결")
        self._on_event("monitoradded", "")     # 작업 표시줄·모니터를 다시 맞추게
        return False


