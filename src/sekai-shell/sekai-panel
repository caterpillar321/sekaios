def _locale_keys():
    """LANG=ko_KR.UTF-8 → ["ko_KR", "ko"]  (.desktop 의 Name[ko_KR], Name[ko] 순서로 찾는다)"""
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
            or os.environ.get("LANG") or "").split(".")[0].split("@")[0]
    keys = []
    if lang and lang not in ("C", "POSIX"):
        keys.append(lang)
        if "_" in lang:
            keys.append(lang.split("_")[0])
    return keys


LOCALE_KEYS = _locale_keys()


def localized(entry, key):
    for loc in LOCALE_KEYS:
        v = entry.get(f"{key}[{loc}]")
        if v:
            return v
    return entry.get(key, "")


# 한글 초성 — 윈도우처럼 한글 앱을 ㄱ ㄴ ㄷ … 으로 묶는다
CHOSEONG = "ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎ"
CHOSEONG_GROUP = {"ㄲ": "ㄱ", "ㄸ": "ㄷ", "ㅃ": "ㅂ", "ㅆ": "ㅅ", "ㅉ": "ㅈ"}   # 된소리는 예사소리 칸에


def index_letter(name):
    """목록 머리글자: 영문은 A–Z, 한글은 초성, 그 밖(숫자·기호)은 #"""
    c = (name or "#")[:1]
    if "가" <= c <= "힣":
        ch = CHOSEONG[(ord(c) - 0xAC00) // 588]
        return CHOSEONG_GROUP.get(ch, ch)
    if c.isascii() and c.isalpha():
        return c.upper()
    return "#"


def sort_key(name):
    """정렬: 한글 → 영문 → 기타 (윈도우 한국어판과 같은 순서)"""
    c = (name or "")[:1]
    group = 0 if "가" <= c <= "힣" else (1 if c.isascii() and c.isalpha() else 2)
    return (group, name.lower())


# 모든 앱 목록에서 숨길 것 — 사용자가 직접 실행할 일이 없는 내부 구성요소
HIDDEN_APPS = {"foot-server", "footclient"}


def load_apps():
    dirs = [
        os.path.expanduser("~/.local/share/applications"),
        "/usr/local/share/applications",
        "/usr/share/applications",
    ]
    apps, seen = [], set()
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop") or fn in seen:
                continue
            seen.add(fn)
            entry = {}
            try:
                with open(os.path.join(d, fn), encoding="utf-8", errors="replace") as f:
                    in_main = False
                    for line in f:
                        line = line.strip()
                        if line.startswith("["):
                            in_main = line == "[Desktop Entry]"
                            continue
                        if not in_main or "=" not in line:
                            continue
                        k, _, v = line.partition("=")
                        entry[k] = v
            except OSError:
                continue
            if entry.get("NoDisplay", "").lower() == "true":
                continue
            if fn[:-len(".desktop")].lower() in HIDDEN_APPS:
                continue
            if entry.get("Type", "Application") != "Application":
                continue
            name, exe = localized(entry, "Name"), entry.get("Exec")
            if not name or not exe:
                continue
            # %f %u %U %F %i %c %k 같은 필드 코드 제거
            exe = " ".join(t for t in exe.split() if not (len(t) == 2 and t[0] == "%"))
            apps.append({
                "id": fn[:-len(".desktop")].lower(),
                "name": name,
                "exec": exe,
                "icon": entry.get("Icon", "application-x-executable"),
                "terminal": entry.get("Terminal", "").lower() == "true",
                "comment": localized(entry, "Comment"),
                "name_en": entry.get("Name", name),      # 영어 이름으로도 검색되게
            })
    apps.sort(key=lambda a: sort_key(a["name"]))
    return apps


def launch(app):
    cmd = app["exec"]
    if app.get("terminal"):
        cmd = f"sekai-terminal -e {cmd}"
    # foot 은 Wayland 전용 — 기본 화면 모드(X11)에서는 X 용 터미널로
    if cmd.split()[:1] in (["foot"], ["footclient"]):
        cmd = "sekai-terminal" + cmd[len(cmd.split()[0]):]
    try:
        subprocess.Popen(shlex.split(cmd), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


# 요일 — 로캘에 기대지 않는다 (세션 로캘이 영어여도 한국어로)
WEEKDAYS = ["월", "화", "수", "목", "금", "토", "일"]


def korean_date(t=None, weekday_long=False):
    t = t or time.localtime()
    wd = WEEKDAYS[t.tm_wday] + ("요일" if weekday_long else "")
    return f"{t.tm_mon}월 {t.tm_mday}일 ({wd})" if not weekday_long else f"{t.tm_mon}월 {t.tm_mday}일 {wd}"


def icon_image(names, size):
    """names 는 문자열 또는 후보 목록. 처음 찾아지는 것을 쓴다."""
    if isinstance(names, str):
        names = [names]
    img = Gtk.Image()
    img.set_pixel_size(size)
    theme = Gtk.IconTheme.get_default()
    for n in names:
        if not n:
            continue
        if n.startswith("/") and os.path.exists(n):
            img.set_from_file(n)
            return img
        if theme.has_icon(n):
            img.set_from_icon_name(n, Gtk.IconSize.MENU)
            return img
    img.set_from_icon_name("application-x-executable", Gtk.IconSize.MENU)
    return img


