        sys_box.pack_start(self.tray, False, False, 0)

        # ── 알림 ──
        self.noti_btn = Gtk.Button()
        nb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.noti_icon = icon_image("notifications-symbolic", 16)
        nb.pack_start(self.noti_icon, False, False, 0)
        self.noti_badge = Gtk.Label(label="")
        self.noti_badge.get_style_context().add_class("noti-badge")
        self.noti_badge.set_valign(Gtk.Align.CENTER)
        self.noti_badge.set_no_show_all(True)
        nb.pack_start(self.noti_badge, False, False, 0)
        self.noti_btn.add(nb)
        self.noti_btn.get_style_context().add_class("sys-item")
        self.noti_btn.get_style_context().add_class("noti-btn")
        self.noti_btn.set_valign(Gtk.Align.CENTER)
        self.noti_btn.set_tooltip_text("알림")
        sys_box.pack_start(self.noti_btn, False, False, 0)

        self.notifications = NotificationService(
            on_count_changed=self._on_noti_count)
        if self.notifications.center is not None:
            self.noti_btn.connect(
                "clicked", lambda *_: self.notifications.center.toggle())
        self._on_noti_count(self.notifications.unread,
                            len(self.notifications.history),
                            self.notifications.dnd)

        self.vol_popup = self._build_vol_popup()
        self.vol = Gtk.Button()
        self.vol_icon = icon_image("audio-volume-high-symbolic", 16)
        self.vol.add(self.vol_icon)
        self.vol.get_style_context().add_class("sys-item")
        self.vol.set_valign(Gtk.Align.CENTER)
        self.vol.connect("clicked", lambda *_: self.vol_popup.toggle())
        self.vol.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        self.vol.connect("scroll-event", self._on_vol_scroll)
        sys_box.pack_start(self.vol, False, False, 0)

        # 네트워크 표시는 트레이의 nm-applet 아이콘이 맡는다
        #   (연결 상태·연결 메뉴·Wi-Fi 암호 입력까지). 전에는 여기에
        #   인터페이스 이름(ens33 등)을 글자로 찍었는데 사용자에겐 의미가 없었다.

        self.cal_popup = self._build_cal_popup()
        self.clock_btn = Gtk.Button()
        self.clock_btn.get_style_context().add_class("clock")
        cb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        cb.set_valign(Gtk.Align.CENTER)
        self.clock = Gtk.Label(label="--:--", xalign=1)
        self.clock.get_style_context().add_class("clock-time")
        self.clock_date = Gtk.Label(label="", xalign=1)
        self.clock_date.get_style_context().add_class("clock-date")
        cb.pack_start(self.clock, False, False, 0)
        cb.pack_start(self.clock_date, False, False, 0)
        self.clock_btn.add(cb)
        self.clock_btn.set_valign(Gtk.Align.CENTER)
        self.clock_btn.connect("clicked", lambda *_: self.cal_popup.toggle())
        sys_box.pack_start(self.clock_btn, False, False, 0)

        bar.pack_end(sys_box, False, False, 0)

        # ── 갱신 ──
        self.rebuild_tasks()
        self.update_sys()
        GLib.timeout_add_seconds(1, self.tick_clock)
        GLib.timeout_add_seconds(5, self.update_sys)
        self.event_hooks = []
        hypr.subscribe(self.on_hypr_event)
        self.tick_clock()

    # ── 알림 버튼 표시 ──────────────────────────────────
    def _on_noti_count(self, unread, total, dnd):
        ctx = self.noti_btn.get_style_context()
        (ctx.add_class if dnd else ctx.remove_class)("dnd")
        (ctx.add_class if unread else ctx.remove_class)("unread")
        self.noti_icon.set_from_icon_name(
            "notifications-disabled-symbolic" if dnd else "notifications-symbolic",
            Gtk.IconSize.MENU)
        if unread and not dnd:
            self.noti_badge.set_text(str(min(unread, 99)))
            self.noti_badge.show()
        else:
            self.noti_badge.hide()
        self.noti_btn.set_tooltip_text(
            "방해 금지" if dnd else
            (f"읽지 않은 알림 {unread}개" if unread else f"알림 {total}개"))

    # ── 볼륨 팝업 ───────────────────────────────────────
    def _build_vol_popup(self):
        pop = PanelPopup(GtkLayerShell.Edge.RIGHT, margin=10)
        box = pop.root
        box.set_spacing(12)
        box.set_size_request(300, -1)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        t = Gtk.Label(label="음량", xalign=0)
        t.get_style_context().add_class("pop-title")
        head.pack_start(t, True, True, 0)
        self.vol_value = Gtk.Label(label="", xalign=1)
        self.vol_value.get_style_context().add_class("pop-value")
        head.pack_end(self.vol_value, False, False, 0)
        box.pack_start(head, False, False, 0)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.mute_btn = Gtk.ToggleButton()
        self.mute_btn.get_style_context().add_class("icon-btn")
        self.mute_icon = icon_image("audio-volume-high-symbolic", 16)
        self.mute_btn.add(self.mute_icon)
        self.mute_btn.set_tooltip_text("음소거")
        self.mute_btn.set_valign(Gtk.Align.CENTER)
        self.mute_btn.connect("toggled", self._on_mute)
        row.pack_start(self.mute_btn, False, False, 0)

        self.vol_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.vol_scale.set_draw_value(False)
        self.vol_scale.connect("value-changed", self._on_vol_scale)
        row.pack_start(self.vol_scale, True, True, 0)
        box.pack_start(row, False, False, 0)

        mix = Gtk.Button(label="소리 설정")
        mix.get_style_context().add_class("pop-btn")
        mix.set_halign(Gtk.Align.END)
        mix.connect("clicked", lambda *_: (pop.close(),
                    subprocess.Popen(["sekai-settings", "--page=sound"], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)))
        box.pack_start(mix, False, False, 0)

        pop.on_open = self._sync_vol_popup
        return pop

    def _sync_vol_popup(self):
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, text=True, timeout=1).stdout
            v = float(out.split()[1]) if len(out.split()) > 1 else 0.0
            self._vol_guard = True
            self.vol_scale.set_value(round(v * 100))
            muted = "MUTED" in out
            self.mute_btn.set_active(muted)
            self.mute_icon.set_from_icon_name(
                "audio-volume-muted-symbolic" if muted else "audio-volume-high-symbolic",
                Gtk.IconSize.MENU)
            self.vol_value.set_text("음소거" if muted else f"{round(v * 100)}%")
            self._vol_guard = False
        except Exception:
            pass

    def _on_vol_scale(self, sc):
        if getattr(self, "_vol_guard", False):
            return
        subprocess.Popen(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                          f"{int(sc.get_value())}%"])
        self.vol_value.set_text(f"{int(sc.get_value())}%")
        GLib.timeout_add(150, self.update_sys)

    def _on_vol_scroll(self, _w, ev):
        step = 0
        if ev.direction == Gdk.ScrollDirection.UP:
            step = 5
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            step = -5
        elif ev.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = ev.get_scroll_deltas()
            step = -5 if dy > 0 else (5 if dy < 0 else 0)
        if step:
            subprocess.Popen(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@",
                              f"{abs(step)}%{'+' if step > 0 else '-'}"])
            GLib.timeout_add(120, self.update_sys)
        return True

    def _on_mute(self, btn):
        if getattr(self, "_vol_guard", False):
            return
        subprocess.Popen(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@",
                          "1" if btn.get_active() else "0"])
        GLib.timeout_add(150, self.update_sys)
        GLib.timeout_add(200, lambda: (self._sync_vol_popup(), False)[1])

    # ── 달력 팝업 ───────────────────────────────────────
    def _build_cal_popup(self):
        pop = PanelPopup(GtkLayerShell.Edge.RIGHT, margin=10)
        box = pop.root
        box.set_spacing(10)
        box.set_size_request(300, -1)

        self.cal_date = Gtk.Label(xalign=0)
        self.cal_date.get_style_context().add_class("pop-title")
        box.pack_start(self.cal_date, False, False, 0)
        self.cal_year = Gtk.Label(xalign=0)
        self.cal_year.get_style_context().add_class("pop-subtitle")
        box.pack_start(self.cal_year, False, False, 0)

        self.calendar = Gtk.Calendar()
        self.calendar.get_style_context().add_class("calendar")
        box.pack_start(self.calendar, False, False, 0)

        today = Gtk.Button(label="오늘")
        today.get_style_context().add_class("pop-btn")
        today.set_halign(Gtk.Align.END)
        today.connect("clicked", lambda *_: self._cal_today())
        box.pack_start(today, False, False, 0)

        pop.on_open = self._cal_today
        return pop

    def _cal_today(self):
        t = time.localtime()
        self.calendar.select_month(t.tm_mon - 1, t.tm_year)
        self.calendar.select_day(t.tm_mday)
        self.cal_date.set_text(korean_date(t, weekday_long=True))
        self.cal_year.set_text(f"{t.tm_year}년")

    # ── 워크스페이스 ────────────────────────────────────
    def rebuild_workspaces(self):
        # 작업 표시줄에서는 제거됨. 별도 워크스페이스 UI 에서 재사용 예정.
        if not hasattr(self, "wsbox"):
            return False
        for c in self.wsbox.get_children():
            self.wsbox.remove(c)
        wss = self.hypr.query("workspaces") or []
        active = (self.hypr.query("activeworkspace") or {}).get("id")
        used = {w["id"] for w in wss if w.get("windows", 0) > 0 and w.get("id", 0) > 0}
        for i in range(1, 6):
            b = Gtk.Button(label=str(i))
            ctx = b.get_style_context()
            ctx.add_class("ws-btn")
            if i == active:
                ctx.add_class("active")
            elif i in used:
                ctx.add_class("used")
            b.connect("clicked", lambda _w, n=i: self.hypr.dispatch(f"workspace {n}"))
            self.wsbox.pack_start(b, False, False, 0)
        self.wsbox.show_all()
        return False

    def draw_logo(self, widget, cr):
        a = widget.get_allocation()
        size = min(a.width, a.height)
        cr.translate((a.width - size) / 2, (a.height - size) / 2)
        draw_logo(cr, size)
        return False

    def toggle_menu(self, *_, monitor=None):
        """monitor: 그 모니터의 시작 버튼을 눌렀을 때. 없으면(Win 키) 초점이 있는 모니터에"""
        if self.menu.get_visible():
            self.menu.close()
        else:
            if monitor is None:
                monitor = focused_gdk_monitor(self.hypr)
            self.menu.present_menu(monitor)  # None 이면 모니터를 정하지 않는다

    # ── Hyprland 이벤트 ──
    def on_hypr_event(self, name, _arg):
        for fn in self.event_hooks:
            try:
                fn(name, _arg)
            except Exception as e:
                dbg("이벤트 훅 오류", name, e)
        # 폴백: 사용자가 다른 창을 클릭하면 포커스 이벤트가 온다 → 메뉴 닫기
        if name in ("activewindow", "activewindowv2", "openwindow") and self.menu.get_visible():
            GLib.idle_add(self.menu.close)
        if name in ("openwindow", "closewindow", "activewindow", "activewindowv2",
                    "movewindow", "movewindowv2", "windowtitle", "windowtitlev2",
                    "workspace", "activespecial", "fullscreen", "changefloatingmode",
                    "focusedmon", "moveworkspace", "monitoradded", "monitorremoved"):
            GLib.idle_add(self.rebuild_all_tasks)

    def rebuild_all_tasks(self):
        self.rebuild_tasks()
        for p in self.others:
            p.rebuild_tasks()
        return False

    def sync_monitors(self):
        """모니터마다 작업 표시줄 — 주 모니터 말고는 SecondaryPanel"""
        for p in self.others:
            p.destroy()
        self.others = []
        disp = Gdk.Display.get_default()
        prim = primary_monitor()
        if prim is not None and prim != self.gdk_monitor:
            self.gdk_monitor = prim
            GtkLayerShell.set_monitor(self, prim)
        for i in range(disp.get_n_monitors()):
            m = disp.get_monitor(i)
            if m != self.gdk_monitor:
                p = SecondaryPanel(self.hypr, m, self)
                p.show_all()
                self.others.append(p)
        self.rebuild_all_tasks()
        return False

    # ── 시스템 정보 ──
    def tick_clock(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(
            sekai_conf("panel", "clock_format", "%H:%M") or "%H:%M", t))
        self.clock_date.set_text(korean_date(t))
        self.clock_btn.set_tooltip_text(time.strftime("%Y년 ", t) + korean_date(t, True))
        return True

    def update_sys(self):
        # 볼륨
        try:
            out = subprocess.run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
                                 capture_output=True, text=True, timeout=1).stdout
            muted = "MUTED" in out
            v = float(out.split()[1]) if len(out.split()) > 1 else 0.0
            pct = int(round(v * 100))
            if muted or pct == 0:
                name = "audio-volume-muted-symbolic"
            elif pct < 34:
                name = "audio-volume-low-symbolic"
            elif pct < 67:
                name = "audio-volume-medium-symbolic"
            else:
                name = "audio-volume-high-symbolic"
            self.vol_icon.set_from_icon_name(name, Gtk.IconSize.MENU)
            self.vol.set_tooltip_text("음소거" if muted else f"음량 {pct}%")
            ctx = self.vol.get_style_context()
            (ctx.add_class if muted else ctx.remove_class)("muted")
        except Exception:
            self.vol.set_tooltip_text("음량")
        return True


# ───────────────────────────────────────────────────────────────
def main():
    import signal

    # style.css 는 @accent / @bg / @surface / @fg 를 쓴다.
    # 그 정의는 설정 파일에서 읽어 앞에 붙인다.
    css_paths = (os.path.join(HERE, "style.css"),
                 "/usr/share/sekai-shell/style.css")
    css_holder = {"prov": None}

    def load_css():
        refresh_logo_colors()
        body = ""
        for path in css_paths:
            if os.path.exists(path):
                with open(path, encoding="utf-8") as f:
                    body = f.read()
                break
        # 사용자가 직접 덧붙이고 싶을 때
        if not _layer.WAYLAND:
            # 기본 화면 모드(X11)엔 뒤를 흐리는 효과가 없다 — 반투명 면을 거의 불투명하게
            body = body.replace("alpha(@surface, 0.86)", "alpha(@surface, 0.97)")
        user = os.path.expanduser("~/.config/sekai/panel.css")
        if os.path.exists(user):
            with open(user, encoding="utf-8") as f:
                body += "\n" + f.read()
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data((css_prelude() + body).encode())
        except Exception as e:
            dbg("CSS 오류:", e)
            return
        if css_holder["prov"] is not None:
            Gtk.StyleContext.remove_provider_for_screen(
                Gdk.Screen.get_default(), css_holder["prov"])
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        css_holder["prov"] = prov

    load_css()

    # 다크/라이트 모드 — 아이콘 테마(어두운 바탕엔 Papirus-Dark, 밝은 바탕엔 Papirus)와 GTK 다크 여부
    from sekaishell import theme as _theme

    def apply_mode():
        _theme.apply_gtk_settings(Gtk.Settings.get_default(),
                                  _theme.mode_of(sekai_settings().get("appearance", {})))
    apply_mode()

    # Wayland(Hyprland) 이면 IPC 소켓, X11 기본 화면 모드면 libwnck 로 흉내
    if _layer.WAYLAND:
        hypr = Hypr()
    else:
        from sekaishell.wm import X11Hypr
        hypr = X11Hypr()
    panel = Panel(hypr)
    panel.show_all()
    # 모니터마다 작업 표시줄 — 꽂고 뺄 때도 다시 맞춘다
    panel.sync_monitors()
    if monitors.primary_name() and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        # 주 디스플레이를 골라 두었으면 로그인 직후 초점(새 창이 뜨는 곳)을 그리로
        hypr.dispatch(f"focusmonitor {monitors.primary_hypr_name()}")
    _mon_src = {"id": 0}

    def _monitors_changed(*_):
        if _mon_src["id"]:
            GLib.source_remove(_mon_src["id"])

        def go():
            _mon_src["id"] = 0
            return panel.sync_monitors()
        _mon_src["id"] = GLib.timeout_add(600, go)
    Gdk.Display.get_default().connect("monitor-added", _monitors_changed)
    Gdk.Display.get_default().connect("monitor-removed", _monitors_changed)
    pins.on_change(lambda: GLib.idle_add(panel.rebuild_all_tasks))

    # ── 창 전환기 · OSD · 클립보드 · 창 배치 — org.sekai.Shell 로 부른다 (sekai-ctl) ──
    switcher = Switcher(hypr, on_restore=panel.restore_window)
    osd = Osd(bottom_margin=int(sekai_conf("panel", "height", PANEL_HEIGHT)) + 24)
    clip = ClipboardPopup(hypr)
    clip.set_panel_height(int(sekai_conf("panel", "height", PANEL_HEIGHT)))
    wm = WindowManager(hypr)
    if _layer.WAYLAND:
        # 끌어서 스냅 미리보기 (X11 기본 화면 모드에선 xfwm4 가 가장자리 스냅을 직접 한다)
        from sekaishell.snappreview import SnapPreview
        from sekaishell.snaplayouts import SnapLayouts
        from sekaishell.snapassist import SnapAssist
        wm.preview = SnapPreview()
        wm.assist = SnapAssist(wm)            # 스냅한 뒤 남은 칸에 둘 창 고르기
        from sekaishell.snaplayouts import TopLayoutBar
        wm.topbar = TopLayoutBar()            # 위쪽 가운데로 끌면 내려오는 레이아웃 바
        wm.layouts = SnapLayouts(wm)          # 최대화 버튼에 마우스를 올리면 뜨는 배치 그림
    panel.event_hooks.append(wm.on_event)

    def volume(action):
        osd.volume(action)
        panel.update_sys()

    panel.updates = UpdateNotifier()
    panel.gpuhint = GpuHint()

    panel.shell = ShellService({
        "Switch": switcher.step,
        "SwitchCommit": switcher.commit,
        "Volume": volume,
        "Brightness": osd.brightness,
        "Snap": wm.snap,
        "Clipboard": clip.toggle,
        "StartMenu": panel.toggle_menu,
        "NotificationCenter": lambda: (getattr(panel.notifications, "center", None)
                                       or panel.cal_popup).toggle(),
        "Osd": osd.show_text,
    })

    # SIGUSR1 = 시작 메뉴 토글
    #   Hyprland 키바인딩에서:  bind = SUPER, Super_L, exec, pkill -USR1 -f sekai-panel
    def on_usr1(*_):
        GLib.idle_add(panel.toggle_menu)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)

    # SIGUSR2 = 알림 센터 토글  (pkill -USR2 -f sekai-panel)
    #   달력은 시계를 누르면 열리므로 단축키는 알림 센터에 준다.
    def on_usr2(*_):
        c = getattr(panel.notifications, "center", None)
        GLib.idle_add(c.toggle if c is not None else panel.cal_popup.toggle)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, on_usr2)

    # SIGHUP = 설정이 바뀌었다 (sekai-settings 가 보낸다) → CSS 다시 적용
    def on_hup(*_):
        def reload_():
            # 패널은 D-Bus 이름(알림 데몬, 트레이 워처)을 쥐고 있으므로
            # 재시작하지 않고 제자리에서 크기를 바꾼다.
            new_h = int(sekai_conf("panel", "height", PANEL_HEIGHT))
            osd.set_bottom(new_h + 24)
            clip.set_panel_height(new_h)
            if new_h != panel.get_size_request()[1]:
                dbg("패널 높이 변경", new_h)
                panel.set_size_request(-1, new_h)
                GtkLayerShell.auto_exclusive_zone_enable(panel)
            load_css()
            apply_mode()                    # 다크/라이트가 바뀌었을 수 있다 (아이콘 테마)
            if primary_monitor() != panel.gdk_monitor:
                panel.sync_monitors()       # 주 디스플레이가 바뀌었다 — 작업 표시줄을 옮긴다
            panel.tray.refresh_icons()
            # 방해 금지는 설정 앱에서도 바꿀 수 있다 — 상태를 다시 읽는다
            try:
                from sekaishell import config as _c
                svc = panel.notifications
                dnd = bool(_c.state("dnd", False))
                if dnd != svc.dnd:
                    svc.set_dnd(dnd)
            except Exception as e:
                dbg("방해 금지 상태 갱신 실패:", e)
            panel.queue_draw()
            return False
        GLib.idle_add(reload_)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, on_hup)

    Gtk.main()


if __name__ == "__main__":
    main()
