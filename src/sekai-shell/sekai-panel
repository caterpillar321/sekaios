        self.connect("destroy", lambda *_: GLib.source_remove(self._src))

    def _tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime(sekai_conf("panel", "clock_format", "%H:%M") or "%H:%M", t))
        self.clock_date.set_text(korean_date(t))
        return True


