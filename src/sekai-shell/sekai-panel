def sekai_settings():
    """설정 파일을 읽어 기본값 위에 덮어쓴 dict 를 돌려준다."""
    import copy
    out = copy.deepcopy(_SEKAI_DEFAULTS)
    try:
        with open(SEKAI_CFG, encoding="utf-8") as f:
            data = json.load(f)
        for k, v in data.items():
            if isinstance(v, dict) and isinstance(out.get(k), dict):
                out[k].update(v)
            else:
                out[k] = v
    except Exception:
        pass
    return out


def sekai_conf(section, key, default=None):
    return sekai_settings().get(section, {}).get(key, default)


