_apps_cache = {"t": 0, "apps": {}}


def apps_by_id():
    """시작 메뉴의 앱 목록을 소문자 id 로 (30초 동안 다시 읽지 않는다)"""
    if time.monotonic() - _apps_cache["t"] > 30:
        _apps_cache["apps"] = {a["id"].lower(): a for a in load_apps()}
        _apps_cache["t"] = time.monotonic()
    return _apps_cache["apps"]


def launch_app_id(app_id):
    a = apps_by_id().get((app_id or "").lower())
    if a:
        launch(a)
        return
    info = pins.app_info(app_id)                  # 시작 메뉴에 안 보이는 앱 (NoDisplay)
    if info is not None:
        try:
            info.launch([], None)
        except Exception:
            pass


def hypr_monitor_origins(hypr):
    """Hyprland 모니터 id → (x, y). 창이 어느 모니터에 있는지 Gdk 모니터와 맞춰 보려고"""
    return {m.get("id"): (m.get("x"), m.get("y")) for m in (hypr.query("monitors") or [])}


def primary_monitor():
    """주 디스플레이 — 설정(디스플레이 → 주 디스플레이로 사용)을 따른다"""
    return monitors.primary_gdk()


def focused_gdk_monitor(hypr):
    """Hyprland 에서 초점이 있는 모니터의 Gdk 모니터 (Win 키로 시작 메뉴를 열 때)"""
    disp = Gdk.Display.get_default()
    for m in hypr.query("monitors") or []:
        if m.get("focused"):
            for i in range(disp.get_n_monitors()):
                g = disp.get_monitor(i).get_geometry()
                if (g.x, g.y) == (m.get("x"), m.get("y")):
                    return disp.get_monitor(i)
    return primary_monitor()


def popup_menu(menu, widget, ev):
    """우클릭 메뉴 띄우기 — 닫히면 해제한다.
    attach_to_widget 로 붙인 메뉴는 창이 살아 있는 한 남아서, 우클릭할 때마다 하나씩 쌓였다.
    항목의 activate 는 deactivate 바로 뒤에 같은 흐름에서 불리므로 해제는 idle 로 미룬다."""
    menu.get_style_context().add_class("task-menu")
    menu.attach_to_widget(widget, None)
    menu.connect("deactivate", lambda m: GLib.idle_add(m.destroy))
    menu.show_all()
    menu.popup_at_pointer(ev)


def run_limited(argv, done, secs=3, capture=False):
    """명령을 기다리지 않고 돌린다 — 끝나면 done(출력 또는 None) 을 메인 스레드에서 한 번.
    secs 초 안에 안 끝나면 죽이고 done(None) (PipeWire 가 멈추면 wpctl 이 안 끝나
    음량 아이콘이 영원히 멈춰 있었다)."""
    flags = Gio.SubprocessFlags.STDERR_SILENCE | (Gio.SubprocessFlags.STDOUT_PIPE if capture
                                                  else Gio.SubprocessFlags.STDOUT_SILENCE)
    try:
        proc = Gio.Subprocess.new(argv, flags)
    except GLib.Error:
        done(None)
        return
    st = {"done": False}

    def finish(out):
        if st["done"]:
            return
        st["done"] = True
        if st.get("src"):
            GLib.source_remove(st["src"])
        done(out)

    def timeout():
        st["src"] = 0
        proc.force_exit()
        finish(None)
        return False
    st["src"] = GLib.timeout_add_seconds(secs, timeout)

    def fin(p, res):
        try:
            if capture:
                _ok, out, _err = p.communicate_utf8_finish(res)
            else:
                p.wait_finish(res)
                out = ""
            finish(out if p.get_successful() else None)
        except GLib.Error:
            finish(None)
    if capture:
        proc.communicate_utf8_async(None, None, fin)
    else:
        proc.wait_async(None, fin)


def query_volume(cb):
    """wpctl get-volume 을 기다리지 않고 — cb((0~1 음량, 음소거)) 또는 cb(None) 을 메인 스레드에서.
    동기로 부르면 PipeWire 가 바쁠 때 작업 표시줄 전체가 굳었다."""
    def done(out):
        try:
            parts = (out or "").split()
            cb((float(parts[1]), "MUTED" in out) if out and len(parts) > 1 else None)
        except ValueError:
            cb(None)
    run_limited(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], done, capture=True)


class TaskbarMixin:
    """작업 버튼 — 주 작업 표시줄과 다른 모니터의 작업 표시줄이 함께 쓴다.

    필요한 속성: self.hypr, self.tasks(Gtk.Box), self.gdk_monitor (이 작업 표시줄의 모니터)
    윈도우 7 이후처럼 앱마다 아이콘 하나: 같은 앱의 창은 한 버튼으로 묶고, 아래 막대로 상태를 보인다
      (실행 중 = 짧은 막대, 초점 = 긴 강조색 막대). 창이 여럿이면 누를 때 창 목록.
    순서: 고정한 앱 → 고정 안 한 실행 중 앱 (처음 연 순서).
    모니터가 여럿이면 각 작업 표시줄에는 그 모니터에 있는 창만. 고정한 앱은 모든 작업 표시줄에.
    """

    _preview = None

    def _hook_bar_menu(self):
        """작업 표시줄 빈 곳 우클릭 — 작업 관리자 · 작업 표시줄 설정 (윈도우 11 처럼)"""
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("button-press-event", self._on_bar_press)

    def _on_bar_press(self, widget, ev):
        # 단추(작업 버튼·시작·시계 등)는 자기 창으로 받는다 — 이 창으로 온 누름만 빈 곳이다
        if ev.button != 3 or ev.window != self.get_window():
            return False
        m = Gtk.Menu()
        for label, cmd in (("작업 관리자", ["sekai-taskmgr"]),
                           ("작업 표시줄 설정", ["sekai-settings", "--page=appearance"])):
            it = Gtk.MenuItem(label=label)
            it.connect("activate", lambda _i, c=cmd: subprocess.Popen(
                c, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            m.append(it)
        popup_menu(m, widget, ev)
        return True

    @property
    def preview(self):
        """창 미리보기 — 모든 작업 표시줄이 하나를 같이 쓴다"""
        if TaskbarMixin._preview is None:
            TaskbarMixin._preview = TaskPreview(self.hypr)
        return TaskbarMixin._preview

    def _hook_preview(self):
        if getattr(self, "_pv_hooked", False):
            return
        self._pv_hooked = True
        self.add_events(Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("leave-notify-event",
                     lambda _w, ev: ev.detail != Gdk.NotifyType.INFERIOR and self.preview.schedule_hide() and False)

    def _my_clients(self, clients, origins=None, ws_mon=None):
        disp = Gdk.Display.get_default()
        if disp.get_n_monitors() < 2 or self.gdk_monitor is None:
            return clients
        g = self.gdk_monitor.get_geometry()
        if origins is None:
            origins = hypr_monitor_origins(self.hypr)

        def mon(c):
            # 최소화한 창(special:min)은 최소화 칸이 있는 모니터로 옮겨진다 — 원래 데스크톱의 모니터로 가린다
            #   (안 그러면 다른 모니터에서 최소화한 창의 단추가 이 작업 표시줄로 넘어왔다)
            if ws_mon and (c.get("workspace") or {}).get("id", 0) < 0:
                m = ws_mon.get(desktops.home(c))
                if m is not None:
                    return m
            return c.get("monitor")
        return [c for c in clients if origins.get(mon(c)) == (g.x, g.y)]

    def task_snapshot(self):
        """작업 표시줄을 그리는 데 필요한 Hyprland 상태 — 모든 작업 표시줄이 한 번 조회한 것을 같이 쓴다"""
        active = self.hypr.query("activewindow") or {}
        clients = _open_order(self.hypr.query("clients") or [])
        desktops.remember(clients)                  # 최소화하기 전의 데스크톱을 알아 두려고
        mons = self.hypr.query("monitors") or []
        wss = self.hypr.query("workspaces") or []
        return {"clients": clients,
                "ndesk": len(desktops.load()),
                "ws_mon": {w.get("id"): w.get("monitorID") for w in wss if isinstance(w, dict)},
                "active": active.get("address") if isinstance(active, dict) else None,
                "origins": {m.get("id"): (m.get("x"), m.get("y")) for m in mons},
                # 모니터마다 지금 보이는 워크스페이스 (X11 흉내에는 없다 — 그땐 가리지 않는다)
                "shown": {(m.get("activeWorkspace") or {}).get("id") for m in mons
                          if (m.get("activeWorkspace") or {}).get("id")}}

    def _queue_rebuild(self, delay=120):
        (getattr(self, "main", None) or self).queue_rebuild_all(delay)

    def rebuild_tasks(self, snap=None):
        self._hook_preview()
        if snap is None:
            snap = self.task_snapshot()
        # 미리보기가 이 작업 표시줄의 버튼으로 뜨길 기다리는 중이면 — 새 버튼으로 옮긴다 (아래)
        pend = self.preview.pending()
        pend = pend if pend and pend[1].get_toplevel() is self else None
        for c in self.tasks.get_children():
            self.tasks.remove(c)
        self._task_btns = {}                                # 앱 묶음 → (버튼, 창들)
        clients = self._my_clients(snap["clients"], snap["origins"], snap.get("ws_mon"))
        clients = [c for c in clients if c.get("mapped", True) and c.get("address")]  # 연 순서
        if snap.get("shown") and desktops.mode("taskbar") == "current":
            # 설정 › 멀티태스킹 — 지금 보고 있는 데스크톱의 창만 (윈도우 기본값과 같게)
            clients = [c for c in clients if desktops.visible(c, snap["shown"], snap.get("ndesk"))]
        active_addr = snap["active"]

        groups = {}                                         # 묶음 키 → 창들
        order = []
        for c in clients:
            cls = c.get("class") or ""
            key = pins.app_id_for_class(cls) or ("class:" + cls.lower())
            if key not in groups:
                groups[key] = []
                order.append(key)
            groups[key].append(c)
        pinned = [pid for pid in pins.load() if pid in groups or pins.app_info(pid) is not None]
        for key in pinned + [k for k in order if k not in pinned]:
            self._app_button(key, groups.get(key, []), active_addr)
        self.tasks.show_all()
        if pend:
            new = self._task_btns.get(pend[0])
            if new and new[1]:
                self.preview.retarget(new[0], new[1], active_addr)
            else:
                self.preview.cancel_show()                  # 그 앱의 창이 없어졌다
        return False

    def _app_button(self, key, wins, active_addr):
        app_id = None if key.startswith("class:") else key
        info = pins.app_info(app_id) if app_id else None
        name = info.get_display_name() if info else \
            ((wins[0].get("class") or "?") if wins else key)
        name = name[:1].upper() + name[1:]

        btn = Gtk.Button()
        ctx = btn.get_style_context()
        ctx.add_class("task-btn")
        ctx.add_class("app-btn")
        btn.set_valign(Gtk.Align.CENTER)
        if wins:
            ctx.add_class("running")
            if any(c.get("address") == active_addr for c in wins):
                ctx.add_class("active")
            elif all(self._minimized(c) for c in wins):
                ctx.add_class("minimized")
        if not wins:
            btn.set_tooltip_text(name)             # 창이 있으면 미리보기가 대신한다

        if info is not None and info.get_icon() is not None:
            img = Gtk.Image.new_from_gicon(info.get_icon(), Gtk.IconSize.DIALOG)
            img.set_pixel_size(24)
        else:
            img = app_icon((wins[0].get("class") if wins else None) or app_id or "", 24)
        btn.add(img)

        btn.connect("clicked", self.on_app_click, key, app_id, wins, active_addr)
        btn.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                       | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        if wins:
            btn.connect("enter-notify-event", lambda b, _e: self.preview.show_later(
                key, b, wins, active_addr, self._preview_pick, self._preview_close) and False)
        else:
            btn.connect("enter-notify-event", lambda *_: self.preview.schedule_hide() and False)
        btn.connect("leave-notify-event", lambda *_: self.preview.schedule_hide() and False)
        btn.connect("button-press-event", self.on_app_press, app_id, wins, name)
        self.tasks.pack_start(btn, False, False, 0)
        self._task_btns[key] = (btn, wins)

    @staticmethod
    def _minimized(c):
        # 워크스페이스 id 가 음수 = 특수 워크스페이스 = 우리 기준 "최소화"
        return (c.get("workspace", {}) or {}).get("id", 0) < 0

    def on_app_click(self, btn, key, app_id, wins, active_addr):
        """윈도우 작업 표시줄과 같은 동작:
             창 없음     → 앱 실행
             창 하나     → 최소화됨: 복원 / 초점 있음: 최소화 / 그 외: 초점
             창 여럿     → 창 미리보기 (골라서 전환)"""
        if not wins:
            self.preview.hide_now()
            if app_id:
                launch_app_id(app_id)
            return
        if len(wins) > 1:
            self.preview.show_for(key, btn, wins, active_addr, self._preview_pick, self._preview_close)
            return
        self.preview.hide_now()
        self.activate_window(wins[0], active_addr)

    def _fresh(self, c):
        """누른 순간의 창 상태 — 단추·미리보기가 쥔 정보는 몇백 ms 늦을 수 있다 (방금 최소화한 창을
        보이는 창으로 알고 초점을 주면 최소화 칸 전체가 화면에 펼쳐졌다). 창이 없어졌으면 None"""
        addr = c.get("address")
        return next((x for x in (self.hypr.query("clients") or []) if x.get("address") == addr), None)

    def _preview_pick(self, c):
        """미리보기에서 고름 — 최소화돼 있으면 복원, 아니면 초점 (초점이 있어도 최소화하지 않는다)"""
        c = self._fresh(c)
        if c is None:
            self._queue_rebuild()
            return
        if self._minimized(c):
            self.restore_window(c.get("address"))
        else:
            self.hypr.dispatch(f"focuswindow address:{c.get('address')}")
            self._queue_rebuild()

    def _preview_close(self, c):
        self.hypr.dispatch(f"closewindow address:{c.get('address')}")

    def activate_window(self, c, active_addr):
        c = self._fresh(c)
        if c is None:
            self._queue_rebuild()
            return
        addr = c.get("address")
        if self._minimized(c):
            self.restore_window(addr)
        elif addr == active_addr:
            self.hypr.dispatch(f"movetoworkspacesilent special:min,address:{addr}")
        else:
            self.hypr.dispatch(f"focuswindow address:{addr}")
        self._queue_rebuild()

    def restore_window(self, addr):
        """최소화(special:min)된 창을 원래 데스크톱으로 되돌리고 초점 (모르면 지금 데스크톱으로).
        다른 데스크톱의 창이면 그리로 간다 — 윈도우처럼 (movetoworkspace 는 창을 따라간다)"""
        wid = desktops.home({"address": addr})
        if not wid or wid > len(desktops.load()):
            # 모르거나 그 데스크톱이 이미 닫혔다 — 지금 데스크톱으로
            wid = (self.hypr.query("activeworkspace") or {}).get("id", 1)
        self.hypr.dispatch(f"movetoworkspace {wid},address:{addr}")
        self.hypr.dispatch(f"focuswindow address:{addr}")
        self._queue_rebuild()

    # ── 우클릭 메뉴 (윈도우의 점프 목록처럼) · 가운데 클릭 = 새 창 ──
    def on_app_press(self, _w, ev, app_id, wins, name):
        if ev.button in (2, 3):
            self.preview.hide_now()
        if ev.button == 2:
            if app_id:
                launch_app_id(app_id)
            return True
        if ev.button != 3:
            return False
        m = Gtk.Menu()
        if app_id:
            it = Gtk.MenuItem(label=name if not wins else f"{name} — 새 창")
            it.connect("activate", lambda *_: launch_app_id(app_id))
            m.append(it)
            if pins.is_pinned(app_id):
                it = Gtk.MenuItem(label="작업 표시줄에서 고정 해제")
                it.connect("activate", lambda *_: pins.unpin(app_id))
            else:
                it = Gtk.MenuItem(label="작업 표시줄에 고정")
                it.connect("activate", lambda *_: pins.pin(app_id))
            m.append(it)
        if wins:
            if app_id:
                m.append(Gtk.SeparatorMenuItem())
            it = Gtk.MenuItem(label="창 닫기" if len(wins) == 1 else "모든 창 닫기")
            addrs = [c.get("address") for c in wins]
            it.connect("activate", lambda *_: [self.hypr.dispatch(f"closewindow address:{a}") for a in addrs])
            m.append(it)
        if not m.get_children():
            return True
        self._popup(m, ev)
        return True

    def _popup(self, menu, ev):
        popup_menu(menu, self, ev)


