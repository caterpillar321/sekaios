#!/usr/bin/env python3
# ═══════════════════════════════════════════════════════════════
#  SekaiOS 자리 비움 관리 — swayidle 을 설정대로 띄워 둔다
#
#  설정 (~/.config/sekai/settings.json 의 "power", 초 단위, 0 = 안 함)
#    screen_off   화면 끄기
#    lock         화면 잠그기
#    suspend      절전
#  그리고 언제나: 절전 직전 잠그기, loginctl lock-session 이 오면 잠그기
#
#  SIGHUP 을 받으면 설정을 다시 읽어 swayidle 을 새로 띄운다
#  (설정 앱이 "전원 및 잠금"을 바꾸면 보낸다).
# ═══════════════════════════════════════════════════════════════
import json
import os
import shutil
import signal
import subprocess
import sys
import time

CFG = os.path.expanduser("~/.config/sekai/settings.json")
DEFAULTS = {"screen_off": 600, "lock": 900, "suspend": 0}
# 잠금은 lock-now 로 — 잠금이 실패하면(설정 파일이 깨졌다거나) 검증된 swaylock 으로 넘어가고,
#   잠금 화면이 풀리지 않은 채 죽으면 다시 띄운다. swayidle 은 명령의 종료 코드를 보지 않아,
#   before-sleep 에서 잠금이 실패해도 그대로 절전에 들어가 잠기지 않은 채 깨어났다.
#   (lock-now 는 잠금이 실제로 걸린 뒤 돌아온다)
LOCK = "/usr/libexec/sekai/lock-now"
DPMS_OFF = "hyprctl dispatch dpms off"
DPMS_ON = "hyprctl dispatch dpms on"

child = None
reload_wanted = False


def power():
    try:
        with open(CFG, encoding="utf-8") as f:
            p = json.load(f).get("power", {}) or {}
    except Exception:
        p = {}
    out = {}
    for k, d in DEFAULTS.items():
        try:
            out[k] = max(0, int(p.get(k, d)))
        except (TypeError, ValueError):
            out[k] = d
    return out


def command(p):
    cmd = ["swayidle", "-w"]
    if p["lock"]:
        cmd += ["timeout", str(p["lock"]), LOCK]
    if p["screen_off"]:
        cmd += ["timeout", str(p["screen_off"]), DPMS_OFF, "resume", DPMS_ON]
        # 잠긴 뒤에는 화면을 더 빨리 끈다 (윈도우: 잠금 화면 1분)
        if p["lock"] and p["screen_off"] > p["lock"] + 60:
            cmd += ["timeout", str(p["lock"] + 60),
                    # 잠금 화면이 떠 있을 때만 (sekai-lock 이 잡고 있는 잠금 파일로 확인)
                    f'flock -n "$XDG_RUNTIME_DIR/sekai-lock.pid" true || {DPMS_OFF}',
                    "resume", DPMS_ON]
    if p["suspend"]:
        cmd += ["timeout", str(p["suspend"]), "systemctl suspend"]
    cmd += ["before-sleep", LOCK,
            "after-resume", DPMS_ON,
            "lock", LOCK]
    return cmd


def start():
    global child
    cmd = command(power())
    print("[idle]", " ".join(cmd), file=sys.stderr, flush=True)
    child = subprocess.Popen(cmd)


def stop():
    global child
    if child and child.poll() is None:
        child.terminate()
        try:
            child.wait(3)
        except subprocess.TimeoutExpired:
            child.kill()
    child = None


def on_hup(*_):
    global reload_wanted
    reload_wanted = True


def on_term(*_):
    stop()
    sys.exit(0)


def compositor_pid():
    """나를 띄운 Hyprland 의 PID — 세션이 끝나면 나도 끝나려고.

    Hyprland 는 exec-once 를 두 번 fork 해서 띄우므로 부모를 따라가도 안 나온다.
    인스턴스 폴더의 hyprland.lock 첫 줄이 Hyprland 의 PID 다.
    """
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if sig:
        try:
            with open(os.path.join(rt, "hypr", sig, "hyprland.lock")) as f:
                return int(f.readline().strip())
        except (OSError, ValueError):
            pass
    pid = os.getppid()
    while pid > 1:
        try:
            with open(f"/proc/{pid}/comm") as f:
                if f.read().strip() == "Hyprland":
                    return pid
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def take_over():
    """이전 세션에서 남은 sekai-idle 이 있으면 끝낸다 (한 사용자에 하나만)"""
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sekai-idle.pid")
    try:
        with open(path) as f:
            old = int(f.read().strip())
        with open(f"/proc/{old}/cmdline", "rb") as f:
            if b"sekai-idle" in f.read() and old != os.getpid():
                os.kill(old, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    try:
        with open(path, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def main_x11():
    """기본 화면 모드(X11): X 화면 보호기 시간 + xss-lock 이 잠금 프로그램을 부른다"""
    p = power()
    lock = p["lock"] or 0
    subprocess.run(["xset", "s", str(lock), str(lock)] if lock else ["xset", "s", "off"])
    off = p["screen_off"]
    subprocess.run(["xset", "dpms", str(off), str(off), str(off)] if off else ["xset", "-dpms"])
    os.execvp("xss-lock", ["xss-lock", "--transfer-sleep-lock", "--", "/usr/libexec/sekai/lock-now"])


def main():
    global reload_wanted
    if not os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "x11":
        return main_x11()
    if not shutil.which("swayidle"):
        print("swayidle 이 없습니다.", file=sys.stderr)
        return 1
    take_over()
    comp = compositor_pid()
    wd = os.environ.get("WAYLAND_DISPLAY")
    wl = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), wd) if wd and not wd.startswith("/") else wd
    signal.signal(signal.SIGHUP, on_hup)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    start()
    fails = 0
    while True:
        time.sleep(0.5)
        if comp is None:
            comp = compositor_pid()             # 막 떴을 땐 Hyprland 의 잠금 파일이 아직 없을 수 있다
        if (comp and not alive(comp)) or (wl and not os.path.exists(wl)):
            # 세션이 끝났다 — swayidle 과 함께 끝낸다 (안 그러면 세션이 'closing' 으로 남는다)
            stop()
            return 0
        if reload_wanted:
            reload_wanted = False
            stop()
            start()
            continue
        if child.poll() is not None:
            # swayidle 이 죽었다 — 너무 자주 죽으면 천천히 다시
            fails += 1
            time.sleep(min(30, fails * 2))
            start()


if __name__ == "__main__":
    sys.exit(main() or 0)
