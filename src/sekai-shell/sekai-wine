#!/usr/bin/env python3
"""sekai-wine — SekaiOS 의 Windows 앱 (Wine)

  sekai-wine open <파일.exe|.msi> …         설치하거나 그냥 실행하는 창
  sekai-wine run <환경> [--lnk 경로 | --exe 경로] [인자…]   시작 메뉴 바로 가기가 부른다
  sekai-wine list                            환경과 앱 목록 (JSON)
  sekai-wine remove <환경>                    환경을 통째로 지운다
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from sekaiwine import core  # noqa: E402


def main(argv):
    if len(argv) >= 2 and argv[0] == "open":
        from sekaiwine.app import main as open_main
        return open_main(argv[1:])
    if len(argv) >= 2 and argv[0] == "run":
        env = core.load(argv[1])
        if not env:
            print(f"환경 {argv[1]} 이 없습니다", file=sys.stderr)
            return 1
        rest = argv[2:]
        if len(rest) >= 2 and rest[0] in ("--lnk", "--exe"):
            target, args = rest[1], rest[2:]
        elif rest:
            target, args = rest[0], rest[1:]
        else:
            print("실행할 것을 주세요 (--lnk · --exe)", file=sys.stderr)
            return 2
        core.spawn(env, target, args)
        return 0
    if argv[:1] == ["list"]:
        print(json.dumps(core.envs(), ensure_ascii=False, indent=1))
        return 0
    if len(argv) == 2 and argv[0] == "remove":
        env = core.load(argv[1])
        if not env:
            return 1
        core.remove(env)
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
