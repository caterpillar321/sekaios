#!/bin/sh
# SekaiOS 로그인 화면 세션 — greetd 가 _greetd 사용자로 실행한다.
#   로그인 화면만 띄우는 작은 Hyprland. 로그인에 성공하면 sekai-greeter 가
#   끝나고 Hyprland 도 닫힌다 → greetd 가 사용자 세션을 연다.
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
locale -a 2>/dev/null | grep -qi '^ko_KR.utf8$' && export LANG=ko_KR.UTF-8
. /usr/lib/sekai/hw-env.sh
# 출력은 버린다 — 안 그러면 Hyprland 시작 로그가 화면(가상 터미널)에 잠깐 찍힌다.
# (Hyprland 자체 로그는 \$XDG_RUNTIME_DIR/hypr/*/hyprland.log 에 따로 남는다)

# ── 마지막 사용자의 해상도로 시작 (로그인 뒤 화면이 한 번 더 바뀌지 않게) ──
#   /var/lib/sekai/displays/<사용자>.conf 는 사용자가 쓰는 파일이다.
#   그대로 source 하면 로그인 화면 권한으로 아무 명령이나 실행될 수 있으므로
#   ① 파일 주인이 그 사용자인 일반 파일인지(read_owned — 바꿔치기·FIFO·링크 막기)
#   ② 줄이 "monitor = 이름, 모드, 위치, 배율[, transform, n][, vrr, n]" 형식인지
#   확인해서 통과한 줄만 새로 적는다.
CONF=/usr/share/sekai/greeter/hyprland.conf
APP=sekai-greeter
X=/usr/lib/sekai/x11

# Hyprland 로 띄우고, 시작하자마자(10초 안) 비정상으로 끝나면 기본 화면 모드(X11)로 다시.
#   (그냥 두면 greetd 가 계속 다시 띄우다 포기해서 화면이 영영 까맣게 남는다)
#   로그인 화면 프로그램이 한 번이라도 떴으면(표시 파일) Hyprland 는 멀쩡한 것 — 되띄우지 않는다.
#   예전엔 비밀번호를 10초 안에 넣으면 정상 로그인을 고장으로 알고 로그인 뒤에 X11 로그인 화면을
#   띄웠다 (콘솔 화면 버퍼에 그려져 좌상단·보조 모니터에 로그인 화면이 남고, 로그인도 몇 초 늦었다).
DONE="${XDG_RUNTIME_DIR:-/tmp}/sekai-greeter.done"

# 부팅 화면(Plymouth)을 이제 비켜세운다 — 화면을 잡기 바로 전에. Plymouth 는 root 의 요청만 받으므로
#   요청 파일을 두면 sekai-plymouth-release(.path) 가 대신 전하고 지운다 (최대 3초 기다림).
#   greetd 가 시작할 때 비켜세우면 로그인 화면이 뜨기까지 2초쯤 아무도 화면을 잡지 않아, 그 사이 모니터가
#   연결을 다시 알리면 콘솔이 화면을 다시 잡았다 (부팅 화면이 사라지고 모니터가 깜박였다).
#   요청 길이 없으면 greetd.service 가 예전처럼 시작할 때 비켜세운다.
release_splash() {
    req=/run/sekai-greeter/plymouth-deactivate
    [ -d /run/sekai-greeter ] && [ -w /run/sekai-greeter ] || return 0
    : > "$req" 2>/dev/null || return 0
    n=0
    while [ -e "$req" ] && [ $n -lt 30 ]; do
        sleep 0.1
        n=$((n + 1))
    done
}

run_greeter() {
    release_splash
    if [ -n "${SEKAI_BASIC:-}" ]; then
        exec "$X/start" "$X/greeter" "$APP"
    fi
    rm -f "$DONE"
    started=$(date +%s)
    Hyprland -c "$1" >/dev/null 2>&1
    rc=$?
    [ -e "$DONE" ] && { rm -f "$DONE"; exit 0; }
    if [ $rc -ne 0 ] && [ $(( $(date +%s) - started )) -lt 10 ]; then
        export SEKAI_BASIC=1
        exec "$X/start" "$X/greeter" "$APP"
    fi
    exit $rc
}

# 설치 직후 첫 부팅이면 로그인 화면 대신 첫 부팅 설정(OOBE)
if [ -e /var/lib/sekai/oobe-pending ] && [ -x /usr/bin/sekai-oobe ]; then
    APP=sekai-oobe
    run_greeter /usr/share/sekai/oobe/hyprland.conf
fi
# 사용자 파일을 안전하게 읽는다 — 주인이 $2 인 4KB 이하의 일반 파일만, 한 번 연 fd 로 확인과 읽기를 같이.
#   그 폴더는 누구나 쓰므로: 확인한 뒤 이름으로 다시 열면 그 사이에 바꿔치기될 수 있고(TOCTOU),
#   FIFO 로 바꿔 두면 grep 이 영원히 기다려 로그인 화면이 뜨지 않는다. 심볼릭 링크는 따라가지 않는다.
read_owned() {
    timeout 3 python3 -c '
import os, pwd, stat, sys
try:
    uid = pwd.getpwnam(sys.argv[2]).pw_uid
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
except (OSError, KeyError):
    sys.exit(1)
st = os.fstat(fd)
if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 4096:
    sys.exit(1)
sys.stdout.write(os.read(fd, 4096).decode("utf-8", "replace"))
' "$1" "$2" 2>/dev/null
}

home=${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}
last=$(cat "$home/.cache/sekai-greeter/last-user" 2>/dev/null)
case "$last" in *[!a-z0-9_-]*|"") last= ;; esac          # 사용자 이름 모양이 아니면 무시
disp="/var/lib/sekai/displays/$last.conf"
if [ -n "$last" ] && text=$(read_owned "$disp" "$last"); then
    # 이름을 예측할 수 없는 새 파일에 (공용 /tmp 에서 남이 미리 만들어 둔 파일에 쓰지 않게)
    run=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/sekai-greeter.XXXXXX") &&
    {
        echo "source = $CONF"
        printf '%s\n' "$text" | grep -E '^monitor = [A-Za-z0-9._-]+, ([0-9]{2,5}x[0-9]{2,5}(@[0-9]{1,3}(\.[0-9]{1,3})?(Hz)?)?|preferred|highres|highrr), (auto|-?[0-9]{1,5}x-?[0-9]{1,5}), [0-9]{1,2}(\.[0-9]{1,3})?(, transform, [0-7])?(, vrr, [0-2])?$' | head -8
    } > "$run" 2>/dev/null && CONF=$run
    # 주 디스플레이 (사용자가 설정에서 고른 것) — 로그인 입력 칸을 거기에 (sekai-greeter)
    prim=$(printf '%s\n' "$text" | sed -n 's/^# primary = \([A-Za-z0-9._-]\{1,32\}\)$/\1/p' | head -1)
    [ -n "$prim" ] && export SEKAI_PRIMARY="$prim"
fi

run_greeter "$CONF"
