LOCKFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "sekai-lock.pid")
LOCKED_MARK = LOCKFILE + ".locked"       # 화면이 실제로 잠긴 동안만 있다 (내용 = 잠근 pid)
DEMO = os.environ.get("SEKAI_LOCK_DEMO") == "1"
