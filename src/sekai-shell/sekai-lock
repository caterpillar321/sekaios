def settings():
    try:
        with open(CFG, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except Exception:
        return {}


def accent_color():
    """강조색 — 설정이 이상하면(null·잘못된 색) 기본값. 잠금 전에 죽으면 안 된다."""
    try:
        a = settings().get("appearance") or {}
        v = str(a.get("accent") or "") if isinstance(a, dict) else ""
    except Exception:
        v = ""
    import re
    # CSS 에 그대로 끼워 넣는 값이다 — #rrggbb 모양만 받는다
    return v if re.fullmatch(r"#[0-9a-fA-F]{6}", v) else "#39c5bb"


def signal_ready(ok):
    global READY_FD
    if ok:
        # 잠김 표시 — 풀었을 때만 지운다(clear_mark). 풀리지 않은 채 죽으면 남아서
        #   lock-now 의 감시자가 "죽었다"를 알아본다 (그래서 atexit 로 지우지 않는다)
        try:
            with open(LOCKED_MARK, "w") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
    if READY_FD is not None:
        try:
            os.write(READY_FD, b"1" if ok else b"0")
            os.close(READY_FD)
        except OSError:
            pass
        READY_FD = None


def clear_mark():
    try:
        os.remove(LOCKED_MARK)
    except OSError:
        pass


