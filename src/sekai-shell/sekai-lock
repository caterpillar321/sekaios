# ── 기본 화면 모드(X11) — ext-session-lock 이 없으므로 검증된 X 잠금 프로그램(xsecurelock)을 쓴다 ──
#   xsecurelock 은 입력을 다 잡고 화면을 덮은 "뒤에" -- 뒤의 명령을 부른다 → 그때 잠김 표시를 남긴다.
#   사용자 전환(sekai-switch-user)은 이 표시를 보고 정말 잠긴 뒤에만 로그인 화면으로 넘어간다.
if not DEMO and (not os.environ.get("WAYLAND_DISPLAY") or os.environ.get("XDG_SESSION_TYPE") == "x11"):
    env = dict(os.environ,
               XSECURELOCK_FONT="Pretendard:size=14",
               XSECURELOCK_AUTH_BACKGROUND_COLOR="#151517",
               XSECURELOCK_AUTH_FOREGROUND_COLOR="#f1f1f3",
               XSECURELOCK_AUTH_WARNING_COLOR="#ff9aa8",
               XSECURELOCK_PASSWORD_PROMPT="asterisks",
               XSECURELOCK_SHOW_HOSTNAME="0",
               XSECURELOCK_SHOW_USERNAME="1",
               XSECURELOCK_SHOW_DATETIME="1",
               XSECURELOCK_DATETIME_FORMAT="%m월 %d일 %H:%M",
               XSECURELOCK_BLANK_TIMEOUT="60",
               XSECURELOCK_SAVER="saver_blank")
    try:
        os.remove(LOCKED_MARK)
    except OSError:
        pass
    # 알림 명령의 부모($PPID)가 xsecurelock 이다 — 표시 내용 = xsecurelock pid
    notify = ["sh", "-c", 'echo "$PPID" > "$1"', "sh", LOCKED_MARK]
    try:
        # close_fds=False: xss-lock 이 넘긴 절전 지연 fd(XSS_SLEEP_LOCK_FD)를 xsecurelock 이 받아야 한다
        proc = subprocess.Popen(["xsecurelock", "--"] + notify, env=env, close_fds=False)
        # 우리 쪽 복사본은 닫는다 — xss-lock 은 그 fd 가 모두 닫혀야(= 잠긴 뒤) 절전을 허락한다
        sfd = os.environ.get("XSS_SLEEP_LOCK_FD", "")
        if sfd.isdigit():
            try:
                os.close(int(sfd))
            except OSError:
                pass
        rc = proc.wait()
    except OSError as e:
        print("xsecurelock 을 실행하지 못했습니다:", e, file=sys.stderr)
        rc = 1
    try:
        os.remove(LOCKED_MARK)
    except OSError:
        pass
    sys.exit(rc)

