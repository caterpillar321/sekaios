READY_TIMEOUT = 3.0


def single_instance():
    """이미 잠겨 있으면 또 잠그지 않는다 (Super+L 을 두 번 눌러도, idle 과 겹쳐도)."""
    fd = os.open(LOCKFILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    try:
        os.remove(LOCKED_MARK)              # 죽은 앞 인스턴스가 남긴 표시
    except OSError:
        pass
    return fd


def wait_other_locked(timeout=10.0):
    """다른 인스턴스가 잠금을 잡고 있다 — 실제로 화면이 잠길 때까지 기다린다.
    잠금 파일만 잡혔을 뿐 아직 안 잠긴 순간에 '잠김'이라 답하면, 절전 직전 잠금(before-sleep)이
    잠기기 전에 절전을 허락해 버린다.
      → 'locked' 표시가 생기면 True / 앞 인스턴스가 끝나면 우리가 잠금을 넘겨받음 / 시간 초과 False"""
    end = time.monotonic() + timeout
    while time.monotonic() < end:
        try:
            with open(LOCKED_MARK) as f, open(LOCKFILE) as g:
                if f.read().strip() == g.read().strip():
                    return True
        except OSError:
            pass
        fd = single_instance()
        if fd is not None:
            return fd                        # 앞 인스턴스가 실패하고 끝났다 → 우리가 잠근다
        time.sleep(0.1)
    return False


def daemonize():
    """자식이 화면을 잠그면 부모가 0 으로 끝난다 (swaylock -f 와 같은 약속).
    잠금에 실패하면 1. 자식이 READY_TIMEOUT 안에 답하지 않으면(잠그기 전에 멈췄다) 자식을 치우고 1 —
    그냥 기다리면 부르는 쪽의 대체 잠금(|| swaylock)이 돌지 않고, 절전 직전이면 logind 가 기다리다 말고
    잠기지 않은 채 절전에 들어간다."""
    r, w = os.pipe()
    pid = os.fork()
    if pid > 0:
        os.close(w)
        got = b""
        try:
            ready, _, _ = select.select([r], [], [], READY_TIMEOUT)
            if ready:
                got = os.read(r, 1)
        except OSError:
            pass
        if got != b"1":
            # 멈춘 자식을 치운다. 이미 잠갔다가 죽은 것이라면 컴포지터는 잠긴 채로 두고,
            #   대체 잠금(swaylock)이 이어받는다 (hyprland.conf: misc:allow_session_lock_restore)
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        sys.exit(0 if got == b"1" else 1)
    os.close(r)
    os.setsid()
    # 부모를 부른 쪽(터미널·ssh·swayidle)이 출력 끝을 기다리지 않게 표준 입출력을 놓는다
    null = os.open(os.devnull, os.O_RDWR)
    logdir = os.path.expanduser("~/.local/state/sekai")
    try:
        os.makedirs(logdir, exist_ok=True)
        log = os.open(os.path.join(logdir, "lock.log"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    except OSError:
        log = null
    os.dup2(null, 0)
    os.dup2(null, 1)
    os.dup2(log, 2)
    return w


READY_FD = None
if __name__ == "__main__" and "--fg" not in sys.argv and not DEMO:
    READY_FD = daemonize()

INSTANCE = single_instance()
if INSTANCE is None:
    # 다른 인스턴스가 잠그는 중이거나 이미 잠갔다 — 실제로 잠긴 걸 확인하고 답한다
    got = wait_other_locked()
    if got is True or got is False:
        if READY_FD is not None:
            os.write(READY_FD, b"1" if got else b"0")
        sys.exit(0 if got else 1)
    INSTANCE = got

