    def _draw_avatar(self, w, cr):
        a = w.get_allocation()
        g = cairo.LinearGradient(0, 0, a.width, a.height)
        g.add_color_stop_rgb(0, 0.37, 0.84, 0.81)
        g.add_color_stop_rgb(1, 0.20, 0.62, 0.72)
        cr.arc(a.width / 2, a.height / 2, min(a.width, a.height) / 2, 0, 6.2832)
        cr.set_source(g)
        cr.fill()
        return False

    def set_msg(self, text, info=False):
        if not self.primary:
            return
        self.msg.set_text(text)
        ctx = self.msg.get_style_context()
        (ctx.add_class if info else ctx.remove_class)("info")

    def tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", t))
        self.date.set_text(f"{t.tm_mon}월 {t.tm_mday}일 {WEEKDAYS[t.tm_wday]}요일")

    # ── 그리기 ──
    def _draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        if self.imgs is None or self.size != (W, H):
            self.size = (W, H)
            self.imgs = blurred(self.app.wall, W, H) if self.app.wall is not None else (None, None)
        sharp, soft = self.imgs
        k = self.stage * self.stage * (3 - 2 * self.stage)       # 부드러운 전환
        draw_cover(cr, sharp, W, H)
        if soft is not None and k > 0:
            Gdk.cairo_set_source_pixbuf(cr, soft, (W - soft.get_width()) / 2,
                                        (H - soft.get_height()) / 2)
            cr.paint_with_alpha(k)
        # 글자가 읽히게: 커튼은 위아래만, 로그인은 전체를 조금 더 어둡게
        cr.set_source_rgba(0, 0, 0, 0.12 + 0.23 * k)
        cr.paint()
        g = cairo.LinearGradient(0, 0, 0, H * 0.55)
        g.add_color_stop_rgba(0, 0, 0, 0, 0.35 * (1 - k))
        g.add_color_stop_rgba(1, 0, 0, 0, 0)
        cr.set_source(g)
        cr.paint()
        return False

    def apply_stage(self):
        k = self.stage
        self.curtain.set_opacity(max(0.0, 1 - k * 1.6))
        self.curtain.set_visible(k < 0.99)
        if self.primary:
            self.hint.set_opacity(max(0.0, 1 - k * 2))
            if k > 0.01 and not self.login.get_visible():
                self.login.set_no_show_all(False)
                self.login.show_all()
            elif k <= 0.01 and self.login.get_visible():
                self.login.hide()
            self.login.set_opacity(max(0.0, (k - 0.3) / 0.7))
            self.login.set_margin_top(int(40 * (1 - k)))
        self.back.queue_draw()


class Locker:
    def __init__(self):
        self.user = pwd.getpwuid(os.getuid()).pw_name
        gecos = (pwd.getpwuid(os.getuid()).pw_gecos or "").split(",")[0].strip()
        self.display_name = gecos or self.user
        self.busy = False
        self.fails = 0
        self.last_input = time.monotonic()
        self.views = []
        self.windows = []
        self.anim = None
        # 배경은 잠금을 건 뒤에 따로 읽는다 (_load_wall) — 큰 그림을 푸는 동안 잠금이 늦어지지 않게.
        #   그 사이에는 어두운 바탕으로 그린다
        self.wall = None

        display = Gdk.Display.get_default()
        if DEMO:
            self.lock = None
            monitors = [display.get_monitor(0)]
        else:
            if not GtkSessionLock.is_supported():
                print("컴포지터가 ext-session-lock 을 지원하지 않습니다.", file=sys.stderr)
                signal_ready(False)
                sys.exit(1)
            self.lock = GtkSessionLock.prepare_lock()
            self.lock.connect("locked", lambda *_: signal_ready(True))
            self.lock.connect("finished", self._finished)
            self.lock.lock_lock()
            monitors = [display.get_monitor(i) for i in range(display.get_n_monitors())]

        self.main = None
        self.mons = []                  # 창마다 붙은 모니터 (views·windows 와 같은 순서)
        prim = primary_gdk(display) if monitors else None
        for m in monitors:
            self._add_view(m, primary=(m == prim))
        if self.main is None and self.views:
            self._make_primary(0)
        if self.lock is not None:
            # 잠긴 동안 모니터를 꽂거나 빼도 (도킹 해제 등) 입력 칸이 있는 화면이 남게
            display.connect("monitor-added", lambda _d, m: self._monitor_added(m))
            display.connect("monitor-removed", lambda _d, m: self._monitor_removed(m))
        GLib.timeout_add_seconds(1, self._tick)
        threading.Thread(target=self._load_wall, daemon=True).start()

    def _load_wall(self):
        """배경화면 — 따로 푼 뒤 메인 스레드에서 붙인다. 설정이 이상해도 기본 그림으로."""
        try:
            path = (settings().get("wallpaper") or {}).get("path") or FALLBACK_WALL
            if not isinstance(path, str) or not os.path.exists(path):
                path = FALLBACK_WALL
        except Exception:
            path = FALLBACK_WALL
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file(path)
        except Exception:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(FALLBACK_WALL)
            except Exception:
                return
        GLib.idle_add(self._set_wall, pb)

    def _set_wall(self, pb):
        self.wall = pb
        for v in self.views:
            v.imgs = None                       # 흐린 그림을 새로 만들게
            v.back.queue_draw()
        return False

    def _add_view(self, m, primary):
        win = Gtk.Window()
        view = LockView(self, primary=primary)
        win.add(view)
        win.connect("key-press-event", self._key)
        if self.lock is not None:
            self.lock.new_surface(win, m)
        else:
            win.fullscreen()
            win.connect("destroy", Gtk.main_quit)
        win.show_all()
        self.views.append(view)
        self.windows.append(win)
        self.mons.append(m)
        if primary:
            self.main = view
        view.stage = view.target = self.main.target if self.main else 0.0
        view.apply_stage()
        return view

    def _drop_view(self, i):
        self.views.pop(i)
        self.mons.pop(i)
        win = self.windows.pop(i)
        win.destroy()

    def _make_primary(self, i):
        """i 번 화면을 입력 칸이 있는 화면으로 다시 만든다"""
        m = self.mons[i]
        self._drop_view(i)
        self.main = None
        self._add_view(m, primary=True)

    def _monitor_added(self, m):
        self._add_view(m, primary=self.main is None)

    def _monitor_removed(self, m):
        if m not in self.mons:
            return
        i = self.mons.index(m)
        was_main = self.views[i] is self.main
        self._drop_view(i)
        if was_main:
            self.main = None
            if self.views:
                self._make_primary(0)

    def _finished(self, *_):
        # 다른 잠금 프로그램이 이미 잠갔거나 컴포지터가 거부했다 — 또는 컴포지터가 잠금을 끝냈다
        #   (어느 쪽이든 이 프로그램이 잡은 잠금은 없다 → 표시를 지운다. 감시자가 다시 띄우지 않게)
        print("잠금이 거부되었거나 끝났습니다.", file=sys.stderr)
        signal_ready(False)
        clear_mark()
        self.exit_code = 2
        Gtk.main_quit()

    def _tick(self):
        for v in self.views:
            v.tick()
        if self.main is None:                   # 모니터가 하나도 없을 때 (절전 직전 등)
            return True
        if (self.main.target == 1.0 and not self.busy and not self.main.pw.get_text()
                and time.monotonic() - self.last_input > IDLE_BACK):
            self.animate(0.0)
        return True

    def poke(self):
        self.last_input = time.monotonic()

    # ── 커튼 ↔ 로그인 ──
    def reveal(self):
        self.poke()
        if self.main is not None and self.main.target != 1.0:
            self.animate(1.0)

    def animate(self, target):
        for v in self.views:
            v.target = target
        if self.anim is None:
            self.anim = GLib.timeout_add(16, self._step)

    def _step(self):
        done = True
        for v in self.views:
            d = v.target - v.stage
            if abs(d) > 0.001:
                v.stage += max(-0.07, min(0.07, d))
                done = False
            else:
                v.stage = v.target
            v.apply_stage()
        if self.main is None:
            self.anim = None
            return False
        if self.main.target == 1.0 and self.main.stage > 0.5 and not self.main.pw.has_focus():
            self.main.pw.grab_focus()
        if done:
            self.anim = None
            if self.main.target == 0.0:
                self.main.pw.set_text("")
                self.main.set_msg("")
            return False
        return True

    def _key(self, win, ev):
        self.poke()
        if self.main is None:
            return True
        if self.main.target != 1.0:
            self.reveal()
            # 첫 글자를 버리지 않게 — 글자 키면 비밀번호 칸으로 넘긴다
            ch = Gdk.keyval_to_unicode(ev.keyval)
            if ch and ch >= 32 and not (ev.state & Gdk.ModifierType.CONTROL_MASK):
                GLib.idle_add(self._type_first, chr(ch))
            return True
        if ev.keyval == Gdk.KEY_Escape:
            if self.main.pw.get_text():
                self.main.pw.set_text("")
            else:
                self.animate(0.0)
            return True
        if win is not self.main.get_toplevel():
            # 다른 모니터에 초점이 있으면 — 입력을 주 화면 비밀번호 칸으로 직접 옮긴다
            #   (초점만 옮기면 첫 글자 뒤의 키가 그 모니터에서 버려진다)
            e = self.main.pw
            if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.submit()
            elif ev.keyval == Gdk.KEY_BackSpace:
                e.set_text(e.get_text()[:-1])
            else:
                ch = Gdk.keyval_to_unicode(ev.keyval)
                if ch and ch >= 32 and not (ev.state & Gdk.ModifierType.CONTROL_MASK):
                    e.set_text(e.get_text() + chr(ch))
            e.set_position(-1)
            return True
        caps = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_caps_lock_state()
        cur = self.main.msg.get_text()
        if caps and not cur:
            self.main.set_msg("Caps Lock 이 켜져 있습니다.", info=True)
        elif not caps and cur.startswith("Caps"):
            self.main.set_msg("")
        return False

    def _type_first(self, ch):
        e = self.main.pw
        e.grab_focus()
        e.set_text(e.get_text() + ch)
        e.set_position(-1)
        return False

    # ── 확인 ──
    def submit(self):
        if self.busy:
            return
        pw = self.main.pw.get_text()
        if not pw:
            self.main.set_msg("비밀번호를 입력하세요.", info=True)
            return
        self.busy = True
        self.main.pw.set_sensitive(False)
        self.main.go.set_sensitive(False)
        self.main.set_msg("확인하는 중…", info=True)
        threading.Thread(target=self._check, args=(pw,), daemon=True).start()

    def _check(self, password):
        # PAM 은 틀리면 몇 초 기다리게 한다 → 화면이 멈추지 않게 따로 돈다
        if DEMO:
            time.sleep(0.6)
            code = 0 if password == "demo" else 7
        else:
            try:
                import pam
                svc = PAM_SERVICE if os.path.exists(f"/etc/pam.d/{PAM_SERVICE}") else "login"
                p = pam.pam()
                code = 0 if p.authenticate(self.user, password, service=svc) else int(p.code or 7)
                if code:
                    print("PAM:", code, p.reason, file=sys.stderr)
            except Exception as e:
                print("PAM 오류:", e, file=sys.stderr)
                code = -1
        GLib.idle_add(self._done, code)

    # PAM 이 돌려준 까닭 → 보여 줄 말. python-pam 의 authenticate 는 비밀번호 확인(pam_authenticate) 뒤
    #   계정 확인(pam_acct_mgmt)까지 해서, 만료·잠김도 "틀림"과 똑같이 False 였다
    PAM_NEW_AUTHTOK_REQD, PAM_ACCT_EXPIRED, PAM_AUTHTOK_EXPIRED = 12, 13, 27
    PAM_MESSAGES = {
        13: "계정이 만료됐습니다 — 관리자에게 문의하세요.",
        6: "이 계정은 지금 잠금을 풀 수 없습니다 (권한 거부).",
        11: "시도 횟수를 넘었습니다 — 잠시 뒤 다시 해 보세요.",
        9: "인증 정보를 확인할 수 없습니다 — 잠시 뒤 다시 해 보세요.",
        -1: "인증 모듈 오류 — 잠금을 풀 수 없습니다.",
    }

    def _done(self, code):
        self.busy = False
        if code == 0:
            self.unlock()
            return False
        if code in (self.PAM_NEW_AUTHTOK_REQD, self.PAM_AUTHTOK_EXPIRED):
            # 비밀번호는 맞았다(pam_acct_mgmt 는 인증에 성공한 뒤에만 불린다) — 이미 로그인한 사람이니
            #   잠금은 풀고 바꾸라고 알린다. 잠금 화면에서 바꾸게 하면 영영 못 들어갈 수 있다
            try:
                subprocess.Popen(["notify-send", "-a", "보안", "-u", "critical", "-i", "dialog-password",
                                  "비밀번호가 만료됐습니다",
                                  "새 비밀번호로 바꿔 주세요 — 설정 → 계정, 또는 터미널에서 passwd"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
            self.unlock()
            return False
        self.fails += 1
        self.main.pw.set_sensitive(True)
        self.main.go.set_sensitive(True)
        self.main.pw.set_text("")
        self.main.set_msg(self.PAM_MESSAGES.get(code, "비밀번호가 올바르지 않습니다.") +
                          (f" ({self.fails}번째)" if self.fails > 1 else ""))
        self.main.pw.grab_focus()
        self.poke()
        return False

    def switch_user(self):
        # 이 세션은 잠긴 채로 두고 다른 가상 터미널의 로그인 화면으로 (묻지 않고 허용되는 작업)
        try:
            subprocess.Popen(["pkexec", "/usr/libexec/sekai/sekai-switch-user"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        self.animate(0.0)

    def unlock(self):
        if self.lock is not None:
            self.lock.unlock_and_destroy()
            Gdk.Display.get_default().sync()
        clear_mark()                            # 사용자가 풀었다 — 감시자가 다시 띄우지 않는다
        self.exit_code = 0
        Gtk.main_quit()


def apply_style():
    """모양 — 여기서 무엇이 잘못돼도 잠금은 이미 걸려 있어야 한다 (그래서 Locker() 뒤에 부른다)"""
    prov = Gtk.CssProvider()
    try:
        prov.load_from_data((CSS % {"accent": accent_color()}).encode())
    except Exception as e:
        print("잠금 화면 스타일 오류 — 기본 색으로:", e, file=sys.stderr)
        try:
            prov.load_from_data((CSS % {"accent": "#39c5bb"}).encode())
        except Exception:
            return
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_USER)
    try:
        st = Gtk.Settings.get_default()
        if st:
            st.set_property("gtk-application-prefer-dark-theme", True)
            if os.path.isdir("/usr/share/icons/Papirus-Dark"):
                st.set_property("gtk-icon-theme-name", "Papirus-Dark")
    except Exception:
        pass


def main():
    # 세션 잠금을 먼저 건다 — 설정 파일이 깨져 있어도 잠그기 전에 죽지 않게
    #   (예전엔 스타일을 먼저 만들다 "appearance": null·잘못된 강조색에서 예외로 끝나,
    #    절전 직전 잠금이 실패한 채 절전에 들어갔다)
    #   종료 코드 (--fg 로 앞에서 돌릴 때 의미가 있다): 0 풀림 · 1 잠그지 못함 · 2 컴포지터가 잠금을 끝냄
    locker = Locker()
    apply_style()
    Gtk.main()
    sys.exit(getattr(locker, "exit_code", 1))


if __name__ == "__main__":
    main()
