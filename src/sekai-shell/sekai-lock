def settings():
    try:
        with open(CFG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def signal_ready(ok):
    global READY_FD
    if ok:
        try:
            with open(LOCKED_MARK, "w") as f:
                f.write(str(os.getpid()))
            atexit.register(lambda: os.path.exists(LOCKED_MARK) and os.remove(LOCKED_MARK))
        except OSError:
            pass
    if READY_FD is not None:
        try:
            os.write(READY_FD, b"1" if ok else b"0")
            os.close(READY_FD)
        except OSError:
            pass
        READY_FD = None


