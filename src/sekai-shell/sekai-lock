def blurred(pb, W, H):
    """화면 크기로 채운 뒤 흐리게 — 작게 줄였다가 부드럽게 키우는 방식 (빠르다)."""
    bw, bh = pb.get_width(), pb.get_height()
    s = max(W / bw, H / bh)
    nw, nh = max(1, int(bw * s)), max(1, int(bh * s))
    full = pb.scale_simple(nw, nh, GdkPixbuf.InterpType.BILINEAR)
    small = full.scale_simple(max(1, nw // 24), max(1, nh // 24), GdkPixbuf.InterpType.HYPER)
    small = small.scale_simple(max(1, nw // 12), max(1, nh // 12), GdkPixbuf.InterpType.BILINEAR)
    return full, small.scale_simple(nw, nh, GdkPixbuf.InterpType.BILINEAR)


def draw_cover(cr, pb, W, H):
    if pb is None:
        cr.set_source_rgb(0.08, 0.08, 0.09)
        cr.paint()
        return
    Gdk.cairo_set_source_pixbuf(cr, pb, (W - pb.get_width()) / 2, (H - pb.get_height()) / 2)
    cr.paint()


