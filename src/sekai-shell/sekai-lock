        self.stage = 0.0            # 0 = 커튼, 1 = 로그인 (그 사이는 전환 중)
        self.target = 0.0
        self.imgs = None            # (선명, 흐림) — 크기가 정해진 뒤 만든다
        self.size = (0, 0)

        self.back = Gtk.DrawingArea()
        self.back.connect("draw", self._draw)
        self.add(self.back)

        # 커튼: 가운데 위쪽 큰 시계 (윈도우 잠금 화면)
