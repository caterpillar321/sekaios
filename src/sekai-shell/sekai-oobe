def helper(req, timeout=90):
    """도우미에게 한 줄 JSON 을 보내고 답을 받는다"""
    if DEMO:
        time.sleep(0.4)
        if req["op"] == "net":
            return {"ok": True, "wifi": True, "connected": [{"type": "ethernet", "name": "유선 연결 1"}],
                    "internet": True}
        if req["op"] == "wifi_scan":
            return {"ok": True, "networks": [{"ssid": "Sekai-Home", "signal": 82, "secure": True, "active": False},
                                             {"ssid": "Cafe_Free", "signal": 45, "secure": False, "active": False}]}
        return {"ok": True}
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(SOCK)
        s.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode())
        f = s.makefile("rb")
        return json.loads(f.readline() or b"{}")
    except Exception as e:
        return {"ok": False, "error": f"설정 도우미와 연결하지 못했습니다 ({type(e).__name__})"}
    finally:
        s.close()


def _system_user(name):
    """sshd·messagebus 같은 시스템 계정 이름인지 (도우미도 거부하지만 화면에서 먼저 알려 준다)"""
    try:
        return pwd.getpwnam(name).pw_uid < 1000
    except KeyError:
        return False


def in_thread(fn, done):
    threading.Thread(target=lambda: GLib.idle_add(done, fn()), daemon=True).start()


