    def build_account(self):
        box = W.page_box("계정을 만드세요", "이 컴퓨터를 쓸 사람의 이름과 암호입니다. 이 계정은 관리자 권한(sudo)을 가집니다.")
        g = Gtk.Grid(column_spacing=16, row_spacing=10)
        g.set_margin_top(8)
        self.f_full, self.f_user, self.f_pw, self.f_pw2 = (Gtk.Entry() for _ in range(4))
        self.f_full.set_placeholder_text("예: 하츠네 미쿠")
        self.f_user.set_placeholder_text("영문 소문자로 시작")
        for e in (self.f_pw, self.f_pw2):
            e.set_visibility(False)
            e.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        rows = [("이름", self.f_full, "화면에 보이는 이름 — 한글도 됩니다"),
                ("사용자 이름", self.f_user, "로그인·홈 폴더 이름 — 영문 소문자·숫자"),
                ("암호", self.f_pw, ""), ("암호 확인", self.f_pw2, "")]
        for i, (k, e, sub) in enumerate(rows):
            g.attach(W.label(k, "row-title"), 0, i, 1, 1)
            e.set_width_chars(28)
            g.attach(e, 1, i, 1, 1)
            g.attach(W.label(sub, "row-sub"), 2, i, 1, 1)
        box.pack_start(g, False, False, 0)
        self.acct_err = W.label("", "field-err")
        box.pack_start(self.acct_err, False, False, 0)
        self.user_touched = False
        self.f_full.connect("changed", lambda *_: self._auto_user())
        self.f_user.connect("changed", lambda *_: self._check_acct())
        self.f_user.connect("key-press-event", lambda *_: setattr(self, "user_touched", True))
        for e in (self.f_pw, self.f_pw2):
            e.connect("changed", lambda *_: self._check_acct())
        self.f_pw2.connect("activate", lambda *_: self.wz.next_btn.get_sensitive() and self.go_style())
        return box

    def _auto_user(self):
        if self.user_touched:
            self._check_acct()
            return
        # 이름이 영문이면 거기서 사용자 이름을 만들고, 한글이면 비워 두고 직접 쓰게 한다
        base = re.sub(r"[^a-z0-9]", "", self.f_full.get_text().lower().split(" ")[0])
        if base and base[0].isalpha():
            self.f_user.set_text(base[:20])
        self._check_acct()

    def _check_acct(self):
        u, p1, p2 = self.f_user.get_text(), self.f_pw.get_text(), self.f_pw2.get_text()
        err = ""
        if u and not re.match(r"^[a-z][a-z0-9_-]{0,30}$", u):
            err = "사용자 이름은 영문 소문자로 시작하고 영문 소문자·숫자·_·- 만 쓸 수 있습니다"
        elif u in ("root", "admin", "daemon", "bin", "sys", "nobody", "sekai-oobe") or _system_user(u):
            err = "쓸 수 없는 사용자 이름입니다 (시스템이 쓰는 이름)"
        elif ":" in self.f_full.get_text():
            err = "이름에 : 는 쓸 수 없습니다"
        elif p2 and p1 != p2:
            err = "암호가 서로 다릅니다"
        self.acct_err.set_text(err)
        ok = bool(u and p1 and p1 == p2 and not err)
        self.wz.set_next_enabled(ok)
        if ok:
            self.st.update(fullname=self.f_full.get_text().strip(), username=u, password=p1)
        self.wz.hint.set_text("암호는 잊지 않을 만한 것으로 — 로그인과 관리자 작업에 씁니다"
                              if not p1 or len(p1) >= 6 else "6자 이상을 권장합니다")

    def go_account(self, forward=True):
        self.wz.show_page("account", back=lambda: self.go_name(False), next_enabled=False, forward=forward)
        self.wz.on_next = self.go_style
        self._check_acct()
        GLib.idle_add((self.f_full if not self.f_full.get_text() else self.f_pw).grab_focus)

    # ── 꾸미기 ──
    def build_style(self):
        box = W.page_box("나만의 색을 고르세요", "강조색과 배경화면입니다. 언제든 설정 › 색 및 모양에서 바꿀 수 있습니다.")
        box.pack_start(W.label("강조색", "section-title"), False, False, 0)
        sw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.swatches = {}
        for hexc, name in ACCENTS:
            b = Gtk.Button()
            b.get_style_context().add_class("swatch-btn")
            b.set_tooltip_text(name)
            prov = Gtk.CssProvider()
            prov.load_from_data(f"button {{ background: {hexc}; }}".encode())
            b.get_style_context().add_provider(prov, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            b.connect("clicked", lambda _b, h=hexc: self._pick_accent(h))
            sw.pack_start(b, False, False, 0)
            self.swatches[hexc] = b
        box.pack_start(sw, False, False, 0)
        box.pack_start(W.label("배경화면", "section-title"), False, False, 0)
        wb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.walls = {}
        for key, name in WALLS:
            ev = Gtk.EventBox()
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            v.get_style_context().add_class("wall-pick")
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(f"{WALLDIR}/{key}.jpg", 240, 135, False)
                v.pack_start(Gtk.Image.new_from_pixbuf(pb), False, False, 0)
            except Exception:
                v.pack_start(W.icon("image-x-generic", 64), False, False, 0)
            v.pack_start(W.label(name, "choice-sub", 0.5), False, False, 0)
            ev.add(v)
            ev.connect("button-press-event", lambda *_a, k=key: self._pick_wall(k))
            wb.pack_start(ev, False, False, 0)
            self.walls[key] = v
        box.pack_start(wb, False, False, 0)
        return box

    def _pick_accent(self, h):
        self.st["accent"] = h
        for k, b in self.swatches.items():
            (b.get_style_context().add_class if k == h else b.get_style_context().remove_class)("selected")

    def _pick_wall(self, k):
        self.st["wallpaper"] = k
        for key, v in self.walls.items():
            (v.get_style_context().add_class if key == k else v.get_style_context().remove_class)("selected")
        try:
            self.bg = GdkPixbuf.Pixbuf.new_from_file(f"{WALLDIR}/{k}.jpg")
            self.queue_draw()
        except Exception:
            pass

    def go_style(self, forward=True):
        self._pick_accent(self.st["accent"])
        self._pick_wall(self.st["wallpaper"])
        self.wz.show_page("style", back=lambda: self.go_account(False), next_label="마치기", forward=forward)
        self.wz.on_next = self.go_setup

    # ── 준비 ──
    def build_setup(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.set_valign(Gtk.Align.CENTER)
        box.set_halign(Gtk.Align.CENTER)
        lg = W.logo_widget(80)
        lg.set_halign(Gtk.Align.CENTER)
        box.pack_start(lg, False, False, 0)
        self.setup_title = W.label("잠시만 기다려 주세요", "wiz-title", 0.5)
        box.pack_start(self.setup_title, False, False, 0)
        self.setup_msg = W.label("", "setup-msg", 0.5)
        box.pack_start(self.setup_msg, False, False, 0)
        sp = Gtk.Spinner()
        sp.set_size_request(28, 28)
        sp.start()
        box.pack_start(sp, False, False, 6)
        return box

    def go_setup(self):
        name = self.st["fullname"] or self.st["username"]
        self.setup_title.set_text(f"{name}님, 환영합니다")
        self.wz.show_page("setup", back=None, next_label=None, footer=False)
        msgs = iter(["계정을 만드는 중", "설정을 적용하는 중", "바탕화면을 준비하는 중"])
        self.setup_msg.set_text(next(msgs))

        def rotate():
            m = next(msgs, None)
            if m and self.wz.stack.get_visible_child_name() == "setup":
                self.setup_msg.set_text(m)
                return True
            return False
        GLib.timeout_add(1600, rotate)
        req = dict(self.st, op="apply")
        in_thread(lambda: helper(req, timeout=180), self._applied)

    def _applied(self, r):
        if not r.get("ok"):
            self.go_error(r.get("error", "설정하지 못했습니다"))
            return False
        in_thread(lambda: helper({"op": "finish"}), self._finished)
        return False

    def _finished(self, _r):
        # 다음 로그인 화면이 이 사람을 먼저 보여 주게
        try:
            d = os.path.expanduser("~/.cache/sekai-greeter")
            os.makedirs(d, exist_ok=True)
            with open(os.path.join(d, "last-user"), "w") as f:
                f.write(self.st["username"])
        except OSError:
            pass
        in_thread(self._login, self._logged_in)
        return False

    def _login(self):
        if DEMO:
            time.sleep(1.5)
            return None
        from sekaishell.greetd import Greetd, GreetdError
        try:
            return Greetd().login(self.st["username"], self.st["password"], SESSION_CMD, SESSION_ENV)
        except (GreetdError, OSError) as e:
            return f"로그인하지 못했습니다 ({e})"

    def _logged_in(self, err):
        self.st["password"] = ""
        if err:
            # 계정은 만들어졌다 — 로그인 화면으로 넘겨 직접 들어가게
            self.setup_msg.set_text("로그인 화면에서 암호를 입력해 주세요")
            GLib.timeout_add(2500, Gtk.main_quit)
            return False
        self.setup_msg.set_text("거의 다 됐습니다")
        GLib.timeout_add(400, Gtk.main_quit)          # 이 화면이 끝나야 greetd 가 세션을 연다
        return False

    # ── 오류 ──
    def build_error(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_valign(Gtk.Align.CENTER)
        box.pack_start(W.icon(["dialog-error-symbolic", "dialog-error"], 56), False, False, 0)
        box.pack_start(W.label("설정하지 못했습니다", "wiz-title", 0.5), False, False, 0)
        self.err_lbl = W.label("", "wiz-sub", 0.5, wrap=True)
        box.pack_start(self.err_lbl, False, False, 0)
        return box

    def go_error(self, msg):
        self.err_lbl.set_text(msg)
        self.wz.show_page("error", back=lambda: self.go_account(False), next_label="다시 시도")
        self.wz.on_next = self.go_setup


def main():
    W.load_css(OOBE_CSS)
    win = Oobe()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    win.go_lang()
    Gtk.main()


if __name__ == "__main__":
    main()
