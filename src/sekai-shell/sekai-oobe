    def go_net(self, forward=True):
        for w in (self.wifi_head, self.wifi_list, self.wifi_pw_box, self.wifi_err):
            w.hide()
        self.wz.show_page("net", back=lambda: self.go_region(False), next_label="건너뛰기",
                          hint="나중에 작업 표시줄의 네트워크 아이콘에서도 연결할 수 있습니다", forward=forward)
        self.wz.on_next = self.go_name
        in_thread(lambda: helper({"op": "net"}), self._net_done)

    def _net_done(self, r):
        conns = r.get("connected") or []
        if conns:
            c = conns[0]
            wired = c.get("type") == "ethernet"
            self.net_icon.set_from_icon_name("network-wired-symbolic" if wired else
                                             "network-wireless-signal-excellent-symbolic", Gtk.IconSize.DIALOG)
            self.net_title.set_text(("유선 네트워크" if wired else "Wi-Fi") + "에 연결되었습니다")
            self.net_sub.set_text(c.get("name", "") + ("  ·  인터넷 사용 가능" if r.get("internet") else ""))
            self.wz.next_btn.set_label("다음")
        else:
            self.net_icon.set_from_icon_name("network-offline-symbolic", Gtk.IconSize.DIALOG)
            self.net_title.set_text("연결되어 있지 않습니다")
            self.net_sub.set_text("아래에서 Wi-Fi 를 고르거나 랜선을 꽂으세요" if r.get("wifi") else "랜선을 꽂으면 자동으로 연결됩니다")
        if r.get("wifi"):
            self.wifi_head.show_all()
            self.wifi_list.show_all()
            self._scan()
        return False

    def _scan(self):
        self.wifi_list.clear()
        self.wifi_list.pack_start(W.label("찾는 중…", "choice-sub"), False, False, 0)
        self.wifi_list.show_all()
        in_thread(lambda: helper({"op": "wifi_scan"}), self._scan_done)

    def _scan_done(self, r):
        self.wifi_list.clear()
        self.nets = {n["ssid"]: n for n in r.get("networks") or []}
        for n in self.nets.values():
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            lvl = "excellent" if n["signal"] > 70 else "good" if n["signal"] > 45 else "ok" if n["signal"] > 25 else "weak"
            h.pack_start(W.icon(f"network-wireless-signal-{lvl}-symbolic", 20), False, False, 0)
            h.pack_start(W.label(n["ssid"], "choice-title"), True, True, 0)
            h.pack_end(W.label("연결됨" if n["active"] else "보안" if n["secure"] else "개방", "choice-sub"),
                       False, False, 0)
            self.wifi_list.add(n["ssid"], h)
        if not self.nets:
            self.wifi_list.pack_start(W.label("주변에 Wi-Fi 가 없습니다", "choice-sub"), False, False, 0)
        self.wifi_list.show_all()
        return False

    def _pick_wifi(self, ssid):
        self.pick_ssid = ssid
        n = self.nets.get(ssid, {})
        self.wifi_err.hide()
        self.wifi_pw.set_text("")
        self.wifi_pw.set_visible(n.get("secure", True))
        self.wifi_pw_box.show()
        (self.wifi_pw if n.get("secure", True) else self.wifi_btn).grab_focus()

    def _connect(self):
        self.wifi_btn.set_sensitive(False)
        self.wifi_btn.set_label("연결하는 중…")
        req = {"op": "wifi_connect", "ssid": self.pick_ssid, "password": self.wifi_pw.get_text()}
        in_thread(lambda: helper(req), self._connect_done)

    def _connect_done(self, r):
        self.wifi_btn.set_sensitive(True)
        self.wifi_btn.set_label("연결")
        if r.get("ok"):
            self.wifi_pw_box.hide()
            in_thread(lambda: helper({"op": "net"}), self._net_done)
        else:
            self.wifi_err.set_text(r.get("error", "연결하지 못했습니다"))
            self.wifi_err.show()
        return False

    # ── 컴퓨터 이름 ──
    def build_name(self):
        box = W.page_box("이 컴퓨터의 이름을 정하세요",
                         "네트워크에서 다른 기기에 보이는 이름입니다. 영문, 숫자, 하이픈(-)만 쓸 수 있습니다.")
        self.host = Gtk.Entry()
        self.host.set_max_length(63)
        self.host.set_width_chars(30)
        self.host.set_halign(Gtk.Align.START)
        self.host.connect("changed", lambda *_: self._check_host())
        self.host.connect("activate", lambda *_: self.wz.next_btn.get_sensitive() and self.go_account())
        box.pack_start(self.host, False, False, 8)
        self.host_err = W.label("", "field-err")
        box.pack_start(self.host_err, False, False, 0)
        return box

    def _check_host(self):
        t = self.host.get_text()
        ok = bool(re.match(r"^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$", t))
        self.host_err.set_text("" if ok or not t else "영문, 숫자, 하이픈(-)만 쓸 수 있고 하이픈으로 시작·끝날 수 없습니다")
        self.wz.set_next_enabled(ok)
        if ok:
            self.st["hostname"] = t

    def go_name(self, forward=True):
        self.host.set_text(self.st["hostname"])
        self.wz.show_page("name", back=lambda: self.go_net(False), forward=forward)
        self.wz.on_next = self.go_account
        self._check_host()
        GLib.idle_add(self.host.grab_focus)

