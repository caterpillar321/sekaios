def login_users():
    """로그인할 수 있는 사람 계정 (uid 1000~, 셸이 있는 것)."""
    out = []
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(("nologin", "false")):
            real = (p.pw_gecos or "").split(",")[0].strip()
            out.append((p.pw_name, real or p.pw_name))
    return sorted(out)


def signed_in():
    """이미 로그인해 있는 사람 → 그 세션 번호 (사용자 전환으로 잠시 떠난 사람들)"""
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--json=short"],
                             capture_output=True, text=True, timeout=3).stdout
        res = {}
        for s in json.loads(out or "[]"):
            if s.get("class") != "user" or s.get("seat") != "seat0" or not s.get("tty"):
                continue
            # 로그아웃했는데 프로세스가 남아 "closing" 인 세션은 로그인한 게 아니다
            # 그래픽 세션만 — 글자 콘솔(Ctrl+Alt+F2) 로그인은 "로그인해 있는 사람"이 아니다 (그걸 세면
            #   비밀번호 입력 칸 대신 "잠금 화면이 나옵니다"가 떠 그 콘솔로 넘겨졌다)
            props = dict(l.partition("=")[::2] for l in subprocess.run(
                ["loginctl", "show-session", str(s["session"]), "-p", "State", "-p", "Type"],
                capture_output=True, text=True, timeout=3).stdout.splitlines())
            if props.get("State") in ("active", "online") and props.get("Type") in ("wayland", "x11"):
                res[s["user"]] = s["session"]
        return res
    except Exception:
        return {}


# PAM 이 greetd 에 준 까닭(설명 글) → 보여 줄 말. 오류 문장은 영어(C 로캘)로 온다
PAM_REASONS = (
    (("account has expired", "acct_expired"), "계정이 만료됐습니다 — 관리자에게 문의하세요."),
    (("new one required", "authentication token expired", "password expired", "password has expired"),
     "비밀번호가 만료됐습니다 — 새 비밀번호로 바꿔야 합니다. Ctrl+Alt+F2 의 글자 화면에서 로그인하면 바꿀 수 있습니다."),
    (("permission denied",), "이 계정은 지금 로그인할 수 없습니다 (권한 거부)."),
    (("maximum number of tries", "maxtries"), "시도 횟수를 넘었습니다 — 잠시 뒤 다시 해 보세요."),
    (("locked",), "계정이 잠겼습니다 — 잠시 뒤 다시 하거나 관리자에게 문의하세요."),
)
EXPIRED_MSG = PAM_REASONS[1][1]
# 비밀번호를 바꾸라는 대화(비밀번호가 맞은 뒤 greetd 가 pam_chauthtok 으로 넘어간다)에서 나오는 말
CHANGE_HINTS = ("change your password", "password change", "new password", "current password",
                "expired", "암호", "비밀번호")


def explain(desc, default):
    d = (desc or "").lower()
    for keys, msg in PAM_REASONS:
        if any(k in d for k in keys):
            return msg
    return default


def greetd_login(g, user, password, cmd, env):
    """greetd 로 로그인. 성공하면 None, 실패하면 보여 줄 말.
    sekaishell.greetd.Greetd.login 과 같되, 비밀번호를 두 번째로 묻는 것을 무조건 "틀림"으로 보지 않는다 —
    비밀번호가 만료되면 greetd 는 인증에 성공한 뒤 바꾸기 대화(새 비밀번호 묻기)로 넘어가는데,
    예전엔 그게 "비밀번호가 올바르지 않습니다"로 보였다. 이 화면에서 바꾸기는 아직 하지 않으므로
    취소하고 알린다. 계정 만료·잠김 같은 오류도 까닭대로."""
    r = g.create_session(user)
    answered = False
    said = []                                   # 받은 안내·오류 글 (까닭을 알아보려고)
    while r.get("type") == "auth_message":
        kind = r.get("auth_message_type")
        text = r.get("auth_message") or ""
        if kind in ("secret", "visible"):
            if answered:
                g.cancel()
                seen = " ".join(said + [text]).lower()
                if any(h in seen for h in CHANGE_HINTS):
                    return EXPIRED_MSG
                return "추가 인증을 요구합니다 — 이 로그인 화면에선 아직 지원하지 않는 방식입니다."
            r = g.respond(password)
            answered = True
        else:                                   # info / error — 기록해 두고 넘긴다
            said.append(text)
            r = g.respond(None)
    if r.get("type") == "error":
        g.cancel()
        desc = r.get("description") or ""
        default = "비밀번호가 올바르지 않습니다." if r.get("error_type") == "auth_error" else \
            (desc or "로그인하지 못했습니다.")
        return explain(" ".join(said + [desc]), default)
    r = g.start_session(cmd, env)
    if r.get("type") != "success":
        g.cancel()
        return explain(r.get("description"), r.get("description") or "세션을 시작하지 못했습니다.")
    return None


def last_user():
    try:
        with open(os.path.join(STATE, "last-user")) as f:
            return f.read().strip()
    except OSError:
        return None


def remember_user(name):
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "last-user"), "w") as f:
            f.write(name)
    except OSError:
        pass


# ── 자판 배열 — 윈도우처럼 고른 사람의 입력 배열로 ──
#   설정 앱이 해상도와 함께 /var/lib/sekai/displays/<사람>.conf 에 게시한다 (sekaisettings.store.publish_display).
#   아무나 쓰는 폴더라 주인이 그 사람인 작은 일반 파일만 읽고, 값은 형식을 엄격히 검사한다.
#   안 하면 설정에서 de·fr 배열로 바꾼 사람은 잠금 화면에선 풀리는 비밀번호가 로그인 화면에선 틀렸다(us 고정).
DISPLAYS = "/var/lib/sekai/displays"
KB_DEFAULT = {"kb_layout": "us", "kb_variant": "",                        # greeter/hyprland.conf 의 input 과 같게
              "kb_options": "korean:ralt_hangul,korean:rctrl_hanja"}
_KB_NAME = r"[a-z][a-z0-9_]{0,15}"
_KB_OPT = r"[a-z0-9_]{1,32}:[a-z0-9_+-]{1,32}"
KB_RE = {"kb_layout": re.compile(rf"{_KB_NAME}(,{_KB_NAME}){{0,3}}"),
         "kb_variant": re.compile(r"[A-Za-z0-9_-]{0,32}(,[A-Za-z0-9_-]{0,32}){0,3}"),
         "kb_options": re.compile(rf"({_KB_OPT}(,{_KB_OPT}){{0,15}})?")}


def read_owned(path, user):
    """주인이 user 인 4KB 이하 일반 파일만 읽는다 — 한 번 연 fd 로 확인과 읽기를 같이 (링크·FIFO·바꿔치기 막기,
    sekai-greeter-session 의 read_owned 와 같다)"""
    try:
        uid = pwd.getpwnam(user).pw_uid
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except (OSError, KeyError):
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 4096:
            return None
        return os.read(fd, 4096).decode("utf-8", "replace")
    except OSError:
        return None
    finally:
        os.close(fd)


def user_keyboard(user):
    """그 사람이 설정에서 고른 자판 배열 (없거나 형식이 틀린 값은 로그인 화면 기본값).
    kb_options 가 비었으면 기본 옵션 — 세션도 그렇다 (hyprland.conf 의 옵션을 사용자 설정이 덮을 때만 바뀐다)"""
    kb = dict(KB_DEFAULT)
    text = read_owned(os.path.join(DISPLAYS, user + ".conf"), user) if user else None
    for ln in (text or "").splitlines():
        if not ln.startswith("# "):
            continue
        k, sep, v = ln[2:].partition(" = ")
        v = v.strip()
        if sep and k in KB_RE and v and KB_RE[k].fullmatch(v):
            kb[k] = v
    return kb


def apply_keyboard(kb):
    """로그인 화면의 자판을 바꾼다. 변형부터 비운다 — 새 배열에 없는 옛 변형이 잠깐이라도 남으면 자판을 못 만든다"""
    try:
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            seq = [("kb_variant", ""), ("kb_options", kb["kb_options"]), ("kb_layout", kb["kb_layout"])]
            if kb["kb_variant"]:
                seq.append(("kb_variant", kb["kb_variant"]))
            for k, v in seq:        # 빈 값은 인자로 따로 넘겨야 한다 (--batch 는 빈 값을 못 넣는다)
                subprocess.run(["hyprctl", "keyword", "input:" + k, v], timeout=3,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif os.environ.get("DISPLAY"):                               # 기본 화면 모드 (X11)
            cmd = ["setxkbmap", "-layout", kb["kb_layout"], "-variant", kb["kb_variant"], "-option", ""]
            if kb["kb_options"]:
                cmd += ["-option", kb["kb_options"]]
            subprocess.run(cmd, timeout=3, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def active_keymap():
    """지금 자판 배열 이름 (Hyprland 가 xkb 에서 받은 것, 예: English (US))"""
    try:
        out = subprocess.run(["hyprctl", "devices", "-j"], capture_output=True, text=True, timeout=2).stdout
        kbs = json.loads(out).get("keyboards") or []
    except (OSError, subprocess.SubprocessError, ValueError, AttributeError):
        return ""
    kb = next((k for k in kbs if k.get("main")), kbs[0] if kbs else {})
    return kb.get("active_keymap") or ""


def draw_avatar(widget, cr, text, size):
    """강조색 원 + 이름 첫 글자"""
    a = widget.get_allocation()
    cx, cy, r = a.width / 2, a.height / 2, size / 2
    g = __import__("cairo").LinearGradient(0, 0, a.width, a.height)
    g.add_color_stop_rgb(0, 0.37, 0.84, 0.81)
    g.add_color_stop_rgb(1, 0.20, 0.62, 0.72)
    cr.arc(cx, cy, r, 0, 6.2832)
    cr.set_source(g)
    cr.fill()
    return False


