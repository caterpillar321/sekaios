            ul = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            ul.get_style_context().add_class("userlist")
            ul.set_halign(Gtk.Align.START)
            ul.set_valign(Gtk.Align.END)
            ul.set_margin_start(40)
            ul.set_margin_bottom(220)
            self.user_buttons = {}
            self.state_labels = {}
            for uname, real in self.users:
                b = Gtk.Button()
                h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                o = Gtk.Overlay()
                d = Gtk.DrawingArea()
                d.set_size_request(30, 30)
                d.connect("draw", lambda w, cr: draw_avatar(w, cr, "", 30))
                o.add(d)
                il = Gtk.Label(label=(real or uname)[:1].upper())
                il.get_style_context().add_class("mini-avatar")
                o.add_overlay(il)
                h.pack_start(o, False, False, 0)
                nv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
                nv.set_valign(Gtk.Align.CENTER)
                nv.pack_start(Gtk.Label(label=real or uname, xalign=0), False, False, 0)
                st = Gtk.Label(label="로그인됨", xalign=0)
                st.get_style_context().add_class("signed-in")
                st.set_no_show_all(True)
                nv.pack_start(st, False, False, 0)
                h.pack_start(nv, False, False, 0)
                self.state_labels[uname] = st
                b.add(h)
                b.connect("clicked", lambda _b, u=uname: self.pick(u))
                ul.pack_start(b, False, False, 0)
                self.user_buttons[uname] = b
            ov.add_overlay(ul)

        # ── 오른쪽 아래: 전원 ──
        corner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        corner.set_halign(Gtk.Align.END)
        corner.set_valign(Gtk.Align.END)
        corner.set_margin_end(36)
        corner.set_margin_bottom(36)
        for icon, tip, cmd in (("system-reboot-symbolic", "다시 시작", ["systemctl", "reboot"]),
                               ("system-shutdown-symbolic", "시스템 종료", ["systemctl", "poweroff"])):
            b = Gtk.Button()
            b.get_style_context().add_class("corner")
            im = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
            im.set_pixel_size(20)
            b.add(im)
            b.set_tooltip_text(tip)
            b.connect("clicked", lambda _b, c=cmd: subprocess.Popen(c))
            corner.pack_start(b, False, False, 0)
        ov.add_overlay(corner)

        self.connect("key-press-event", self._key)
        self.pick(self.user)
        self._tick()
        GLib.timeout_add_seconds(1, self._tick)
        self.sessions = {}
        self._refresh_sessions()
        GLib.timeout_add_seconds(2, self._refresh_sessions)

    # ── 그리기 ──
    def _draw_bg(self, w, cr):
        a = w.get_allocation()
        if self.bg is not None:
            bw, bh = self.bg.get_width(), self.bg.get_height()
            s = max(a.width / bw, a.height / bh)          # 화면을 꽉 채우게 (잘림 허용)
            cr.save()
            cr.translate((a.width - bw * s) / 2, (a.height - bh * s) / 2)
            cr.scale(s, s)
            Gdk.cairo_set_source_pixbuf(cr, self.bg, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(0.08, 0.08, 0.09)
            cr.paint()
        # 글자가 잘 읽히게 전체를 살짝 어둡게 + 아래쪽을 더 어둡게
        import cairo
        cr.set_source_rgba(0, 0, 0, 0.25)
        cr.paint()
        g = cairo.LinearGradient(0, a.height * 0.45, 0, a.height)
        g.add_color_stop_rgba(0, 0, 0, 0, 0)
        g.add_color_stop_rgba(1, 0, 0, 0, 0.45)
        cr.set_source(g)
        cr.paint()
        return False

    def _refresh_sessions(self):
        self.sessions = signed_in()
        for u, lb in getattr(self, "state_labels", {}).items():
            lb.set_visible(u in self.sessions)
        # 고른 사람의 상태가 바뀌었으면 (그 사이 로그아웃 등) 화면을 맞춘다
        mode = self.user in self.sessions
        if mode != getattr(self, "_switch_mode", None) and not self.busy:
            self.pick(self.user)
        return True

    def _tick(self):
        t = time.localtime()
        self.clock.set_text(time.strftime("%H:%M", t))
        self.date.set_text(f"{t.tm_mon}월 {t.tm_mday}일 {WEEKDAYS[t.tm_wday]}요일")
        return True

    # ── 동작 ──
    def pick(self, uname):
        self.user = uname
        real = dict(self.users).get(uname) or uname
        self.name.set_text(real)
        self.initial.set_text(real[:1].upper())
        for u, b in getattr(self, "user_buttons", {}).items():
            ctx = b.get_style_context()
            (ctx.add_class if u == uname else ctx.remove_class)("current")
        self.pw.set_text("")
        self._set_msg("")
        # 이미 로그인해 있는 사람(사용자 전환으로 잠시 떠난 사람) → 새로 로그인하지 않고 그 화면으로
        self._switch_mode = uname in getattr(self, "sessions", {})
        self.pw.set_visible(not self._switch_mode)
        self.go.set_tooltip_text("이 사람의 화면으로 전환" if self._switch_mode else "로그인")
        if self._switch_mode:
            self._set_msg("로그인되어 있습니다 — 전환하면 이 사람의 잠금 화면이 나옵니다", info=True)
            self.go.grab_focus()
        else:
            self.pw.grab_focus()

    def _key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.pw.set_text("")
            return True
        # Caps Lock 경고 — 비밀번호가 안 맞는 가장 흔한 이유
        if not self.busy:
            caps = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_caps_lock_state()
            if caps and not self.msg.get_text():
                self._set_msg("Caps Lock 이 켜져 있습니다.", info=True)
            elif not caps and self.msg.get_text().startswith("Caps"):
                self._set_msg("")
        return False

    def _set_msg(self, text, info=False):
        self.msg.set_text(text)
        ctx = self.msg.get_style_context()
        (ctx.add_class if info else ctx.remove_class)("info")

    def submit(self):
        if self.busy:
            return
        sid = getattr(self, "sessions", {}).get(self.user)
        if sid:
            # 그 사람의 세션으로 넘어간다. 그 세션은 잠겨 있어 거기서 암호를 묻는다
            r = subprocess.run(["loginctl", "activate", sid], capture_output=True, text=True)
            if r.returncode != 0:
                self._set_msg("전환하지 못했습니다.")
            return
        password = self.pw.get_text()
        if not password:
            self._set_msg("비밀번호를 입력하세요.", info=True)
            return
        self.busy = True
        self.pw.set_sensitive(False)
        self.go.set_sensitive(False)
        self._set_msg("로그인하는 중…", info=True)
        threading.Thread(target=self._login, args=(self.user, password), daemon=True).start()

    def _login(self, user, password):
        # PAM 은 틀리면 몇 초 기다리게 한다 → 화면이 멈추지 않게 따로 돈다
        if DEMO:
            time.sleep(1.0)
            err = None if password == "demo" else "비밀번호가 올바르지 않습니다."
        else:
            try:
                err = Greetd().login(user, password, SESSION_CMD, SESSION_ENV)
            except (GreetdError, OSError) as e:
                err = f"로그인 관리자와 통신하지 못했습니다 ({e})"
        GLib.idle_add(self._done, user, err)

    def _done(self, user, err):
        self.busy = False
        if err is None:
            remember_user(user)
            self._set_msg("환영합니다", info=True)
            GLib.timeout_add(250, Gtk.main_quit)     # 그리터가 끝나야 greetd 가 세션을 연다
            return False
        self.pw.set_sensitive(True)
        self.go.set_sensitive(True)
        self.pw.set_text("")
        self._set_msg(err)
        self.pw.grab_focus()
        return False


def main():
    prov = Gtk.CssProvider()
    prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    st = Gtk.Settings.get_default()
    if st:
        st.set_property("gtk-application-prefer-dark-theme", True)
        if os.path.isdir("/usr/share/icons/Papirus-Dark"):
            st.set_property("gtk-icon-theme-name", "Papirus-Dark")
    w = Greeter()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    w.pick(w.user)          # show_all 이 숨겨 둔 입력칸을 다시 보이게 하므로 상태를 한 번 더 맞춘다
    Gtk.main()


if __name__ == "__main__":
    main()
