def login_users():
    """로그인할 수 있는 사람 계정 (uid 1000~, 셸이 있는 것)."""
    out = []
    for p in pwd.getpwall():
        if 1000 <= p.pw_uid < 60000 and not p.pw_shell.endswith(("nologin", "false")):
            real = (p.pw_gecos or "").split(",")[0].strip()
            out.append((p.pw_name, real or p.pw_name))
    return sorted(out)


def signed_in():
    """이미 로그인해 있는 사람 → 그 세션 번호 (사용자 전환으로 잠시 떠난 사람들)"""
    try:
        out = subprocess.run(["loginctl", "list-sessions", "--json=short"],
                             capture_output=True, text=True, timeout=3).stdout
        res = {}
        for s in json.loads(out or "[]"):
            if s.get("class") != "user" or s.get("seat") != "seat0" or not s.get("tty"):
                continue
            # 로그아웃했는데 프로세스가 남아 "closing" 인 세션은 로그인한 게 아니다
            st = subprocess.run(["loginctl", "show-session", str(s["session"]), "-p", "State",
                                 "--value"], capture_output=True, text=True, timeout=3).stdout.strip()
            if st in ("active", "online"):
                res[s["user"]] = s["session"]
        return res
    except Exception:
        return {}


def last_user():
    try:
        with open(os.path.join(STATE, "last-user")) as f:
            return f.read().strip()
    except OSError:
        return None


def remember_user(name):
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "last-user"), "w") as f:
            f.write(name)
    except OSError:
        pass


def draw_avatar(widget, cr, text, size):
    """강조색 원 + 이름 첫 글자"""
    a = widget.get_allocation()
    cx, cy, r = a.width / 2, a.height / 2, size / 2
    g = __import__("cairo").LinearGradient(0, 0, a.width, a.height)
    g.add_color_stop_rgb(0, 0.37, 0.84, 0.81)
    g.add_color_stop_rgb(1, 0.20, 0.62, 0.72)
    cr.arc(cx, cy, r, 0, 6.2832)
    cr.set_source(g)
    cr.fill()
    return False


class Greeter(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.users = login_users() or [(os.environ.get("USER", "user"), "")]
        names = [u for u, _ in self.users]
        lu = last_user()
        self.user = lu if lu in names else names[0]
        self.busy = False

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sekai-greeter")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                  GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, e, True)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        GtkLayerShell.set_exclusive_zone(self, -1)

        self.bg = None
        try:
            self.bg = GdkPixbuf.Pixbuf.new_from_file(WALLPAPER)
        except Exception:
            pass

        ov = Gtk.Overlay()
        self.add(ov)
        back = Gtk.DrawingArea()
        back.connect("draw", self._draw_bg)
        ov.add(back)

        # ── 왼쪽 위: 로고 ──
        mark = Gtk.DrawingArea()
        mark.set_size_request(28, 28)
        mark.connect("draw", lambda w, cr: (sekai_logo.draw(cr, 28), False)[1])
        mark.set_halign(Gtk.Align.START)
        mark.set_valign(Gtk.Align.START)
        mark.set_margin_start(36)
        mark.set_margin_top(32)
        ov.add_overlay(mark)

        # ── 가운데: 계정 ──
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        center.set_halign(Gtk.Align.CENTER)
        center.set_valign(Gtk.Align.CENTER)
        center.set_margin_bottom(40)

        self.avatar = Gtk.Overlay()
        disc = Gtk.DrawingArea()
        disc.set_size_request(112, 112)
        disc.connect("draw", lambda w, cr: draw_avatar(w, cr, "", 112))
        self.avatar.add(disc)
        self.initial = Gtk.Label()
        self.initial.get_style_context().add_class("avatar")
        self.avatar.add_overlay(self.initial)
        self.avatar.set_halign(Gtk.Align.CENTER)
        center.pack_start(self.avatar, False, False, 0)

        self.name = Gtk.Label()
        self.name.get_style_context().add_class("username")
        center.pack_start(self.name, False, False, 6)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.set_halign(Gtk.Align.CENTER)
        self.pw = Gtk.Entry()
        self.pw.get_style_context().add_class("pw")
        self.pw.set_visibility(False)
        self.pw.set_placeholder_text("비밀번호")
        self.pw.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pw.connect("activate", lambda *_: self.submit())
        self.pw.connect("changed", lambda *_: self._set_msg(""))
        row.pack_start(self.pw, False, False, 0)
        self.go = Gtk.Button()
        self.go.get_style_context().add_class("go")
        img = Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.BUTTON)
        img.set_pixel_size(18)
        self.go.add(img)
        self.go.set_tooltip_text("로그인")
        self.go.connect("clicked", lambda *_: self.submit())
        row.pack_start(self.go, False, False, 0)
        center.pack_start(row, False, False, 0)

        self.msg = Gtk.Label()
        self.msg.get_style_context().add_class("msg")
        self.msg.set_size_request(-1, 22)
        center.pack_start(self.msg, False, False, 0)
        ov.add_overlay(center)

        # ── 왼쪽 아래: 시계 ──
        clk = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        clk.set_halign(Gtk.Align.START)
        clk.set_valign(Gtk.Align.END)
        clk.set_margin_start(56)
        clk.set_margin_bottom(52)
        self.clock = Gtk.Label(xalign=0)
        self.clock.get_style_context().add_class("clock")
        self.date = Gtk.Label(xalign=0)
        self.date.get_style_context().add_class("date")
        clk.pack_start(self.clock, False, False, 0)
        clk.pack_start(self.date, False, False, 0)
        ov.add_overlay(clk)

        # ── 왼쪽 가운데 아래: 계정이 여럿이면 목록 (윈도우처럼) ──
