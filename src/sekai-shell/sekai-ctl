#!/bin/sh
# ═══════════════════════════════════════════════════════════════
#  sekai-ctl — 단축키에서 셸(작업 표시줄)에 일을 시키는 작은 명령
#
#    sekai-ctl switch next|prev|commit      Alt+Tab 창 전환기
#    sekai-ctl volume up|down|mute|mic-mute  음량 + 화면 표시
#    sekai-ctl brightness up|down           밝기 + 화면 표시
#    sekai-ctl snap left|right|up|down      창 배치 (Win+화살표)
#    sekai-ctl showdesktop                  바탕 화면 보기 (Win+D) — 다시 하면 창들을 되살린다
#    sekai-ctl power button|lid             전원 단추를 눌렀다 / 덮개가 움직였다 (설정 › 전원 및 잠금 대로)
#    sekai-ctl touchpad [toggle|on|off]     터치패드 켜고 끄기 (노트북 Fn 키)
#    sekai-ctl kbdlight up|down|toggle      키보드 조명
#    sekai-ctl airplane                     비행기 모드 켜고 끄기
#    sekai-ctl clipboard                    클립보드 기록 (Win+V)
#    sekai-ctl menu | notifications         시작 메뉴 / 알림 센터
#    sekai-ctl quicksettings                빠른 설정 (Win+A)
#    sekai-ctl osd <아이콘> <글>             화면에 잠깐 알림
#    sekai-ctl desktop new|close|next|prev   가상 데스크톱 (이름을 화면 가운데에)
#    sekai-ctl desktop go|move <번호>        그 데스크톱으로 / 지금 창을 그리로
#    sekai-ctl magnify in|out|off            돋보기 (Win + = · Win + - · Win + Esc)
#    sekai-ctl colorfilter                   색 필터 켜고 끄기 (Win + Ctrl + C)
#    sekai-ctl osk [on|off]                  화상 키보드 (Win + Ctrl + O)
#    sekai-ctl narrator [on|off]             내레이터 — Orca 화면 읽기 (Win + Ctrl + Enter)
#
#  셸이 떠 있지 않으면 음량·밝기·데스크톱 이동은 그래도 한다 (표시만 없다).
# ═══════════════════════════════════════════════════════════════
call() {
    m=$1; shift
    gdbus call --session --dest org.sekai.Shell --object-path /org/sekai/Shell \
        --method "org.sekai.Shell.$m" "$@" >/dev/null 2>&1
}

case "$1" in
    switch)
        case "$2" in
            prev)   call Switch -- -1 ;;
            commit) call SwitchCommit ;;
            *)      call Switch 1 ;;
        esac ;;
    volume)
        call Volume "${2:-up}" || case "$2" in
            up)       wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            down)     wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute)     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
        esac ;;
    brightness)
        call Brightness "${2:-up}" || case "$2" in
            up)   brightnessctl -q set 5%+ ;;
            down) brightnessctl -q -n1 set 5%- ;;
        esac ;;
    snap)          call Snap "${2:-up}" ;;
    showdesktop)   call ShowDesktop ;;                         # 바탕 화면 보기 (Win+D) — 다시 하면 되살린다
    power)         call Power "${2:-button}" ;;                # 셸이 없으면 억제도 없어 logind 가 이미 처리했다
    touchpad)      call Touchpad "${2:-toggle}" ;;
    kbdlight)      call KbdLight "${2:-up}" || case "$2" in
            down) brightnessctl -q -d '*::kbd_backlight' set 1- ;;
            *)    brightnessctl -q -d '*::kbd_backlight' set 1+ ;;
        esac ;;
    airplane)      call Airplane ;;
    clipboard)     call Clipboard ;;
    menu)          call StartMenu ;;
    notifications) call NotificationCenter ;;
    quicksettings|qs) call QuickSettings ;;
    osd)           call Osd "${2:-dialog-information-symbolic}" "${3:-}" ;;
    magnify)       call Magnify "${2:-in}" ;;                 # 돋보기 in · out · off · toggle
    colorfilter)   call ColorFilter "${2:-toggle}" ;;         # 색 필터 켜고 끄기
    osk)           call Osk "${2:-toggle}" ;;                 # 화상 키보드 on · off · toggle
    narrator)      call Narrator "${2:-toggle}" ;;            # 내레이터 on · off · toggle
    desktop)
        call Desktop "${2:-show}" "${3:-}" || case "$2" in
            next) hyprctl dispatch workspace e+1 ;;
            prev) hyprctl dispatch workspace e-1 ;;
            go)   hyprctl dispatch workspace "$3" ;;
            move) hyprctl dispatch movetoworkspace "$3" ;;
            new)  hyprctl dispatch workspace emptym ;;
        esac >/dev/null 2>&1 ;;
    *)
        sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
        exit 2 ;;
esac
