# ── 실행기(.desktop) 신뢰 ─────────────────────────────────────
def launcher_trusted(path):
    """실행기를 믿어도 되나 — Thunar·GNOME 과 같은 기준.
    실행 권한이 있고 내 파일이며, 신뢰 표시가 있어야 한다: metadata::trusted = true
    (작업 표시줄의 바로 가기 만들기가 붙인다) 또는 Thunar 의 metadata::xfce-exe-checksum 이 지금 내용과 맞음.
    브라우저로 받은 '청구서.pdf.desktop' 은 어느 것도 없다."""
    try:
        st = os.stat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or not os.access(path, os.X_OK):
        return False
    try:
        info = Gio.File.new_for_path(path).query_info(
            "metadata::trusted,metadata::xfce-exe-checksum", Gio.FileQueryInfoFlags.NONE, None)
    except GLib.Error:
        return False
    if info.get_attribute_as_string("metadata::trusted") == "true":
        return True
    want = info.get_attribute_as_string("metadata::xfce-exe-checksum")
    if not want or st.st_size > 1 << 20:
        return False
    try:
        # Thunar 는 내용의 SHA-256 을 적어 둔다 — 내용이 바뀌면 신뢰도 풀린다
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest() == want
    except OSError:
        return False


def mark_trusted(path):
    """'신뢰하고 실행' — 실행 권한과 신뢰 표시를 붙인다
    (작업 표시줄의 바로 가기 만들기 sekai-panel make_desktop_shortcut 과 같은 chmod + metadata::trusted)"""
    try:
        mode = os.stat(path).st_mode
        # 읽을 수 있는 쪽에만 실행 권한 — 755 로 못 박으면 600 이던 파일을 남에게 열어 버린다
        os.chmod(path, stat.S_IMODE(mode) | stat.S_IXUSR | ((mode & 0o044) >> 2))
    except OSError as e:
        dbg("실행 권한을 못 붙임", path, e)
    try:
        Gio.File.new_for_path(path).set_attribute_string(
            "metadata::trusted", "true", Gio.FileQueryInfoFlags.NONE, None)
    except GLib.Error as e:
        dbg("신뢰 표시를 못 붙임", path, e)


def launcher_command(path):
    """확인 창에 보일 명령 (Exec=) — 읽기만 한다"""
    try:
        if os.path.getsize(path) > 1 << 20:
            return ""
        kf = GLib.KeyFile()
        kf.load_from_file(path, GLib.KeyFileFlags.NONE)
        return kf.get_string("Desktop Entry", "Exec")
    except (OSError, GLib.Error):
        return ""


# ── 아이콘 배치 (칸 계산) ─────────────────────────────────────
def grid_size(W, H, panel_h):
    """화면에 들어가는 칸 수 (열, 행) — 아래 작업 표시줄 자리는 뺀다"""
    cols = max(1, int((W - 2 * MARGIN) // CELL_W))
    rows = max(1, int((H - panel_h - 2 * MARGIN) // CELL_H))
    return cols, rows


def cell_origin(c, r):
    return MARGIN + c * CELL_W, MARGIN + r * CELL_H


def cell_of(x, y):
    """아이콘 왼쪽 위 좌표에 가장 가까운 칸 (화면 밖일 수도)"""
    return round((x - MARGIN) / CELL_W), round((y - MARGIN) / CELL_H)


def clamp_cell(cell, cols, rows):
    return min(max(cell[0], 0), cols - 1), min(max(cell[1], 0), rows - 1)


def first_free(taken, rows):
    """위에서 아래로, 왼쪽 열부터 첫 빈 칸 — 화면이 다 차면 오른쪽 바깥 열로 넘친다 (자동 정렬과 같게)"""
    c = 0
    while True:
        for r in range(rows):
            if (c, r) not in taken:
                return c, r
        c += 1


def nearest_free(want, taken, cols, rows):
    """want 에서 가장 가까운 화면 안의 빈 칸. 화면이 다 찼으면 first_free"""
    if want not in taken and 0 <= want[0] < cols and 0 <= want[1] < rows:
        return want
    wc, wr = want
    best = None
    for c in range(cols):
        for r in range(rows):
            if (c, r) in taken:
                continue
            d = ((c - wc) * CELL_W) ** 2 + ((r - wr) * CELL_H) ** 2
            if best is None or d < best[0]:
                best = (d, (c, r))
    return best[1] if best else first_free(taken, rows)


def free_name(name, is_dir, exists):
    """겹치지 않는 이름 — 윈도우처럼 '이름 (2).확장자'. exists(이름) 가 참이면 이미 있는 이름"""
    stem, ext = name, ""
    dot = name.rfind(".")
    if not is_dir and dot > 0:
        stem, ext = name[:dot], name[dot:]
    cand, n = name, 1
    while exists(cand):
        n += 1
        cand = f"{stem} ({n}){ext}"
    return cand


