def settings():
    try:
        with open(CFG, encoding="utf-8") as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except Exception:
        return {}


def hex_rgb(h, fb=(0.224, 0.773, 0.733)):
    try:
        h = h.lstrip("#")
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except Exception:
        return fb


def desktop_dir(create=True):
    try:
        p = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True,
                           text=True, timeout=2).stdout.strip()
    except Exception:
        p = ""
    if not p or p == os.path.expanduser("~"):
        p = os.path.expanduser("~/Desktop")
    if create:
        os.makedirs(p, exist_ok=True)
    return p


def run(cmd, cwd=None):
    try:
        subprocess.Popen(cmd if isinstance(cmd, list) else ["sh", "-c", cmd],
                         start_new_session=True, cwd=cwd,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        dbg("실행 실패", cmd, e)


def notify(summary, body=""):
    """실패를 사용자에게 알린다 (알림 센터에도 남는다).
    본문이 '-' 로 시작하면 notify-send 가 옵션으로 읽으므로 본문은 따옴표로 시작하게 만든다."""
    run(["notify-send", "-a", "바탕 화면", "-i", "dialog-error", summary, body])


