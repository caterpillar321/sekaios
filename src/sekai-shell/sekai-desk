class Desk(Gtk.Window):
    def __init__(self, monitor, primary):
        super().__init__()
        self.monitor = monitor
        self.primary = primary
        self.items = []
        self.selected = set()
        self.cursor = None                 # 화살표 키의 기준 아이콘 (key)
        self.hover = None
        self.band = None                   # 끌어서 선택하는 사각형 (x0,y0,x1,y1)
        self.press = None
        self._drag = None                  # 아이콘을 끄는 중: 고른 것·누른 점
        self._drag_uris = []
        self.wall_src = None               # 원본 픽스버프
        self.wall_path = None
        self.wall_cache = {}               # (w,h,mode) → cairo 표면
        self.fade_from = None              # 전환 효과용 이전 표면
        self.fade_t = 1.0
        self.accent = (0.224, 0.773, 0.733)
        self.menu = DeskMenu()
        self.rename = RenamePopup()
        self.trust = TrustPopup()

        # 아이콘 자리·보기 설정 (주 모니터만) — 기본은 지금까지와 같게: 자동 정렬 · 이름순 · 격자
        self.auto = True                   # 보기 › 아이콘 자동 정렬
        self.snap = True                   # 보기 › 아이콘을 격자에 맞춤
        self.sort = "name"                 # 정렬 기준
        self.pos = {}                      # 파일 이름(특별 항목은 key) → [열, 행] 또는 {"x", "y"}
        self._fallback = set()             # 저장된 자리가 화면 밖·겹침이라 임시로 딴 칸에 둔 것 (key)
        self._want = {}                    # 곧 생길 이름 → (x, y, 시각): 그 근처 빈 칸에 (새 폴더·끌어다 놓기)
        self._grid = (1, 1)                # 지금 화면의 (열, 행)
        self._save_src = 0
        self._reserved = set()             # 복사·이동 중이라 곧 생길 이름
        self._jobs = set()                 # 도는 cp/mv (끝날 때까지 붙잡아 둔다)

        make_translucent(self)
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "sekai-desk")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.BACKGROUND)
        GtkLayerShell.set_monitor(self, monitor)
        for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                  GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, e, True)
        GtkLayerShell.set_exclusive_zone(self, -1)       # 작업 표시줄 밑까지 배경을 깐다
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.ON_DEMAND)

        self.area = Gtk.DrawingArea()
        self.area.set_can_focus(True)
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                             Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK |
                             Gdk.EventMask.KEY_PRESS_MASK)
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_press)
        self.area.connect("button-release-event", self.on_release)
        self.area.connect("motion-notify-event", self.on_motion)
        self.area.connect("leave-notify-event", lambda *_: self._set_hover(None))
        self.area.connect("key-press-event", self.on_key)
        self.area.connect("size-allocate", lambda *_: self.layout())
        if self.primary:
            # 끌어다 놓기 — 다른 앱의 파일(uri) + 바탕화면 안에서 아이콘 자리 옮기기(우리 형식).
            #   놓기(drop)는 직접 처리한다: GTK 기본 처리는 drag_finish 를 한 번 더 부르고,
            #   옮기기면 원본 쪽에 지우라고(del) 한다
            self.area.drag_dest_set(Gtk.DestDefaults.MOTION | Gtk.DestDefaults.HIGHLIGHT,
                                    [Gtk.TargetEntry.new(ICONS_TARGET, Gtk.TargetFlags.SAME_WIDGET, 0)],
                                    Gdk.DragAction.MOVE | Gdk.DragAction.COPY)
            self.area.drag_dest_add_uri_targets()
            self.area.connect("drag-motion", self.on_drag_motion)
            self.area.connect("drag-drop", self.on_drag_drop)
            self.area.connect("drag-data-received", self.on_drop)
            self.area.connect("drag-data-get", self.on_drag_get)
            self.area.connect("drag-end", self.on_drag_end)
        self.add(self.area)

        # 바탕화면 폴더가 바뀌면 다시 읽는다 — 사진 수백 장을 복사하면 변경 알림이 수천 번 오므로
        #   한 번으로 모은다(디바운스). 썸네일은 (시각·크기)가 같으면 다시 만들지 않고,
        #   새로 만들 것은 화면이 멈추지 않게 뒤에서 조금씩 (_thumb_step).
        self._pending = 0                  # 모아 둔 새로 읽기 타이머
        self._pending_since = 0.0
        self._thumbs = {}                  # 경로 → ((시각, 크기), 픽스버프)
        self._thumb_queue = []             # 썸네일을 만들어야 할 Item
        self._thumb_src = 0
        self.monitor_file = None
        self.trash_mon = None
        self.connect("destroy", self._on_destroy)

        if self.primary:
            self._load_icons()
        self.reload_settings()
        self.dirs_mon = None
        self._dirs_src = 0
        if self.primary:
            self.ddir = desktop_dir()
            self._watch_ddir()
            # 사용자 폴더 이름이 바뀌면(언어를 바꿔 "표준 폴더 이름 업데이트" → ~/Desktop 이 ~/바탕화면) 따라간다
            self.dirs_mon = Gio.File.new_for_path(os.path.join(
                os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "user-dirs.dirs")
            ).monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.dirs_mon.connect("changed", lambda *_: self._dirs_changed())
            # 휴지통 상태(비었나/찼나)에 따라 아이콘을 바꾼다
            self.trash_mon = Gio.File.new_for_uri("trash:///").monitor_directory(
                Gio.FileMonitorFlags.NONE, None)
            self.trash_mon.connect("changed", lambda *_: self._refresh_later(300))
            self.refresh()

    def _watch_ddir(self):
        if self.monitor_file is not None:
            self.monitor_file.cancel()
        self.monitor_file = Gio.File.new_for_path(self.ddir).monitor_directory(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor_file.connect("changed", lambda *_: self._refresh_later(150))

    def _dirs_changed(self, tries=0):
        """user-dirs.dirs 가 바뀌었다 — 바탕화면 폴더가 옮겨졌으면 그 폴더를 본다.
        새 폴더는 우리가 만들지 않는다: 이름 바꾸기 도구가 옛 폴더를 옮기기 전에 빈 새 폴더가 있으면 옮기지 못한다.
        새 폴더가 생길 때까지 잠깐 기다린다 (없으면 그대로 둔다)."""
        if self._dirs_src:
            GLib.source_remove(self._dirs_src)

        def go():
            self._dirs_src = 0
            new = desktop_dir(create=False)
            if new == self.ddir:
                return False
            if not os.path.isdir(new):
                if tries < 10:
                    self._dirs_changed(tries + 1)
                return False
            self.ddir = new
            self._watch_ddir()
            self.refresh()
            return False
        self._dirs_src = GLib.timeout_add(500, go)

    def _on_destroy(self, *_):
        """모니터를 뺐다 꽂을 때마다 새로 만들어진다 — 감시·타이머·팝업·큰 그림을 놓는다
        (안 놓으면 감시 콜백이 이 창을 붙잡고 있어 해제되지 않고 계속 쌓였다)"""
        if self._save_src:                             # 미뤄 둔 자리 저장을 마저 한다
            self._save()
        for mon in (self.monitor_file, self.trash_mon, self.dirs_mon):
            if mon is not None:
                mon.cancel()
        self.monitor_file = self.trash_mon = self.dirs_mon = None
        for src in (self._pending, self._thumb_src, self._dirs_src):
            if src:
                GLib.source_remove(src)
        self._pending = self._thumb_src = self._dirs_src = 0
        self.menu.close()                              # 하위 메뉴 타이머도 멈춘다
        for pop in (self.menu.sub, self.menu, self.rename, self.trust):
            pop.catcher.destroy()
            pop.destroy()
        self.wall_src = None
        self.wall_cache = {}
        self.fade_from = None
        self.items = []
        self._thumbs = {}
        self._thumb_queue = []

    # ── 설정 ──────────────────────────────────────────────
    def reload_settings(self):
        s = settings()
        a = s.get("appearance") or {}
        self.accent = hex_rgb(a.get("accent", "#39c5bb"))
        try:
            self.panel_h = int((s.get("panel") or {}).get("height", 48))
        except (TypeError, ValueError):
            self.panel_h = 48
        w = s.get("wallpaper") or {}
        path = w.get("path") or FALLBACK_WALL
        if not os.path.exists(path):
            path = FALLBACK_WALL
        old_look = (getattr(self, "mode", None), getattr(self, "bgcolor", None))
        self.mode = w.get("mode") if w.get("mode") in ("fill", "fit", "stretch", "center", "tile",
                                                       "solid_color") else "fill"
        self.bgcolor = hex_rgb(w.get("color", "#151517"), (0.08, 0.08, 0.09))
        # 같은 이름의 파일을 새 그림으로 덮어쓴 경우도 알아본다 (시각·크기)
        stamp = file_stamp(path)
        if path != self.wall_path or stamp != getattr(self, "wall_stamp", None):
            self.wall_stamp = stamp
            old = self._current_surface()
            try:
                # 폰 사진은 EXIF 방향대로 세운다 (안 하면 사진 앱에서 배경으로 고른 세로 사진이 누워 보였다)
                self.wall_src = GdkPixbuf.Pixbuf.new_from_file(path).apply_embedded_orientation()
                self.wall_path = path
            except Exception as e:
                dbg("배경 읽기 실패", path, e)
                self.wall_src = None
            self.wall_cache.clear()
            if old is not None:                        # 이전 배경에서 새 배경으로 스르륵
                self.fade_from = old
                self.fade_t = 0.0
                GLib.timeout_add(16, self._fade_step)
        elif old_look != (self.mode, self.bgcolor):
            # 배치·바탕색이 바뀌었을 때만 다시 그린다 — 설정 앱이 저장할 때마다 SIGHUP 이 오는데,
            #   그때마다 4K 원본을 고품질로 다시 줄이면 무겁다
            self.wall_cache.clear()
        self.area.queue_draw()
        if self.primary:
            self.layout()

    def _fade_step(self):
        if self.fade_from is None:                    # 창이 닫혔다 (_on_destroy)
            return False
        self.fade_t = min(1.0, self.fade_t + 16 / 450)
        self.area.queue_draw()
        if self.fade_t >= 1.0:
            self.fade_from = None
            return False
        return True

    # ── 아이콘 자리 저장 ──────────────────────────────────
    def _load_icons(self):
        try:
            with open(ICONS_CFG, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            d = {}
        if not isinstance(d, dict):
            d = {}
        self.auto = d.get("auto_arrange", True) is not False
        self.snap = d.get("align_to_grid", True) is not False
        self.sort = d.get("sort_by") if d.get("sort_by") in dict(SORTS) else "name"
        self.pos = {}
        raw = d.get("positions")
        for k, v in (raw.items() if isinstance(raw, dict) else ()):
            if isinstance(v, list) and len(v) == 2 and all(type(n) is int for n in v):
                self.pos[k] = [v[0], v[1]]
            elif isinstance(v, dict) and all(type(v.get(n)) is int for n in ("x", "y")):
                self.pos[k] = {"x": v["x"], "y": v["y"]}

    def _save(self):
        """자리·보기 설정을 저장 — 임시 파일에 쓰고 바꿔 끼운다 (쓰다 꺼져도 반쪽 파일이 남지 않게)"""
        if self._save_src:
            GLib.source_remove(self._save_src)
            self._save_src = 0
        # 없어진 파일의 자리는 버린다. 폴더를 못 읽는 때(떼어 낸 디스크 등)는 그대로 둔다
        if os.path.isdir(self.ddir):
            self.pos = {k: v for k, v in self.pos.items()
                        if k.startswith("::") or os.path.lexists(os.path.join(self.ddir, k))}
        data = {"auto_arrange": self.auto, "align_to_grid": self.snap, "sort_by": self.sort,
                "positions": self.pos}
        tmp = f"{ICONS_CFG}.{os.getpid()}.tmp"
        try:
            os.makedirs(os.path.dirname(ICONS_CFG), exist_ok=True)
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=1)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, ICONS_CFG)
        except OSError as e:
            dbg("아이콘 자리 저장 실패", e)
        return False

    def _save_later(self):
        """새 항목의 자리 — 파일 수백 개를 복사하면 여러 번 오므로 모아서 한 번"""
        if not self._save_src:
            self._save_src = GLib.timeout_add(500, self._save)

    # ── 아이콘 목록 ───────────────────────────────────────
    def _refresh_once(self):
        self._pending = 0
        self.refresh()
        return False

    def _refresh_later(self, ms):
        """변경 알림을 모아 한 번만 다시 읽는다. 알림이 계속 와도 2초에 한 번은 읽는다."""
        if not self.primary:
            return
        now = time.monotonic()
        if self._pending:
            if now - self._pending_since > 2.0:
                return                              # 곧 돈다 — 계속 미루지 않는다
            GLib.source_remove(self._pending)
        else:
            self._pending_since = now
        self._pending = GLib.timeout_add(ms, self._refresh_once)

    def _thumb_step(self):
        """썸네일을 한 번에 몇 장씩만 — 메인 스레드에서 사진 수백 장을 한꺼번에 풀면 화면이 멈춘다"""
        for _ in range(4):
            if not self._thumb_queue:
                self._thumb_src = 0
                self.area.queue_draw()
                return False
            it, ctype, stamp = self._thumb_queue.pop(0)
            if it not in self.items:                # 그 사이 목록이 바뀌었다
                continue
            pb = thumbnail(it.path, ctype)
            self._thumbs[it.path] = (stamp, pb)
            if pb is not None:
                it.pixbuf = pb
        self.area.queue_draw()
        return True

    def refresh(self):
        items = []
        home = os.path.expanduser("~")
        items.append(Item("::computer", "내 PC", uri="computer:///", special=True, is_dir=True,
                          gicon=Gio.ThemedIcon.new("computer")))
        items.append(Item("::home", os.path.basename(home) or "홈", path=home,
                          uri=Gio.File.new_for_path(home).get_uri(), special=True, is_dir=True,
                          gicon=Gio.ThemedIcon.new("user-home")))
        # 설치 USB 로 켠 라이브 세션이면 "SekaiOS 설치" 아이콘도
        if os.path.isdir("/run/live/medium") and shutil_which("sekai-installer"):
            items.append(Item("::install", "SekaiOS 설치", special=True,
                              gicon=Gio.ThemedIcon.new_from_names(["sekaios", "system-software-install"])))
        full = self._trash_count() > 0
        items.append(Item("::trash", "휴지통", uri="trash:///", special=True, is_dir=True,
                          gicon=Gio.ThemedIcon.new("user-trash-full" if full else "user-trash")))

        entries = []
        queue = []
        recheck = False
        try:
            d = Gio.File.new_for_path(self.ddir)
            en = d.enumerate_children("standard::*,time::modified", Gio.FileQueryInfoFlags.NONE, None)
            for info in en:
                if info.get_is_hidden() or info.get_is_backup():
                    continue
                entries.append(info)
        except Exception as e:
            dbg("바탕화면 폴더 읽기 실패", e)
        for info in entries:
            p = os.path.join(self.ddir, info.get_name())
            ctype = info.get_content_type() or ""
            it = Item(p, info.get_display_name(), path=p,
                      uri=Gio.File.new_for_path(p).get_uri(), gicon=info.get_icon(),
                      is_dir=info.get_file_type() == Gio.FileType.DIRECTORY)
            it.size = info.get_size()
            it.mtime = info.get_attribute_uint64("time::modified")
            it.kind = Gio.content_type_get_description(ctype) if ctype else ""
            # 'X.DESKTOP' 도 실행기다 (GIO 는 내용 유형으로 알아보고, xdg-open 이 exo-open 에 넘기면 실행된다)
            it.is_desktop_entry = not it.is_dir and (
                p.lower().endswith(".desktop") or Gio.content_type_is_a(ctype, "application/x-desktop"))
            if it.is_desktop_entry:
                if launcher_trusted(p):
                    try:
                        app = Gio.DesktopAppInfo.new_from_filename(p)
                        if app:
                            it.app = app
                            it.name = app.get_display_name() or it.name
                            it.gicon = app.get_icon() or it.gicon
                    except Exception:
                        pass
                else:
                    # 믿을 수 없는 실행기 — 파일 안의 Name·Icon 을 쓰지 않는다 (문서 행세를 못 하게).
                    #   이름은 파일 이름 그대로('청구서.pdf.desktop'), 아이콘은 일반 실행기
                    it.gicon = UNTRUSTED_ICON
                    # 작업 표시줄은 바로 가기 파일을 쓴 다음에 신뢰 표시를 붙인다 — 막 생긴 것은 조금 뒤 다시 본다
                    if 0 <= time.time() - it.mtime < 3:        # 미래 시각 파일로 끝없이 돌지 않게
                        recheck = True
            elif ctype in IMAGE_TYPES:
                stamp = file_stamp(p)
                got = self._thumbs.get(p)
                if got is not None and got[0] == stamp:
                    it.pixbuf = got[1]                   # 이미 만든 썸네일
                else:
                    queue.append((it, ctype, stamp))
            items.append(it)
        items.sort(key=lambda i: order_key(i, self.sort))

        for it in items:
            if it.pixbuf is None:
                it.pixbuf = load_icon(it.gicon)       # 썸네일이 나오기 전엔 보통 아이콘
        keep = {k for k in self.selected if any(i.key == k for i in items)}
        self.items = items
        self.selected = keep
        # 지워진 파일의 썸네일은 버린다
        live = {i.path for i in items if i.path}
        self._thumbs = {k: v for k, v in self._thumbs.items() if k in live}
        self._thumb_queue = queue
        if queue and not self._thumb_src:
            self._thumb_src = GLib.idle_add(self._thumb_step)
        self.layout()
        if recheck:
            self._refresh_later(1000)

    def _trash_count(self):
        try:
            info = Gio.File.new_for_uri("trash:///").query_info("trash::item-count",
                                                               Gio.FileQueryInfoFlags.NONE, None)
            return info.get_attribute_uint32("trash::item-count")
        except Exception:
            return 0

    # ── 배치 ──────────────────────────────────────────────
    def layout(self):
        """아이콘 자리를 정한다.
        자동 정렬: 정렬 순서대로 왼쪽 위부터 세로로 채우고, 넘치면 다음 줄 (윈도우 기본 배치).
        손 배치: 저장된 자리에. 새 항목은 첫 빈 칸(또는 바라는 자리 근처), 화면 밖·겹친 자리는 가까운 빈 칸."""
        if not self.primary:
            return
        W, H = self._screen()
        if W < CELL_W or H < CELL_H:
            return            # 아직 크기를 받기 전 (1×1) — 가짜 크기로 자리를 정해 저장하면 안 된다
        cols, rows = self._grid = grid_size(W, H, self.panel_h)
        self._fallback = set()
        if self.auto:
            for i, it in enumerate(self.items):
                it.x, it.y = cell_origin(*divmod(i, rows))
            self.area.queue_draw()
            return
        maxx, maxy = W - CELL_W, H - self.panel_h - CELL_H
        taken, cells, pixels, moved, fresh = set(), [], [], [], []
        for it in self.items:
            p = self.pos.get(pos_key(it))
            if isinstance(p, list):
                cells.append((it, p))
            elif isinstance(p, dict):
                pixels.append((it, p))
            else:
                fresh.append(it)
        for it, (c, r) in cells:
            if 0 <= c < cols and 0 <= r < rows and (c, r) not in taken:
                taken.add((c, r))
                it.x, it.y = cell_origin(c, r)
            else:
                moved.append((it, clamp_cell((c, r), cols, rows)))
        for it, p in pixels:                           # 격자 밖 자리 — 겹쳐도 된다 (윈도우처럼)
            if 0 <= p["x"] <= maxx and 0 <= p["y"] <= maxy:
                it.x, it.y = p["x"], p["y"]
                taken.add(cell_of(it.x, it.y))
            else:
                moved.append((it, clamp_cell(cell_of(p["x"], p["y"]), cols, rows)))
        # 해상도·작업 표시줄 높이가 바뀌어 밖이 된 자리는 가까운 빈 칸에 — 저장은 하지 않는다
        #   (로그인 직후 잠깐 다른 크기를 받았다가 돌아와도 원래 자리로)
        for it, want in moved:
            cell = nearest_free(want, taken, cols, rows)
            taken.add(cell)
            it.x, it.y = cell_origin(*cell)
            self._fallback.add(it.key)
        now = time.monotonic()
        for it in fresh:                               # 처음 보는 항목 — 정렬 순서대로 첫 빈 칸
            w = self._want.pop(pos_key(it), None)
            if w and now - w[2] < 600:                 # 새 폴더를 만든 자리·끌어다 놓은 자리 근처
                cell = nearest_free(clamp_cell(cell_of(w[0], w[1]), cols, rows), taken, cols, rows)
            else:
                cell = first_free(taken, rows)
            taken.add(cell)
            it.x, it.y = cell_origin(*cell)
            self.pos[pos_key(it)] = list(cell)
        if fresh:
            self._save_later()
        self.area.queue_draw()

    def _want_spot(self, name, x, y):
        """name 이 생기면 (x, y)(아이콘 왼쪽 위) 근처 빈 칸에 둔다"""
        now = time.monotonic()
        self._want = {k: v for k, v in self._want.items() if now - v[2] < 600}
        self._want[name] = (x, y, now)

    def _snapshot(self):
        """자동 정렬을 끌 때 — 지금 자리 그대로 굳힌다 (윈도우처럼)"""
        self.pos = {pos_key(it): list(cell_of(it.x, it.y)) for it in self.items}
        self._fallback = set()

    def _pin_fallback(self):
        """임시 자리에 있던 아이콘을 그 자리로 굳힌다 — 다른 아이콘을 옮긴 뒤
        원래 칸이 비었다고 혼자 튀어 돌아가지 않게"""
        for it in self.items:
            if it.key in self._fallback:
                self.pos[pos_key(it)] = list(cell_of(it.x, it.y))
        self._fallback = set()

    def _move_icons(self, moves):
        """아이콘을 바탕화면 안의 새 자리로. moves = [(Item, 왼쪽 위 x, y)] — 앞의 것이 먼저 칸을 잡는다"""
        if not moves:
            return
        if self.auto:                                  # 손으로 옮기면 자동 정렬이 꺼진다 (윈도우처럼)
            self._snapshot()
            self.auto = False
        self._pin_fallback()
        W, H = self._screen()
        cols, rows = self._grid
        moving = {it.key for it, _x, _y in moves}
        if self.snap:
            # 가장 가까운 칸, 차 있으면 가장 가까운 빈 칸
            taken = {cell_of(i.x, i.y) for i in self.items if i.key not in moving}
            for it, x, y in moves:
                cell = nearest_free(clamp_cell(cell_of(x, y), cols, rows), taken, cols, rows)
                taken.add(cell)
                self.pos[pos_key(it)] = list(cell)
        else:
            # 자유 좌표 — 화면(작업 표시줄 위) 안으로만 제한, 겹쳐도 된다
            maxx, maxy = max(0, W - CELL_W), max(0, H - self.panel_h - CELL_H)
            for it, x, y in moves:
                self.pos[pos_key(it)] = {"x": int(min(max(x, 0), maxx)), "y": int(min(max(y, 0), maxy))}
        self._save()
        self.layout()

    def _snap_all(self):
        """격자에 맞춤을 켤 때 — 칸 밖에 있던 아이콘을 가까운 빈 칸으로 (칸 위의 것은 그대로)"""
        cols, rows = self._grid
        taken, rest = set(), []
        for it in self.items:
            cell = cell_of(it.x, it.y)
            if (it.x, it.y) == cell_origin(*cell) and cell not in taken:
                taken.add(cell)
                self.pos[pos_key(it)] = list(cell)
            else:
                rest.append(it)
        for it in rest:
            cell = nearest_free(clamp_cell(cell_of(it.x, it.y), cols, rows), taken, cols, rows)
            taken.add(cell)
            self.pos[pos_key(it)] = list(cell)
        self._fallback = set()

    def toggle_auto(self):
        """보기 › 아이콘 자동 정렬"""
        if self.auto:
            self._snapshot()                           # 꺼도 아이콘은 지금 자리 그대로
            self.auto = False
        else:
            self.auto = True
            self.pos = {}
            self._fallback = set()
        self._save()
        self.layout()

    def toggle_snap(self):
        """보기 › 아이콘을 격자에 맞춤"""
        self.snap = not self.snap
        if self.snap and not self.auto:
            self._snap_all()
        self._save()
        self.layout()

    def arrange_by(self, by):
        """정렬 기준 — 자동 정렬이 꺼져 있어도 그 순서로 한 번 다시 늘어놓는다 (윈도우처럼)"""
        self.sort = by
        self.items.sort(key=lambda i: order_key(i, by))
        if not self.auto:
            rows = self._grid[1]
            self.pos = {pos_key(it): list(divmod(i, rows)) for i, it in enumerate(self.items)}
            self._fallback = set()
        self._save()
        self.layout()

    # ── 그리기 ────────────────────────────────────────────
    def _current_surface(self):
        a = self.area.get_allocation() if self.get_realized() else None
        if not a or a.width <= 1:
            return None
        return self._wall_surface(a.width, a.height)

    def _wall_surface(self, W, H):
        key = (W, H, self.mode)
        if key in self.wall_cache:
            return self.wall_cache[key]
        surf = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
        cr = cairo.Context(surf)
        cr.set_source_rgb(*self.bgcolor)
        cr.paint()
        pb = self.wall_src if self.mode != "solid_color" else None
        if pb is not None:
            bw, bh = pb.get_width(), pb.get_height()
            if self.mode == "tile":
                Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
                cr.get_source().set_extend(cairo.EXTEND_REPEAT)
                cr.paint()
            else:
                if self.mode == "fill":
                    sx = sy = max(W / bw, H / bh)
                elif self.mode == "fit":
                    sx = sy = min(W / bw, H / bh)
                elif self.mode == "stretch":
                    sx, sy = W / bw, H / bh
                else:                                   # center
                    sx = sy = 1.0
                # 한 번만 고품질로 줄여 둔다 (매 프레임 큰 그림을 스케일하면 느리다)
                nw, nh = max(1, int(bw * sx)), max(1, int(bh * sy))
                scaled = pb.scale_simple(nw, nh, GdkPixbuf.InterpType.HYPER) if (nw, nh) != (bw, bh) else pb
                Gdk.cairo_set_source_pixbuf(cr, scaled, (W - nw) / 2, (H - nh) / 2)
                cr.paint()
        self.wall_cache = {key: surf}
        return surf

    def on_draw(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        cur = self._wall_surface(W, H)
        if self.fade_from is not None and self.fade_t < 1.0:
            cr.set_source_surface(self.fade_from, 0, 0)
            cr.paint()
            cr.set_source_surface(cur, 0, 0)
            cr.paint_with_alpha(self.fade_t * self.fade_t * (3 - 2 * self.fade_t))
        else:
            cr.set_source_surface(cur, 0, 0)
            cr.paint()
        if self.primary:
            for it in self.items:
                self._draw_item(cr, it)
            if self.band:
                x0, y0, x1, y1 = self.band
                cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
                cr.set_source_rgba(*self.accent, 0.18)
                cr.fill_preserve()
                cr.set_source_rgba(*self.accent, 0.7)
                cr.set_line_width(1)
                cr.stroke()
        return False

    def _round(self, cr, x, y, w, h, r):
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()

    def _draw_item(self, cr, it):
        x, y = it.x, it.y
        sel = it.key in self.selected
        if sel or self.hover == it.key:
            self._round(cr, x + 2, y + 2, CELL_W - 4, CELL_H - 4, 6)
            if sel:
                cr.set_source_rgba(*self.accent, 0.30)
                cr.fill_preserve()
                cr.set_source_rgba(*self.accent, 0.65)
                cr.set_line_width(1)
                cr.stroke()
            else:
                cr.set_source_rgba(1, 1, 1, 0.10)
                cr.fill()
        if it.pixbuf is not None:
            pw, ph = it.pixbuf.get_width(), it.pixbuf.get_height()
            ix, iy = x + (CELL_W - pw) / 2, y + 8 + (ICON - ph) / 2
            Gdk.cairo_set_source_pixbuf(cr, it.pixbuf, ix, iy)
            cr.paint()
            if it.app is not None:                     # 바로 가기 표시 (작은 화살표) — 믿는 실행기만
                ax, ay = x + (CELL_W - ICON) / 2, y + 8 + ICON - 14
                self._round(cr, ax, ay, 14, 14, 3)
                cr.set_source_rgb(1, 1, 1)
                cr.fill()
                cr.set_source_rgb(0.1, 0.1, 0.12)
                cr.set_line_width(1.6)
                cr.move_to(ax + 4, ay + 10)
                cr.line_to(ax + 10, ay + 4)
                cr.move_to(ax + 6, ay + 4)
                cr.line_to(ax + 10, ay + 4)
                cr.line_to(ax + 10, ay + 8)
                cr.stroke()
        # 이름 — 두 줄까지, 그림자로 어떤 배경에서도 읽히게
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(Pango.FontDescription("Pretendard 10"))
        layout.set_width((CELL_W - 8) * Pango.SCALE)
        layout.set_alignment(Pango.Alignment.CENTER)
        layout.set_wrap(Pango.WrapMode.WORD_CHAR)
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        layout.set_height(-1 if sel else -2)          # 선택되면 전체 이름
        layout.set_text(it.name, -1)
        tx, ty = x + 4, y + 8 + ICON + 6
        for dx, dy, a in ((0, 1, 0.75), (1, 1, 0.35), (-1, 1, 0.35), (0, 2, 0.25)):
            cr.move_to(tx + dx, ty + dy)
            cr.set_source_rgba(0, 0, 0, a)
            PangoCairo.show_layout(cr, layout)
        cr.move_to(tx, ty)
        cr.set_source_rgb(1, 1, 1)
        PangoCairo.show_layout(cr, layout)

    # ── 입력 ──────────────────────────────────────────────
    def item_at(self, x, y):
        for it in reversed(self.items):                # 겹치면 나중에 그린(위에 보이는) 것
            if it.x <= x < it.x + CELL_W and it.y <= y < it.y + CELL_H:
                return it
        return None

    def _set_hover(self, key):
        if key != self.hover:
            self.hover = key
            self.area.queue_draw()

    def on_motion(self, _w, ev):
        if not self.primary:
            return False
        if self.press and self.press.get("item") is None:
            x0, y0 = self.press["x"], self.press["y"]
            self.band = (x0, y0, ev.x, ev.y)
            bx0, bx1 = sorted((x0, ev.x))
            by0, by1 = sorted((y0, ev.y))
            base = self.press["base"]
            hit = {it.key for it in self.items
                   if it.x < bx1 and it.x + CELL_W > bx0 and it.y < by1 and it.y + CELL_H > by0}
            self.selected = base | hit
            self.area.queue_draw()
            return True
        if self.press and self.press.get("item") and not self.press.get("dragging"):
            if abs(ev.x - self.press["x"]) + abs(ev.y - self.press["y"]) > 8:
                self._start_drag(ev)
        it = self.item_at(ev.x, ev.y)
        self._set_hover(it.key if it else None)
        return False

    def on_press(self, _w, ev):
        self.area.grab_focus()
        if not self.primary:
            if ev.button == 3:
                self._menu_empty(ev)
            return True
        it = self.item_at(ev.x, ev.y)
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1 and it:
            self.open_items([it])
            return True
        if ev.button == 1:
            if it:
                if ctrl:
                    self.selected ^= {it.key}
                elif it.key not in self.selected:
                    self.selected = {it.key}
                self.cursor = it.key
                self.press = {"x": ev.x, "y": ev.y, "item": it}
            else:
                if not ctrl:
                    self.selected = set()
                self.press = {"x": ev.x, "y": ev.y, "item": None, "base": set(self.selected)}
            self.area.queue_draw()
        elif ev.button == 3:
            if it:
                if it.key not in self.selected:
                    self.selected = {it.key}
                self.cursor = it.key
                self.area.queue_draw()
                self._menu_item(ev)
            else:
                self.selected = set()
                self.area.queue_draw()
                self._menu_empty(ev)
        return True

    def on_release(self, _w, ev):
        self.press = None
        if self.band:
            self.band = None
            self.area.queue_draw()
        return True

    def on_key(self, _w, ev):
        if not self.primary:
            return False
        k = ev.keyval
        ctrl = bool(ev.state & Gdk.ModifierType.CONTROL_MASK)
        sel = [it for it in self.items if it.key in self.selected]
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and sel:
            self.open_items(sel)
        elif k == Gdk.KEY_Delete and sel:
            self.trash_items(sel)
        elif k == Gdk.KEY_F2 and len(sel) == 1:
            self.rename_item(sel[0])
        elif k == Gdk.KEY_F5:
            self.refresh()
        elif ctrl and k in (Gdk.KEY_a, Gdk.KEY_A):
            self.selected = {it.key for it in self.items}
            self.area.queue_draw()
        elif k == Gdk.KEY_Escape:
            self.selected = set()
            self.area.queue_draw()
        elif k in ARROWS:
            self._arrow(*ARROWS[k], bool(ev.state & Gdk.ModifierType.SHIFT_MASK))
        else:
            return False
        return True

    def _arrow(self, dx, dy, extend):
        """화살표 — 그 방향의 가장 가까운 아이콘으로 (보이는 칸 배치 기준, 같은 줄·열을 먼저).
        Shift 를 누르면 선택에 더한다. 끝에서는 멈춘다 (감아 돌지 않는다)."""
        if not self.items:
            return
        cur = next((i for i in self.items if i.key == self.cursor and i.key in self.selected), None) \
            or next((i for i in self.items if i.key in self.selected), None)
        if cur is None:
            nxt = min(self.items, key=lambda i: (i.x, i.y))    # 고른 게 없으면 왼쪽 위 첫 아이콘
        else:
            best = None
            for it in self.items:
                if it is cur:
                    continue
                ox, oy = it.x - cur.x, it.y - cur.y
                along = ox * dx + oy * dy                     # 가려는 방향으로 얼마나
                across = abs(oy) if dx else abs(ox)           # 옆으로 얼마나 비껴 있나
                if along <= 0 or across * 1.2 >= along:       # 뒤쪽이나 대각선 너머는 아니다
                    continue
                score = along + 2 * across
                if best is None or score < best[0]:
                    best = (score, it)
            if best is None:
                return
            nxt = best[1]
        if extend:
            self.selected.add(nxt.key)
        else:
            self.selected = {nxt.key}
        self.cursor = nxt.key
        self.area.queue_draw()

    # ── 끌어다 놓기 ───────────────────────────────────────
    def _drag_image(self, items, px, py):
        """끄는 동안 손가락을 따라다닐 그림 — 고른 아이콘들을 지금 배치 그대로 반투명하게 (윈도우처럼).
        그림 안에서 누른 점을 핫스폿으로 둬서, 놓으면 그림이 보이던 자리에 아이콘이 선다 (_drop_icons)."""
        x0, y0 = min(i.x for i in items), min(i.y for i in items)
        w = int(max(i.x for i in items) - x0) + CELL_W
        h = int(max(i.y for i in items) - y0) + CELL_H
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, w, h)
        cr = cairo.Context(surf)
        cr.translate(-x0, -y0)
        cr.push_group()
        for it in items:
            self._draw_item(cr, it)
        cr.pop_group_to_source()
        cr.paint_with_alpha(0.7)
        surf.set_device_offset(-(px - x0), -(py - y0))  # GTK 는 장치 오프셋의 반대를 핫스폿으로 쓴다
        return surf

    def _start_drag(self, ev):
        self.press["dragging"] = True
        it0 = self.press["item"]
        sel = [it for it in self.items if it.key in self.selected or it is it0]
        px, py = self.press["x"], self.press["y"]
        self._drag = {"keys": {it.key for it in sel}, "anchor": it0.key, "x": px, "y": py}
        # 다른 앱(Thunar 등)에 놓으면 지금처럼 파일 끌기 — 특별 항목은 파일이 아니니 뺀다.
        #   바탕화면 안에 놓으면 자리 옮기기 (우리 형식, 같은 위젯에서만)
        self._drag_uris = [it.uri for it in sel if not it.special and it.uri]
        tl = Gtk.TargetList.new([Gtk.TargetEntry.new(ICONS_TARGET, Gtk.TargetFlags.SAME_WIDGET, 0)])
        if self._drag_uris:
            tl.add_uri_targets(1)
        ctx = self.area.drag_begin_with_coordinates(tl, Gdk.DragAction.MOVE | Gdk.DragAction.COPY,
                                                    1, ev, int(px), int(py))
        if ctx:
            Gtk.drag_set_icon_surface(ctx, self._drag_image(sel, px, py))

    def on_drag_get(self, _w, _ctx, data, info, _t):
        if info == 1:
            data.set_uris(self._drag_uris)

    def on_drag_end(self, *_):
        self._drag = None
        self.press = None

    def _own_drag(self, ctx):
        return Gtk.drag_get_source_widget(ctx) == self.area

    def on_drag_motion(self, _w, ctx, _x, _y, time_):
        if self._own_drag(ctx):
            Gdk.drag_status(ctx, Gdk.DragAction.MOVE, time_)   # 자리 옮기기 — 복사(+) 표시가 뜨지 않게
            return True
        return False

    def on_drag_drop(self, w, ctx, x, y, time_):
        if self._own_drag(ctx):
            if self._drag:
                self._drop_icons(x, y)
            Gtk.drag_finish(ctx, True, False, time_)
            return True
        target = w.drag_dest_find_target(ctx, None)
        try:
            name = target.name() if target is not None else None
        except Exception:
            name = None
        if not name or name in ("NONE", ICONS_TARGET):
            Gtk.drag_finish(ctx, False, False, time_)
            return True
        w.drag_get_data(ctx, target, time_)           # → on_drop
        return True

    def _drop_icons(self, x, y):
        """바탕화면 안에서 끌어 놓음 — 놓은 점과 누른 점의 차이만큼 옮긴다 (여러 개면 서로의 배치 그대로)"""
        d = self._drag
        dx, dy = x - d["x"], y - d["y"]
        items = [it for it in self.items if it.key in d["keys"]]
        if (dx, dy) == (0, 0) or (self.snap or self.auto) and all(
                cell_of(it.x + dx, it.y + dy) == cell_of(it.x, it.y) for it in items):
            return                                     # 제자리에 놓음 — 자동 정렬을 괜히 끄지 않는다
        a = next((i for i in items if i.key == d["anchor"]), None)
        ax, ay = (a.x, a.y) if a else (0, 0)
        # 누른 아이콘이 먼저 칸을 잡고, 나머지는 그 가까운 것부터
        items.sort(key=lambda i: (i.key != d["anchor"], abs(i.x - ax) + abs(i.y - ay)))
        self._move_icons([(it, it.x + dx, it.y + dy) for it in items])

    def on_drop(self, _w, ctx, x, y, data, _info, time_):
        ok = self._receive(data.get_uris() or [], ctx.get_selected_action() == Gdk.DragAction.MOVE, x, y)
        # 옮기기여도 원본 쪽에 지우라고(del) 하지 않는다 — 이동은 여기서 직접 한다
        Gtk.drag_finish(ctx, ok, False, time_)

    def _receive(self, uris, move, x, y):
        """다른 앱에서 끌어 온 파일을 바탕화면 폴더로.
        같은 파일 시스템 안의 이동은 rename 으로 바로. 복사·다른 디스크로의 이동·폴더는 cp/mv 를
        뒤에서 돌린다 (큰 파일을 복사하는 동안 바탕화면이 멈추지 않게). 이름이 겹치면 '이름 (2)'."""
        sx, sy = x - CELL_W / 2, y - 8 - ICON / 2      # 아이콘 가운데가 놓은 점에 오게
        real_d = os.path.realpath(self.ddir)
        here, took = [], False
        verb = "옮기지" if move else "복사하지"
        for u in uris:
            f = Gio.File.new_for_uri(u)
            src = f.get_path() if f.has_uri_scheme("file") else None
            if not src:
                continue                               # file:// 가 아닌 것(웹 주소 등)은 받지 않는다
            src = os.path.normpath(src)
            name = os.path.basename(src)
            if os.path.realpath(os.path.dirname(src)) == real_d:
                # 이미 바탕화면에 있는 것 (파일 관리자에서 바탕화면 폴더를 보다가 끌어 옴) — 자리만 옮긴다
                it = next((i for i in self.items if i.path and os.path.basename(i.path) == name), None)
                if it:
                    here.append(it)
                continue
            is_dir = os.path.isdir(src) and not os.path.islink(src)
            real_s = os.path.realpath(src)
            if is_dir and (real_d == real_s or real_d.startswith(real_s + os.sep)):
                notify(f"바탕 화면으로 {verb} 못했습니다",
                       f"‘{name}’ 안에 바탕 화면 폴더가 있습니다 — 폴더를 자기 안으로 넣을 수 없습니다.")
                continue
            dst_name = free_name(name, is_dir, lambda n: n in self._reserved or
                                 os.path.lexists(os.path.join(self.ddir, n)))
            dst = os.path.join(self.ddir, dst_name)
            self._want_spot(dst_name, sx, sy)
            if move:
                try:
                    os.rename(src, dst)
                    took = True
                    continue
                except OSError as e:
                    if e.errno != errno.EXDEV:         # 다른 파일 시스템이면 아래 mv 로
                        notify(f"바탕 화면으로 {verb} 못했습니다", f"‘{name}’\n{e.strerror}")
                        continue
            argv = ["mv", "-T", "--", src, dst] if move else ["cp", "-a", "-T", "--", src, dst]
            took = self._run_job(argv, verb, dst_name) or took
        if here:
            # 격자면 놓은 칸 근처 빈 칸에 차례로, 자유 배치면 놓은 점부터 아래로
            self._move_icons([(it, sx, sy if self.snap else sy + i * CELL_H) for i, it in enumerate(here)])
            took = True
        if took:
            self._refresh_later(100)
        return took

    def _run_job(self, argv, verb, name):
        try:
            proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_SILENCE |
                                      Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as e:
            notify(f"바탕 화면으로 {verb} 못했습니다", f"‘{name}’\n{e.message}")
            return False
        self._reserved.add(name)
        self._jobs.add(proc)
        proc.communicate_async(None, None, self._job_done, (verb, name))
        return True

    def _job_done(self, proc, res, data):
        verb, name = data
        self._jobs.discard(proc)
        self._reserved.discard(name)
        err = ""
        try:
            _ok, _out, eb = proc.communicate_finish(res)
            err = eb.get_data().decode("utf-8", "replace") if eb else ""
        except GLib.Error as e:
            err = e.message
        if not proc.get_successful():
            lines = [ln.strip() for ln in err.splitlines() if ln.strip()]
            notify(f"바탕 화면으로 {verb} 못했습니다", f"‘{name}’" + (f"\n{lines[-1]}" if lines else ""))
        self._refresh_later(150)

    # ── 동작 ──────────────────────────────────────────────
    def _launch(self, path):
        try:
            app = Gio.DesktopAppInfo.new_from_filename(path)
            if app is not None:
                app.launch([], None)
                return True
        except Exception as e:
            dbg("앱 실행 실패", e)
        return False

    def _open_default(self, it_uri, it_path=None):
        try:
            Gio.AppInfo.launch_default_for_uri(it_uri, None)
        except Exception:
            run(["xdg-open", it_path or it_uri])

    def open_items(self, items):
        doubt = []
        for it in items:
            if it.key == "::install":
                run(["sekai-installer"])
                continue
            if it.is_desktop_entry:
                # 열 때 다시 본다 — 목록을 읽은 뒤 권한·표시가 바뀌었을 수 있다
                if not launcher_trusted(it.path):
                    doubt.append(it.path)
                    continue
                if self._launch(it.path):
                    continue
            if it.is_dir or it.special:
                run([file_manager(), it.uri or it.path])
            else:
                self._open_default(it.uri, it.path)
        if doubt:
            W, H = self._screen()
            cmd = launcher_command(doubt[0]) if len(doubt) == 1 else ""
            self.trust.ask(doubt, cmd, lambda: self._trust_and_open(doubt), W, H)

    def _trust_and_open(self, paths):
        for p in paths:
            mark_trusted(p)
            if not self._launch(p):
                self._open_default(Gio.File.new_for_path(p).get_uri(), p)
        self._refresh_later(100)                       # 이제 앱 이름·아이콘으로

    def trash_items(self, items):
        for it in items:
            if it.special or not it.path:
                continue
            try:
                Gio.File.new_for_path(it.path).trash(None)
            except Exception as e:
                dbg("휴지통 실패", e)
        self.selected = set()
        self._refresh_later(200)

    def rename_item(self, it):
        if it.special or not it.path:
            return

        def do(name):
            dst = os.path.join(os.path.dirname(it.path), name)
            if os.path.exists(dst):
                return "같은 이름이 이미 있습니다."
            try:
                os.rename(it.path, dst)
            except OSError as e:
                return f"바꾸지 못했습니다: {e.strerror}"
            old = os.path.basename(it.path)
            if old in self.pos:                        # 자리도 새 이름으로
                self.pos[name] = self.pos.pop(old)
                self._save()
            self.selected = {dst}
            self.cursor = dst
            return None
        self.rename.ask(it.x, it.y, os.path.basename(it.path), do, self._screen()[1])

    def new_folder(self, spot=None):
        base = "새 폴더"
        n, name = 1, base
        while os.path.exists(os.path.join(self.ddir, name)):
            n += 1
            name = f"{base} ({n})"
        os.makedirs(os.path.join(self.ddir, name))
        if spot:
            self._want_spot(name, *spot)
        GLib.timeout_add(250, lambda: (self._rename_new(name), False)[1])

    def new_text(self, spot=None):
        base = "새 텍스트 문서"
        n, name = 1, base + ".txt"
        while os.path.exists(os.path.join(self.ddir, name)):
            n += 1
            name = f"{base} ({n}).txt"
        open(os.path.join(self.ddir, name), "w").close()
        if spot:
            self._want_spot(name, *spot)
        GLib.timeout_add(250, lambda: (self._rename_new(name), False)[1])

    def _rename_new(self, name):
        self.refresh()
        it = next((i for i in self.items if i.path and os.path.basename(i.path) == name), None)
        if it:
            self.selected = {it.key}
            self.cursor = it.key
            self.area.queue_draw()
            self.rename_item(it)

    def _screen(self):
        return self.area.get_allocated_width(), self.area.get_allocated_height()

    def _menu_empty(self, ev):
        W, H = self._screen()
        entries = []
        if self.primary:
            # 새로 만든 것은 누른 칸 근처에 (자동 정렬이 꺼져 있을 때 — 윈도우처럼)
            spot = (ev.x - CELL_W / 2, ev.y - CELL_H / 2)
            view = [("아이콘 자동 정렬", None, self.toggle_auto, "✓" if self.auto else ""),
                    ("아이콘을 격자에 맞춤", None, self.toggle_snap, "✓" if self.snap else "")]
            order = [(label, None, lambda by=by: self.arrange_by(by), "●" if by == self.sort else "")
                     for by, label in SORTS]
            entries += [("새 폴더", "folder-new-symbolic", lambda: self.new_folder(spot)),
                        ("새 텍스트 문서", "document-new-symbolic", lambda: self.new_text(spot)),
                        None,
                        ("보기", "view-grid-symbolic", view),
                        ("정렬 기준", "view-sort-ascending-symbolic", order),
                        ("새로 고침", "view-refresh-symbolic", self.refresh),
                        ("여기서 터미널 열기", "utilities-terminal-symbolic",
                         lambda: run([settings().get("apps", {}).get("terminal") or "sekai-terminal"], cwd=self.ddir)),
                        ("파일 관리자에서 열기", "folder-open-symbolic",
                         lambda: run([file_manager(), self.ddir])),
                        None]
        entries += [("배경 바꾸기", "preferences-desktop-wallpaper-symbolic",
                     lambda: run(["sekai-settings", "--page=wallpaper"])),
                    ("디스플레이 설정", "video-display-symbolic",
                     lambda: run(["sekai-settings", "--page=display"])),
                    ("개인 설정", "preferences-desktop-theme-symbolic",
                     lambda: run(["sekai-settings", "--page=appearance"]))]
        self.menu.show_at(ev.x, ev.y, entries, W, H)

    def _menu_item(self, ev):
        W, H = self._screen()
        sel = [it for it in self.items if it.key in self.selected]
        entries = [("열기", "document-open-symbolic", lambda: self.open_items(sel))]
        real = [it for it in sel if not it.special]
        if any(it.key == "::trash" for it in sel):
            entries.append(("휴지통 비우기", "user-trash-full-symbolic", self.empty_trash))
        if len(real) == 1:
            entries.append(("이름 바꾸기", "document-edit-symbolic", lambda: self.rename_item(real[0])))
            entries.append(("경로 복사", "edit-copy-symbolic",
                            lambda: run(["wl-copy", real[0].path])))
        if real:
            entries += [None, ("휴지통으로 이동", "user-trash-symbolic", lambda: self.trash_items(real))]
        self.menu.show_at(ev.x, ev.y, entries, W, H)

    def empty_trash(self):
        # 되돌릴 수 없는 일이라 바로 지우지 않고 파일 관리자의 휴지통을 연다
        # (Thunar 의 "휴지통 비우기"가 확인을 묻는다)
        run([file_manager(), "trash:///"])


# ───────────────────────────────────────────────────────────────
def main():
    prov = Gtk.CssProvider()
    for p in (os.path.join(HERE, "style.css"), "/usr/share/sekai-shell/style.css"):
        if os.path.exists(p):
            a = settings().get("appearance") or {}
            pre = ("@define-color accent %s;\n@define-color bg %s;\n@define-color surface %s;\n"
                   "@define-color fg %s;\n") % (a.get("accent", "#39c5bb"), a.get("bg", "#151517"),
                                                a.get("surface", "#1e1e22"), a.get("fg", "#f1f1f3"))
            with open(p, encoding="utf-8") as f:
                prov.load_from_data((pre + f.read()).encode())
            break
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                             Gtk.STYLE_PROVIDER_PRIORITY_USER)
    st = Gtk.Settings.get_default()
    if st and os.path.isdir("/usr/share/icons/Papirus-Dark"):
        st.set_property("gtk-icon-theme-name", "Papirus-Dark")

    disp = Gdk.Display.get_default()
    desks = []

    def build():
        """모니터마다 바탕화면 하나. 아이콘은 주 모니터에만."""
        for d in desks:
            d.destroy()
        desks.clear()
        n = disp.get_n_monitors()
        prim = primary_gdk(disp) if n else None
        for i in range(n):
            m = disp.get_monitor(i)
            d = Desk(m, primary=(m == prim))
            d.show_all()
            desks.append(d)
        return False

    build()
    # 모니터를 꽂거나 빼면 다시 만든다 (새 모니터가 까맣게, 빠진 주 모니터와 함께 아이콘이 사라지지 않게)
    rebuild = {"src": 0}

    def later(*_):
        if rebuild["src"]:
            GLib.source_remove(rebuild["src"])

        def go():
            rebuild["src"] = 0
            return build()
        rebuild["src"] = GLib.timeout_add(500, go)
    disp.connect("monitor-added", later)
    disp.connect("monitor-removed", later)

    hup = {"src": 0}

    def apply_hup():
        hup["src"] = 0
        # 주 디스플레이가 바뀌었으면 아이콘을 옮긴다 (다시 만든다)
        prim = primary_gdk(disp)
        if any(d.primary != (d.monitor == prim) for d in desks if hasattr(d, "primary")):
            later()
        for d in desks:
            d.reload_settings()
        return False

    def on_hup(*_):
        # 설정 앱은 저장할 때마다 보낸다 (슬라이더를 끌면 연달아) — 잠깐 모아서 한 번만
        if hup["src"]:
            GLib.source_remove(hup["src"])
        hup["src"] = GLib.timeout_add(200, apply_hup)
        return True
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGHUP, on_hup)
    Gtk.main()


if __name__ == "__main__":
    main()
