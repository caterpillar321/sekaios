class DeskMenu(PanelPopup):
    """오른쪽 클릭 메뉴 — 누른 자리에 뜨는 레이어 창.

    GtkMenu 는 레이어셸 표면에서 z-순서가 꼬이므로 우리 팝업을 쓴다.
    """

    def __init__(self):
        super().__init__(dim=False)
        self.get_style_context().add_class("tray-menu")
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.list.set_size_request(220, -1)
        self.root.pack_start(self.list, True, True, 0)

    def show_at(self, x, y, entries, screen_w, screen_h):
        for c in self.list.get_children():
            self.list.remove(c)
        for e in entries:
            if e is None:
                sep = Gtk.Separator()
                sep.get_style_context().add_class("menu-sep")
                self.list.pack_start(sep, False, False, 0)
                continue
            label, icon, cb = e
            b = Gtk.Button()
            b.get_style_context().add_class("menu-item")
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            if icon:
                img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
                img.set_pixel_size(16)
                h.pack_start(img, False, False, 0)
            h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            b.add(h)
            b.connect("clicked", lambda _b, f=cb: (self.close(), f()))
            self.list.pack_start(b, False, False, 0)
        self.list.show_all()
        # 화면 밖으로 나가지 않게 대략 맞춘다
        w, h = 240, 20 + 36 * len([e for e in entries if e]) + 10 * entries.count(None)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, int(min(x, screen_w - w - 8)))
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, int(min(y, screen_h - h - 60)))
        self.open()


class RenamePopup(PanelPopup):
    def __init__(self):
        super().__init__(dim=False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        t = Gtk.Label(label="이름 바꾸기", xalign=0)
        t.get_style_context().add_class("pop-title")
        self.root.pack_start(t, False, False, 0)
        self.entry = Gtk.Entry()
        self.entry.set_width_chars(28)
        self.entry.connect("activate", lambda *_: self._ok())
        self.root.pack_start(self.entry, False, False, 0)
        self.err = Gtk.Label(xalign=0)
        self.err.get_style_context().add_class("pop-subtitle")
        self.root.pack_start(self.err, False, False, 0)
        self.cb = None

    def ask(self, x, y, current, cb, screen_h=1080):
        self.cb = cb
        self.entry.set_text(current)
        self.err.set_text("Enter 로 바꾸기 · Esc 로 취소")
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(8, int(x) - 40))
        # 아이콘 칸 바로 아래 — 이름 글자를 가리지 않게
        top = int(y) + CELL_H + 2
        if top + 140 > screen_h - 56:                  # 화면 아래쪽이면 아이콘 위로
            top = int(y) - 130
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(8, top))
        self.open()
        # 확장자 앞까지만 선택 (윈도우처럼)
        dot = current.rfind(".")
        self.entry.grab_focus()
        self.entry.select_region(0, dot if dot > 0 else -1)

    def _ok(self):
        name = self.entry.get_text().strip()
        if not name or "/" in name:
            self.err.set_text("사용할 수 없는 이름입니다.")
            return
        err = self.cb(name) if self.cb else None
        if err:
            self.err.set_text(err)
            return
        self.close()


