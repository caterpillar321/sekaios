CFG = os.path.expanduser("~/.config/sekai/settings.json")
FALLBACK_WALL = "/usr/share/backgrounds/sekai/hatsune.jpg"
DEBUG = os.environ.get("SEKAI_DEBUG") == "1"

ICON = 48                 # 아이콘 크기
CELL_W, CELL_H = 96, 100  # 한 칸
MARGIN = 14


def dbg(*a):
    if DEBUG:
        print("[desk]", *a, file=sys.stderr, flush=True)


def settings():
    try:
        with open(CFG, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def hex_rgb(h, fb=(0.224, 0.773, 0.733)):
    try:
        h = h.lstrip("#")
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except Exception:
        return fb


def desktop_dir():
    try:
        p = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True,
                           text=True, timeout=2).stdout.strip()
    except Exception:
        p = ""
    if not p or p == os.path.expanduser("~"):
        p = os.path.expanduser("~/Desktop")
    os.makedirs(p, exist_ok=True)
    return p


def run(cmd, cwd=None):
    try:
        subprocess.Popen(cmd if isinstance(cmd, list) else ["sh", "-c", cmd],
                         start_new_session=True, cwd=cwd,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception as e:
        dbg("실행 실패", cmd, e)


def file_manager():
    return settings().get("apps", {}).get("files") or "thunar"


# ───────────────────────────────────────────────────────────────
class Item:
    """바탕화면 아이콘 하나."""
    __slots__ = ("key", "name", "uri", "path", "gicon", "special", "is_dir",
                 "is_desktop_entry", "pixbuf", "x", "y", "app")

    def __init__(self, key, name, uri=None, path=None, gicon=None, special=False,
                 is_dir=False):
        self.key = key
        self.name = name
        self.uri = uri
        self.path = path
        self.gicon = gicon
        self.special = special
        self.is_dir = is_dir
        self.is_desktop_entry = bool(path and path.endswith(".desktop"))
        self.pixbuf = None
        self.x = self.y = 0
        self.app = None


def load_icon(gicon, names=None, size=ICON):
    theme = Gtk.IconTheme.get_default()
    try:
        if gicon is not None:
            info = theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if info:
                return info.load_icon()
    except Exception:
        pass
    for n in (names or []) + ["text-x-generic", "application-x-executable"]:
        try:
            if theme.has_icon(n):
                return theme.load_icon(n, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except Exception:
            continue
    return None


IMAGE_TYPES = ("image/png", "image/jpeg", "image/gif", "image/webp", "image/bmp")


def thumbnail(path, ctype):
    """그림 파일은 내용을 작게 보여 준다 (윈도우처럼)."""
    if ctype not in IMAGE_TYPES:
        return None
    try:
        if os.path.getsize(path) > 25 * 1024 * 1024:
            return None
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON, ICON, True)
    except Exception:
        return None


