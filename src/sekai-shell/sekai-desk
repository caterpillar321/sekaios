class Item:
    """바탕화면 아이콘 하나."""
    __slots__ = ("key", "name", "uri", "path", "gicon", "special", "is_dir",
                 "is_desktop_entry", "pixbuf", "x", "y", "app", "size", "mtime", "kind")

    def __init__(self, key, name, uri=None, path=None, gicon=None, special=False,
                 is_dir=False):
        self.key = key
        self.name = name
        self.uri = uri
        self.path = path
        self.gicon = gicon
        self.special = special
        self.is_dir = is_dir
        self.is_desktop_entry = bool(path and path.endswith(".desktop") and not is_dir)
        self.pixbuf = None
        self.x = self.y = 0
        self.app = None                    # 믿을 수 있는 실행기일 때만
        self.size = 0
        self.mtime = 0
        self.kind = ""                     # 항목 유형 (정렬용 설명)


def pos_key(it):
    """저장 파일의 키 — 파일 이름 (특별 항목은 key)"""
    return it.key if it.special else os.path.basename(it.path)


def order_key(it, by):
    """정렬 순서 — 특별 항목(내 PC·홈·설치·휴지통) → 폴더 → 파일, 그 안에서 기준 (윈도우 탐색기처럼).
    크기·날짜는 큰 것·새것부터, 폴더는 크기가 없으니 이름순."""
    if it.special:
        return (0, SPECIAL_ORDER.index(it.key) if it.key in SPECIAL_ORDER else 99, "")
    name = GLib.utf8_collate_key_for_filename(it.name, -1)   # '파일 2' 가 '파일 10' 앞에
    if by == "size":
        first = 0 if it.is_dir else -it.size
    elif by == "type":
        first = GLib.utf8_collate_key(it.kind, -1)
    elif by == "date":
        first = -it.mtime
    else:
        first = 0
    return (1 if it.is_dir else 2, first, name)


def load_icon(gicon, names=None, size=ICON):
    theme = Gtk.IconTheme.get_default()
    try:
        if gicon is not None:
            info = theme.lookup_by_gicon(gicon, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if info:
                return info.load_icon()
    except Exception:
        pass
    for n in (names or []) + ["text-x-generic", "application-x-executable"]:
        try:
            if theme.has_icon(n):
                return theme.load_icon(n, size, Gtk.IconLookupFlags.FORCE_SIZE)
        except Exception:
            continue
    return None


IMAGE_TYPES = ("image/png", "image/jpeg", "image/gif", "image/webp", "image/bmp")


def thumbnail(path, ctype):
    """그림 파일은 내용을 작게 보여 준다 (윈도우처럼)."""
    if ctype not in IMAGE_TYPES:
        return None
    try:
        if os.path.getsize(path) > 25 * 1024 * 1024:
            return None
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON, ICON, True)
    except Exception:
        return None


def file_stamp(path):
    """(수정 시각, 크기) — 썸네일을 다시 만들어야 하는지 가늠한다"""
    try:
        st = os.stat(path)
        return (st.st_mtime_ns, st.st_size)
    except OSError:
        return None


