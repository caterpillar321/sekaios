class DeskMenu(PanelPopup):
    """오른쪽 클릭 메뉴 — 누른 자리에 뜨는 레이어 창.

    GtkMenu 는 레이어셸 표면에서 z-순서가 꼬이므로 우리 팝업을 쓴다.
    항목: None 은 구분선, (이름, 아이콘, 동작[, 표시]).
      동작이 목록이면 하위 메뉴 — 줄에 마우스를 올리면 옆으로 펼친다 (하위 메뉴 창 하나를 다시 쓴다).
      표시는 체크 칸의 글자 ("✓"·"●", 꺼져 있으면 "").
    """

    def __init__(self, parent=None):
        super().__init__(dim=False)
        self.get_style_context().add_class("tray-menu")
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        if parent is not None:
            # 하위 메뉴는 키보드를 가져가지 않는다 — Esc 는 부모가 받아 둘 다 닫는다
            GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.list.set_size_request(220 if parent is None else 180, -1)
        self.root.pack_start(self.list, True, True, 0)
        self.parent_menu = parent
        self.sub = DeskMenu(self) if parent is None else None
        self._sub_row = None               # 하위 메뉴를 펼친 줄
        self._switch = 0                   # 다른 줄로 옮겨 갈 때 잠깐 기다리는 타이머
        self._at = (0, 0)                  # 이 창의 왼쪽 위 (여백)
        self._screen = (1920, 1080)

    def _top(self):
        return self.parent_menu or self

    def _fill(self, entries):
        for c in self.list.get_children():
            self.list.remove(c)
        marks = any(e is not None and len(e) > 3 for e in entries)
        for e in entries:
            if e is None:
                sep = Gtk.Separator()
                sep.get_style_context().add_class("menu-sep")
                self.list.pack_start(sep, False, False, 0)
                continue
            label, icon, act = e[:3]
            b = Gtk.Button()
            b.get_style_context().add_class("menu-item")
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            if marks:                                  # 체크 칸 — 꺼진 줄도 자리를 둬서 글자가 나란하게
                t = Gtk.Label(label=(e[3] if len(e) > 3 else "") or "")
                t.get_style_context().add_class("menu-check")
                t.set_size_request(14, -1)
                h.pack_start(t, False, False, 0)
            if icon:
                img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU)
                img.set_pixel_size(16)
                h.pack_start(img, False, False, 0)
            h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            if isinstance(act, list):
                h.pack_end(Gtk.Label(label="▸"), False, False, 0)
                b.connect("clicked", lambda _b, s=act: self._open_sub(_b, s))
                b.connect("enter-notify-event", lambda _b, _e, s=act: self._hover(_b, s))
            else:
                b.connect("clicked", lambda _b, f=act: (self._top().close(), f()))
                b.connect("enter-notify-event", lambda _b, _e: self._hover(_b, None))
            b.add(h)
            self.list.pack_start(b, False, False, 0)
        self.list.show_all()

    def show_at(self, x, y, entries, screen_w, screen_h):
        self.close()
        self._fill(entries)
        # 화면 밖으로 나가지 않게 대략 맞춘다
        w, h = 240, 20 + 36 * len([e for e in entries if e]) + 10 * entries.count(None)
        self._at = (int(min(x, screen_w - w - 8)), int(min(y, screen_h - h - 60)))
        self._screen = (screen_w, screen_h)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, self._at[0])
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, self._at[1])
        self.open()

    # ── 하위 메뉴 (옆으로 펼치기) ──
    def _cancel_switch(self):
        if self._switch:
            GLib.source_remove(self._switch)
            self._switch = 0

    def _hover(self, row, entries):
        """마우스를 올린 줄 — 하위 메뉴 줄이면 펼친다. 펼친 채 다른 줄로 가면 잠깐 뒤에 바꾼다
        (하위 메뉴로 비스듬히 가는 길에 아래 줄을 스쳐도 닫히지 않게)"""
        if self.sub is None:                           # 하위 메뉴 안 — 부모가 닫으려던 것을 멈춘다
            self.parent_menu._cancel_switch()
            return False
        self._cancel_switch()
        if self.sub.get_visible():
            if row is not self._sub_row:
                self._switch = GLib.timeout_add(250, self._switch_to, row, entries)
        elif entries is not None:
            self._open_sub(row, entries)
        return False

    def _switch_to(self, row, entries):
        self._switch = 0
        if entries is not None:
            self._open_sub(row, entries)
        else:
            self.sub.close()
            self._sub_row = None
        return False

    def _open_sub(self, row, entries):
        self._cancel_switch()
        sub = self.sub
        if sub.get_visible() and row is self._sub_row:   # 이미 펼친 줄을 누름 — 깜빡이지 않게 그대로
            return
        sub.close()
        sub._fill(entries)
        sub.root.show_all()                            # 처음엔 숨어 있어 크기가 0 으로 잰다
        nat = sub.get_preferred_size()[1]
        W, H = self._screen
        at_row = row.translate_coordinates(self, 0, 0) or (0, 0)
        at_list = self.list.translate_coordinates(self, 0, 0) or (0, 0)
        # 부모 메뉴 오른쪽에, 첫 줄이 마우스를 올린 줄과 나란하게. 오른쪽에 자리가 없으면 왼쪽에
        x = self._at[0] + self.get_allocated_width() - 4
        if x + nat.width > W - 4:
            x = self._at[0] - nat.width + 4
        y = self._at[1] + at_row[1] - at_list[1]
        x, y = max(4, int(x)), max(4, int(min(y, H - nat.height - 60)))
        sub._at, sub._screen = (x, y), self._screen
        GtkLayerShell.set_margin(sub, GtkLayerShell.Edge.LEFT, x)
        GtkLayerShell.set_margin(sub, GtkLayerShell.Edge.TOP, y)
        # 바깥 클릭은 부모의 캐처가 받는다 (닫을 때 함께 닫는다) — 하위 메뉴는 캐처를 띄우지 않는다
        sub.show_all()
        self._sub_row = row

    def close(self):
        self._cancel_switch()
        if self.sub is not None:
            self.sub.close()
            self._sub_row = None
        super().close()


class RenamePopup(PanelPopup):
    def __init__(self):
        super().__init__(dim=False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        t = Gtk.Label(label="이름 바꾸기", xalign=0)
        t.get_style_context().add_class("pop-title")
        self.root.pack_start(t, False, False, 0)
        self.entry = Gtk.Entry()
        self.entry.set_width_chars(28)
        self.entry.connect("activate", lambda *_: self._ok())
        self.root.pack_start(self.entry, False, False, 0)
        self.err = Gtk.Label(xalign=0)
        self.err.get_style_context().add_class("pop-subtitle")
        self.root.pack_start(self.err, False, False, 0)
        self.cb = None

    def ask(self, x, y, current, cb, screen_h=1080):
        self.cb = cb
        self.entry.set_text(current)
        self.err.set_text("Enter 로 바꾸기 · Esc 로 취소")
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(8, int(x) - 40))
        # 아이콘 칸 바로 아래 — 이름 글자를 가리지 않게
        top = int(y) + CELL_H + 2
        if top + 140 > screen_h - 56:                  # 화면 아래쪽이면 아이콘 위로
            top = int(y) - 130
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(8, top))
        self.open()
        # 확장자 앞까지만 선택 (윈도우처럼)
        dot = current.rfind(".")
        self.entry.grab_focus()
        self.entry.select_region(0, dot if dot > 0 else -1)

    def _ok(self):
        name = self.entry.get_text().strip()
        if not name or "/" in name:
            self.err.set_text("사용할 수 없는 이름입니다.")
            return
        err = self.cb(name) if self.cb else None
        if err:
            self.err.set_text(err)
            return
        self.close()


class TrustPopup(PanelPopup):
    """믿을 수 없는 실행기(.desktop)를 열 때 묻는 창 — Thunar·GNOME 처럼.
    받은 파일이 문서처럼 보이다가 클릭 한 번에 명령을 실행하지 못하게."""

    def __init__(self):
        super().__init__(dim=True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, False)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        self.root.set_size_request(400, -1)
        t = Gtk.Label(label="신뢰할 수 없는 실행기입니다", xalign=0)
        t.get_style_context().add_class("pop-title")
        self.root.pack_start(t, False, False, 0)
        self.body = Gtk.Label(xalign=0)
        self.body.set_line_wrap(True)
        self.body.set_max_width_chars(52)
        self.root.pack_start(self.body, False, False, 0)
        self.cmd = Gtk.Label(xalign=0)
        self.cmd.set_ellipsize(Pango.EllipsizeMode.END)
        self.cmd.set_max_width_chars(52)
        self.cmd.set_no_show_all(True)                 # 여러 개일 땐 숨긴다 (open 의 show_all 이 되살리지 않게)
        self.cmd.get_style_context().add_class("pop-subtitle")
        self.root.pack_start(self.cmd, False, False, 0)
        btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.no = Gtk.Button(label="취소")
        self.yes = Gtk.Button(label="신뢰하고 실행")
        for b in (self.no, self.yes):
            b.get_style_context().add_class("pop-btn")
            btns.pack_end(b, False, False, 0)
        self.no.connect("clicked", lambda *_: self.close())
        self.yes.connect("clicked", lambda *_: self._yes())
        self.root.pack_start(btns, False, False, 0)
        self.cb = None

    def ask(self, paths, cmd, cb, screen_w, screen_h):
        self.cb = cb
        names = [os.path.basename(p) for p in paths]
        warn = "믿을 수 있는 곳에서 받은 것이 아니면 실행하지 마세요."
        if len(names) == 1:
            self.body.set_text(f"‘{names[0]}’\n\n프로그램을 실행하는 실행기 파일인데, 실행 권한이나 "
                               f"신뢰 표시가 없습니다. {warn}")
        else:
            shown = ", ".join(names[:3]) + (f" 외 {len(names) - 3}개" if len(names) > 3 else "")
            self.body.set_text(f"실행기 {len(names)}개: {shown}\n\n실행 권한이나 신뢰 표시가 없습니다. {warn}")
        self.cmd.set_text(f"실행할 명령: {cmd}" if cmd else "")
        self.cmd.set_visible(bool(cmd))
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, max(8, (screen_w - 440) // 2))
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(8, screen_h // 3 - 90))
        self.open()
        self.no.grab_focus()                           # Enter 를 그냥 누르면 취소 쪽

    def _yes(self):
        cb, self.cb = self.cb, None
        self.close()
        if cb:
            cb()


