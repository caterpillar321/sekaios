# SekaiOS 부팅 화면 — 두 별 로고가 은은하게 숨 쉬고, 아래 점 세 개가 차례로 빛난다.

Window.SetBackgroundTopColor(0.071, 0.075, 0.090);
Window.SetBackgroundBottomColor(0.043, 0.047, 0.055);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 30, 1);

dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot_image);
    dots[i].SetPosition(cx - 26 + i * 20 - dot_image.GetWidth() / 2, cy + logo.image.GetHeight() / 2 + 30, 1);
    dots[i].SetOpacity(0.25);
}

t = 0;
fun refresh_callback() {
    t++;
    logo.sprite.SetOpacity(0.78 + 0.22 * Math.Sin(t / 22));
    for (i = 0; i < 3; i++) {
        phase = Math.Sin(t / 9 - i * 1.1);
        if (phase < 0) phase = 0;
        dots[i].SetOpacity(0.2 + 0.8 * phase);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# 부팅 중 메시지(예: 디스크 검사)는 점 아래에 작게
msg_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.72, 0.72, 0.76);
    msg_sprite.SetImage(img);
    msg_sprite.SetPosition(cx - img.GetWidth() / 2, cy + logo.image.GetHeight() / 2 + 70, 2);
}
Plymouth.SetMessageFunction(message_callback);

# 암호 입력(디스크 암호화 등)이 필요할 때 — 지금은 쓰지 않지만 멈추지 않도록
pw_sprite = Sprite();
fun display_password_callback(prompt, bullets) {
    s = prompt + "  ";
    for (i = 0; i < bullets; i++) s += "●";
    img = Image.Text(s, 0.95, 0.95, 0.96);
    pw_sprite.SetImage(img);
    pw_sprite.SetPosition(cx - img.GetWidth() / 2, cy + logo.image.GetHeight() / 2 + 70, 3);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
fun display_normal_callback() { pw_sprite.SetOpacity(0); }
Plymouth.SetDisplayNormalFunction(display_normal_callback);
