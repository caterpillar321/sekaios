[Desktop Entry]
Type=Application
Name=Photos
Name[ko]=사진
GenericName=Image Viewer
GenericName[ko]=사진 보기
Comment=View photos and pictures, and browse the other pictures in the same folder
Comment[ko]=사진과 그림을 보고, 같은 폴더의 다른 사진으로 넘겨 봅니다
Exec=sekai-photos %U
Icon=multimedia-photo-viewer
Terminal=false
Categories=Graphics;Viewer;Photography;GTK;
Keywords=사진;그림;이미지;사진 보기;그림 보기;이미지 뷰어;슬라이드 쇼;회전;photos;photo;picture;image;viewer;image viewer;slideshow;rotate;jpg;jpeg;png;gif;
MimeType=image/jpeg;image/pjpeg;image/png;image/apng;image/gif;image/bmp;image/x-bmp;image/x-ms-bmp;image/webp;image/tiff;image/svg+xml;image/svg+xml-compressed;image/x-icon;image/vnd.microsoft.icon;image/avif;image/heif;image/heic;image/jxl;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpixmap;image/x-xbitmap;image/x-icns;
StartupNotify=true
StartupWMClass=org.sekaios.Photos
