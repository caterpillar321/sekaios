# ═══════════════════════════════════════════════════════════
#  SekaiOS 부팅 메뉴 (rEFInd)
#  이 파일은 sekai-bootloader 가 만든다 — 패키지 업데이트 때 다시 써진다.
#  커널 옵션은 /etc/default/sekai-boot 에서 바꾼다.
# ═══════════════════════════════════════════════════════════

# manual  : 아래 정의한 SekaiOS 항목
# internal: 다른 내장 디스크 스캔 → 윈도우 등을 자동 탐지
#   external/optical 은 뺀다 — 꽂아 둔 설치 USB·ISO 가 부팅 항목으로 뜨지 않게
scanfor manual, internal
scan_driver_dirs EFI/@ID@/drivers_x64
icons_dir icons
timeout 3
resolution max

# 조용한 부팅: rEFInd 가 텍스트 화면으로 바꾸지 않고(파란 머리글 화면 없음) 그대로 넘긴다
use_graphics_for osx, windows, linux
hideui hints, badges

# SekaiOS 테마 — 경로는 rEFInd 가 있는 폴더 기준
banner          themes/sekai/background.png
banner_scale    fillscreen
selection_big   themes/sekai/selection_big.png
selection_small themes/sekai/selection_small.png

# 종료 · 재시작 · 펌웨어(BIOS·UEFI) 설정
#   rEFInd 0.14.2 는 showtools 에 쓴 칸만 덮어쓰고 나머지 칸의 기본 도구를 남긴다
#   → 뒤쪽을 없는 도구(gptsync)로 채워 기본값을 밀어낸다 (없는 도구는 표시되지 않음)
showtools shutdown, reboot, firmware, gptsync, gptsync, gptsync, gptsync, gptsync, gptsync, gptsync, gptsync, gptsync

# ESP 에 복사해 둔 커널(/@ID@/vmlinuz)을 '리눅스 하나 더'로 잡지 않게
scan_all_linux_kernels false

menuentry "SekaiOS" {
    icon   /EFI/@ID@/icons/os_sekai.png
    loader /@ID@/vmlinuz
    initrd /@ID@/initrd.img
    options "@ROOT@ @OPTS@"

    submenuentry "Verbose boot" {
        options "@ROOT@ systemd.log_level=info"
    }
    submenuentry "Recovery (single user)" {
        options "@ROOT@ single"
    }
}
