[Unit]
Description=SekaiOS: boot screen and console in the same monitor mode as the desktop (video=)
# 모드가 바뀔 때마다 모니터 신호가 끊겨 화면이 꺼졌다 켜진다 — 부팅부터 같은 모드로 (sekai-bootmode)

[Service]
Type=oneshot
ExecStart=/usr/libexec/sekai/sekai-bootmode
Nice=10
# update-grub 은 os-prober 가 모든 디스크를 훑어 수십 초 걸릴 수 있다 — 그래도 영영 붙잡히진 않게
TimeoutStartSec=180
