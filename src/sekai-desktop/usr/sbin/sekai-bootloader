#!/bin/bash
# ═══════════════════════════════════════════════════════════════
#  SekaiOS 부트로더 관리 — shim + GRUB (보안 부팅 지원)
#
#    sekai-bootloader install --disk /dev/sdX --part N
#        처음 설치 (설치 프로그램이 부른다)
#    sekai-bootloader update
#        패키지 업데이트 때: shim·GRUB 을 새것으로, 메뉴 다시 만들기.
#        예전 rEFInd 설치본이면 GRUB 으로 옮긴다.
#    sekai-bootloader kernel [버전]
#        (예전 커널 훅 자리 — GRUB 은 update-grub 이 따로 돈다)
#
#  보안 부팅 체인:  shimx64.efi (Microsoft 서명)
#                → grubx64.efi (데비안 서명)
#                → 커널 (데비안 서명)
#  ESP 구조 (SekaiOS 가 설치된 디스크의 자기 ESP):
#    /EFI/sekai/    shimx64.efi grubx64.efi mmx64.efi grub.cfg BOOTX64.CSV
#    /EFI/debian/   grub.cfg  ← 데비안 서명 GRUB 이 설정을 여기서 찾는다
#                   (진짜 데비안이 같은 ESP 를 쓰면 그쪽 것이라 건드리지 않는다 — debian_cfg 참고)
#    /EFI/BOOT/     BOOTX64.EFI(=shim) grubx64.efi mmx64.efi fbx64.efi sekaios.sha256
#                   (NVRAM 부팅 항목이 지워져도 켜지고, fbx64 가 항목을 되살린다.
#                    다른 OS 와 같이 쓰는 ESP 면 건드리지 않는다 — fallback 참고)
#  메뉴 모양: /etc/default/grub.d/sekai.cfg, 항목: /etc/grub.d/09_sekaios
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

ESP=/boot/efi
ID=sekai
EFIDIR="$ESP/EFI/$ID"
LABEL="SekaiOS"

say() { echo "sekai-bootloader: $*"; }
die() { echo "sekai-bootloader: 오류: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "관리자 권한이 필요합니다"

grub_install() {
    # --no-nvram: 부팅 항목은 아래에서 우리 이름(SekaiOS)으로 직접 만든다
    grub-install --target=x86_64-efi --efi-directory="$ESP" --bootloader-id="$ID" \
        --uefi-secure-boot --no-nvram >/dev/null 2>&1 || die "grub-install 실패"
    [ -f "$EFIDIR/shimx64.efi" ] || die "shim 이 설치되지 않았습니다 (shim-signed 패키지)"
    debian_cfg
    # fbx64 가 NVRAM 항목을 되살릴 때 쓰는 목록 (UTF-16LE)
    printf 'shimx64.efi,%s,,%s\n' "$LABEL" "SekaiOS 부팅" | iconv -f UTF-8 -t UTF-16LE > "$EFIDIR/BOOTX64.CSV"
}

debian_cfg() {
    # 데비안 서명 GRUB(grubx64.efi)은 설정 위치가 /EFI/debian 으로 박혀 있다 (서명된 이미지라 바꿀 수 없다).
    #   그 폴더가 없으면 자기가 켜진 곳($cmdpath = EFI/sekai)의 grub.cfg 를 읽는다.
    #   진짜 데비안이 같은 ESP 를 쓰면 이 파일은 그쪽 것이다 — 덮으면 데비안 부팅이 망가진다.
    #   그래서 폴백 경로와 같은 원칙으로, 우리가 쓴 것만 갱신한다:
    #     ① 파일이 없다  ② 지난번에 우리가 쓴 그대로다 (EFI/sekai/debian-grub.sha256)
    #     ③ 우리 grub.cfg 와 내용이 같다  ④ EFI/debian 에 grub.cfg 말고 아무것도 없다 (표시가 없던 예전 설치본)
    #   그 밖엔 건드리지 않는다. 이때 SekaiOS 를 켜면 데비안 쪽 메뉴가 뜬다 — 데비안에서 os-prober 를
    #   켜면(GRUB_DISABLE_OS_PROBER=false) 그 메뉴에 SekaiOS 도 나온다.
    local D="$ESP/EFI/debian" CFG="$ESP/EFI/debian/grub.cfg" MARK="$EFIDIR/debian-grub.sha256"
    if [ -f "$CFG" ] \
       && [ "$(sha256sum "$CFG" | cut -d" " -f1)" != "$(cat "$MARK" 2>/dev/null)" ] \
       && ! cmp -s "$CFG" "$EFIDIR/grub.cfg" \
       && [ -n "$(find "$D" -mindepth 1 ! -iname grub.cfg -print -quit 2>/dev/null)" ]; then
        say "이 ESP 를 데비안이 같이 써서 EFI/debian/grub.cfg 는 건드리지 않습니다 (SekaiOS 는 데비안 쪽 부팅 메뉴로 켜질 수 있습니다)"
        return 0
    fi
    mkdir -p "$D"
    cp -f "$EFIDIR/grub.cfg" "$CFG"
    sha256sum "$CFG" | cut -d" " -f1 > "$MARK"
}

other_os() {
    # 이 ESP 에 SekaiOS 말고 다른 것이 있으면 그 폴더 이름을 찍는다 (없으면 실패).
    #   우리 것: EFI/sekai, EFI/BOOT, grub.cfg 만 든 EFI/debian (데비안 서명 GRUB 이 찾는 곳 — 위에서 만든다).
    #   FAT 은 대소문자를 가리지 않으므로 소문자로 비교한다.
    local d n
    for d in "$ESP"/EFI/*/; do
        [ -d "$d" ] || continue
        n=$(basename "$d")
        case "${n,,}" in
            "$ID"|boot) continue ;;
            debian) [ -z "$(find "$d" -mindepth 1 ! -iname grub.cfg -print -quit 2>/dev/null)" ] && continue ;;
        esac
        echo "$n"
        return 0
    done
    return 1
}

fallback() {
    # 폴백 경로(EFI/BOOT/BOOTX64.EFI — NVRAM 항목이 없을 때 펌웨어가 켜는 것)는 한 ESP 에 하나뿐이다.
    #   남의 것을 덮으면 그 운영체제가 폴백으로 켜지지 않는다. 그래서 우리가 넣은 것만 고친다:
    #     ① 지난번에 우리가 쓴 그대로다 (sekaios.sha256 에 적어 둔 해시와 같다) — 업데이트
    #     ② 이 ESP 에 SekaiOS 말고 아무것도 없다 — 새 설치(설치 프로그램이 디스크째 만든 ESP),
    #        또는 표시가 없던 예전 SekaiOS 설치본(rEFInd 시절 포함)
    #   그 밖엔 (다른 OS 가 있거나, 우리가 쓴 뒤에 누가 바꿨다) 건드리지 않는다.
    local B="$ESP/EFI/BOOT" MARK="$ESP/EFI/BOOT/sekaios.sha256" other cur
    if [ -f "$B/BOOTX64.EFI" ] && [ -f "$MARK" ]; then
        cur=$(sha256sum "$B/BOOTX64.EFI" | cut -d" " -f1)
        if [ "$cur" != "$(cat "$MARK" 2>/dev/null)" ]; then
            say "폴백 경로(EFI/BOOT)가 SekaiOS 가 쓴 뒤에 바뀌어 건드리지 않습니다"
            return
        fi
    elif other=$(other_os); then
        say "이 ESP 에 다른 운영체제($other)가 있어 폴백 경로(EFI/BOOT)는 건드리지 않습니다"
        return
    fi
    mkdir -p "$B"
    # 예전 SekaiOS(rEFInd)가 폴백 경로에 두던 것 — 우리 것일 때만 여기까지 온다
    rm -f "$B/refind.conf"; rm -rf "$B/icons" "$B/fonts" "$B/themes" "$B/drivers_x64"
    cp -f "$EFIDIR/shimx64.efi" "$B/BOOTX64.EFI"
    cp -f "$EFIDIR/grubx64.efi" "$B/grubx64.efi"
    cp -f "$EFIDIR/mmx64.efi"   "$B/mmx64.efi"   2>/dev/null || true
    cp -f /usr/lib/shim/fbx64.efi.signed "$B/fbx64.efi" 2>/dev/null || true
    sha256sum "$B/BOOTX64.EFI" | cut -d" " -f1 > "$MARK"
}

nvram() {  # 디스크 파티션번호
    local disk="$1" part="$2"
    # 같은 이름의 옛 항목(예전 rEFInd 포함)을 지우고 새로
    for n in $(efibootmgr 2>/dev/null | grep -P "^Boot[0-9A-Fa-f]{4}\\* \\Q$LABEL\\E(\\t|$)" | cut -c5-8); do
        efibootmgr -b "$n" -B >/dev/null 2>&1 || true
    done
    if efibootmgr --create --disk "$disk" --part "$part" \
            --loader "\\EFI\\$ID\\shimx64.efi" --label "$LABEL" >/dev/null 2>&1; then
        say "UEFI 부팅 항목 등록 ($LABEL)"
    else
        say "UEFI 부팅 항목을 등록하지 못했습니다 — 폴백 경로로 켜집니다"
    fi
}

esp_disk_part() {
    local src pk
    src=$(findmnt -no SOURCE "$ESP")
    pk=$(lsblk -no PKNAME "$src" | head -1)
    echo "/dev/$pk $(cat /sys/class/block/$(basename "$src")/partition)"
}

cleanup_refind() {
    # 예전(rEFInd) 설치본의 흔적 — 더는 쓰지 않는다
    rm -f  "$EFIDIR/refind_x64.efi" "$EFIDIR/refind.conf"
    rm -rf "$EFIDIR/icons" "$EFIDIR/fonts" "$EFIDIR/themes" "$EFIDIR/drivers_x64" "$EFIDIR/banners"
    rm -rf "$ESP/$ID"          # ESP 에 복사해 두던 커널
}

cmd="${1:-}"; shift || true
case "$cmd" in
    install)
        disk=""; part=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --disk) disk="$2"; shift 2 ;;
                --part) part="$2"; shift 2 ;;
                *) die "모르는 옵션: $1" ;;
            esac
        done
        [ -n "$disk" ] && [ -n "$part" ] || die "사용법: install --disk /dev/sdX --part N"
        mountpoint -q "$ESP" || die "$ESP 가 마운트돼 있지 않습니다"
        grub_install; fallback
        # 출력은 버리지 않는다 — 설치 기록에 남아야 os-prober 가 무엇을 찾았는지 알 수 있다
        update-grub 2>&1 || die "update-grub 실패"
        nvram "$disk" "$part"
        ;;
    update)
        mountpoint -q "$ESP" && [ -d "$ESP/EFI/$ID" ] || { say "SekaiOS ESP 구조가 없어 건너뜁니다"; exit 0; }
        migrate=0
        [ -f "$EFIDIR/refind_x64.efi" ] && [ ! -f "$EFIDIR/shimx64.efi" ] && migrate=1
        grub_install; fallback
        update-grub >/dev/null 2>&1 || die "update-grub 실패"
        if [ $migrate = 1 ]; then
            read -r disk part <<<"$(esp_disk_part)"
            nvram "$disk" "$part"
            cleanup_refind
            say "rEFInd 에서 GRUB 으로 옮겼습니다 (보안 부팅 지원)"
        fi
        say "부팅 메뉴 갱신"
        ;;
    kernel)
        exit 0 ;;
    *)
        sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
        exit 2 ;;
esac
