#!/usr/bin/python3
"""SekaiOS — 부팅 화면·콘솔의 모니터 모드를 바탕화면과 같게 (커널 옵션 video=).

모니터는 화면 모드(해상도·주사율)가 바뀔 때마다 연결을 다시 맺는다. 그동안 신호가 끊기고,
LCD 는 "신호 없음"으로 보고 백라이트까지 끄기도 한다. 부팅하며 펌웨어 → 부팅 화면 → 로그인 화면 →
바탕화면으로 넘어갈 때마다 모드가 달라지면 그만큼 화면이 꺼졌다 켜진다.
커널 콘솔(과 그 위의 부팅 화면)을 바탕화면과 같은 모드로 시작하면 뒤의 전환에서 모드가 그대로다.

사용자 세션(sekai-panel)이 지금 쓰는 모드를 /var/lib/sekai/displays/<사용자>.modes 에 적으면
sekai-bootmode.path 가 이것을 부른다. 지금 화면 앞(seat0)의 활성 세션 사용자의 것만 쓴다
(예전엔 "가장 최근에 쓴 사용자" — 수정 시각은 누구나 touch 로 바꿀 수 있어 다른 사용자가 값을 정할 수 있었다).
그 폴더는 누구나 쓸 수 있으므로 ① 파일 주인이 그 사용자인지 ② 줄 형식을 엄격히 확인한다.
값이 바뀌었을 때만 /var/lib/sekai/boot-video 를 고치고 update-grub (09_sekaios 가 읽는다).
update-grub 은 다른 SekaiOS update-grub(첫 부팅·부트로더 업데이트)과 겹치지 않게 차례를 기다린다 (update-grub-locked).
"""
import fcntl
import os
import pwd
import re
import signal
import stat
import subprocess
import sys

DIR = "/var/lib/sekai/displays"
OUT = "/var/lib/sekai/boot-video"
LOCK = "/run/sekai-update-grub.lock"                 # update-grub-locked 와 같은 잠금
UPDATE_GRUB = "/usr/libexec/sekai/update-grub-locked"
LINE = re.compile(r"^([A-Za-z]{1,8}(?:-[A-Za-z])?-[0-9]{1,2}) ([0-9]{3,5})x([0-9]{3,5})@([0-9]{2,3}(?:\.[0-9]{1,3})?)$")


class Stopped(Exception):
    """systemd 가 멈추라고 했다 (TimeoutStartSec·끄기) — boot-video 를 되돌리고 끝나려고 예외로 받는다"""


def on_term(signum, frame):
    signal.signal(signal.SIGTERM, signal.SIG_IGN)   # 되돌리는 중에 또 끊기지 않게
    raise Stopped()


def log(*a):
    print("sekai-bootmode:", *a, file=sys.stderr, flush=True)


def read_owned(path, uid):
    """(내용, 수정 시각) — 주인이 uid 인 4KB 이하의 일반 파일만, 아니면 None.
    한 번 연 fd 로 확인과 읽기를 같이 한다 (확인한 뒤 이름으로 다시 열면 그 사이에 바꿔치기될 수 있다).
    심볼릭 링크는 따라가지 않고(O_NOFOLLOW), FIFO 도 막히지 않게 연다(O_NONBLOCK) — 누구나 쓰는 폴더라서."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size > 4096:
            return None
        return os.read(fd, 4096).decode("utf-8", "replace"), st.st_mtime
    except OSError:
        return None
    finally:
        os.close(fd)


def loginctl(*args):
    try:
        r = subprocess.run(["loginctl", *args], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    return r.stdout if r.returncode == 0 else ""


def active_user():
    """지금 화면 앞(seat0)의 활성 세션 사용자 — 없거나 로그인 화면·원격 세션이면 None.
    모니터 모드는 그 화면을 쓰는 사람의 것이 맞다. 로그인 화면(_greetd)은 class=greeter 라 빠진다."""
    sid = loginctl("show-seat", "seat0", "-p", "ActiveSession", "--value").strip()
    if not sid or not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", sid):
        return None
    props = {}
    for line in loginctl("show-session", sid, "-p", "Name", "-p", "Class", "-p", "Remote").splitlines():
        k, _, v = line.partition("=")
        props[k] = v
    if props.get("Class") != "user" or props.get("Remote") == "yes":
        return None
    name = props.get("Name", "")
    return name if re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name) else None


def newest():
    """(사용자, 내용) — 화면 앞 활성 세션 사용자의 .modes (주인이 그 사용자일 때만)"""
    user = active_user()
    if not user:
        return None
    try:
        uid = pwd.getpwnam(user).pw_uid
    except KeyError:
        return None
    got = read_owned(os.path.join(DIR, user + ".modes"), uid)
    return (user, got[0]) if got else None


def video_opts(text):
    opts = []
    for line in text.splitlines()[:8]:
        m = LINE.match(line.strip())
        if not m:
            continue
        name, w, h, hz = m.group(1), int(m.group(2)), int(m.group(3)), float(m.group(4))
        if not (320 <= w <= 16384 and 200 <= h <= 16384 and 20 <= hz <= 600):
            continue
        # 커널은 주사율을 정수(반올림)로 맞춰 본다 — 164.96 → 165
        opts.append(f"video={name}:{w}x{h}@{round(hz)}")
    return " ".join(opts)


def wanted():
    """(사용자, video= 옵션, boot-video 에 적을 내용) — 없으면 None"""
    found = newest()
    if not found:
        return None
    user, text = found
    opts = video_opts(text)
    return user, opts, f'SEKAI_VIDEO_OPTS="{opts}"\n'.encode()


def current():
    """지금 boot-video 의 내용 (없거나 못 읽으면 None)"""
    try:
        with open(OUT, "rb") as f:
            return f.read()
    except OSError:
        return None


def put(data):
    """boot-video 를 바꿔 넣는다 — None 이면 지운다"""
    if data is None:
        try:
            os.remove(OUT)
        except FileNotFoundError:
            pass
        return
    tmp = OUT + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, OUT)


def take_lock():
    """update-grub 차례 — 다른 SekaiOS update-grub 이 도는 중이면 끝나기를 기다린다. 잠금 fd 를 돌려준다"""
    # root 만 열 수 있게 — 남이 읽기로 열어 붙잡으면(flock 은 읽기 전용 fd 로도 된다) 모든 update-grub 이 멈춘다
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.fchmod(fd, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("다른 update-grub 이 끝나기를 기다립니다")
        fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def main():
    if os.path.isdir("/run/live/medium") or not os.path.isfile("/boot/grub/grub.cfg"):
        return 0                                     # 라이브·이미지 만드는 중
    got = wanted()
    if not got or current() == got[2]:
        return 0                                     # 대부분 여기서 끝 — 잠금도 필요 없다
    signal.signal(signal.SIGTERM, on_term)
    try:
        lock = take_lock()
    except OSError as e:
        log("update-grub 잠금을 잡지 못했습니다:", e)   # 잠그지 않고 돌리진 않는다
        return 1
    # 차례를 받은 뒤에 다시 읽는다 — 기다리는 동안 모드가 또 바뀌었거나, 앞선 실행이 이미 적었을 수 있다
    got = wanted()
    old = current()
    if not got or old == got[2]:
        return 0
    user, opts, want = got
    ok = False
    try:
        # 09_sekaios 가 update-grub 중에 읽으므로 먼저 적는다
        put(want)
        log(f"{user} 의 모니터 모드로: {opts or '(없음)'}")
        r = subprocess.run([UPDATE_GRUB], capture_output=True, text=True, pass_fds=(lock,),
                           env=dict(os.environ, SEKAI_GRUB_LOCK_FD=str(lock)))
        ok = r.returncode == 0
        if not ok:
            log("update-grub 실패:", r.stderr.strip()[-400:])
    except OSError as e:
        log("update-grub 을 돌리지 못했습니다:", e)
    finally:
        if not ok:
            # 반영되지 않았다 — 예전 내용으로 되돌려야(없었으면 지워야) 다음 번에 "같다"며 건너뛰지 않고 다시 시도한다
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            try:
                put(old)
            except OSError as e:
                log("boot-video 를 되돌리지 못했습니다:", e)
    return 0 if ok else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Stopped:
        log("멈추라는 신호를 받아 끝냅니다 (boot-video 는 그대로 — 다음 번에 다시 시도)")
        sys.exit(1)
