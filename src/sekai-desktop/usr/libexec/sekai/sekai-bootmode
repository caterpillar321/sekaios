#!/usr/bin/python3
"""SekaiOS — 부팅 화면·콘솔의 모니터 모드를 바탕화면과 같게 (커널 옵션 video=).

모니터는 화면 모드(해상도·주사율)가 바뀔 때마다 연결을 다시 맺는다. 그동안 신호가 끊기고,
LCD 는 "신호 없음"으로 보고 백라이트까지 끄기도 한다. 부팅하며 펌웨어 → 부팅 화면 → 로그인 화면 →
바탕화면으로 넘어갈 때마다 모드가 달라지면 그만큼 화면이 꺼졌다 켜진다.
커널 콘솔(과 그 위의 부팅 화면)을 바탕화면과 같은 모드로 시작하면 뒤의 전환에서 모드가 그대로다.

사용자 세션(sekai-panel)이 지금 쓰는 모드를 /var/lib/sekai/displays/<사용자>.modes 에 적으면
sekai-bootmode.path 가 이것을 부른다. 가장 최근에 적은 사용자의 것을 쓴다.
그 폴더는 누구나 쓸 수 있으므로 ① 파일 주인이 이름의 사용자인지 ② 줄 형식을 엄격히 확인한다.
값이 바뀌었을 때만 /var/lib/sekai/boot-video 를 고치고 update-grub (09_sekaios 가 읽는다).
"""
import os
import pwd
import re
import subprocess
import sys

DIR = "/var/lib/sekai/displays"
OUT = "/var/lib/sekai/boot-video"
LINE = re.compile(r"^([A-Za-z]{1,8}(?:-[A-Za-z])?-[0-9]{1,2}) ([0-9]{3,5})x([0-9]{3,5})@([0-9]{2,3}(?:\.[0-9]{1,3})?)$")


def log(*a):
    print("sekai-bootmode:", *a, file=sys.stderr, flush=True)


def newest():
    """(사용자, 경로) — 주인이 맞는 .modes 중 가장 최근 것"""
    best = None
    try:
        names = os.listdir(DIR)
    except OSError:
        return None
    for f in names:
        if not f.endswith(".modes"):
            continue
        user = f[:-len(".modes")]
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", user):
            continue
        path = os.path.join(DIR, f)
        try:
            st = os.lstat(path)
            uid = pwd.getpwnam(user).pw_uid
        except (OSError, KeyError):
            continue
        if not os.path.isfile(path) or os.path.islink(path) or st.st_uid != uid or st.st_size > 4096:
            continue
        if best is None or st.st_mtime > best[0]:
            best = (st.st_mtime, user, path)
    return best[1:] if best else None


def video_opts(path):
    opts = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f.read().splitlines()[:8]:
            m = LINE.match(line.strip())
            if not m:
                continue
            name, w, h, hz = m.group(1), int(m.group(2)), int(m.group(3)), float(m.group(4))
            if not (320 <= w <= 16384 and 200 <= h <= 16384 and 20 <= hz <= 600):
                continue
            # 커널은 주사율을 정수(반올림)로 맞춰 본다 — 164.96 → 165
            opts.append(f"video={name}:{w}x{h}@{round(hz)}")
    return " ".join(opts)


def main():
    if os.path.isdir("/run/live/medium") or not os.path.isfile("/boot/grub/grub.cfg"):
        return 0                                     # 라이브·이미지 만드는 중
    found = newest()
    if not found:
        return 0
    user, path = found
    opts = video_opts(path)
    want = f'SEKAI_VIDEO_OPTS="{opts}"\n'
    try:
        with open(OUT, encoding="utf-8") as f:
            if f.read() == want:
                return 0
    except OSError:
        pass
    tmp = OUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(want)
    os.replace(tmp, OUT)
    log(f"{user} 의 모니터 모드로: {opts or '(없음)'}")
    r = subprocess.run(["update-grub"], capture_output=True, text=True)
    if r.returncode != 0:
        log("update-grub 실패:", r.stderr.strip()[-400:])
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
