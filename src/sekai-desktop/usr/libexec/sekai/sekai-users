#!/usr/bin/env python3
# ═══════════════════════════════════════════════════════════════
#  SekaiOS 계정 관리 도우미 — 관리자 권한으로 실행된다 (pkexec)
#
#    sekai-users add <사용자이름> <admin|standard>     (표시 이름·암호는 표준 입력 두 줄)
#    sekai-users remove <사용자이름> <keep|delete>     (홈 폴더를 남길지)
#    sekai-users admin <사용자이름> <on|off>
#    sekai-users logs <사용자이름>                     (기록 읽기 그룹을 관리자 여부에 맞춘다)
#
#  설정 앱의 "가족 및 다른 사용자" 페이지가 부른다 (logs 는 컴퓨터 관리의 이벤트 뷰어).
#  관리자(sudo)는 시스템 기록도 바로 볼 수 있게 systemd-journal 그룹에 함께 넣고, 관리자를 풀면 뺀다
#  (윈도우처럼 관리자는 이벤트 뷰어의 시스템·보안 기록을 암호 없이 본다).
#  관리자 권한으로 도는 프로그램이라 인자는 엄격히 검사한다.
#  결과: 성공하면 종료 코드 0, 실패하면 표준 출력에 사람이 읽을 이유 한 줄.
# ═══════════════════════════════════════════════════════════════
import grp
import os
import pwd
import re
import subprocess
import sys

USER_RE = re.compile(r"^[a-z][a-z0-9_-]{0,30}$")
RESERVED = {"root", "daemon", "bin", "sys", "sync", "games", "man", "lp", "mail", "news", "uucp",
            "proxy", "www-data", "backup", "list", "irc", "nobody", "admin", "_greetd", "sekai-oobe"}
GROUPS = ("audio", "video", "plugdev", "netdev", "cdrom", "dialout", "bluetooth", "users")
JOURNAL = "systemd-journal"         # 시스템 기록(journald)을 읽는 그룹 — 관리자만
# 관리자에게 함께 주는 그룹 — 시스템 기록 읽기(이벤트 뷰어), 프린터 추가·제거(CUPS 의 SystemGroup)
ADMIN_EXTRA = (JOURNAL, "lpadmin")
ENV = dict(os.environ, LC_ALL="C.UTF-8", PATH="/usr/sbin:/usr/bin:/sbin:/bin")
DISPLAYS = "/var/lib/sekai/displays"


def fail(msg, code=1):
    print(msg, flush=True)
    sys.exit(code)


def run(cmd, inp=None):
    r = subprocess.run(cmd, input=inp, capture_output=True, text=True, env=ENV)
    return r.returncode, r.stdout + r.stderr


def have_group(g):
    try:
        grp.getgrnam(g)
        return True
    except KeyError:
        return False


def human_user(name):
    """사람 계정(uid 1000~)만 다룬다 — 시스템 계정은 건드리지 않는다"""
    try:
        p = pwd.getpwnam(name)
    except KeyError:
        fail("없는 사용자입니다")
    if not (1000 <= p.pw_uid < 60000):
        fail("이 계정은 여기서 바꿀 수 없습니다")
    return p


def caller():
    """pkexec 를 부른 사람의 이름"""
    uid = os.environ.get("PKEXEC_UID")
    try:
        return pwd.getpwuid(int(uid)).pw_name if uid else None
    except (KeyError, ValueError):
        return None


def admins():
    try:
        return [m for m in grp.getgrnam("sudo").gr_mem]
    except KeyError:
        return []


def add(name, kind):
    if not USER_RE.match(name) or name in RESERVED:
        fail("사용자 이름은 영문 소문자로 시작하고 영문 소문자·숫자·_·- 만 쓸 수 있습니다")
    try:
        pwd.getpwnam(name)
        fail("이미 있는 사용자 이름입니다")
    except KeyError:
        pass
    lines = sys.stdin.read().split("\n")
    full = (lines[0] if lines else "").strip()
    pw = lines[1] if len(lines) > 1 else ""
    if ":" in full or len(full) > 80 or not pw or len(pw) > 256:
        fail("표시 이름이나 암호가 올바르지 않습니다")
    groups = [g for g in GROUPS if have_group(g)]
    if kind == "admin":
        groups.append("sudo")
        groups += [g for g in ADMIN_EXTRA if have_group(g)]
    rc, out = run(["useradd", "-m", "-s", "/bin/bash", "-c", full or name, "-G", ",".join(groups), name])
    if rc != 0:
        fail("계정을 만들지 못했습니다")
    # 예전에 같은 이름이던 계정(이 수정 전에 지웠거나 다른 도구로 지운 것)이나 남이 미리 만들어 둔 파일 —
    #   새 계정은 아직 로그인한 적이 없으니 그 이름의 파일은 모두 남의 것이다
    clear_displays(name)
    rc, out = run(["chpasswd"], inp=f"{name}:{pw}\n")
    if rc != 0:
        run(["userdel", "-r", name])
        fail("암호를 정하지 못했습니다")


def remove(name, keep):
    p = human_user(name)
    if name == caller():
        fail("지금 로그인한 자기 계정은 지울 수 없습니다")
    rc, out = run(["loginctl", "list-sessions", "--no-legend"])
    if any(ln.split()[2:3] == [name] for ln in out.splitlines() if ln.strip()):
        fail("이 사용자가 로그인해 있습니다 — 먼저 로그아웃해야 합니다")
    if name in admins() and len(admins()) <= 1:
        fail("마지막 관리자는 지울 수 없습니다")
    cmd = ["userdel"] + ([] if keep == "keep" else ["-r"]) + [name]
    rc, out = run(cmd)
    if rc not in (0, 12):              # 12 = 홈 폴더를 지우지 못함 (계정은 지워짐)
        fail("계정을 지우지 못했습니다")
    if keep == "keep" and os.path.isdir(p.pw_dir) and p.pw_dir.startswith("/home/"):
        # 남긴 홈 폴더는 관리자만 열 수 있게 — 그대로 두면 옛 UID 소유라, 다음에 만드는 계정이
        # 같은 UID 를 받아 이 사람의 파일(브라우저 프로필·키링 등)을 모두 읽을 수 있다
        try:
            os.chown(p.pw_dir, 0, 0)
            os.chmod(p.pw_dir, 0o700)
        except OSError:
            pass
    clear_displays(name)


def clear_displays(name):
    """공용 폴더의 <이름>.conf(로그인 화면 해상도)·<이름>.modes(부팅 화면 모드)를 지운다.
    남아 있으면 같은 이름으로 다시 만든 계정(새 UID)에겐 sticky 폴더의 남의 파일이라 고쳐 쓰지 못하고,
    읽는 쪽(그리터·sekai-bootmode)도 주인이 달라 버려서 조용히 동작하지 않는다.
    unlink 는 링크를 따라가지 않고(링크·FIFO 면 그 이름만 지운다) 폴더는 지우지 못한다."""
    if "/" in name or name.startswith("."):
        return
    for ext in (".conf", ".modes"):
        try:
            os.unlink(os.path.join(DISPLAYS, name + ext))
        except OSError:
            pass


def admin(name, on):
    human_user(name)
    if on == "off":
        if name == caller():
            fail("자기 자신의 관리자 권한은 뺄 수 없습니다")
        if name in admins() and len(admins()) <= 1:
            fail("마지막 관리자의 권한은 뺄 수 없습니다")
        rc, out = run(["gpasswd", "-d", name, "sudo"])
    else:
        rc, out = run(["usermod", "-aG", "sudo", name])
    if rc != 0:
        fail("권한을 바꾸지 못했습니다")
    sync_logs(name)


def sync_logs(name):
    """관리자 전용 그룹(ADMIN_EXTRA — 기록 읽기·프린터 관리)을 관리자 여부에 맞춘다 — 다음 로그인부터 적용된다"""
    ok = True
    is_admin = name in admins()
    for g in ADMIN_EXTRA:
        if not have_group(g):
            continue
        member = name in grp.getgrnam(g).gr_mem
        rc = 0
        if is_admin and not member:
            rc, _out = run(["usermod", "-aG", g, name])
        elif not is_admin and member:
            rc, _out = run(["gpasswd", "-d", name, g])
        ok = ok and rc == 0
    return ok


def logs(name):
    human_user(name)
    if not have_group(JOURNAL):
        fail("이 시스템에는 기록 읽기 그룹이 없습니다")
    if not sync_logs(name):
        fail("권한을 바꾸지 못했습니다")
    if name not in admins():
        fail("관리자 계정만 시스템 기록을 볼 수 있습니다")


def main():
    if os.geteuid() != 0:
        fail("관리자 권한이 필요합니다")
    a = sys.argv[1:]
    if len(a) == 3 and a[0] == "add" and a[2] in ("admin", "standard"):
        add(a[1], a[2])
    elif len(a) == 3 and a[0] == "remove" and a[2] in ("keep", "delete"):
        remove(a[1], a[2])
    elif len(a) == 3 and a[0] == "admin" and a[2] in ("on", "off"):
        admin(a[1], a[2])
    elif len(a) == 2 and a[0] == "logs":
        logs(a[1])
    else:
        fail("사용법: sekai-users add|remove|admin|logs …", 2)
    print("OK", flush=True)


if __name__ == "__main__":
    main()
