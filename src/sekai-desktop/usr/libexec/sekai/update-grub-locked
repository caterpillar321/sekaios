#!/bin/bash
# SekaiOS — update-grub 을 한 번에 하나씩
#   SekaiOS 가 부르는 update-grub 은 모두 이것을 거친다:
#     첫 부팅(sekai-oobe-helper), 부팅 화면 모드(sekai-bootmode), 부트로더 설치·업데이트(sekai-bootloader)
#
#   grub-mkconfig 는 잠금 없이 정해진 이름(grub.cfg.new)에 쓰고, os-prober 도 정해진 마운트 자리를 쓴다.
#   둘이 겹치면 한쪽이 다른 쪽의 반쯤 쓴 파일을 grub.cfg 로 옮겨 Windows 항목이 빠지거나 잘린다.
#   기다리는 쪽은 차례를 기다린다(버리지 않는다). 다만 기다리는 동안 다른 쪽이 update-grub 을
#   새로 "시작"해 성공했으면 그 결과가 이미 지금 상태를 담고 있으므로 한 번 더 돌지 않는다.
#
#   SEKAI_GRUB_LOCK_FD=N  부른 쪽이 이 잠금을 이미 잡고 fd N 을 물려준 경우 (sekai-bootmode —
#     boot-video 를 적는 것부터 update-grub 까지 한 차례로 해야 한다). 같은 열린 파일이라 바로 통과한다.
#   종료 코드는 update-grub 의 것. 잠금을 못 잡으면 돌리지 않고 실패한다 (겹쳐 도는 것보다 낫다).
set -u
# /run/lock 은 누구나 쓸 수 있어(1777) 남이 먼저 만들어 붙잡아 둘 수 있다 — root 만 쓰는 /run 에
LOCK=/run/sekai-update-grub.lock
SEQ=/run/sekai-update-grub.seq      # 지금까지 시작한 update-grub 순번
DONE=/run/sekai-update-grub.done    # 마지막으로 성공한 update-grub 의 순번

say() { echo "update-grub-locked: $*" >&2; }
num() { local n; n=$(head -c 20 "$1" 2>/dev/null); case $n in ''|*[!0-9]*) n=0 ;; esac; echo $((10#$n)); }
put() { printf '%s\n' "$2" > "$1.tmp" && mv -f "$1.tmp" "$1"; }

[ "$(id -u)" -eq 0 ] || { say "관리자 권한이 필요합니다"; exit 1; }

# 부른 쪽은 바꿀 것을 다 바꾼 뒤에 여기에 온다 — 이 순번보다 뒤에 시작한 update-grub 은 그것을 본다
before=$(num "$SEQ")

if [ -n "${SEKAI_GRUB_LOCK_FD:-}" ]; then
    fd=$SEKAI_GRUB_LOCK_FD
    case $fd in *[!0-9]*) say "SEKAI_GRUB_LOCK_FD 가 올바르지 않습니다"; exit 1 ;; esac
    # 물려받은 fd 가 정말 이 잠금 파일인지 — 다른 파일이면 잠그지 않은 채 돌게 된다
    [ "/proc/self/fd/$fd" -ef "$LOCK" ] || { say "물려받은 fd 가 잠금 파일이 아닙니다"; exit 1; }
else
    # 남이 읽기로 열어 붙잡지 못하게(flock 은 읽기 전용 fd 로도 된다) root 만 열 수 있게 만든다
    (umask 077; exec 9>>"$LOCK") && exec 9>>"$LOCK" || { say "잠금 파일을 열지 못했습니다 ($LOCK)"; exit 1; }
    chmod 600 "$LOCK" 2>/dev/null
    fd=9
fi
unset SEKAI_GRUB_LOCK_FD
if ! flock -n "$fd"; then
    say "다른 update-grub 이 끝나기를 기다립니다"
    flock "$fd" || { say "잠금을 잡지 못했습니다"; exit 1; }
fi

if [ "$(num "$DONE")" -gt "$before" ]; then
    say "기다리는 동안 다른 update-grub 이 부팅 메뉴를 새로 만들었습니다 — 다시 돌지 않습니다"
    exit 0
fi
n=$(( $(num "$SEQ") + 1 ))
put "$SEQ" "$n" || { say "순번을 적지 못했습니다 ($SEQ)"; exit 1; }
# 잠금 fd 는 update-grub 과 그 자식에게도 물려준다 — 이 스크립트가 먼저 죽어도 grub-mkconfig 가
#   끝날 때까지 잠금이 풀리지 않게
update-grub
rc=$?
[ $rc -eq 0 ] && put "$DONE" "$n"
exit $rc
