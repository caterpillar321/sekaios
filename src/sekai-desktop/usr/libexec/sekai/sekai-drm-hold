#!/usr/bin/python3
"""SekaiOS — 그래픽 장치(/dev/dri/card*)를 열어 두기만 한다. 로그인 화면 ↔ 바탕화면이 끊김 없이 넘어가게.

로그인 화면(Hyprland)이 끝나고 사용자 Hyprland 가 뜨기 전 잠깐, 장치를 연 프로그램이 하나도 없으면
커널이 콘솔 화면(fbdev)을 되살린다(lastclose). 조용한 부팅이면 콘솔이 한 번도 그려지지 않아
그 버퍼엔 지난 화면 조각이 남아 있고, 한 장이 모든 모니터 (0,0) 에 복제돼 보였다
(좌상단·보조 모니터에 로그인 화면이 남는 아티팩트, 부팅 때 잠깐 보이는 쓰레기 화면).
장치를 열어 두면 그 되살리기가 없고, 마지막 화면이 남은 채 다음 Hyprland 가 넘겨받는다.

화면 제어권(DRM master)은 갖지 않는다 — 열자마자 내려놓는다. 로그인 화면이 제어권을 가진 뒤에
시작해야 한다 (greetd.service 가 plymouth-handoff 다음에 띄운다).
"""
import fcntl
import glob
import os
import select
import signal

DRM_IOCTL_DROP_MASTER = 0x641F          # _IO('d', 0x1f)

fds = []
for path in sorted(glob.glob("/dev/dri/card[0-9]*")):
    try:
        fd = os.open(path, os.O_RDWR | os.O_CLOEXEC)
    except OSError:
        continue
    try:
        fcntl.ioctl(fd, DRM_IOCTL_DROP_MASTER)   # 혹시 제어권이 넘어왔으면 곧바로 내려놓는다
    except OSError:
        pass                                     # 보통은 제어권이 없어 실패한다 — 정상
    fds.append(fd)

if not fds:
    raise SystemExit(0)
signal.signal(signal.SIGTERM, lambda *_: os._exit(0))


# ── 커널 글자 콘솔(fbcon)을 보고 있는 가상 터미널에 맞춰 붙이고 뗀다 (sekai-fbcon 머리말) ──
#   글자 콘솔(tty2~6)을 보는 동안만 붙인다. 그래픽 화면(1번·사용자 전환의 8번~)으로 돌아오면 다시 뗀다 —
#   안 그러면 Ctrl+Alt+F2 를 한 번 쓴 뒤로는 로그아웃·사용자 전환 때 콘솔이 다시 번쩍였다.
#   커널이 터미널을 바꿀 때 /sys/class/tty/tty0/active 에 알림을 준다 (못 받아도 5초마다 다시 본다)
def fbcon_bind(on):
    for c in glob.glob("/sys/class/vtconsole/vtcon*"):
        try:
            with open(c + "/name") as f:
                if "frame buffer" not in f.read().lower():
                    continue
            with open(c + "/bind") as f:
                if f.read().strip() == ("1" if on else "0"):
                    continue
            with open(c + "/bind", "w") as f:
                f.write("1" if on else "0")
        except OSError:
            pass


ACTIVE = "/sys/class/tty/tty0/active"
try:
    act = open(ACTIVE)
except OSError:
    while True:
        signal.pause()
poller = select.poll()
poller.register(act, select.POLLPRI | select.POLLERR)
last = None
while True:
    try:
        act.seek(0)
        tty = act.read().strip()
    except OSError:
        tty = last
    if tty != last:
        last = tty
        fbcon_bind(tty in ("tty2", "tty3", "tty4", "tty5", "tty6"))
    poller.poll(5000)
