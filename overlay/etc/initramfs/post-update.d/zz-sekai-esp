#!/bin/sh
# SekaiOS — initramfs 가 재생성될 때 ESP 복사본 갱신
set -e
version="$1"
initramfs="$2"
[ -n "$version" ] || exit 0

ESP=/boot/efi
DIR="$ESP/sekai"
mountpoint -q "$ESP"    || exit 0
[ -d "$ESP/EFI/sekai" ] || exit 0

src="${initramfs:-/boot/initrd.img-$version}"
[ -f "$src" ] || exit 0

mkdir -p "$DIR"
cp -f "$src" "$DIR/.initrd.new" && mv -f "$DIR/.initrd.new" "$DIR/initrd.img"
sync
echo "zz-sekai-esp: ESP initramfs 갱신 ($version)"
exit 0
