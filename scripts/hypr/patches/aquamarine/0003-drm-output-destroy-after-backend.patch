+    // expired() is also true while an object is being destroyed (upstream 6d0b356 only checked for null).
+    if (!backend.expired() && backend->backend && !backend->backend.expired())
+        backend->backend->removeIdleEvent(frameIdle);
+    if (connector) {
+        connector->isPageFlipPending   = false;
+        connector->frameEventScheduled = false;
+    }
